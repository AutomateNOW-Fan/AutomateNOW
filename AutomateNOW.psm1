        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($SecretVault_Id)")) -eq $true) {
            ## Begin warning ##
            ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
            $Error.Clear()
            Try {
                [boolean]$SecretVault_exists = ($null -ne (Get-AutomateNOWSecretVault -Id $SecretVault_Id))
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWSecretVault failed to check if the Secret Vault [$SecretVault_Id] already existed due to [$Message]."
                Break
            }
            If ($SecretVault_exists -eq $false) {
                [string]$current_domain = $anow_session.header.domain
                Write-Warning -Message "There is not a Secret Vault with Id [$SecretVault_Id] in the current domain [$current_domain]."
                Break
            }
            ## End warning ##
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'id' = $SecretVault_Id
            $BodyMetaData.'_operationType' = 'update'
            $BodyMetaData.'_operationId' = 'setDefaultVault'
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            $Error.Clear()
            Try {
                [ANOWSecretVault]$UpdatedSecretVault = $results.response.data | Select-Object -First 1
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to parse the returned updated object to an [ANOWSecretVault] object due to [$Message]. The object was still updated though."
                Break
            }
            If ($UpdatedSecretVault.defaultVault -eq $true) {
                Write-Verbose -Message "Secret Vault [$SecretVault_Id] was successfully set as the default"
                If ($Quiet -ne $true) {
                    Return $UpdatedSecretVault
                }
            }
            Else {
                Write-Warning -Message "The Secret Vault [$SecretVault_Id] was not set as the default."
                Break
            }
        }
    }
    End {
    }
}

Function Clear-AutomateNOWSecretVaultCache {
    <#
    .SYNOPSIS
    Clears the cache of a Secret Vault on an AutomateNOW! instance

    .DESCRIPTION
    Clears the cache of a Secret Vault on an AutomateNOW! instance

    .PARAMETER SecretVault
    An [ANOWSecretVault] object representing the Secret Vault (cache) to be cleared.

    .PARAMETER Force
    Force the clearing without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the informational message.

    .INPUTS
    An [ANOWSecretVault] object is required which can be sent across the pipeline.

    .OUTPUTS
    An informational message will be emitted.

    .EXAMPLE
    Forcibly clears the cache on a Secret Vault named 'SecretVault1' (multi-line)

    $vault = Get-AutomateNOWSecretVault -Id 'SecretVault1'
    $vault | Clear-AutomateNOWSecretVaultCache -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWSecretVault]$SecretVault,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/secretVault/clearVaultCache'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWSecretVault]$SecretVault = $_
        }
        [string]$SecretVault_Id = $SecretVault.simpleId
        [boolean]$SecretVault_UseCache = $SecretVault.useCacheVault
        If ($SecretVault_UseCache -eq $false) {
            Write-Warning -Message "$SecretVault_Id does not make use of the cache. No action is required."
            Break
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($SecretVault_Id)")) -eq $true) {
            ## Begin warning ##
            ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
            $Error.Clear()
            Try {
                [boolean]$SecretVault_exists = ($null -ne (Get-AutomateNOWSecretVault -Id $SecretVault_Id))
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWSecretVault failed to check if the Secret Vault [$SecretVault_Id] already existed due to [$Message]."
                Break
            }
            If ($SecretVault_exists -eq $false) {
                [string]$current_domain = $anow_session.header.domain
                Write-Warning -Message "There is not a Secret Vault with Id [$SecretVault_Id] in the current domain [$current_domain]."
                Break
            }
            ## End warning ##
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'id' = $SecretVault_Id
            $BodyMetaData.'_operationType' = 'custom'
            $BodyMetaData.'_operationId' = 'clearVaultCache'
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Else {
                If ($Quiet -ne $true) {
                    Write-Information -MessageData "The cache for Secret Vault [$SecretVault_Id] was successfully cleared."
                }
            }
        }
    }
    End {
    }
}

Function Add-AutomateNOWSecretVaultSecret {
    <#
    .SYNOPSIS
    Adds (puts) a new secret to a Secret Vault on an AutomateNOW! instance

    .DESCRIPTION
    Adds (puts) a new secret to a Secret Vault on an AutomateNOW! instance

    .PARAMETER SecretVault
    An [ANOWSecretVault] object representing the Secret Vault that is receiving the new secret.

    .PARAMETER Key
    Mandatory string representing the key of the key/value pair being added

    .PARAMETER Value
    Mandatory string representing the value of the key/value pair being added

    .PARAMETER Force
    Force the clearing without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the informational message.

    .INPUTS
    An [ANOWSecretVault] object is required which can be sent across the pipeline along with a Key and a Value

    .OUTPUTS
    An informational message will be emitted.

    .EXAMPLE
    Forcibly and quietly adds a secret (i.e. a key/value pair) to a Secret Vault named 'SecretVault1'

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Add-AutomateNOWSecretVaultSecret -Key 'key' -Value 'value' -Force -Quiet

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWSecretVault]$SecretVault,
        [Parameter(Mandatory = $true)]
        [string]$Key,
        [Parameter(Mandatory = $true)]
        [string]$Value,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        $batchStopped = $false
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        if ($batchStopped) { return }
        If ($_.id.Length -gt 0) {
            [ANOWSecretVault]$SecretVault = $_
        }
        [string]$SecretVault_Id = $SecretVault.simpleId
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($SecretVault_Id)")) -eq $true) {
            ## Begin warning ##
            ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
            $lookup = Invoke-ANOWPrivateCommand -Command (Get-Command Get-AutomateNOWSecretVault) -Parameters @{Id=$SecretVault_Id}
            if (-not $lookup.Succeeded -or $lookup.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Vault existence could not be confirmed without a diagnostic. Values and exception details were withheld. No secret update was sent; subsequent writes are stopped.'
                return
            }
            ## End warning ##
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'id' = $SecretVault_Id
            $BodyMetaData.'key' = $Key
            $BodyMetaData.'value' = $Value
            $BodyMetaData.'_operationType' = 'custom'
            $BodyMetaData.'_operationId' = 'putSecret'
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            [string]$command = ('/secretVault/putSecret?' + $Body)
            If ($null -eq $parameters["Command"]) {
                $parameters.Add('Command', $command)
            }
            Else {
                $parameters.Command = $command
            }
            $request = Invoke-ANOWPrivateCommand -Command (Get-Command Invoke-AutomateNOWAPI) -Parameters $parameters
            if (-not $request.Succeeded) {
                $batchStopped = $true
                Write-Warning 'Vault secret update transport failed or emitted a diagnostic. Values were withheld; the outcome is uncertain. No subsequent secret will be written.'
                return
            }
            $results = if ($request.Data.Count -eq 1) { $request.Data[0] } else { $null }
            if (-not (Test-ANOWSuccessStatus $results.response)) {
                $batchStopped = $true
                Write-Warning 'Vault secret update did not return a numeric zero success status. Response values were withheld. No subsequent secret will be written.'
                return
            }
            if (-not $Quiet) { Write-Information "Added '$Key' to Secret Vault [$SecretVault_Id]" }

        }
    }
    End {
    }
}

