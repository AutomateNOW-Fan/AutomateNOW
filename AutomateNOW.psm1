Function Remove-AutomateNOWCommunicationNote {
    <#
    .SYNOPSIS
    Removes a Communication Note from an AutomateNOW! instance

    .DESCRIPTION
    Removes a Communication Note from an AutomateNOW! instance

    .PARAMETER CommunicationNote
    Mandatory [ANOWCommunicationNote] object representing the Communication Note that is being removed. Use Get-AutomateNOWCommunicationNote to retrieve them.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present a [ANOWCommunicationNote] object to the -CommunicationNote parameter (or to the pipeline).

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Forcibly removes the first page of Communication Notes associated with a Task Template named 'TaskTemplate1'

    Get-AutomateNOWCommunicationNote -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1') | Remove-AutomateNOWCommunicationNote -Force

    .EXAMPLE
    Forcibly removes a Communication Note with an Id of '156240c4-7754-4a30-8b1d-dc207fbb540d' (one-liner format)

    Get-AutomateNOWCommunicationNote -Id '156240c4-7754-4a30-8b1d-dc207fbb540d' | Remove-AutomateNOWCommunicationNote -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    If you provide the numerical -Id instead of the -CommunicationNote object then there will not be "old_values" included in the request.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWCommunicationNote]$CommunicationNote,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/communicationNote/delete'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If (($_.id.Length -gt 0)) {
            [ANOWCommunicationNote]$CommunicationNote = $_
        }
        [string]$CommunicationNote_id = $CommunicationNote.id
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($CommunicationNote_id)")) -eq $true) {
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.Add('id', $CommunicationNote_id )
            If ($null -ne $CommunicationNote) {
                [string]$old_values = $CommunicationNote.CreateOldValues()
                $BodyMetaData.Add('_oldValues', $old_values )
            }
            $BodyMetaData.Add('_operationType', 'remove')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_componentId', 'CommunicationNoteList')
            $BodyMetaData.Add('_dataSource', 'CommunicationNoteDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$CommunicationNote_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Communication Note $CommunicationNote_id was removed (archived)"
        }
    }
    End {

    }
}

Function Update-AutomateNOWCommunicationNote {
    <#
    .SYNOPSIS
    Updates a Communication Note from an AutomateNOW! instance

    .DESCRIPTION
    Updates a Communication Note from an AutomateNOW! instance

    .PARAMETER CommunicationNote
    Mandatory [ANOWCommunicationNote] object representing the Communication Note that is being removed. Use Get-AutomateNOWCommunicationNote to retrieve them.

    .PARAMETER Content
    Mandatory string representing the content of the Communication Note. For example: "I am closing this because..."

    .PARAMETER Accept
    Exclusive switch parameter that marks the note as 'Accepted' (applies only to CHANGE_REQUEST and PROBLEM note types)

    .PARAMETER Acknowledge
    Exclusive switch parameter that marks the note as 'Acknowledged' (applies only to INFO and WARNING note types)

    .PARAMETER Answer
    Exclusive switch parameter that marks the note as 'Answered'

    .PARAMETER Close
    Exclusive switch parameter that marks the note as 'Closed'

    .PARAMETER Comment
    Exclusive switch parameter that marks the note as 'Commented'

    .PARAMETER Done
    Exclusive switch parameter that marks the note as 'Completed' (applies only to CHANGE_REQUEST and PROBLEM note types)

    .PARAMETER Reject
    Exclusive switch parameter that marks the note as 'Rejected' (applies only to CHANGE_REQUEST and PROBLEM note types)

    .PARAMETER Reopen
    Exclusive switch parameter that marks the note as 'Reopened' (applies to any note type that is closed)

    .PARAMETER Quiet
    Optional switch parameter that suppresses the output of this function

    .INPUTS
    You must present a [ANOWCommunicationNote] object to the -CommunicationNote parameter (or to the pipeline).

    .OUTPUTS
    An [ANOWCommunicationNote] object will be emitted.

    .EXAMPLE
    Quietly finds and acknowledges the first page of INFO notes on a Processing Template named 'TaskTemplate1' (one-liner)

    Get-AutomateNOWCommunicationNote -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1') -NoteType INFO | Update-AutomateNOWCommunicationNote -Acknowledge -Content "Acknowledging this note" -Quiet

    .EXAMPLE
    Comments on a specific Note by its Id (one-liner)

    Get-AutomateNOWCommunicationNote -Id 'ead543dc-e68c-4db2-a2d2-be283a189f87' | Update-AutomateNOWCommunicationNote -Acknowledge -Content "Commenting on this note"

    .EXAMPLE
    Quietly re-opens the first page of notes on a Processing Template named 'TaskTemplate1' (multi-line)

    $notes = Get-AutomateNOWCommunicationNote -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1')
    $notes | Update-AutomateNOWCommunicationNote -Reopen -Content "Reopening this note" -Quiet

    .EXAMPLE
    Quietly finds and closes the first page of notes (all types) on a Processing Template named 'TaskTemplate1' (one-liner)

    Get-AutomateNOWCommunicationNote -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1') | Update-AutomateNOWCommunicationNote -Close -Content "Closing this note" -Quiet

    .EXAMPLE
    Accepts the first page of notes of type PROBLEM on a Processing Template named 'TaskTemplate1' (one-liner))

    Get-AutomateNOWCommunicationNote -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1') -NoteType PROBLEM | Update-AutomateNOWCommunicationNote -Accept -Content "Accepting this problem note"

    .EXAMPLE
    Quietly rejects the first page of notes of type PROBLEM on a Processing Template named 'TaskTemplate1' (one-liner))

    Get-AutomateNOWCommunicationNote -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1') -NoteType PROBLEM | Update-AutomateNOWCommunicationNote -Reject -Content "Rejecting this problem note"

    .EXAMPLE
    Quietly marks the first page of notes of type PROBLEM as done on a Processing Template named 'TaskTemplate1' (one-liner))

    Get-AutomateNOWCommunicationNote -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1') -NoteType PROBLEM | Update-AutomateNOWCommunicationNote -Done -Content "Marking this as done"

    .EXAMPLE
    Answers a specific Note of type QUESTION by its Id (one-liner)

    Get-AutomateNOWCommunicationNote -Id '9105f233-9545-49b1-9e98-971eabb95aef' | Update-AutomateNOWCommunicationNote -Answer -Content "The answer is..."

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Updating notes is not considered destructive by the vendor hence there is no confirmation needed with this function.

    #>
    [OutputType([ANOWCommunicationNote])]
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWCommunicationNote]$CommunicationNote,
        [Parameter(Mandatory = $true)]
        [string]$Content,
        [Parameter(Mandatory = $true, ParameterSetName = 'Accept')]
        [switch]$Accept,
        [Parameter(Mandatory = $true, ParameterSetName = 'Acknowledge')]
        [switch]$Acknowledge,
        [Parameter(Mandatory = $true, ParameterSetName = 'Answer')]
        [switch]$Answer,
        [Parameter(Mandatory = $true, ParameterSetName = 'Close')]
        [switch]$Close,
        [Parameter(Mandatory = $true, ParameterSetName = 'Comment')]
        [switch]$Comment,
        [Parameter(Mandatory = $true, ParameterSetName = 'Done')]
        [switch]$Done,
        [Parameter(Mandatory = $true, ParameterSetName = 'Reject')]
        [switch]$Reject,
        [Parameter(Mandatory = $true, ParameterSetName = 'Reopen')]
        [switch]$Reopen,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If (($_.id.Length -gt 0)) {
            [ANOWCommunicationNote]$CommunicationNote = $_
        }
        [string]$CommunicationNote_id = $CommunicationNote.id
        [string]$CommunicationNote_type = $CommunicationNote.noteType
        [string]$CommunicationNote_status = $CommunicationNote.noteStatus
        If ($Accept -eq $true) {
            [string]$endpoint = 'accept'
            [string]$note_reply_type = 'ACCEPT'
            If ($CommunicationNote_type -notin @('CHANGE_REQUEST', 'PROBLEM')) {
                Write-Warning -Message "A reply type of '$note_reply_type' is only valid for note types: 'CHANGE_REQUEST' or 'PROBLEM'"
                Break
            }
        }
        ElseIf ($Acknowledge -eq $true) {
            [string]$endpoint = 'acknowledge'
            [string]$note_reply_type = 'ACKNOWLEDGE'
            If ($CommunicationNote_type -notin @('INFO', 'WARNING')) {
                Write-Warning -Message "A reply type of '$note_reply_type' is only valid for note types 'INFO' and 'WARNING'"
                Break
            }
        }
        ElseIf ($Answer -eq $true) {
            [string]$endpoint = 'answer'
            [string]$note_reply_type = 'ANSWER'
            If ($CommunicationNote_type -ne 'QUESTION') {
                Write-Warning -Message "A reply type of '$note_reply_type' is only valid for note type 'QUESTION'"
                Break
            }
        }
        ElseIf ($Close -eq $true) {
            If ($CommunicationNote_status -eq 'CLOSED') {
                Write-Warning -Message "$CommunicationNote_id is already closed"
                Break
            }
            [string]$endpoint = 'close'
            [string]$note_reply_type = 'CLOSE' # Note that CLOSE is a valid reply type for all note types that are not closed
        }
        ElseIf ($Comment -eq $true) {
            [string]$endpoint = 'comment'
            [string]$note_reply_type = 'COMMENT' # Note that COMMENT is a valid reply type for all note types
        }
        ElseIf ($Done -eq $true) {
            [string]$endpoint = 'done'
            [string]$note_reply_type = 'DONE'
            If ($CommunicationNote_type -notin @('CHANGE_REQUEST', 'PROBLEM')) {
                Write-Warning -Message "A reply type of '$note_reply_type' is only valid for note types: 'CHANGE_REQUEST' or 'PROBLEM'"
                Break
            }
        }
        ElseIf ($Reject -eq $true) {
            [string]$endpoint = 'reject'
            [string]$note_reply_type = 'REJECT'
            If ($CommunicationNote_type -notin @('CHANGE_REQUEST', 'PROBLEM')) {
                Write-Warning -Message "A reply type of '$note_reply_type' is only valid for note types: 'CHANGE_REQUEST' or 'PROBLEM'"
                Break
            }
        }
        ElseIf ($Reopen -eq $true) {
            If ($CommunicationNote_status -ne 'CLOSED') {
                Write-Warning -Message "Open notes may not be reopened."
                Break
            }
            [string]$endpoint = 'reopen'
            [string]$note_reply_type = 'REOPEN' # Note that REOPEN is a valid reply type for all note types that are closed
        }
        Else {
            Write-Warning -Message "Unable to determine the update type under Update-AutomateNOWCommunicatioNote"
            Break
        }
        [string]$command = ('/communicationNote/' + $endpoint)
        If ($null -eq $parameters.Command) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.Command = $command
        }
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        $BodyMetaData.Add('id', $CommunicationNote_id )
        $BodyMetaData.Add('content', $content )
        $BodyMetaData.Add('noteReplyType', $note_reply_type )
        $BodyMetaData.Add('_operationType', 'update')
        $BodyMetaData.Add('_operationId', $endpoint)
        $BodyMetaData.Add('_textMatchStyle', 'exact')
        $BodyMetaData.Add('_dataSource', 'CommunicationNoteDataSource')
        $BodyMetaData.Add('isc_metaDataPrefix', '_')
        $BodyMetaData.Add('isc_dataFormat', 'json')
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        If ($null -eq $parameters.Body) {
            $parameters.Add('Body', $Body)
        }
        Else {
            $parameters.Body = $Body
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$CommunicationNote_id] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        Write-Verbose -Message "Communication Note $CommunicationNote_id was updated"
        $Error.Clear()
        Try {
            [ANOWCommunicationNote]$communication_note = $results.response.data | Select-Object -First 1
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Unable to parse the response into an [ANOWCommunicationNote] object (under Update-AutomateNOWCommunicationNote) against [$CommunicationNote_id] due to [$Message]."
            Break
        }
        If ($Quiet -ne $true) {
            Return $communication_note
        }
    }
    End {

    }
}

Function Show-AutomateNOWCollaborationWall {
    <#
    .SYNOPSIS
    Uses Out-GridView to show the Communication Notes from an AutomateNOW! instance to create a "Collaboration Wall" (Windows desktop clients only)

    .DESCRIPTION
    Uses Out-GridView to show the Communication Notes from an AutomateNOW! instance to create a "Collaboration Wall" (Windows desktop clients only)

    .PARAMETER CommunicationNote
    Optional [ANOWCommunicationNote] object representing the Communication Notes being shown. Use Get-AutomateNOWCommunicationNote to retrieve them and send them across the pipeline (see the examples)

    .PARAMETER Title
    Optional string for the title of the Out-Gridview window.

    .PARAMETER Quiet
    Optional switch parameter that will suppress the output if any rows are selected when the grid is closed.

    .INPUTS
    Inputs are not required but you may present [ANOWCommunicationNote] objects to the pipeline to customize what is shown.

    .OUTPUTS
    A table from Out-GridView will be displayed and the selected Communication Notes will be returned back as [ANOWCommunicationNote] objects.

    .EXAMPLE
    Gets and shows the first page of Communication Notes (one-liner)

    Show-AutomateNOWCollaborationWall

    .EXAMPLE
    Gets and shows (with a customized title) the first page of Communication Notes with a type of INFO and a status of NEW.

    Get-AutomatenowCommunicationNote -noteType INFO -status NEW | Show-AutomateNOWCollaborationWall -Title 'New INFO notes'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    This function is intended for PowerShell clients on Windows desktop operating systems.

    Clicking OK (or pressing ENTER) on the table will close it and emit the Communication Notes that were selected (if -Quiet is not used).

    #>
    Param(
        [Parameter(Mandatory = $false, ValueFromPipeline = $True)]
        [ANOWCommunicationNote]$CommunicationNote,
        [Parameter(Mandatory = $false)]
        [string]$Title,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        [ANOWCommunicationNote[]]$communication_notes_from_pipeline = @()
    }
    Process {
        If ($_.id.length -gt 0) {
            [ANOWCommunicationNote]$CommunicationNote = $_
        }
        If ($CommunicationNote.id.length -gt 0) {
            $communication_notes_from_pipeline += $CommunicationNote
        }
    }
    End {
        If ($communication_notes_from_pipeline.Count -eq 0) {
            $Error.Clear()
            Try {
                [ANOWCommunicationNote[]]$communication_notes = Get-AutomateNOWCommunicationNote | Sort-Object -Property 'noteType', 'lastUpdated'
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWCommunicationNote failed to retrieve the Communication Notes due to [$Message]."
                Break
            }
        }
        Else {
            [ANOWCommunicationNote[]]$communication_notes = $communication_notes_from_pipeline
        }
        [int32]$communication_notes_count = $communication_notes.count
        If ($communication_notes_count -eq 0) {
            Write-Warning -Message "There were no communication notes available to show"
            Break
        }
        [PSCustomObject[]]$formatted_notes = $communication_notes | Select-Object -Property 'domain', 'lastUpdated', 'noteSubjectName', 'noteStatus', 'noteType', 'noteSubjectCategory', 'content', 'noteSourceType', 'noteSourceName', 'dateCreated'
        If ($Title.Length -eq 0) {
            [string]$Title = 'Collaboration Wall'
        }
        If ($Quiet -ne $true) {
            [PSCustomObject[]]$selected_notes = $formatted_notes | Out-GridView -Title $Title -PassThru
            Return $selected_notes
        }
        Else {
            $formatted_notes | Out-GridView -Title $Title
        }
    }
}

