nt":"SLA"},{"processingType":"SERVICE","serviceType":"MONITOR","monitorType":"PROCESSING_BASELINE_DEVIATION_MONITOR","id":"PROCESSING_BASELINE_DEVIATION_MONITOR","icon":"skin/chart_down_color.png","name":"Baseline Deviation Monitor","parent":"PROCESSING"},{"processingType":"SERVICE","serviceType":"MONITOR","monitorType":"PROCESSING_DEADLINE_MONITOR","id":"PROCESSING_DEADLINE_MONITOR","icon":"skin/chart_stock.png","name":"Processing Deadline Monitor","parent":"SLA"},{"processingType":"TRIGGER","id":"TRIGGER","name":"Trigger","icon":"skin/arrow-out.png","folder":true},{"processingType":"TRIGGER","triggerType":"SCHEDULE","id":"SCHEDULE","icon":"skin/clock.png","name":"Time Schedule","parent":"TRIGGER"},{"processingType":"TRIGGER","triggerType":"USER","id":"USER","icon":"skin/user.png","name":"User","parent":"TRIGGER"},{"processingType":"TRIGGER","triggerType":"EVENT","id":"EVENT","icon":"skin/arrow-out.png","name":"Event Schedule","parent":"TRIGGER"},{"processingType":"TRIGGER","triggerType":"SELF_SERVICE","id":"SELF_SERVICE","icon":"skin/user.png","name":"Self Service","parent":"TRIGGER"},{"parent":"NONEXISTING_ITEM_TO_HIDE_FROM_VIEW","processingType":"TASK","taskType":"TRIGGER_ITEM","id":"TRIGGER_ITEM","name":"Trigger Item","icon":"skin/exe.png","inactive":true},{"processingType":"TASK","taskType":"PROCESSING_OBSERVER","id":"PROCESSING_OBSERVER","icon":"skin/emotion_eye.png","name":"Processing Observer","parent":"NONEXISTING_ITEM_TO_HIDE_FROM_VIEW","inactive":true}]'
    If ($AsJson -eq $true) {
        Return $TaskTypesJson
    }
    [PSCustomObject]$TaskTypes = $TaskTypesJson | ConvertFrom-Json
    If ($Parent.Length -gt 0) {
        [PSCustomObject[]]$TaskTypesArray = $TaskTypes | ForEach-Object { [PSCustomObject]@{ Parent = $_.parent; Id = $_.id; Name = $_.name; } } | Where-Object { $_.Parent -eq $Parent }
    }
    ElseIf ($Id.Length -gt 0) {
        [PSCustomObject[]]$TaskTypesArray = $TaskTypes | ForEach-Object { [PSCustomObject]@{ Parent = $_.parent; Id = $_.id; Name = $_.name; } } | Where-Object { $_.Id -eq $Id }
    }
    ElseIf ($Name.Length -gt 0) {
        [PSCustomObject[]]$TaskTypesArray = $TaskTypes | ForEach-Object { [PSCustomObject]@{ Parent = $_.parent; Id = $_.id; Name = $_.name; } } | Where-Object { $_.Name -eq $Name }
    }
    ElseIf ($InternalOnly -eq $true) {
        [PSCustomObject[]]$1st_level = $TaskTypes | Where-Object { $_.Parent -in (($TaskTypes | Where-Object { $_.Parent -eq 'INTERNAL' }).Id) }
        [PSCustomObject[]]$2nd_level = $TaskTypes | Where-Object { $_.Parent -in $1st_level.id }
        [PSCustomObject[]]$TaskTypesArray = ($1st_level + $2nd_level) | ForEach-Object { [PSCustomObject]@{ Parent = $_.parent; Id = $_.id; Name = $_.name; } }
    }
    ElseIf ($NonInternalOnly -eq $true) {
        [PSCustomObject[]]$1st_level = $TaskTypes | Where-Object { $_.Parent -in (($TaskTypes | Where-Object { $_.Parent -eq 'INTERNAL' }).Id) }
        [PSCustomObject[]]$2nd_level = $TaskTypes | Where-Object { $_.Parent -in $1st_level.id }
        [PSCustomObject[]]$combined_levels = ($1st_level + $2nd_level)
        [string[]]$internal_ids = $combined_levels.id
        [PSCustomObject[]]$TaskTypesArray = $TaskTypes | Where-Object { $_.id -notin $internal_ids } | ForEach-Object { [PSCustomObject]@{ Parent = $_.parent; Id = $_.id; Name = $_.name; } }
    }
    Else {
        [array]$TaskTypesArray = $TaskTypes | ForEach-Object { [PSCustomObject]@{ Parent = $_.parent; Id = $_.id; Name = $_.name; } }
    }
    If (($ListInternal -eq $true) -or ($ListNonInternal -eq $true)) {
        [string]$List = ((($TaskTypesArray).Id | Sort-Object) -join '; ') + ';'
        Return $List
    }
    Else {
        Return $TaskTypesArray
    }
}

