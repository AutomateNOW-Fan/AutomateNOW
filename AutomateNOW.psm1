        [Parameter(Mandatory = $false, ParameterSetName = 'ServiceManagerTemplateItem')]
        [switch]$UnsetTitle,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [Parameter(Mandatory = $false, ParameterSetName = 'ServiceManagerTemplateItem')]
        [string[]]$Tags,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [Parameter(Mandatory = $false, ParameterSetName = 'ServiceManagerTemplateItem')]
        [switch]$UnsetTags,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [ANOWServerNode]$ServerNode,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [switch]$UnsetServerNode,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [ANOWEndpoint]$Endpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [switch]$UnsetEndpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [Parameter(Mandatory = $false, ParameterSetName = 'ServiceManagerTemplateItem')]
        [ANOWResultMapping]$ResultMapping,
        [Parameter(Mandatory = $false, ParameterSetName = 'WorkflowTemplateItem')]
        [Parameter(Mandatory = $false, ParameterSetName = 'ServiceManagerTemplateItem')]
        [switch]$UnsetResultMapping,
