Function Complete-AutomateNOWSchedule {
    <#
    .SYNOPSIS
    Force Completes or Force Fails a Schedule on an AutomateNOW! instance

    .DESCRIPTION
    Force Completes or Force Fails a Schedule on an AutomateNOW! instance

    .PARAMETER Schedule
    An [ANOWSchedule] object representing the Schedule to be completed

    .PARAMETER ForceFail
    Switch parameter that alters this function set 'Force Failed' instead of 'Force Completed'

    .PARAMETER DoNotKeepForcedStatus
    Optional switch that enables "Restate on agent status update". Not enabling this is equivalent to "Keep completed status on agent status update".

    .PARAMETER Force
    Force the restart without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to suppress the informational message and the Force Completed Schedule

    .INPUTS
    ONLY [ANOWSchedule] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWSchedule] object is returned.

    .EXAMPLE
    Force Completes a Schedule with a (Run) Id of 123456 while discarding the forced status of the Schedule upon Agent status update (one-liner)

    123456 | Get-AutomateNOWSchedule | Complete-AutomateNOWSchedule -DoNotKeepForcedStatus $true

    .EXAMPLE
    Force Fails a Schedule with a (Run) Id of 123456 (one-liner)

    123456 | Get-AutomateNOWSchedule | Complete-AutomateNOWSchedule -ForceFail

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWSchedule])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWSchedule]$Schedule,
        [Parameter(Mandatory = $false)]
        [switch]$ForceFail,
        [Parameter(Mandatory = $false)]
        [switch]$DoNotKeepForcedStatus,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($ForceFail -ne $true) {
            [string]$command = '/processing/forceCompleted'
            [string]$operationId = 'forceCompleted'
            [string]$action = 'Force Completed'
        }
        Else {
            [string]$command = '/processing/forceFailed'
            [string]$operationId = 'forceFailed'
            [string]$action = 'Force Failed'
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_ -is [ANOWSchedule]) {
            [ANOWSchedule]$Schedule = $_
        }
        [int64]$Schedule_id = $Schedule.id
        [string]$current_schedule_status = $Schedule.processingStatus
        If (($current_schedule_status -eq 'FAILED') -and ($operationId -eq 'forceFailed')) {
            Write-Warning -Message "You cannot Force Fail an already failed Schedule"
            Break
        }
        ElseIf (($current_schedule_status -eq 'COMPLETED') -and ($operationId -eq 'forceCompleted')) {
            Write-Warning -Message "You cannot Force Complete an already completed Schedule"
            Break
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($Schedule_id)")) -eq $true) {
            ## Begin warning ##
            ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
            $Error.Clear()
            Try {
                [ANOWSchedule]$current_schedule = Get-AutomateNOWSchedule -Id $Schedule_id
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWSchedule failed to check if the Schedule [$Schedule_id] existed under Complete-AutomateNOWSchedule due to [$Message]."
                Break
            }
            If ($current_schedule.id.length -eq 0) {
                Write-Warning -Message "The Schedule you specified does not seem to exist under Complete-AutomateNOWSchedule"
                Break
            }
            [string]$current_schedule_status = $current_schedule.processingStatus
            If ($current_schedule_status -notin [ANOWProcessing_processingStatus].GetEnumNames()) {
                Write-Warning -Message "The processing status of the Schedule [$Schedule_id] cannot be read under Complete-AutomateNOWSchedule"
                Break
            }
            ## End warning ##
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            If ($DoNotKeepForcedStatus -eq $true) {
                $BodyMetaData.Add('keepForcedStatus', 'false')
            }
            Else {
                $BodyMetaData.Add('keepForcedStatus', 'true')
            }
            $BodyMetaData.Add('id', $Schedule_id )
            $BodyMetaData.Add('_operationType', 'custom')
            $BodyMetaData.Add('_operationId', $operationId)
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_dataSource', 'ProcessingDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Schedule_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            If ($Quiet -ne $true) {
                $Error.Clear()
                Try {
                    [ANOWSchedule]$completed_schedule = Get-AutomateNOWSchedule -Id $Schedule_id
                }
                Catch {
                    Write-Warning -Message "Get-AutomateNOWSchedule failed to retrieve the Schedule (after it was already '$action') due to [$Message]"
                    Break
                }
                Return $completed_schedule
            }
        }
    }
    End {

    }
}

