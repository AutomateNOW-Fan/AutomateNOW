                Write-Warning 'Item update acknowledgment or output was not verified. The outcome is uncertain and the item may already have changed; do not repeat the request. Later inputs were stopped.'
                return
            }
            Write-Verbose "Processing Template Item [$($item.id)] successfully updated"
            if (-not $Quiet) { $verified.Data[0] }
        }
    }
