#region - SecUser

Function Get-AutomateNOWSecUser {
    <#
    .SYNOPSIS
    Gets the details of a user from an instance of AutomateNOW!

    .DESCRIPTION
    Gets the details of a user from an instance of AutomateNOW!

    .PARAMETER Id
    String parameter to specify the name or Id of the user. This is case-sensitive! If you do not know the username, you can try using the -LoggedOnUser parameter instead.

    .PARAMETER LoggedOnUser
    Switch parameter which skips entering the Id of the user. This is intended for use during the initial logon.

    .PARAMETER startRow
    Integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .PARAMETER ActiveUsersOnly
    Switch parameter which filters out inactive users.

    .PARAMETER APIUsersOnly
    Switch parameter which filters out non-API users. This parameter is exclusive from -IncludeAPIUsers, -AdminsOnly and -NonAdminsOnly.

    .PARAMETER IncludeAPIUsers
    Switch parameter which will include API users with non-API users in the same result. This parameter is exclusive from -APIUsersOnly, -AdminsOnly and -NonAdminsOnly.

    .PARAMETER AdminsOnly
    Switch parameter that will filter out non-admins of the current instance. This parameter is exclusive from -APIUsersOnly, -IncludeAPIUsers and -NonAdminsOnly.

    .PARAMETER NonAdminsOnly
    Switch parameter that will filter out admins of the current instance. This parameter is exclusive from -APIUsersOnly, -IncludeAPIUsers and -AdminsOnly.

    .PARAMETER NoWarning
    Switch parameter to suppress the warning that is emitted when a user with an invalid 'passwordValidUntil' property is encountered

    .INPUTS
    Optional string (or an array of strings to the pipeline) representing the Id of each SecUser to retrieve

    .OUTPUTS
    [ANOWSecUser] objects

    .EXAMPLE
    Gets a user named 'User1'
    Get-AutomateNOWUser -Id 'User1'

    .EXAMPLE
    Gets the basic information on the currently logged in user. You should not need to use this as this module already uses this parameter to populate the $anow_session global variable upon logging in.
    Get-AutomateNOWUser -LoggedOnUser

    .EXAMPLE
    Gets the first page of non-API users
    Get-AutomateNOWSecUser

    .EXAMPLE
    Gets the first page of both API and non-API users
    Get-AutomateNOWSecUser -IncludeAPIUsers

    .EXAMPLE
    Gets the first page of active non-API users
    Get-AutomateNOWSecUser -ActiveUsersOnly

    .EXAMPLE
    Gets the first 10,000 active non-API and API users
    Get-AutomateNOWSecUser -startRow 0 -endRow 10000 -ActiveUsersOnly -IncludeAPIUsers

    .EXAMPLE
    Gets the first 10,000 active API users
    Get-AutomateNOWSecUser -startRow 0 -endRow 10000 -ActiveUsersOnly -APIUsersOnly

    .EXAMPLE
    Gets the first page of API users
    $users6 = Get-AutomateNOWSecUser -APIUsersOnly

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Get-AutomateNOWSecUser DOES NOT refresh the token automatically. This is because it is used during the authentication process.

    ONLY ADMINS CAN GET ALL USERS! You will get unauthorized error otherwise.

    Specifying the -Id parameter always includes internal Security Roles

    #>
    [OutputType([ANOWSecUser])]
    [CmdletBinding(DefaultParameterSetName = 'Default')]
    Param(
        [ValidateScript({ $_ -match '^[0-9a-zA-Z _.-]{1,}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'SpecificUser', ValueFromPipeline = $true)]
        [string]$Id,
        [Parameter(Mandatory = $true, ParameterSetName = 'LoggedOnUser')]
        [switch]$LoggedOnUser,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'APIUsersOnly')]
        [Parameter(Mandatory = $false, ParameterSetName = 'IncludeAPIUsers')]
        [Parameter(Mandatory = $false, ParameterSetName = 'AdminsOnly')]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAdminsOnly')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'APIUsersOnly')]
        [Parameter(Mandatory = $false, ParameterSetName = 'IncludeAPIUsers')]
        [Parameter(Mandatory = $false, ParameterSetName = 'AdminsOnly')]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAdminsOnly')]
        [int32]$endRow = 100,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'APIUsersOnly')]
        [Parameter(Mandatory = $false, ParameterSetName = 'IncludeAPIUsers')]
        [Parameter(Mandatory = $false, ParameterSetName = 'AdminsOnly')]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAdminsOnly')]
        [switch]$ActiveUsersOnly,
        [Parameter(Mandatory = $false, ParameterSetName = 'APIUsersOnly')]
        [switch]$APIUsersOnly,
        [Parameter(Mandatory = $false, ParameterSetName = 'IncludeAPIUsers')]
        [switch]$IncludeAPIUsers,
        [Parameter(Mandatory = $false, ParameterSetName = 'AdminsOnly')]
        [switch]$AdminsOnly,
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAdminsOnly')]
        [switch]$NonAdminsOnly,
        [Parameter(Mandatory = $false)]
        [switch]$NoWarning
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet -DoNotRefresh) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$Instance = $anow_session.Instance
        [hashtable]$parameters = @{}
        If ($LoggedOnUser -eq $true) {
            [string]$command = '/secUser/getUserInfo'
            $parameters.Add('Method', 'GET')
        }
        Else {
            [string]$command = '/secUser/read'
            $parameters.Add('Method', 'POST')
        }
        If ($endRow -lt $startRow) {
            Write-Warning -Message "The endRow must be greater then the startRow"
            Break
        }
        $parameters.Add('Command', $command)
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        $parameters.Add('Instance', $Instance)
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($LoggedOnUser -ne $true) {
            If ($_.Length -gt 0) {
                [string]$id = $_
            }
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            If ($id.Length -gt 0) {
                $BodyMetaData.Add('id', $id )
                [string]$textMatchStyle = 'exactCase'
                $BodyMetaData.Add('_operationId', 'read')
            }
            Else {
                [string]$textMatchStyle = 'substring'
                $BodyMetaData.Add('operator', 'and')
                $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
                If ($APIUsersOnly -eq $true) {
                    $BodyMetaData.Add('criteria1', '{"fieldName":"apiUser","operator":"equals","value":true}')
                }
                ElseIf ($IncludeAPIUsers -ne $true) {
                    $BodyMetaData.Add('criteria1', '{"_constructor":"AdvancedCriteria","operator":"or","criteria":[{"fieldName":"apiUser","operator":"equals","value":false},{"fieldName":"apiUser","operator":"isNull"}]}')
                }
                If ($AdminsOnly -eq $true) {
                    $BodyMetaData.Add('criteria2', '{"fieldName":"admin","operator":"equals","value":true}')
                }
                ElseIf ($NonAdminsOnly -eq $true) {
                    $BodyMetaData.Add('criteria2', '{"fieldName":"admin","operator":"equals","value":false}')
                }
                If ($ActiveUsersOnly -eq $true) {
                    $BodyMetaData.Add('criteria3', '{"fieldName":"isActive","operator":"equals","value":true}')
                }
                $BodyMetaData.Add('_componentId', 'SecUserList')
                $BodyMetaData.Add('_startRow', $startRow)
                $BodyMetaData.Add('_endRow', $endRow)
            }
            $BodyMetaData.Add('_operationType', 'fetch')
            $BodyMetaData.Add('_textMatchStyle', $textMatchStyle)
            $BodyMetaData.Add('_dataSource', 'SecUserDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        If ($LoggedOnUser -ne $True) {
            [ANOWSecUser[]]$Users = ForEach ($User in $results.response.data) {
                [string]$User_Id = $User.Id
                If ($APIUsersOnly -eq $true) {
                    If (($User.apiUser -eq $false) -and ($User_Id -eq $anow_session.User)) {
                        Write-Warning -Message "You do not seem to have permission to fetch other users."
                        Break
                    }
                }
                If ($null -eq $User.defaultTimeZone) {
                    [ANOWTimeZone]$defaultTimeZone = $anow_session.server_timezone
                    $User | Add-Member -MemberType NoteProperty -Name defaultTimeZone -Value $defaultTimeZone
                }
                Else {
                    [ANOWTimeZone]$defaultTimeZone = Get-AutomateNOWTimeZone -Id ($User.defaultTimeZone)
                    $User.defaultTimeZone = $defaultTimeZone
                }
                $Error.Clear()
                Try {
                    [ANOWSecRole[]]$secRoles2 = $User.secRoles
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to convert the embedeed SecRoles within [$User_Id] into [ANOWSecUser] objects due to [$Message]."
                    Break
                }
                $User.secRoles = $secRoles2
                # The following section to fix the passwordValidUntil property is due to an oversight from Beta Systems
                If ( $User.passwordValidUntil -match '^[0-9]{5,}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}$') {
                    If ($NoWarning -ne $true) {
                        Write-Warning -Message "$User_Id has an invalid passwordValidUntil date. Please contact Beta Systems about this :-)"
                    }
                    [string]$passwordValidUntil = $User.passwordValidUntil
                    [int32]$passwordValidUntil_length = $passwordValidUntil.Length
                    [int32]$trim_count = $passwordValidUntil_length - 23
                    [string]$passwordValidUntil_Fixed = $passwordValidUntil.Substring($trim_count, 23)
                    If ($passwordValidUntil_Fixed -notmatch '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}$') {
                        Write-Warning -Message "Truncating an invalid passwordValidUntil value failed"
                        Break
                    }
                    $User.passwordValidUntil = $passwordValidUntil_Fixed
                }
                $User
            }
            If ($Users.Count -gt 0) {
                Return $Users
            }
            Else {
                Write-Verbose -Message "There were 0 users retrieved"
            }
        }
        Else {
            [string]$id = $results.id
            If ($null -ne $results.defaultTimeZone) {
                [ANOWTimeZone]$defaultTimeZone = Get-AutomateNOWTimeZone -Id ($results.defaultTimeZone)
            }
            Else {
                [ANOWTimeZone]$defaultTimeZone = $anow_session.server_timezone
            }
            $results.'defaultTimeZone' = $defaultTimeZone
            $results.'secRoles' = @()
            $Error.Clear()
            If ($LoggedOnUser -eq $true) {
                Try {
                    [PSCustomObject]$User = $results | Select-Object -First 1
                    [string]$User_id = $User.id
                    # The following section to fix the passwordValidUntil property is due to an oversight from Beta Systems
                    If ( $User.passwordValidUntil -match '^[0-9]{5,}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}$') {
                        Write-Warning -Message "$User_Id has an invalid passwordValidUntil date. Please contact Beta Systems about this :-)"
                        [string]$passwordValidUntil = $User.passwordValidUntil
                        [int32]$passwordValidUntil_length = $passwordValidUntil.Length
                        [int32]$trim_count = $passwordValidUntil_length - 23
                        [string]$passwordValidUntil_Fixed = $passwordValidUntil.Substring($trim_count, 23)
                        If ($passwordValidUntil_Fixed -notmatch '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}$') {
                            Write-Warning -Message "Truncating an invalid passwordValidUntil value failed"
                            Break
                        }
                        $User.passwordValidUntil = $passwordValidUntil_Fixed
                    }
                    [ANOWSecUserInfo]$ANOWSecUserInfo = $User
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to convert the returned [ANOWSecUserInfo] object from direct data for [$id] due to [$Message]."
                    Remove-Variable -Name anow_session -Force
                    Break
                }
                If ($ANOWSecUserInfo.id.Length -gt 0) {
                    Return $ANOWSecUserInfo
                }
                Else {
                    Write-Warning -Message "The [ANOWSecUser] object appears to be empty"
                    Break
                }
            }
            Else {
                Try {
                    [ANOWSecUser]$ANOWSecUser = $results
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to convert the returned [ANOWSecUser] object from direct data for [$id] due to [$Message]."
                    Break
                }
                If ($ANOWSecUser.id.Length -gt 0) {
                    Return $ANOWSecUser
                }
                Else {
                    Write-Warning -Message "The [ANOWSecUser] object appears to be empty"
                    Break
                }
            }
        }
    }
    End {

    }
}

Function New-ANOWSecUserUpdateRequest {
    [CmdletBinding()]
    param([ValidateSet('Update','Unlock','Enable','Disable')][string]$Operation,[string]$Id,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    if ([string]::IsNullOrWhiteSpace($Id)) { throw 'An exact user identity is required.' }
    $found=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWSecUser) -OperationParameters @{Id=$Id}
    if (-not $found.Succeeded -or @($found.Data).Count -ne 1 -or $found.Data[0] -isnot [ANOWSecUser] -or
        -not [string]::Equals($found.Data[0].id,$Id,[StringComparison]::Ordinal)) { throw 'One clean matching typed user prerequisite was not verified.' }
    $current=$found.Data[0]
    $metadata=[ordered]@{id=$Id}
    if ($Operation -ceq 'Update') {
        $changed=$false
        foreach ($entry in @(@('FirstName','firstName'),@('LastName','lastName'),@('Department','department'),@('Location','location'),@('Email','email'),@('PhoneNumber','phone'))) {
            if (([string]$Options[$entry[0]]).Length -gt 0) { $metadata[$entry[1]]=$Options[$entry[0]];$changed=$true }
        }
        if (([string]$Options.FirstName).Length -gt 0) { $metadata['firstLastName']=$Options.FirstName+' '+$current.lastName }
        if (([string]$Options.LastName).Length -gt 0) { $metadata['firstLastName']=$current.firstName+' '+$Options.LastName }
        if (([string]$Options.FirstName).Length -gt 0 -and ([string]$Options.LastName).Length -gt 0) { $metadata['firstLastName']=$Options.FirstName+' '+$Options.LastName }
        if ($Options.ContainsKey('AccountValidUntil')) {
            $date=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-Date) -OperationParameters @{Date=$Options.AccountValidUntil;Format='yyyy-MM-ddTHH:mm:ss.fff'}
            if (-not $date.Succeeded -or @($date.Data).Count -ne 1 -or $date.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($date.Data[0])) { throw 'The account expiry was not cleanly formatted.' }
            $metadata['accountValidUntil']=$date.Data[0];$changed=$true
        }
        if ($null -ne $Options.DefaultTimeZone) { $metadata['defaultTimeZone']=$Options.DefaultTimeZone.id;$changed=$true }
        elseif ($Options.UnsetDefaultTimeZone -eq $true) { $metadata['defaultTimeZone']='';$changed=$true }
        if (([string]$Options.defaultDomain).Length -gt 0) {
            $domain=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWDomain) -OperationParameters @{Id=$Options.defaultDomain}
            if (-not $domain.Succeeded -or @($domain.Data).Count -ne 1 -or $domain.Data[0] -isnot [ANOWDomain] -or
                -not [string]::Equals($domain.Data[0].id,$Options.defaultDomain,[StringComparison]::Ordinal)) { throw 'One clean matching default Domain was not verified.' }
            $metadata['defaultDomain']=$Options.defaultDomain;$changed=$true
        } elseif ($Options.unsetDefaultDomain -eq $true) { $metadata['defaultDomain']=$null;$changed=$true }
        foreach ($name in @('skinThemeType','skinDensityType')) {
            if ($Options.ContainsKey($name)) { $metadata[$name]=$Options[$name];$changed=$true }
        }
        if (-not $changed) { throw 'There must be at least 1 change to use Set-AutomateNOWSecUser.' }
        $metadata['createdBy']=$current.createdBy
        $metadata['lastAccountExpired']=if ($current.lastAccountExpired -gt [datetime]::new(1970,1,1)) { $current.lastAccountExpired } else { $null }
        $metadata['languageCode']=$current.languageCode
        $metadata['_oldValues']=$current.CreateOldValues()
        $metadata['_componentId']='SecUserEditForm'
        $command='/secUser/update'
    } else {
        if ($Operation -ceq 'Unlock' -and -not $current.accountLocked) { throw 'The user is already unlocked. There is no action required.' }
        if ($Operation -ceq 'Enable' -and $current.active) { throw 'The user is already enabled. There is no action required.' }
        if ($Operation -ceq 'Disable' -and -not $current.active) { throw 'The user is already disabled. There is no action required.' }
        $action=switch ($Operation) { Unlock { 'unlock' } Enable { 'activate' } Disable { 'deactivate' } }
        $command='/secUser/'+$action
        $metadata['_operationId']=$action
    }
    $metadata['_operationType']='update';$metadata['_textMatchStyle']='exact'
    $metadata['_dataSource']='SecUserDataSource';$metadata['isc_metaDataPrefix']='_';$metadata['isc_dataFormat']='json'
    $serialized=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$metadata}
    if (-not $serialized.Succeeded -or @($serialized.Data).Count -ne 1 -or $serialized.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($serialized.Data[0])) { throw 'The user update form was not cleanly serialized.' }
    return [pscustomobject]@{Command=$command;Body=$serialized.Data[0]}
}

Function ConvertFrom-ANOWSecUserUpdateResponse {
    [CmdletBinding()]
    param([object[]]$Envelopes,[string]$ExpectedId,[switch]$ResolveRoles)
    $ErrorActionPreference='Stop'
    $rows=@($Envelopes[0].response.data)
    if ($rows.Count -ne 1 -or $null -eq $rows[0]) { throw 'Exactly one returned user is required.' }
    $row=$rows[0]
    if ($row -isnot [Collections.IDictionary] -and $row -isnot [Management.Automation.PSCustomObject] -and $row -isnot [ANOWSecUser]) { throw 'A strict returned user object is required.' }
    if ($row.id -isnot [string] -or -not [string]::Equals($row.id,$ExpectedId,[StringComparison]::Ordinal)) { throw 'The returned user identity does not match the update.' }
    $allowed=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($property in [ANOWSecUser].GetProperties()) { $null=$allowed.Add($property.Name) }
    $names=if ($row -is [Collections.IDictionary]) { @($row.Keys) } else { @($row.PSObject.Properties.Name) }
    foreach ($name in $names) { if ($name -isnot [string] -or -not $allowed.Contains($name)) { throw 'The returned user has an unsupported member.' } }
    if ($null -eq $row.defaultTimeZone) { [ANOWTimeZone]$zone=$anow_session.server_timezone }
    else {
        if ($row.defaultTimeZone -isnot [string] -or [string]::IsNullOrWhiteSpace($row.defaultTimeZone)) { throw 'A returned timezone must be an exact nonempty identifier.' }
        $lookup=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWTimeZone) -OperationParameters @{Id=$row.defaultTimeZone}
        if (-not $lookup.Succeeded -or @($lookup.Data).Count -ne 1 -or $lookup.Data[0] -isnot [ANOWTimeZone] -or
            -not [string]::Equals($lookup.Data[0].id,$row.defaultTimeZone,[StringComparison]::Ordinal)) { throw 'One clean matching returned timezone was not verified.' }
        [ANOWTimeZone]$zone=$lookup.Data[0]
    }
    [ANOWSecRole[]]$roles=$row.secRoles
    if ($ResolveRoles -and $null -ne $roles) {
        $resolved=[Collections.Generic.List[ANOWSecRole]]::new()
        foreach ($role in $roles) {
            if ($null -eq $role -or [string]::IsNullOrWhiteSpace($role.id)) { throw 'An exact returned role identity is required.' }
            $lookup=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWSecurityRole) -OperationParameters @{Id=$role.id}
            if (-not $lookup.Succeeded -or @($lookup.Data).Count -ne 1 -or $lookup.Data[0] -isnot [ANOWSecRole] -or
                -not [string]::Equals($lookup.Data[0].id,$role.id,[StringComparison]::Ordinal)) { throw 'One clean matching returned Security Role was not verified.' }
            $resolved.Add($lookup.Data[0])
        }
        $roles=$resolved.ToArray()
    }
    $converted=[pscustomobject]$row | Select-Object -Property * -ExcludeProperty defaultTimeZone,secRoles
    $converted | Add-Member -MemberType NoteProperty -Name defaultTimeZone -Value $zone
    $converted | Add-Member -MemberType NoteProperty -Name secRoles -Value $roles
    return [ANOWSecUser]$converted
}

Function Set-AutomateNOWSecUser {
    <#
    .SYNOPSIS
    Changes the settings of a User from an AutomateNOW! instance

    .DESCRIPTION
    A clean exact-ID prerequisite, explicit integral-zero acknowledgment and one strictly enriched matching result are required, including Quiet. Diagnostics stop subsequent inputs without retry; a dispatched failure may have an uncertain server-side outcome.

    Changes the settings of a User from an AutomateNOW! instance

    .PARAMETER User
    An [ANOWSecUser] object representing the User to be changed.

    .PARAMETER FirstName
    A string representing the first name of the user (given name)

    .PARAMETER LastName
    A string representing the last name of the user (surname)

    .PARAMETER Department
    A string representing the department of the user

    .PARAMETER Location
    A string representing the location of the user

    .PARAMETER Email
    A string representing the email address of the user

    .PARAMETER PhoneNumber
    A string representing the phone number of the user

    .PARAMETER AccountValidUntil
    A datetime object representing the 'Account Valid Until' date. Use Get-Date to create the needed object.

    .PARAMETER DefaultTimeZone
    An [ANOWTimeZone] object representing the Default Time Zone of the user

    .PARAMETER UnsetDefaultTimeZone
    Switch parameter that will blank out the user accounts default timezone.

    .PARAMETER skinThemeType
    A string representing the theme. Valid choice are: LIGHT, GRAY, DARK, CONTRAST_ULTRA

    .PARAMETER skinDensityType
    A string representing the theme. Valid choice are: DENSE, COMPACT, STANDARD, EXPANDED, SPACIOUS

    .PARAMETER admin
    Retained for signature compatibility. Explicit true or false is unsupported and refuses the entire request before any update. Omit Admin for ordinary metadata edits.

    .PARAMETER defaultDomain
    String that will be set as the user's default domain. Note that this function will check to ensure that the domain exists before trying to set it.

    .PARAMETER unsetDefaultDomain
    Unsets the user's default domain.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter that silences the output of the updated object.

    .INPUTS
    ONLY [ANOWSecUser] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWSecUser] object will be returned

    .EXAMPLE
    Sets the theme for a user named 'User1' to Dark (multi-line format)
    Get-AutomateNOWSecUser -Id 'User1' | Set-AutomateNOWSecUser -skinThemeType 'DARK'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Admin updates are explicitly refused. OAuth client ID editing is not implemented. User creation support does not establish an update contract.

    This function does not support any roles. It is only to be used for the basic user properties.

    #>
    [OutputType([ANOWSecUser])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWSecUser]$User,
        [AllowEmptyString()]
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false)]
        [string]$FirstName,
        [AllowEmptyString()]
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false)]
        [string]$LastName,
        [AllowEmptyString()]
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false)]
        [string]$Department,
        [AllowEmptyString()]
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false)]
        [string]$Location,
        [ValidateScript({ $_ -match '^[\w\.-]+@[a-zA-Z\d\.-]+\.[a-zA-Z]{2,}$' })]
        [Parameter(Mandatory = $false, HelpMessage = 'Enter a valid email address')]
        [string]$Email,
        [AllowEmptyString()]
        [ValidateScript({ $_ -match '^[\d]{0,255}$' })]
        [Parameter(Mandatory = $false, HelpMessage = 'Enter numbers only')]
        [string]$PhoneNumber,
        [Parameter(Mandatory = $false)]
        [datetime]$AccountValidUntil,
        [Parameter(Mandatory = $false)]
        [ANOWTimeZone]$DefaultTimeZone,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetDefaultTimeZone,
        [Parameter(Mandatory = $false)]
        [ANOWSecUser_skinThemeType]$skinThemeType,
        [Parameter(Mandatory = $false)]
        [ANOWSecUser_skinDensityType]$skinDensityType,
        [Parameter(Mandatory = $false, HelpMessage = 'Admin updates are unsupported; omit this parameter for ordinary edits')]
        [boolean]$admin,
        [Parameter(Mandatory = $false)]
        [string]$defaultDomain,
        [Parameter(Mandatory = $false)]
        [boolean]$unsetDefaultDomain,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )

    Begin {
        $stopped=$false
        $options=@{};foreach ($key in $PSBoundParameters.Keys) { $options[$key]=$PSBoundParameters[$key] }
        if ($PSBoundParameters.ContainsKey('admin')) {
            $stopped=$true
            Write-Warning 'Admin updates are unsupported until a verified update contract is available. Bound true and false are both refused, including combined edits; no user update is sent.'
            return
        }
        if (-not (Confirm-ANOWPreservationSession)) { $stopped=$true;Write-Warning 'A clean valid session was not confirmed; no user update was sent.';return }
        if ($defaultDomain.Length -gt 0 -and $unsetDefaultDomain -eq $true) { $stopped=$true;Write-Warning 'You cannot both set and unset the default domain. Please choose one or the other.' }
    }
    Process {
        if ($stopped) { return }
        $id=$User.id
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$id")) -eq $true) {
            $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWSecUserUpdateRequest) -OperationParameters @{Operation='Update';Id=$id;Options=$options}
            if (-not $prepared.Succeeded -or @($prepared.Data).Count -ne 1) { $stopped=$true;Write-Warning 'The user update prerequisite/preparation failed; no update was sent.';return }
            $parameters=@{Command=$prepared.Data[0].Command;Body=$prepared.Data[0].Body;Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8'}
            if ($anow_session.NotSecure -eq $true) { $parameters['NotSecure']=$true }
            $written=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if (-not $written.Succeeded -or -not (Test-ANOWPreservationAcknowledgment -Envelopes $written.Data)) { $stopped=$true;Write-Warning 'The user update outcome is uncertain; the account may already have changed. Do not repeat it or continue later inputs.';return }
            $converted=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWSecUserUpdateResponse) -OperationParameters @{Envelopes=$written.Data;ExpectedId=$id}
            if (-not $converted.Succeeded -or @($converted.Data).Count -ne 1 -or $converted.Data[0] -isnot [ANOWSecUser]) { $stopped=$true;Write-Warning 'The acknowledged user update could not be strictly verified; the account may already have changed. Do not repeat it or continue later inputs.';return }
            Write-Verbose "The user update for [$id] was acknowledged with a strict matching result."
            if (-not $Quiet) { return $converted.Data[0] }
        }
    }
    End {}
}

Function Unlock-AutomateNOWSecUser {
    <#
    .SYNOPSIS
    Changes a Users locked state to unlocked on an AutomateNOW! instance

    .DESCRIPTION
    A clean exact-ID prerequisite, explicit integral-zero acknowledgment and one strictly enriched matching result are required, including Quiet. Diagnostics stop subsequent inputs without retry; a dispatched failure may have an uncertain server-side outcome.

    Changes a Users locked state to unlocked on an AutomateNOW! instance

    .PARAMETER User
    An [ANOWSecUser] object representing the User to be unlocked.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter that silences the output of the updated object.

    .INPUTS
    ONLY [ANOWSecUser] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWSecUser] object will be returned

    .EXAMPLE
    Forcefully and quietly unlocks a user named 'User1' (one-liner format)

    Get-AutomateNOWSecUser -Id 'User1' | Unlock-AutomateNOWSecUser -Force -Quiet

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWSecUser]$User,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )

    Begin {
        $stopped=$false
        if (-not (Confirm-ANOWPreservationSession)) { $stopped=$true;Write-Warning 'A clean valid session was not confirmed; no user unlock was sent.' }
    }
    Process {
        if ($stopped) { return }
        $id=$User.id
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$id")) -eq $true) {
            $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWSecUserUpdateRequest) -OperationParameters @{Operation='Unlock';Id=$id;Options=@{}}
            if (-not $prepared.Succeeded -or @($prepared.Data).Count -ne 1) { $stopped=$true;Write-Warning 'The user unlock prerequisite/preparation failed or no action was required; no unlock was sent.';return }
            $parameters=@{Command=$prepared.Data[0].Command;Body=$prepared.Data[0].Body;Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8'}
            if ($anow_session.NotSecure -eq $true) { $parameters['NotSecure']=$true }
            $written=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if (-not $written.Succeeded -or -not (Test-ANOWPreservationAcknowledgment -Envelopes $written.Data)) { $stopped=$true;Write-Warning 'The user unlock outcome is uncertain; the account may already have changed. Do not repeat it or continue later inputs.';return }
            $converted=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWSecUserUpdateResponse) -OperationParameters @{Envelopes=$written.Data;ExpectedId=$id;ResolveRoles=$true}
            if (-not $converted.Succeeded -or @($converted.Data).Count -ne 1 -or $converted.Data[0] -isnot [ANOWSecUser]) { $stopped=$true;Write-Warning 'The acknowledged user unlock could not be strictly verified; the account may already have changed. Do not repeat it or continue later inputs.';return }
            Write-Verbose "The user unlock for [$id] was acknowledged with a strict matching result."
            if (-not $Quiet) { return $converted.Data[0] }
        }
    }
    End {}
}

Function Export-AutomateNOWSecUser {
    <#
    .SYNOPSIS
    Exports the users from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the users from an instance of AutomateNOW! to a local .csv file

    .PARAMETER User
    Mandatory [ANOWSecUser] object (Use Get-AutomateNOWSecUser to retrieve them)

    .INPUTS
    ONLY [ANOWSecUser] objects from the pipeline are accepted. Strings are not accepted.

    .OUTPUTS
    The [ANOWSecUser] objects are exported to the local disk in CSV format

    .EXAMPLE
    Get-AutomateNOWSecUser | Export-AutomateNOWSecUser

    .NOTES
    You must present [ANOWSecUser] objects to the pipeline to use this function.
    #>

    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [ANOWSecUser]$User
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-Users-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWSecUser]$User = $_
        }
        $Error.Clear()
        Try {
            $User | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWSecUser] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function New-AutomateNOWSecUser {
    <#
    .SYNOPSIS
    Creates a User in an AutomateNOW! instance

    .DESCRIPTION
    Creates a User in an AutomateNOW! instance

    .PARAMETER Id
    A mandatory string representing the name of the user (Example: jsmith)

    .PARAMETER SecurePass
    A mandatory SecureString representing the password of the user. This must be at least 4 characters in length and contain characters from at least two of these four groups: uppercase, lowercase, digits and special characters.

    .PARAMETER CopyRolesFromUser
    Optional [ANOWSecUser] (non-admin) user object from which to copy roles to a new non-API user. Use Get-AutomateNOWSecUser to fetch this object.

    .PARAMETER APIUser
    Optional switch that creates an API user instead of a non-API user.

    .PARAMETER Description
    Optional string for API Users only for setting a description

    .PARAMETER FirstName
    An optional string with the user's first name (given name) (non-API users only)

    .PARAMETER LastName
    An optional string with the user's last name (surname) (non-API users only)

    .PARAMETER Department
    An optional string with the user's department (non-API users only)

    .PARAMETER OAuthClientId
    An optional string with the user's OAuth Client Id (not tested!) (non-API users only)

    .PARAMETER Location
    An optional string with the user's location (non-API users only)

    .PARAMETER Email
    An optional string with the user's email address (must be a valid email address) (non-API users only)

    .PARAMETER PhoneNumber
    An optional string with the user's phone number. Digits only! (non-API users only)

    .PARAMETER PasswordValidDays
    An optional integer indicating how long the password remains valid. The default is 100 days.

    .PARAMETER AccountValidUntil
    An optional date string in this format --> 2030-12-31. If omitted, the default is 100 days from the present day.

    .PARAMETER PasswordExpired
    An optional switch parameter that sets the password to expired (non-API users only)

    .PARAMETER Admin
    An optional switch parameter that enables administrative privileges (non-API users only)

    .PARAMETER skinThemeType
    An optional string representing the theme. Valid choice are: LIGHT, GRAY, DARK, CONTRAST_ULTRA (non-API users only)

    .PARAMETER skinDensityType
    An optional string representing the UI density. Valid choices are: DENSE, COMPACT, STANDARD, EXPANDED, SPACIOUS (non-API users only)

    .PARAMETER Quiet
    Switch parameter that silences the output of the newly created object.

    .INPUTS
    None. This function does not accept pipeline input.

    .OUTPUTS
    The newly created [ANOWSecUser] object will be returned

    .EXAMPLE
    Creates a new admin user with all properties set and a 100-day password lifetime (multi-line)

    $secure_pass = Read-Host -AsSecureString
    New-AutomateNOWSecUser -Id 'TestUser1' -FirstName 'John' -LastName 'Smith' -Department 'Sanitation Engineering' -Location 'The basement' -Email 'jsmith@contoso.com' -PhoneNumber '8675309' -SecurePass $secure_pass -PasswordValidDays 100 -AccountValidUntil '2030-12-31' -Admin -skinThemeType CONTRAST_ULTRA -skinDensityType COMPACT

    .EXAMPLE
    Creates a new non-admin user with all properties set, a 100-day password lifetime and roles copied from a user named 'TestUser2' (one-liner)

    New-AutomateNOWSecUser -Id 'TestUser1' -CopyRolesFromUser (Get-AutomateNOWSecUser -Id 'TestUser2') -FirstName 'John' -LastName 'Smith' -Department 'Sanitation Engineering' -Location 'The basement' -Email 'jsmith@contoso.com' -PhoneNumber '8675309' -SecurePass (Read-Host -AsSecureString) -PasswordValidDays 100 -AccountValidUntil '2030-12-31' -skinThemeType CONTRAST_ULTRA -skinDensityType COMPACT

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The console enforces that the phone number may only consist of digits. It is kept as a string so leading zeroes are preserved.

    Copying security roles from an admin user is forbidden since they don't have any roles.

    For API users, use Add-AutomateNOWSecurityAccessToken to generate the security access token for that user.

    #>
    [OutputType([ANOWSecUser])]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute(
        'PSAvoidUsingUsernameAndPasswordParams',
        '',
        Justification = 'SecurePass is a SecureString; PasswordValidDays is a lifetime setting, not a credential.'
    )]
    [CmdletBinding(DefaultParameterSetName = 'NonAPIUser', SupportsShouldProcess = $true, ConfirmImpact = 'Medium')]
    Param(
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,}$' })]
        [Parameter(Mandatory = $true)]
        [string]$Id,
        [Parameter(Mandatory = $true)]
        [SecureString]$SecurePass,
        [ValidateNotNull()]
        [ValidateScript({ $_.id.Length -gt 0 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [ANOWSecUser]$CopyRolesFromUser,
        [Parameter(Mandatory = $true, ParameterSetName = 'APIUser')]
        [switch]$APIUser,
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false, ParameterSetName = 'APIUser')]
        [string]$Description,
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [string]$FirstName,
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [string]$LastName,
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [string]$Department,
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [string]$OAuthClientId,
        [ValidateLength(0, 255)]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [string]$Location,
        [ValidateScript({ $_ -match '^[\w\.-]+@[a-zA-Z\d\.-]+\.[a-zA-Z]{2,}$' })]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser', HelpMessage = 'Enter a valid email address')]
        [string]$Email,
        [ValidatePattern('^[0-9]+$')]
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser', HelpMessage = 'Enter numbers only')]
        [string]$PhoneNumber,
        [Parameter(Mandatory = $false)]
        [int32]$PasswordValidDays = 100,
        [ValidateScript({
                [datetime]$parsed_date = [datetime]::MinValue
                [boolean]$format_valid = $_ -match '^2[0-9]{3}-[0-9]{2}-[0-9]{2}$'
                [boolean]$date_valid = [datetime]::TryParseExact($_, 'yyyy-MM-dd', [System.Globalization.CultureInfo]::InvariantCulture, [System.Globalization.DateTimeStyles]::None, [ref]$parsed_date)
                Return ($format_valid -and $date_valid)
            })]
        [Parameter(Mandatory = $false, HelpMessage = 'This must be in shortform ISO-8601 format. Example: 2031-12-31')]
        [string]$AccountValidUntil,
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [switch]$PasswordExpired,
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser', HelpMessage = 'Set this to true to promote the user to full admin privileges')]
        [switch]$Admin,
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [ANOWSecUser_skinThemeType]$skinThemeType,
        [Parameter(Mandatory = $false, ParameterSetName = 'NonAPIUser')]
        [ANOWSecUser_skinDensityType]$skinDensityType,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
        Write-Warning -Message "There is not a valid token confirmed."
        Break
    }
    [string]$current_domain = $anow_session.header.domain
    [boolean]$password_valid = Test-AutomateNOWSecUserPassword -SecurePassword $SecurePass
    If ($password_valid -eq $false) {
        Write-Warning -Message "The password supplied is not valid. The password must be at least 4 characters and have at least 1 character from 2 of 4 groups (upper, lower, digits, special chars)"
        Break
    }
    If ($PSBoundParameters.ContainsKey('CopyRolesFromUser')) {
        If ($admin -eq $true) {
            Write-Warning -Message "You cannot copy roles to an admin user as admin users do not have roles."
            Break
        }
        ElseIf ($CopyRolesFromUser.admin -eq $true) {
            Write-Warning -Message "You cannot copy roles from an admin user."
            Break
        }
        ElseIf ($CopyRolesFromUser.secRoles.Count -eq 0) {
            [string]$CopyRolesFromUserId = $CopyRolesFromUser.id
            Write-Warning -Message "$CopyRolesFromUserId does not actually have any roles to copy. Please select another user or do not use this option."
            Break
        }
    }
    ## Begin warning ##
    ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
    Try {
        [boolean]$User_exists = ($null -ne (Get-AutomateNOWSecUser -Id $Id))
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Get-AutomateNOWSecUser failed to check if the User [$Id] already existed (under New-AutomateNOWSecUser) due to [$Message]."
        Break
    }
    If ($User_exists -eq $true) {
        Write-Warning -Message "There is already a User named [$Id] in [$current_domain]."
        Break
    }
    ## End warning ##
    [string]$user_type = If ($APIUser -eq $true) { 'API User' } Else { 'User' }
    If (($PSCmdlet.ShouldProcess("$user_type [$Id] in [$current_domain]", "Create AutomateNOW $user_type")) -ne $true) {
        Return
    }
    [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
    $BodyMetaData.Add('id', $Id)
    If ($Description.Length -gt 0) {
        $BodyMetaData.Add('description', $Description)
    }
    If ($FirstName.Length -gt 0) {
        $BodyMetaData.Add('firstName', $FirstName)
    }
    If ($LastName.Length -gt 0) {
        $BodyMetaData.Add('lastName', $LastName)
    }
    If ($Department.Length -gt 0) {
        $BodyMetaData.Add('department', $Department)
    }
    If ($OAuthClientId.Length -gt 0) {
        $BodyMetaData.Add('clientId', $OAuthClientId)
    }
    If ($Location.Length -gt 0) {
        $BodyMetaData.Add('location', $Location)
    }
    If ($Email.Length -gt 0) {
        $BodyMetaData.Add('email', $Email)
    }
    If ($PSBoundParameters.ContainsKey('PhoneNumber')) {
        $BodyMetaData.Add('phone', $PhoneNumber)
    }
    If ($PSVersionTable.PSVersion.Major -ge 7) {
        [string]$Pass = $SecurePass | ConvertFrom-SecureString -AsPlainText
    }
    Else {
        [IntPtr]$password_bstr = [IntPtr]::Zero
        Try {
            $password_bstr = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePass)
            [string]$Pass = [System.Runtime.InteropServices.Marshal]::PtrToStringBSTR($password_bstr)
        }
        Finally {
            If ($password_bstr -ne [IntPtr]::Zero) {
                [System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($password_bstr)
            }
        }
    }
    $BodyMetaData.Add('password', $Pass)
    $BodyMetaData.Add('password2', $Pass) # [sic] Yes, the console really does pass a 'password2' parameter.
    $BodyMetaData.Add('passwordValidDays', $PasswordValidDays)
    If ($AccountValidUntil.Length -eq 0) {
        [string]$AccountValidUntil = Get-Date -Date (Get-Date).ToUniversalTime().AddDays(100) -Format 'yyyy-MM-dd'
    }
    [string]$AccountValidUntil = New-AutomateNOWServerDayTimestamp -date $AccountValidUntil
    $BodyMetaData.Add('accountValidUntil', $AccountValidUntil)
    If ($PasswordExpired -eq $true) {
        $BodyMetaData.Add('passwordExpired', 'true')
    }
    Else {
        $BodyMetaData.Add('passwordExpired', 'false')
    }
    If ($Admin -eq $true) {
        [string]$admin_status = 'true'
    }
    Else {
        [string]$admin_status = 'false'
    }
    $BodyMetaData.Add('admin', $admin_status)
    If ($skinDensityType.Length -gt 0) {
        $BodyMetaData.Add('skinDensityType', $skinDensityType)
    }
    If ($skinThemeType.Length -gt 0) {
        $BodyMetaData.Add('skinThemeType', $skinThemeType)
    }
    If ($PSBoundParameters.ContainsKey('CopyRolesFromUser')) {
        [string]$UserIdToCopyRolesFrom = $CopyRolesFromUser.id
        $BodyMetaData.'copyRolesFromUser' = $UserIdToCopyRolesFrom
        [System.Collections.Specialized.OrderedDictionary]$OldValuesMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        $OldValuesMetaData.Add('copyRolesFromUser', $UserIdToCopyRolesFrom)
        $OldValuesMetaData.Add('admin', ($Admin -eq $true))
        $OldValuesMetaData.Add('firstName', $FirstName)
        $OldValuesMetaData.Add('lastName', $LastName)
        $OldValuesMetaData.Add('passwordExpired', $true)
    }
    Else {
        [System.Collections.Specialized.OrderedDictionary]$OldValuesMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        $OldValuesMetaData.Add('accountValidUntil', $AccountValidUntil)
        $OldValuesMetaData.Add('passwordValidDays', $PasswordValidDays)
    }
    [string]$old_values_json = $OldValuesMetaData | ConvertTo-Json -Compress -Depth 10
    $BodyMetaData.'_oldValues' = [System.Uri]::EscapeDataString($old_values_json)
    If ($APIUser -eq $true) {
        $BodyMetaData.'apiUser' = 'true'
    }
    $BodyMetaData.'_textMatchStyle' = 'exact'
    $BodyMetaData.'_operationType' = 'add'

    $BodyMetaData.'_componentId' = 'SecUserCreateWindow_form'
    $BodyMetaData.'_dataSource' = 'SecUserDataSource'
    $BodyMetaData.'isc_metaDataPrefix' = '_'
    $BodyMetaData.'isc_dataFormat' = 'json'
    [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
    [void]$BodyMetaData.Remove('password')
    [void]$BodyMetaData.Remove('password2')
    $Pass = $null
    [string]$command = '/secUser/create'
    [hashtable]$parameters = @{}
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'POST')
    $parameters.Add('Body', $Body)
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    Try {
        [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
    }
    Catch {
        [string]$exception_type = $_.Exception.GetType().FullName
        Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to an exception of type [$exception_type]. Request and exception details were suppressed because this operation contains credentials."
        Break
    }
    Finally {
        [void]$parameters.Remove('Body')
        $Body = $null
    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Response details were suppressed because this operation contains credentials."
        Break
    }
    [PSCustomObject]$New_User = $results.response.data | Select-Object -First 1
    [ANOWSecRole[]]$secRoles2 = ForEach ($secRole in $New_User.secRoles) {
        [ANOWSecRoleDomain[]]$domain_roles = ForEach ($domain_role_id in $secRole.domainRoles.id) {
            Read-AutomateNOWSecurityRoleDomain -Id $domain_role_id
        }
        $secRole.domainRoles = $domain_roles
        $secRole
    }
    $New_User.secRoles = $secRoles2
    Try {
        [ANOWSecUser]$SecUser = $New_User
    }
    Catch {
        [string]$exception_type = $_.Exception.GetType().FullName
        Write-Warning -Message "Failed to create [ANOWSecUser] object due to an exception of type [$exception_type]. Response details were suppressed because this operation contains credentials."
        Break
    }
    If ($SecUser.id.Length -eq 0) {
        Write-Warning -Message "The newly created [ANOWSecUser] User is empty!"
        Break
    }
    If ($Quiet -ne $true) {
        Return $SecUser
    }
}

Function Remove-AutomateNOWSecUser {
    <#
    .SYNOPSIS
    Removes a User from an AutomateNOW! instance

    .DESCRIPTION
    Removes a User from an AutomateNOW! instance

    .PARAMETER User
    An [ANOWSecUser] object representing the User to be deleted.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    ONLY [ANOWSecUser] objects are accepted (including from the pipeline)

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Remove a single User by name

    Get-AutomateNOWSecUser -Id 'user01' | Remove-AutomateNOWSecUser

    .EXAMPLE
    Removes a series of User objects via input from the pipeline

    @( 'user01', 'user02', 'user03') | Remove-AutomateNOWSecUser

    .EXAMPLE
    Forcefully removes all User objects under a specified email address

    Get-AutomateNOWSecUser | Where-Object { $_.email -eq 'username@contoso.com'} | Remove-AutomateNOWSecUser -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $false, ValueFromPipeline = $True)]
        [ANOWSecUser]$User,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/secUser/delete'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWSecUser]$User = $_
        }
        [string]$User_id = $User.id
        If ($User_id.Length -eq 0) {
            Write-Warning -Message "An object with an empty Id was passed to this function."
            Break
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($User_id)")) -eq $true) {
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            [string]$old_values = $User.CreateOldValues()
            $BodyMetaData.Add('id', $User_id)
            $BodyMetaData.Add('_oldValues', $old_values)
            $BodyMetaData.Add('_operationType', 'remove')
            $BodyMetaData.Add('_componentId', 'SecUserList')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_dataSource', 'SecUserDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$User_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "User [$User_id] successfully removed"
        }
    }
    End {

    }
}

Function Test-AutomateNOWSecUserPassword {
    [OutputType([boolean])]
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true)]
        [SecureString]$SecurePassword
    )
    [string]$plain_password = $null
    [IntPtr]$password_bstr = [IntPtr]::Zero
    Try {
        If ($PSVersionTable.PSVersion.Major -ge 7) {
            $plain_password = $SecurePassword | ConvertFrom-SecureString -AsPlainText
        }
        Else {
            $password_bstr = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePassword)
            $plain_password = [System.Runtime.InteropServices.Marshal]::PtrToStringBSTR($password_bstr)
        }
        [int32]$character_group_count = 0
        If ($plain_password -cmatch '[a-z]') {
            $character_group_count++
        }
        If ($plain_password -cmatch '[A-Z]') {
            $character_group_count++
        }
        If ($plain_password -match '[0-9]') {
            $character_group_count++
        }
        If ($plain_password -match '[^a-zA-Z0-9]') {
            $character_group_count++
        }
        If (($plain_password.Length -ge 4) -and ($character_group_count -ge 2)) {
            Write-Verbose -Message "A valid password was presented"
            Return $true
        }
        Else {
            Write-Verbose -Message "A valid password was not presented"
            Return $false
        }
    }
    Catch {
        [string]$exception_type = $_.Exception.GetType().FullName
        Write-Warning -Message "Secure password validation failed due to an exception of type [$exception_type]. Exception details were suppressed because this operation contains credentials."
        Break
    }
    Finally {
        If ($password_bstr -ne [IntPtr]::Zero) {
            [System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($password_bstr)
        }
        $plain_password = $null
    }
}

Function Set-AutomateNOWSecUserPassword {
    <#
    .SYNOPSIS
    Sets the password of the currently logged in user of an AutomateNOW! instance (local users only!)

    .DESCRIPTION
    Sets the password of the currently logged in user of an AutomateNOW! instance (local users only!) Not intended for ldap integrated user accounts.

    .PARAMETER OldSecurePass
    Secure String representing the current password of the authenticated user

    .PARAMETER NewSecurePass
    Secure String representing the new password of the authenticated user

    .INPUTS
    None. You cannot pipe objects to Set-AutomateNOWSecUserPassword.

    .OUTPUTS
    An informational message will be sent to the host.

    .EXAMPLE
    $oldPassword = Read-Host 'Current password' -AsSecureString
    $newPassword = Read-Host 'New password' -AsSecureString
    Set-AutomateNOWSecUserPassword -OldSecurePass $oldPassword -NewSecurePass $newPassword

    .NOTES
    This function should ONLY be used in a development environment. This function is not ready for production use as it needs to be updated to receive a (pipelined) credential object.

    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>

    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true)]
        [SecureString]$OldSecurePass,
        [Parameter(Mandatory = $true)]
        [SecureString]$NewSecurePass
    )
    $Error.Clear()
    If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
        Write-Warning -Message "There is not a valid token confirmed."
        Break
    }
    $newValidation = Invoke-ANOWPrivateCommand -Command (Get-Command Test-AutomateNOWSecUserPassword) -Parameters @{SecurePassword=$NewSecurePass}
    if (-not $newValidation.Succeeded -or $newValidation.Data.Count -ne 1 -or $newValidation.Data[0] -isnot [bool]) {
        Write-Warning 'New password validation failed. Values and exception details were withheld. No password update was sent.'
        return
    }
    [boolean]$new_password_valid = $newValidation.Data[0]
    If ($new_password_valid -eq $false) {
        Write-Warning -Message "The new password does not appear to be valid. The password must be at least 4 characters and have at least 1 character from 2 of 4 groups (upper, lower, digits, special chars)"
        Break
    }
    $oldValidation = Invoke-ANOWPrivateCommand -Command (Get-Command Test-AutomateNOWSecUserPassword) -Parameters @{SecurePassword=$OldSecurePass}
    if (-not $oldValidation.Succeeded -or $oldValidation.Data.Count -ne 1 -or $oldValidation.Data[0] -isnot [bool]) {
        Write-Warning 'Old password validation failed. Values and exception details were withheld. No password update was sent.'
        return
    }
    [boolean]$old_password_valid = $oldValidation.Data[0]
    If ($old_password_valid -eq $false) {
        Write-Warning -Message "The old password does not appear to be valid. It should have at least 4 characters and have at least 1 character from 2 of 4 groups (upper, lower, digits, special chars). Continuing anyway..."
    }
    [hashtable]$parameters = @{}
    [string]$User = ($anow_session.User)
    If ($User.Length -eq 0) {
        Write-Warning -Message "The logged-in user name could not be extracted."
        Break
    }
    Write-Verbose -Message "About to set a new password for the currently logged user: $User"
    [string]$command = '/secUser/updatePassword'
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'POST')
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    $bodyResult = Invoke-ANOWPrivateCommand -Command (Get-Command New-ANOWPasswordRequestBody) -Parameters @{
        User=$User; OldSecurePass=$OldSecurePass; NewSecurePass=$NewSecurePass
    }
    if (-not $bodyResult.Succeeded) {
        Write-Warning 'Password request formatting failed. Values and exception details were withheld. No password update was sent.'
        return
    }
    $parameters['Body'] = [string]$bodyResult.Data[0]
    $request = Invoke-ANOWPrivateCommand -Command (Get-Command Invoke-AutomateNOWAPI) -Parameters $parameters
    if (-not $request.Succeeded) {
        Write-Warning 'Password update transport failed or emitted a diagnostic. Values were withheld; the outcome is uncertain. Do not retry automatically.'
        return
    }
    $results = if ($request.Data.Count -eq 1) { $request.Data[0] } else { $null }
    if (-not (Test-ANOWSuccessStatus $results.response)) {
        Write-Warning 'Password update did not return a numeric zero success status. Response values were withheld; do not retry automatically.'
        return
    }
    Write-Information -MessageData "Password successfully changed for $User"
}

Function Enable-AutomateNOWSecUser {
    <#
    .SYNOPSIS
    Activates (enables) a user account on an AutomateNOW! instance

    .DESCRIPTION
    A clean exact-ID prerequisite, explicit integral-zero acknowledgment and one strictly enriched matching result are required, including Quiet. Diagnostics stop subsequent inputs without retry; a dispatched failure may have an uncertain server-side outcome.

    Activates (enables) a user account on an AutomateNOW! instance

    .PARAMETER User
    An [ANOWSecUser] object representing the User account to be enabled.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter that silences the output of the updated object.

    .INPUTS
    ONLY [ANOWSecUser] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWSecUser] object will be returned

    .EXAMPLE
    Forcefully and quietly enables a user named 'User1' (one-liner format)

    Get-AutomateNOWSecUser -Id 'User1' | Enable-AutomateNOWSecUser -Force -Quiet

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWSecUser])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWSecUser]$User,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )

    Begin {
        $stopped=$false
        if (-not (Confirm-ANOWPreservationSession)) { $stopped=$true;Write-Warning 'A clean valid session was not confirmed; no user enable was sent.' }
    }
    Process {
        if ($stopped) { return }
        $id=$User.id
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$id")) -eq $true) {
            $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWSecUserUpdateRequest) -OperationParameters @{Operation='Enable';Id=$id;Options=@{}}
            if (-not $prepared.Succeeded -or @($prepared.Data).Count -ne 1) { $stopped=$true;Write-Warning 'The user enable prerequisite/preparation failed or no action was required; no enable was sent.';return }
            $parameters=@{Command=$prepared.Data[0].Command;Body=$prepared.Data[0].Body;Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8'}
            if ($anow_session.NotSecure -eq $true) { $parameters['NotSecure']=$true }
            $written=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if (-not $written.Succeeded -or -not (Test-ANOWPreservationAcknowledgment -Envelopes $written.Data)) { $stopped=$true;Write-Warning 'The user enable outcome is uncertain; the account may already have changed. Do not repeat it or continue later inputs.';return }
            $converted=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWSecUserUpdateResponse) -OperationParameters @{Envelopes=$written.Data;ExpectedId=$id;ResolveRoles=$true}
            if (-not $converted.Succeeded -or @($converted.Data).Count -ne 1 -or $converted.Data[0] -isnot [ANOWSecUser]) { $stopped=$true;Write-Warning 'The acknowledged user enable could not be strictly verified; the account may already have changed. Do not repeat it or continue later inputs.';return }
            Write-Verbose "The user enable for [$id] was acknowledged with a strict matching result."
            if (-not $Quiet) { return $converted.Data[0] }
        }
    }
    End {}
}

