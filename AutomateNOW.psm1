#region - Context Variable

Function ConvertTo-ANOWContextVariableResult {
    [CmdletBinding()]
    param([object]$InputObject, [long]$ExpectedId, [long]$ExpectedProcessing, [switch]$RequireValue)
    $result = [pscustomobject]@{Succeeded=$false;Item=$null;HasValue=$false}
    $values = [Collections.Generic.Dictionary[string,object]]::new([StringComparer]::OrdinalIgnoreCase)
    if ($InputObject -is [Collections.IDictionary]) {
        foreach ($key in $InputObject.Keys) {
            if ($key -isnot [string] -or $values.ContainsKey($key)) { return $result }
            $values.Add($key, $InputObject[$key])
        }
    } elseif ($null -ne $InputObject -and ($InputObject.GetType() -eq [System.Management.Automation.PSCustomObject] -or $InputObject -is [ANOWProcessingContextVariable])) {
        foreach ($property in $InputObject.PSObject.Properties) {
            if ($property.MemberType -notin @('NoteProperty','Property') -or $values.ContainsKey($property.Name)) { return $result }
            $values.Add($property.Name, $property.Value)
        }
    } else { return $result }
    if (-not $values.ContainsKey('id') -or ($RequireValue -and -not $values.ContainsKey('value'))) { return $result }
    $properties = [Collections.Generic.Dictionary[string,Reflection.PropertyInfo]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($property in [ANOWProcessingContextVariable].GetProperties([Reflection.BindingFlags]'Public,Instance')) {
        if ($property.CanWrite -and $property.GetIndexParameters().Count -eq 0) { $properties.Add($property.Name, $property) }
    }
    $staged = @{}
    foreach ($name in $values.Keys) {
        if (-not $properties.ContainsKey($name)) { return $result }
        $target = $properties[$name].PropertyType
        $underlying = [Nullable]::GetUnderlyingType($target)
        if ($null -eq $underlying) { $underlying = $target }
        $value = $values[$name]
        if ($null -eq $value -and $target.IsValueType -and $target -eq $underlying) { return $result }
        if ($null -ne $value) {
            if ($underlying -eq [string] -and $value -isnot [string]) { return $result }
            if ($underlying -eq [bool] -and $value -isnot [bool]) { return $result }
            if ($underlying -eq [long]) {
                if ($value -isnot [string] -and $value -isnot [sbyte] -and $value -isnot [byte] -and $value -isnot [int16] -and $value -isnot [uint16] -and $value -isnot [int32] -and $value -isnot [uint32] -and $value -isnot [int64] -and $value -isnot [uint64]) { return $result }
                [long]$number = 0
                $text = [Convert]::ToString($value, [Globalization.CultureInfo]::InvariantCulture)
                if ($text -cnotmatch '^[0-9]+$' -or -not [long]::TryParse($text, [Globalization.NumberStyles]::None, [Globalization.CultureInfo]::InvariantCulture, [ref]$number)) { return $result }
            }
        }
        $converted = $null
        if (-not [Management.Automation.LanguagePrimitives]::TryConvertTo($value, $target, [Globalization.CultureInfo]::InvariantCulture, [ref]$converted)) { return $result }
        if ($null -ne $converted -and $underlying.IsEnum -and -not [Enum]::IsDefined($underlying, $converted)) { return $result }
        $staged[$properties[$name].Name] = $converted
    }
    if ($staged.id -le 0 -or ($ExpectedId -gt 0 -and $staged.id -ne $ExpectedId) -or
        ($ExpectedProcessing -gt 0 -and $values.ContainsKey('processing') -and $staged.processing -ne $ExpectedProcessing)) { return $result }
    $item = [ANOWProcessingContextVariable]::new()
    foreach ($name in $staged.Keys) { $item.$name = $staged[$name] }
    $result.Item = $item
    $result.HasValue = $values.ContainsKey('value')
    $result.Succeeded = $true
    return $result
}

Function ConvertFrom-ANOWContextVariableResponse {
    [CmdletBinding()]
    param([object[]]$Envelopes, [long]$ExpectedId, [long]$ExpectedProcessing,
        [switch]$RequireValue, [switch]$AllowEmpty, [int]$MaximumRows = 1)
    $result = [pscustomobject]@{Succeeded=$false;Items=@()}
    if (-not (Test-ANOWB2Response -Envelopes $Envelopes -AcknowledgmentOnly)) { return $result }
    $response = $Envelopes[0].response
    $hasData = if ($response -is [Collections.IDictionary]) { $response.Contains('data') } else { $null -ne $response.PSObject.Properties['data'] }
    if (-not $hasData) { return $result }
    [object[]]$rows = @()
    if ($null -ne $response.data) { $rows = @($response.data) }
    if ($rows.Count -gt $MaximumRows -or (-not $AllowEmpty -and $rows.Count -eq 0)) { return $result }
    $items = [Collections.Generic.List[object]]::new()
    foreach ($row in $rows) {
        $converted = ConvertTo-ANOWContextVariableResult -InputObject $row -ExpectedId $ExpectedId -ExpectedProcessing $ExpectedProcessing -RequireValue:$RequireValue
        if (-not $converted.Succeeded) { return $result }
        $items.Add($converted)
    }
    $result.Items = $items.ToArray()
    $result.Succeeded = $true
    return $result
}

Function New-ANOWContextVariableQuery {
    [CmdletBinding()]
    param([long]$Id, [long]$RunId, [string[]]$Name, [int]$startRow, [int]$endRow,
        [string]$sortBy = 'id', [switch]$Ascending)
    [System.Collections.Specialized.OrderedDictionary]$metadata = [ordered]@{}
    if ($Id -gt 0) {
        $route = '/processingContextVariable/get?'
        $metadata.Add('id', $Id)
    } else {
        $route = '/processingContextVariable/read?'
        $metadata.Add('_constructor', 'AdvancedCriteria')
        $metadata.Add('operator', 'and')
        $metadata.Add('criteria1', ('{"fieldName":"processing","operator":"inSet","value":["' + $RunId + '"]}'))
        if ($Name.Count -eq 1) {
            $criterion = [ordered]@{fieldName='name';operator='equals';value=$Name[0]}
            $metadata.Add('criteria2', (ConvertTo-Json -InputObject $criterion -Compress -Depth 4 -ErrorAction Stop))
        } elseif ($Name.Count -gt 1) {
            $criterion = [ordered]@{fieldName='name';operator='inSet';value=@($Name)}
            $metadata.Add('criteria2', (ConvertTo-Json -InputObject $criterion -Compress -Depth 4 -ErrorAction Stop))
        }
        $metadata.Add('_sortBy', $(if ($Ascending) { $sortBy } else { '-' + $sortBy }))
        $metadata.Add('_operationType', 'fetch')
        $metadata.Add('_startRow', $startRow)
        $metadata.Add('_endRow', $endRow)
        $metadata.Add('_textMatchStyle', 'substring')
        $metadata.Add('_componentId', 'ProcessingContextVariableList')
    }
    $metadata.Add('_dataSource', 'ProcessingContextVariableDataSource')
    $metadata.Add('isc_metaDataPrefix', '_')
    $metadata.Add('isc_dataFormat', 'json')
    return ($route + (ConvertTo-QueryString -InputObject $metadata))
}

Function New-ANOWContextVariableUpdateBody {
    [CmdletBinding()]
    param([ANOWProcessingContextVariable]$ContextVariable, [string]$Value)
    [System.Collections.Specialized.OrderedDictionary]$metadata = [ordered]@{}
    [string]$oldValues = $ContextVariable.CreateOldValues()
    $metadata.'id' = [string]$ContextVariable.id
    $metadata.'value' = $Value
    $metadata.'_operationType' = 'update'
    $metadata.'_textMatchStyle' = 'exact'
    $metadata.'_oldValues' = $oldValues
    $metadata.'_componentId' = 'ProcessingContextVariableEditForm'
    $metadata.'_dataSource' = 'ProcessingContextVariableDataSource'
    $metadata.'isc_metaDataPrefix' = '_'
    $metadata.'isc_dataFormat' = 'json'
    ConvertTo-QueryString -InputObject $metadata
}

Function Read-ANOWContextVariableResponse {
    [CmdletBinding()]
    param([long]$Id, [long]$RunId, [string[]]$Name, [int]$startRow, [int]$endRow,
        [long]$ExpectedProcessing, [switch]$RequireValue, [switch]$AllowEmpty,
        [string]$sortBy = 'id', [switch]$Ascending)
    $failed = [pscustomobject]@{Succeeded=$false;Items=@()}
    $query = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWContextVariableQuery) -OperationParameters @{Id=$Id;RunId=$RunId;Name=$Name;startRow=$startRow;endRow=$endRow;sortBy=$sortBy;Ascending=[bool]$Ascending}
    if (-not $query.Succeeded -or @($query.Data).Count -ne 1 -or $query.Data[0] -isnot [string]) { return $failed }
    $parameters = @{Command=$query.Data[0];Method='GET';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Instance=$anow_session.Instance}
    if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
    $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
    if (-not $sent.Succeeded) { return $failed }
    $maximumRows = if ($Id -gt 0) { 1 } else { $endRow - $startRow }
    $converted = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWContextVariableResponse) -OperationParameters @{Envelopes=$sent.Data;ExpectedId=$Id;ExpectedProcessing=$ExpectedProcessing;RequireValue=[bool]$RequireValue;AllowEmpty=[bool]$AllowEmpty;MaximumRows=$maximumRows}
    if (-not $converted.Succeeded -or @($converted.Data).Count -ne 1) { return $failed }
    return $converted.Data[0]
}

Function Get-AutomateNOWContextVariable {
    <#
    .SYNOPSIS
    Gets the Context Variables associated with a Workflow from an instance of AutomateNOW!

    .DESCRIPTION
    Gets the Context Variables associated with a Workflow from an instance of AutomateNOW!

    .PARAMETER Processing
    [ANOWProcessing] object representing a Task, Workflow, Service Manager, Schedule or Service Manager from which the Id will be extracted from.

    .PARAMETER RunId
    One ore more int64 representing the RunId of Processing objects from which to retrieve the Context Variables. Use Get-AutomateNOWTask, Get-AutomateNOWWorkflow, Get-AutomateNOWServiceManager or Get-AutomateNOWSchedule to retrieve these objects from which you can extract their id.

    .PARAMETER Name
    Optional names to filter by: one name uses equals; multiple names use inSet. Names are JSON-escaped and sent literally. Backend acceptance of quoted names and matching/collation rules are not established by offline validation.

    .PARAMETER Id
    Mandatory Id of the specific Context Variable that you want to retrieve. Use this when you know exactly which variable you want to retrieve. This parameter is not available to the pipeline.

    .PARAMETER startRow
    An optional int32 representing what row to start the download from. The default is 0.

    .PARAMETER endRow
    An optional int32 representing how many rows of data to receive. The default is 100.

    .PARAMETER sortBy
    Property sent to the server to sort each bounded collection page. Valid case-sensitive choices are: id, name, value, valuePreview, dateCreated, lastUpdated. The default is id, descending.

    .PARAMETER Ascending
    Request ascending order instead of the default descending order. Each RunId is queried separately; results are not globally sorted across RunIds.

    .PARAMETER PreviewOnly
    Return bounded collection rows without individual value reads. Missing value stays empty in the typed object and must not be interpreted as an empty stored value.

    .INPUTS
    The RunId numbers may be sent across the pipeline

    .OUTPUTS
    An array of [ANOWProcessingContextVariable] objects

    .EXAMPLE
    Retrieves bounded context-variable pages for several Workflow RunIds. Each RunId requires a list request; each returned row missing value requires one exact detail request.
    Get-AutomateNOWContextVariable -RunId 5415442, 5415443, 5415444, 5415445, 5415446, 5404544, 5404545, 5404552, 5404554, 5404555, 5404556, 5404557, 5415447

    .EXAMPLE
    Retrieves context variables across the pipeline from a series of Workflow RunIds
    1913730, 1924427 | Get-AutomateNOWContextVariable | Export-AutomateNOWContextVariable

    .EXAMPLE
    Retrieves the context variables from a single Workflow RunId
    Get-AutomateNOWContextVariable -RunId 5415442

    .EXAMPLE
    Retrieves a single context variable by name from a single Task/Workflow RunId
    Get-AutomateNOWContextVariable -RunId 5415442 -Name 'variable1'

    .EXAMPLE
    Retrieves all of the Context Variables that are associated with a Task with an Id of 123456
    Get-AutomateNOWTask -Id 123456 | Get-AutomateNOWContextVariable

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Context Variables are considered part of the Processing class.

    Use Trace-AutomateNOWProcessing if you need to have the scope (level) of the variable (i.e. self, parent or root).

    Warning: If you send an integer across the pipeline to this function it will be interpreted as the associated RunId (processId) of the variable. If you want to fetch the context variable by its Id then you must use -Id without the pipeline.

    Use -Id for one exact variable lookup; it does not fetch itself again. Default collection reads retrieve each missing full value once, even for short previews. Use -PreviewOnly for inexpensive menus. Values and previews remain separate. List/detail reads are sequential, not an atomic snapshot. A diagnostic or invalid response stops the failing page and later reads.

    #>
    [OutputType([ANOWProcessingContextVariable[]])]
    [CmdletBinding( DefaultParameterSetName = 'RunId')]
    Param(
        [Parameter(Mandatory = $True, ParameterSetName = 'Processing', ValueFromPipeline = $true)]
        [ANOWProcessing]$Processing,
        [Parameter(Mandatory = $True, ParameterSetName = 'RunId', ValueFromPipeline = $true)]
        [int64[]]$RunId,
        [Parameter(Mandatory = $False, ParameterSetName = 'RunId')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Processing')]
        [string[]]$Name,
        [Parameter(Mandatory = $True, ParameterSetName = 'Id')]
        [int64]$Id,
        [Parameter(Mandatory = $False, ParameterSetName = 'RunId')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Processing')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'RunId')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Processing')]
        [int32]$endRow = 100,
        [ValidateSet('id', 'name', 'value', 'valuePreview', 'dateCreated', 'lastUpdated', IgnoreCase = $false)]
        [Parameter(Mandatory = $False, ParameterSetName = 'RunId')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Processing')]
        [string]$sortBy = 'id',
        [Parameter(Mandatory = $False, ParameterSetName = 'RunId')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Processing')]
        [switch]$Ascending,
        [Parameter(Mandatory = $False, ParameterSetName = 'RunId')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Processing')]
        [switch]$PreviewOnly
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'There is not a valid token confirmed. No Context Variable read was submitted.'
        }
    }
    Process {
        if ($batchStopped) { return }
        $exact = $PSCmdlet.ParameterSetName -eq 'Id'
        [long[]]$targets = if ($exact) { @($Id) } elseif ($PSCmdlet.ParameterSetName -eq 'Processing') { @($Processing.id) } else { @($RunId) }
        if ($targets.Count -eq 0 -or @($targets | Where-Object { $_ -le 0 }).Count -gt 0 -or
            (-not $exact -and ($startRow -lt 0 -or $endRow -lt $startRow))) {
            $batchStopped = $true
            Write-Warning 'Positive Context Variable or processing IDs and a valid bounded row range are required. No read was submitted; later inputs were stopped.'
            return
        }
        $seen = [Collections.Generic.HashSet[long]]::new()
        foreach ($target in $targets) {
            $arguments = if ($exact) { @{Id=$target;RequireValue=$true;AllowEmpty=$true} } else { @{RunId=$target;Name=$Name;startRow=$startRow;endRow=$endRow;sortBy=$sortBy;Ascending=[bool]$Ascending;AllowEmpty=$true} }
            $page = Read-ANOWContextVariableResponse @arguments
            if (-not $page.Succeeded) {
                $batchStopped = $true
                Write-Warning 'The Context Variable response was not verified. The failing page and later reads were stopped; no values were returned for that page.'
                return
            }
            $staged = [Collections.Generic.List[ANOWProcessingContextVariable]]::new()
            foreach ($entry in $page.Items) {
                if ($seen.Contains($entry.Item.id)) { continue }
                if (-not $PreviewOnly -and -not $entry.HasValue) {
                    $detail = Read-ANOWContextVariableResponse -Id $entry.Item.id -ExpectedProcessing $entry.Item.processing -RequireValue
                    if (-not $detail.Succeeded) {
                        $batchStopped = $true
                        Write-Warning 'The full Context Variable value was not verified. The failing page and later reads were stopped; preview text was not substituted.'
                        return
                    }
                    $entry.Item.value = $detail.Items[0].Item.value
                }
                $null = $seen.Add($entry.Item.id)
                $staged.Add($entry.Item)
            }
            foreach ($item in $staged) { $item }
        }
    }
    End {
    }
}

Function Set-AutomateNOWContextVariable {
    <#
    .SYNOPSIS
    Sets the value of an existing Context Variable on an AutomateNOW! instance

    .DESCRIPTION
    Sets the value of an existing Context Variable on an AutomateNOW! instance

    .PARAMETER ContextVariable
    An [ANOWProcessingContextVariable] object representing the Context Variable to be modified.

    .PARAMETER Value
    String indicating the new value of the Context Variable

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Suppress the verified updated object. Acknowledgment and value verification still run.

    .INPUTS
    ONLY [ANOWProcessingContextVariable] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWProcessingContextVariable] object will be returned

    .EXAMPLE
    Quietly and forcibly sets the value of a Context Variable named 'Variable1' from a Task with a RunId of 123456 to 'abcdef'

    Get-AutomateNOWTask -Id 123456 | Get-AutomateNOWContextVariable -Name 'Variable1' | Set-AutomateNOWContextVariable -Value 'abcdef' -Force -Quiet

    .EXAMPLE
    Sets the value of a Context Variable using the Id (not the RunId) of the Context Variable (one-liner)

    Get-AutomateNOWContextVariable -Id 762373 | Set-AutomateNOWContextVariable -Value 'abc123'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The maximum length (in characters) of the Value is unknown. One matching prerequisite and update response are required. A valid update row missing value permits one exact verification read. Success requires the full returned value to equal the submitted string. Diagnostics or uncertain verification stop later pipeline updates; the write may already have happened and must not be automatically repeated. Generic caller-derived oldValues generation is unchanged.

    #>
    [OutputType([ANOWProcessingContextVariable])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessingContextVariable]$ContextVariable,
        [Parameter(Mandatory = $true)]
        [string]$Value,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'There is not a valid token confirmed. No Context Variable update was submitted.'
        }
    }
    Process {
        if ($batchStopped) { return }
        if ($null -eq $ContextVariable -or $ContextVariable.id -le 0) {
            $batchStopped = $true
            Write-Warning 'A positive Context Variable ID is required. No update was submitted; later inputs were stopped.'
            return
        }
        [long]$processing = $ContextVariable.processing
        [string]$name = $ContextVariable.name
        [long]$ContextVariable_id = $ContextVariable.id
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Context Variable name: '$($name)' from RunId: $($processing) Id: $($ContextVariable_id)")) -eq $true) {
            $before = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWContextVariable) -OperationParameters @{Id=$ContextVariable_id}
            if (-not $before.Succeeded -or @($before.Data).Count -ne 1 -or $before.Data[0] -isnot [ANOWProcessingContextVariable] -or
                $before.Data[0].id -ne $ContextVariable_id -or ($processing -gt 0 -and $before.Data[0].processing -ne $processing)) {
                $batchStopped = $true
                Write-Warning 'Exactly one matching Context Variable could not be verified. No update was submitted; later inputs were stopped.'
                return
            }
            $body = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWContextVariableUpdateBody) -OperationParameters @{ContextVariable=$ContextVariable;Value=$Value}
            if (-not $body.Succeeded -or @($body.Data).Count -ne 1 -or $body.Data[0] -isnot [string]) {
                $batchStopped = $true
                Write-Warning 'Context Variable update preparation was not verified. No update was submitted; later inputs were stopped.'
                return
            }
            $parameters = @{Command='/processingContextVariable/update';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$body.Data[0]}
            if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
            $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            $response = if ($sent.Succeeded) {
                Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWContextVariableResponse) -OperationParameters @{Envelopes=$sent.Data;ExpectedId=$ContextVariable_id;ExpectedProcessing=$before.Data[0].processing}
            } else { $null }
            if ($null -eq $response -or -not $response.Succeeded -or @($response.Data).Count -ne 1 -or -not $response.Data[0].Succeeded) {
                $batchStopped = $true
                Write-Warning 'The Context Variable update outcome is uncertain. The value may already have changed; do not repeat the update. Later pipeline inputs were stopped.'
                return
            }
            $entry = $response.Data[0].Items[0]
            $updated = $entry.Item
            if (-not $entry.HasValue) {
                $readback = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWContextVariable) -OperationParameters @{Id=$ContextVariable_id}
                if (-not $readback.Succeeded -or @($readback.Data).Count -ne 1 -or $readback.Data[0] -isnot [ANOWProcessingContextVariable] -or
                    $readback.Data[0].id -ne $ContextVariable_id -or ($before.Data[0].processing -gt 0 -and $readback.Data[0].processing -ne $before.Data[0].processing)) {
                    $batchStopped = $true
                    Write-Warning 'The Context Variable update verification is uncertain. The value may already have changed; do not repeat the update. Later pipeline inputs were stopped.'
                    return
                }
                $updated = $readback.Data[0]
            }
            if (-not [string]::Equals($updated.value, $Value, [StringComparison]::Ordinal)) {
                $batchStopped = $true
                Write-Warning 'The Context Variable update value was not verified. The outcome is uncertain; do not repeat the update. Later pipeline inputs were stopped.'
                return
            }
            Write-Verbose "ContextVariable object [$ContextVariable_id] was successfully updated"
            if (-not $Quiet) { $updated }
        }
    }
    End {
    }
}

Function Test-ANOWB3Session {
    # This fixed read-only session check cannot dispatch a caller-selected operation.
    $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Confirm-AutomateNOWSession) -OperationParameters @{Quiet=$true}
    return ($checked.Succeeded -and @($checked.Data).Count -eq 1 -and $checked.Data[0] -eq $true)
}

Function New-AutomateNOWContextVariable {
    <#
    .SYNOPSIS
    Creates a new Context Variable on an AutomateNOW! instance

    .DESCRIPTION
    Creates a new Context Variable on an AutomateNOW! instance

    .PARAMETER Processing
    A mandatory [ANOWProcessing] object from which to associate the newly created Context Variable with. Use Get-AutomateNOWTask, Get-AutomateNOWWorkflow, Get-AutomateNOWSchedule, Get-AutomateNOWServiceManager or Get-AutomateNOWProcessingList to fetch these objects. This parameter cannot be combined with -Id.

    .PARAMETER Id
    A mandatory positive [int64] Id of a Processing object, supplied by name or through the pipeline. This parameter cannot be combined with -Processing.

    .PARAMETER Name
    A mandatory [string] representing the name of the Context Variable. This has a limit of 255 characters.

    .PARAMETER Value
    A mandatory [string] representing the value of the Context Variable. The limit (in characters) of this property is unknown.

    .PARAMETER IsArray
    An optional switch parameter that will set the 'isArray' property to true. It is not yet known what difference this makes.

    .PARAMETER IsFile
    An optional switch parameter that will set the 'isFile' property to true. It is not yet known what difference this makes.

    .PARAMETER Quiet
    Switch parameter that silences the output of the newly created object.

    .INPUTS
    You must provide either a Processing object or its Id (a.k.a. RunId) along with the name and value.

    .OUTPUTS
    The newly created [ANOWProcessingContextVariable] object will be returned.

    .EXAMPLE
    Creates a new Context Variable within a Workflow with an Id (a.k.a. RunId) of 123456 named 'Variable1' with a value of 'Value1' (one-liner)

    Get-AutomateNOWWorkflow -Id 123456 | New-AutomateNOWContextVariable -Name 'Variable1' -Value 'Value1'

    .EXAMPLE
    Creates a new Context Variable within a Task with an Id (a.k.a. RunId) of 123456 named 'Variable1' with a value of 'Value1' (one-liner)

    Get-AutomateNOWTask -Id 123456 | New-AutomateNOWContextVariable -Name 'Variable1' -Value 'Value1'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    All Context Variables must be associated with a Processing object.

    You must include either the -Processing or the -Id parameter but not both. Only one of -IsFile and -IsArray may be true. Both flags are available with either target form.

    Any other 'level' besides 'SELF' that is specified in this API call will be ignored.
    #>
    [OutputType([ANOWProcessingContextVariable])]
    [CmdletBinding(DefaultParameterSetName = 'Processing')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Processing', ValueFromPipeline = $True)]
        [ANOWProcessing]$Processing,
        [Parameter(Mandatory = $true, ParameterSetName = 'Id', ValueFromPipeline = $True)]
        [int64]$Id,
        [ValidateScript({ $_.Length -le 255 })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Processing')]
        [Parameter(Mandatory = $true, ParameterSetName = 'Id')]
        [string]$Name,
        [Parameter(Mandatory = $true, ParameterSetName = 'Processing')]
        [Parameter(Mandatory = $true, ParameterSetName = 'Id')]
        [string]$Value,
        [Parameter(Mandatory = $false, ParameterSetName = 'Id')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Processing')]
        [switch]$IsArray,
        [Parameter(Mandatory = $false, ParameterSetName = 'Id')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Processing')]
        [switch]$IsFile,
        [Parameter(Mandatory = $false, ParameterSetName = 'Id')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Processing')]
        [switch]$Quiet
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'There is not a valid token confirmed. No Context Variable was submitted.'
        }
    }
    Process {
        if ($batchStopped) { return }
        if (($PSBoundParameters.ContainsKey('Processing') -and $PSBoundParameters.ContainsKey('Id')) -or ($IsArray -and $IsFile)) {
            $batchStopped = $true
            Write-Warning 'Supply exactly one of Processing and Id, and at most one of IsArray and IsFile.'
            return
        }
        [long]$Processing_Id = if ($PSBoundParameters.ContainsKey('Processing')) { $Processing.id } else { $Id }
        if ($Processing_Id -le 0) {
            $batchStopped = $true
            Write-Warning 'A positive processing Id is required. No Context Variable was submitted.'
            return
        }
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [ordered]@{
            name=$Name; value=$Value; level='SELF'; processing=$Processing_Id
        }
        if ($IsArray) { $BodyMetaData.'isArray' = 'true' }
        if ($IsFile) { $BodyMetaData.'isFile' = 'true' }
        $BodyMetaData.'_operationType' = 'add'
        $BodyMetaData.'_textMatchStyle' = 'exact'
        $BodyMetaData.'_oldValues' = ('{"level":"SELF","processing":"' + $Processing_Id + '"}')
        $BodyMetaData.'_componentId' = 'ProcessingContextVariableCreateWindow_form'
        $BodyMetaData.'_dataSource' = 'ProcessingContextVariableDataSource'
        $BodyMetaData.'isc_metaDataPrefix' = '_'
        $BodyMetaData.'isc_dataFormat' = 'json'
        $encoded = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$BodyMetaData}
        if (-not $encoded.Succeeded -or @($encoded.Data).Count -ne 1 -or $encoded.Data[0] -isnot [string]) {
            $batchStopped = $true
            Write-Warning 'Context Variable serialization was not verified. No create was submitted; later pipeline inputs were stopped.'
            return
        }
        $parameters = @{Command='/processingContextVariable/create';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$encoded.Data[0]}
        if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
        $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
        if (-not $sent.Succeeded -or -not (Test-ANOWB2Response -Envelopes $sent.Data)) {
            $batchStopped = $true
            Write-Warning 'The Context Variable create outcome is uncertain. The object may already exist; do not repeat the create. Later pipeline inputs were stopped.'
            return
        }
        try {
            [ANOWProcessingContextVariable]$created = @($sent.Data[0].response.data)[0]
            if ($null -eq $created -or $created.id -le 0) { throw 'Empty Context Variable result' }
        } catch {
            $batchStopped = $true
            Write-Warning 'The created Context Variable could not be represented by the loaded class. The object may already exist; do not repeat the create. Later pipeline inputs were stopped.'
            return
        }
        Write-Verbose "A Context Variable object named '$Name' was successfully created under processing Id '$Processing_Id'"
        if (-not $Quiet) { $created }
    }
}

Function Export-AutomateNOWContextVariable {
    <#
    .SYNOPSIS
    Exports the Context Variables from a Task or Workflow from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the Context Variables from a Task or Workflow from an instance of AutomateNOW!

    .PARAMETER ContextVariable
    Mandatory [ANOWProcessingContextVariable] object (Use Get-AutomateNOWContextVariable to retrieve them)

    .INPUTS
    ONLY [ANOWProcessingContextVariable] objects are accepted (including from the pipeline)

    .OUTPUTS
    The [ANOWProcessingContextVariable] objects are exported to the local disk in CSV format

    .EXAMPLE
    Exports the Context Variables from two Workflow RunId's
    1913730, 1924427 | Get-AutomateNOWContextVariable | Export-AutomateNOWContextVariable

    .NOTES
    You must present [ANOWProcessingContextVariable] objects to the pipeline to use this function.
    #>

    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWProcessingContextVariable]$ContextVariable
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-ContextVariables-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        $parameters.Add('Delimiter', "`t")
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWProcessingContextVariable]$ContextVariable = $_
        }
        $Error.Clear()
        Try {
            $ContextVariable | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWProcessingContextVariable] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function Remove-AutomateNOWContextVariable {
    <#
    .SYNOPSIS
    Removes a Context Variable from an AutomateNOW! instance

    .DESCRIPTION
    Removes a Context Variable from an AutomateNOW! instance

    .PARAMETER ContextVariable
    [ANOWProcessingContextVariable] object representing the Context Variable that is being removed. Use Get-AutomateNOWContextVariable to retrieve them.

    .PARAMETER Id
    An int64 representing the Id of the specific Context Variable to remove.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present a [ANOWProcessingContextVariable] object to the -ContextVariable parameter (or to the pipeline).

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Forcibly removes a Context Variable named 'ContextVariable1' (one-liner format)

    Get-AutomateNOWContextVariable -Id 'ContextVariable1' | Remove-AutomateNOWContextVariable -Force

    .EXAMPLE
    Forcibly removes a Context Variable with an Id of 123456 (one-liner format)
    123456 | Remove-AutomateNOWContextVariable

    .EXAMPLE
    Gently removes all of the Context Variables from a Workflow with an Id of 123456
    123456 | Trace-AutomateNOWWorkflow -ReturnContextVariables | Remove-AutomateNOWContextVariable

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    If you provide the numerical -Id instead of the -ContextVariable object then there will not be "old_values" included in the request.

    #>
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Object', ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Object', ValueFromPipeline = $True)]
        [ANOWProcessingContextVariable]$ContextVariable,
        [Parameter(Mandatory = $true, ParameterSetName = 'Id', ValueFromPipeline = $True)]
        [int64]$Id,
        [Parameter(Mandatory = $false, ParameterSetName = 'Id')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Object')]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/processingContextVariable/delete'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If (($_.id -gt 0) -or ($ContextVariable.id -gt 0)) {
            If ($_.id -gt 0) {
                [ANOWProcessingContextVariable]$ContextVariable = $_
            }
            [int64]$ContextVariable_id = $ContextVariable.Id
        }
        ElseIf (($_ -gt 0) -or ($Id -gt 0)) {
            If ($_ -gt 0) {
                [int64]$Id = $_
            }
            [int64]$ContextVariable_id = $Id
        }
        Else {
            Write-Warning -Message 'It was not possible to derive the id of the provided Context Variable.'
            Break
        }
        If ($ContextVariable_id -eq 0) {
            Write-Warning -Message "An empty Id was passed to this function (Remove-AutomateNOWContextVariable)."
            Break
        }
        Else {
            Write-Verbose -Message "Received [$ContextVariable_id] for the Id of the ContextVariable Item to be removed"
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($ContextVariable_id)")) -eq $true) {
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.Add('id', $ContextVariable_id )
            If ($null -ne $ContextVariable) {
                [string]$old_values = $ContextVariable.CreateOldValues()
                $BodyMetaData.Add('_oldValues', $old_values )
            }
            $BodyMetaData.Add('_operationType', 'remove')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_componentId', 'ProcessingContextVariableList')
            $BodyMetaData.Add('_dataSource', 'ProcessingContextVariableDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$ContextVariable_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Context Variable $ContextVariable_id was removed"
        }
    }
    End {

    }
}

Function ConvertTo-ANOWContextVariableFormat {
    [CmdletBinding()]
    param([ANOWProcessingContextVariable[]]$Variables, [string]$Format, [string]$XmlType)
    if ($Format -ceq 'HashTable') {
        $table = @{}
        foreach ($variable in $Variables) {
            $table.Add([string]$variable.Name, [string]$variable.Value)
        }
        return $table
    }
    [object[]]$items = @(foreach ($variable in $Variables) {
        [PSCustomObject]@{ ([string]$variable.Name) = [string]$variable.Value }
    })
    if ($Format -ceq 'XML') {
        $items | ConvertTo-Xml -As $XmlType -ErrorAction Stop
    } else {
        $items | ConvertTo-Json -Compress -ErrorAction Stop
    }
}

Function ConvertFrom-AutomateNOWContextVariable {
    <#
    .SYNOPSIS
    Converts supplied Context Variable names and values to JSON, a hashtable or XML.

    .DESCRIPTION
    Converts strictly typed Context Variables locally, using each supplied Value
    as text. Default JSON is one object for a singleton or an array of objects
    for multiple variables. No input produces no output. No backend read occurs.

    .PARAMETER ContextVariable
    Mandatory ANOWProcessingContextVariable object, accepted by name or pipeline.
    Use full-value Get-AutomateNOWContextVariable results when stored full values
    are required. Preview-only inputs do not establish full-value completeness.

    .PARAMETER AsHashTable
    Returns a hashtable. Names must be unique under the existing case-insensitive
    comparison; duplicate names produce one warning and no output.

    .PARAMETER AsCSV
    Disabled. Selecting CSV produces one warning and no output.

    .PARAMETER csv_delimiter
    Retained single-character CSV delimiter parameter. CSV remains disabled.

    .PARAMETER AsXML
    Returns native PowerShell XML serialization in the selected xml_type mode.

    .PARAMETER xml_type
    Document (default) returns XmlDocument; Stream returns string records;
    String returns one string containing the complete generated XML.

    .INPUTS
    ANOWProcessingContextVariable

    .OUTPUTS
    System.String
    JSON text, XML Stream text records, or one XML String-mode string.

    System.Collections.Hashtable
    Hashtable mode.

    System.Xml.XmlDocument
    XML Document mode.

    .EXAMPLE
    1913730, 1924427 | Get-AutomateNOWContextVariable | ConvertFrom-AutomateNOWContextVariable

    .EXAMPLE
    1913730, 1924427 | Get-AutomateNOWContextVariable | ConvertFrom-AutomateNOWContextVariable -AsHashTable

    .EXAMPLE
    1913730, 1924427 | Get-AutomateNOWContextVariable | ConvertFrom-AutomateNOWContextVariable -AsXML -xml_type Stream

    .NOTES
    Only Name and Value are converted. Supplied Value is used verbatim under the
    existing string conversion rules, including null-to-empty and empty strings.
    Neither preview spelling is consulted; preview length cannot prove stored
    completeness. The converter never retrieves missing full values implicitly.
    JSON preserves duplicate names as separate objects. Hashtable mode rejects
    duplicate names, including names differing only by case. CSV stays disabled.
    Native XML serialization/parsing can normalize line endings.
    Conversion diagnostics discard partial output and report a fixed warning
    without variable contents, generated XML or raw serializer exception text.
    #>
    [OutputType([string], [hashtable], [System.Xml.XmlDocument])]
    [CmdletBinding(DefaultParameterSetName = 'JSON')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'JSON', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'HashTable', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'CSV', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'XML', ValueFromPipeline = $true)]
        [ANOWProcessingContextVariable]$ContextVariable,
        [Parameter(Mandatory = $true, ParameterSetName = 'HashTable')]
        [switch]$AsHashTable,
        [Parameter(Mandatory = $true, ParameterSetName = 'CSV')]
        [switch]$AsCSV,
        [ValidateScript({ $_.Length -eq 1 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'CSV')]
        [string]$csv_delimiter = ',',
        [Parameter(Mandatory = $true, ParameterSetName = 'XML')]
        [switch]$AsXML,
        [ValidateSet('Document', 'Stream', 'String')]
        [Parameter(Mandatory = $false, ParameterSetName = 'XML')]
        [string]$xml_type = 'Document'
    )
    Begin {
        [ANOWProcessingContextVariable[]]$ContextVariables = @()
        $disabled = $AsCSV -eq $true
        if ($disabled) { Write-Warning 'CSV conversion is disabled. No converted output was returned.' }
    }
    Process {
        if (-not $disabled) { $ContextVariables += $ContextVariable }
    }
    End {
        if ($disabled -or $ContextVariables.Count -eq 0) { return }
        if ($AsHashTable) {
            $uniqueCount = @($ContextVariables.Name | Sort-Object -Unique).Count
            if ($ContextVariables.Count -gt $uniqueCount) {
                Write-Warning 'You cannot convert a set of context variables to a hash table if the names of each variable are not unique.'
                return
            }
        }
        $format = if ($AsHashTable) { 'HashTable' } elseif ($AsXML) { 'XML' } else { 'JSON' }
        $converted = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-ANOWContextVariableFormat) -OperationParameters @{
            Variables=$ContextVariables; Format=$format; XmlType=$xml_type; ErrorAction='Stop'
        }
        if (-not $converted.Succeeded) {
            Write-Warning 'Context variable conversion failed. No converted output was returned.'
            return
        }
        return $converted.Data
    }
}

#endregion

#region - Dashboard

Function Get-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Gets the Dashboards from an AutomateNOW! instance

    .DESCRIPTION
    Gets the Dashboards from an AutomateNOW! instance

    .PARAMETER Id
    The Id of the Dashboard. Use this when you only want to retrieve a single Dashboard. This parameter cannot be combined with others.

    .PARAMETER startRow
    Integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .PARAMETER sortBy
    Optional string parameter to sort the results by. Valid choices are: 'id'*, 'title', 'dateCreated', 'lastUpdated', 'sortOrder'

    .PARAMETER Descending
    Optional switch parameter to sort in descending order

    .PARAMETER Folder
    Optional string to filter by a particular Folder

    .PARAMETER Tags
    Optional string array of Tags to filter by. Note that the 'containsAny' operator will be used.

    .INPUTS
    Accepts a string representing the simple id of the Dashboard object from the pipeline or individually (but not an array) or you can specify by start and end rows.

    .OUTPUTS
    An array of one or more [ANOWDashboard] class objects

    .EXAMPLE
    Gets the first page of Dashboards
    Get-AutomateNOWDashboard

    .EXAMPLE
    Gets a specific Dashboard named 'Dashboard1'
    Get-AutomateNOWDashboard -Id 'Dashboard1'

    .EXAMPLE
    Gets a series of Dashboards using the pipeline

    'Dashboard1', 'Dashboard2' | Get-AutomateNOWDashboard

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWDashboard[]])]
    [CmdletBinding( DefaultParameterSetName = 'Default' )]
    Param(
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,}$' })]
        [Parameter(Mandatory = $False, ParameterSetName = 'Id', ValueFromPipeline = $true)]
        [string]$Id,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$endRow = 100,
        [ValidateSet('id', 'title', 'dateCreated', 'lastUpdated', 'sortOrder', IgnoreCase = $false)]
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [string]$sortBy = 'id',
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [switch]$Descending,
        [Parameter(Mandatory = $False)]
        [string]$Folder,
        [Parameter(Mandatory = $False)]
        [string[]]$Tags
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($Tags.Count -gt 0) {
            ForEach ($tag_id in $Tags) {
                $Error.Clear()
                Try {
                    [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] running under Get-AutomateNOWDashboard due to [$Message]"
                    Break
                }
                If ($tag_object.simpleId.length -eq 0) {
                    Throw "Get-AutomateNOWTag failed to confirm that the tag [$tag_id] actually exists under Get-AutomateNOWDashboard. Please check the tag name and try again."
                }
            }
        }
        If ($endRow -le $startRow) {
            Write-Warning -Message "The endRow must be greater than the startRow. Please try again."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If ($_.Length -gt 0 -or $Id.Length -gt 0) {
            If ($_.Length -gt 0 ) {
                $BodyMetaData.'id' = $_
            }
            Else {
                $BodyMetaData.'id' = $Id
            }
            [string]$textMatchStyle = 'exactCase'
            $BodyMetaData.'_operationId' = 'read'
        }
        Else {
            $BodyMetaData.Add('operator', 'or')
            $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
            $BodyMetaData.'_startRow' = $startRow
            $BodyMetaData.'_endRow' = $endRow
            If ($Folder.Length -gt 0) {
                $BodyMetaData.'criteria1' = ('{"fieldName":"folder","operator":"equals","value":"' + $Folder + '"}')
            }
            If ($Tags.Count -gt 0) {
                If ($Tags.Count -gt 1) {
                    $Error.Clear()
                    Try {
                        [string]$TagString = $Tags | ConvertTo-JSON -Compress -Depth 100
                    }
                    Catch {
                        [string]$Message = $_.Exception.Message
                        Write-Warning -Message "ConvertTo-Json failed to convert the provided tag names under Get-AutomateNOWDashboard due to [$Message]."
                        Break
                    }
                }
                Else {
                    [string]$TagString = $Tags
                }
                $BodyMetaData.'criteria2' = ('{"fieldName":"tags","operator":"containsAny","value":' + $TagString + '}')
            }
            If ($Descending -eq $true) {
                $BodyMetaData.Add('_sortBy', ('-' + $sortBy))
            }
            Else {
                $BodyMetaData.Add('_sortBy', $sortBy)
            }
            [string]$textMatchStyle = 'substring'
            $BodyMetaData.'_componentId' = 'DashboardList'
        }
        $BodyMetaData.'_textMatchStyle' = $textMatchStyle
        $BodyMetaData.'_dataSource' = 'DashboardDataSource'
        $BodyMetaData.'_operationType' = 'fetch'
        $BodyMetaData.'isc_metaDataPrefix' = '_'
        $BodyMetaData.'isc_dataFormat' = 'json'
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/dashboard/read?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.Command = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] while running Get-AutomateNOWDashboard due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        $Error.Clear()
        Try {
            [ANOWDashboard[]]$Dashboards = $results.response.data
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Failed to parse the response into a series of [ANOWDashboard] objects due to [$Message]."
            Break
        }
        If ($Dashboards.Count -gt 0) {
            Return $Dashboards
        }
    }
    End {

    }
}

Function Set-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Changes the settings of a Dashboard on an AutomateNOW! instance

    .DESCRIPTION
    Changes the settings of a Dashboard on an AutomateNOW! instance

    .PARAMETER Dashboard
    An [ANOWDashboard] object representing the Dashboard to be changed.

    .PARAMETER Title
    The "Title" of the dashboard. This string may not exceed 32 characters.

    .PARAMETER NumberOfRows
    Optional int32 to specify the number of rows in the dashboard. This number must be 1 or higher.

    .PARAMETER iconSet
    The name of the icon library (if you choose to use one). Possible choices are: FAT_COW, FUGUE (note that FONT_AWESOME is not an actual icon library)

    .PARAMETER iconCode
    The name of the icon which matches the chosen library. Must be lower-case. To see the list of available iconCodes, use Import-AutomateNOWIcon (or Import-AutomateNOWLocalIcon) then try $anow_assets.icon_library."FUGUE"[0..10] to see the names of the first 10 icons from the Fugue library.

    .PARAMETER RemoveIcon
    Switch parameter that will remove the icon configured for this Dashboard.

    .PARAMETER Folder
    (This parameter does not presently work!) String that specifies the name of the folder to place the Dashboard into.

    .PARAMETER UnsetFolder
    (This parameter does not presently work!) Switch parameter that will remove the Dashboard from its current folder.

    .PARAMETER Tags
    Optional string array containing the CASE-SENSITIVE id's of the tags to assign to the new Dashboard.

    .PARAMETER UnsetTags
    Switch parameter that will remove the tags from the Dashboard.

    .PARAMETER Description
    A text description of at least 1 character. Note that the description property is not currently exposed in the ANOW application.

    .PARAMETER UnsetDescription
    Switch parameter that will remove the description.

    .PARAMETER CodeRepository
    Optional Code Repository to place the Dashboard into. Use Get-AutomateNOWCodeRepository to fetch this object.

    .PARAMETER UnsetCodeRepository
    Switch parameter that will remove the Dashboard from its Code Repository.

    .PARAMETER PublicDashboard
    Boolean parameter to modify the "Public" status of the Dashboard.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter that silences the output of the updated object.

    .INPUTS
    ONLY [ANOWDashboard] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWDashboard] object will be returned

    .EXAMPLE
    Forcibly changes the Title of a dashboard named 'Dashboard1' (one-liner format)
    Get-AutomateNOWDashboard -Id 'Dashboard1' | Set-AutomateNOWDashboard -Title 'Dashboard Title' -Force

    .EXAMPLE
    Quietly changes the number of rows and the icon for a Dashboard named 'Dashboard1' (multi-line format)

    $dashboard = Get-AutomateNOWDashboard -Id 'Dashboard1'
    Import-AutomateNOWLocalIcon
    $dashboard | Set-AutomateNOWDashboard -NumberOfRows 5 -iconSet FAT_COW -iconCode 'accordion' -Quiet

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The -iconSet and -iconCode parameter set requires that you import the local icon names with Import-AutomateNOWIcon or Import-AutomateNOWLocalIcon. This is only to check that the name of the icon being sent to the API is valid.

    If you have three tags on a Dashboard and wanted to remove one then use the -SetTags parameter to apply the 2 that you want to keep. If you want to remove all tags then use -UnsetTags.

    Although the Description can be set, at the time of this writing, it is not actually exposed anywhere within the ANOW application.

    #>
    [OutputType([ANOWDashboard])]
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Default', ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Default', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'Icon', ValueFromPipeline = $true)]
        [ANOWDashboard]$Dashboard,
        [ValidateScript({ $_.length -le 32 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'Default', HelpMessage = "Enter a descriptive string between 1 and 32 characters in length. UTF8 characters are not accepted.")]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon', HelpMessage = "Enter a descriptive string between 1 and 32 characters in length. UTF8 characters are not accepted.")]
        [string]$Title,
        [ValidateScript({ $_ -gt 0 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [int32]$NumberOfRows,
        [Parameter(Mandatory = $true, ParameterSetName = 'Icon')]
        [ANOWIcon_IconsOnly]$iconSet,
        [ValidateScript({ $_ -match '^[a-z0-9-_]{1,}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Icon')]
        [string]$iconCode,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [switch]$RemoveIcon,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [string]$Folder,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [switch]$UnsetFolder,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [string[]]$Tags,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [switch]$UnsetTags,
        [ValidateScript({ $_.Length -le 255 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'Default', HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon', HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [string]$Description,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [switch]$UnsetDescription,
        [Parameter(Mandatory = $false)]
        [ANOWCodeRepository]$CodeRepository,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetCodeRepository,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [Nullable[boolean]]$PublicDashboard,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [switch]$Force,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Icon')]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($iconSet.length -gt 0 ) {
            If ($anow_assets.icon_library.length -eq 0) {
                Write-Warning -Message "Please import the ANOW icons into your session with Import-AutomateNOWIcon or Import-AutomateNOWLocalIcon"
                Break
            }
            If ($iconCode -notin ($anow_assets.icon_library."$iconSet")) {
                Write-Warning -Message "The icon [$iconCode] does not appear to exist within the [$iconSet] icon set."
                Break
            }
        }
        If (($RemoveIcon -eq $true) -and ($iconCode.Length -gt 0 -or $iconSet.Length -gt 0)) {
            Write-Warning -Message "You cannot unset the Icon and set it at the same time. Please choose one or the other."
            Break
        }
        If ($UnsetDescription -eq $true -and $Description.Length -gt 0) {
            Write-Warning -Message "You cannot unset the Description and set it at the same time. Please choose one or the other."
            Break
        }
        If ($UnsetFolder -eq $true -and $Folder.Length -gt 0) {
            Write-Warning -Message "You cannot unset the Folder and set it at the same time. Please choose one or the other."
            Break
        }
        If ($UnsetTags -eq $true -and $Tags.Count -gt 0) {
            Write-Warning -Message "You cannot unset the Tags and set them at the same time. Please choose one or the other."
            Break
        }
        If ($iconCode.Length -gt 0 -and $iconSet.Length -eq 0) {
            Write-Warning -Message "You must include the -iconSet when specifying an -iconCode"
            Break
        }
        ElseIf ($iconCode.Length -eq 0 -and $iconSet.Length -gt 0) {
            Write-Warning -Message "You must include the -iconCode when specifying an -iconSet"
            Break
        }
        If ($UnsetCodeRepository -eq $true -and $CodeRepository.Id.Length -gt 0) {
            Write-Warning -Message "You cannot unset the Code Repository and set it at the same time. Please choose one or the other."
            Break
        }
        [string]$command = '/dashboard/update'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWDashboard]$Dashboard = $_
        }
        [string]$Dashboard_id = $Dashboard.id
        If ($null -eq $Dashboard.dashboardDefinition) {
            [PSCustomObject]$dashboardDefinition = [PSCustomObject]@{}
            Write-Verbose -Message "$Dashboard_id did not have a definition yet. Creating one now..."
        }
        Else {
            [PSCustomObject]$dashboardDefinition = $Dashboard.dashboardDefinition
            $Error.Clear()
            Try {
                [string]$dashboardDefinitionJSON = $dashboardDefinition | ConvertTo-JSON -Compress -Depth 100
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "ConvertTo-JSON failed to convert the Dashboard definition from $Dashboard_id due to [$Message]."
                Break
            }
            Write-Verbose -Message "Dashboard definition from $Dashboard_id : $dashboardDefinitionJSON"
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$Dashboard_id")) -eq $true) {
            ## Begin warning ##
            ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
            $Error.Clear()
            Try {
                [boolean]$Dashboard_exists = ($null -ne (Get-AutomateNOWDashboard -Id $Dashboard_id))
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWDashboard failed to check if the Dashboard [$Dashboard_id] already existed due to [$Message]."
                Break
            }
            If ($Dashboard_exists -eq $false) {
                [string]$current_domain = $anow_session.header.domain
                Write-Warning -Message "There is not a Dashboard named [$Dashboard_id] in the current domain [$current_domain]."
                Break
            }
            ## End warning ##
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'id' = $Dashboard_id
            If ($dashboardDefinition.numColumns.Count -gt 0) {
                [int32]$CurrentNumberOfRows = $dashboardDefinition.numColumns | Measure-Object | Select-Object -ExpandProperty Count # This is not a typo. The ANOW product mistakenly refers to the number of rows as numColumns.
            }
            Else {
                [int32]$CurrentNumberOfRows = 2 # 2 is the default number of rows (i.e. "columns") for a newly created dashboard after its definition has been created.
            }
            If ($CurrentNumberOfRows -eq 0) {
                Write-Warning -Message "Could not extract the number of rows from the definition of the provided Dashboard $Dashboard_id"
                Break
            }
            If ($NumberOfRows -gt 0) {
                If ($CurrentNumberOfRows -eq $NumberOfRows) {
                    Write-Warning -Message "$Dashboard_id already has $NumberOfRows number of rows. Please do not use the -NumberOfRows parameter unless you intend to change it from its current value."
                    Break
                }
                If ($null -eq $dashboardDefinition.numColumns) {
                    $dashboardDefinition | Add-Member -MemberType NoteProperty -Name 'numColumns' -Value $NumberOfRows
                }
                Else {
                    $dashboardDefinition.numColumns = $NumberOfRows
                }
            }
            $Error.Clear()
            Try {
                [string]$dashboardDefinitionJSON = $dashboardDefinition | ConvertTo-JSON -Compress -Depth 100
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "ConvertTo-Json failed to convert the updated definition for $Dashboard_id under Set-AutomateNOWDashboard due to [$Message]"
                Break
            }
            $BodyMetaData.'dashboardDefinition' = $dashboardDefinitionJSON
            If ($Description.Length -gt 0) {
                $BodyMetaData.'description' = $Description
            }
            ElseIf ($UnsetDescription -eq $true) {
                $BodyMetaData.'description' = $null
            }

            If ($iconCode.Length -gt 0) {
                $BodyMetaData.'iconCode' = $iconCode
                $BodyMetaData.'iconSet' = $iconSet
            }
            ElseIf ($RemoveIcon -eq $true) {
                $BodyMetaData.'iconSet' = $null
                $BodyMetaData.'iconCode' = $null
                $BodyMetaData.'fugueIcon' = $null
                $BodyMetaData.'fatCowIcon' = $null
            }
            If ($Tags.Count -gt 0) {
                [int32]$current_tag = 1
                ForEach ($tag_id in $Tags) {
                    $Error.Clear()
                    Try {
                        [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
                    }
                    Catch {
                        [string]$Message = $_.Exception.Message
                        Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] under Set-AutomateNOWDashboard due to [$Message]"
                        Break
                    }
                    If ($tag_object.simpleId.length -eq 0) {
                        Throw "Set-AutomateNOWDashboard has detected that the tag [$tag_id] does not appear to exist."
                    }
                    ElseIf (($tag_object.simpleId -eq $tag_id) -and ($tag_object.simpleId -cne $tag_id)) {
                        [string]$tag_object_simpleId = $tag_object.simpleId
                        Throw "Wait! Tags are case-sensitive. [$tag_object_simpleId] is not the same case as [$tag_id]. Please check more carefully..."
                    }
                    [string]$tag_name_sequence = ('tags' + $current_tag)
                    $BodyMetaData.$tag_name_sequence = $tag_id
                    $current_tag++
                }
            }
            ElseIf ($UnsetTags -eq $true) {
                $BodyMetaData.'tags' = $null
            }
            If ($Folder.Length -gt 0) {
                $Error.Clear()
                Try {
                    [ANOWFolder]$folder_object = Get-AutomateNOWFolder -Id $Folder
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Get-AutomateNOWFolder failed to confirm that the folder [$Folder] actually existed under Set-AutomateNOWDashboard due to [$Message]"
                    Break
                }
                If ($folder_object.simpleId.Length -eq 0) {
                    Throw "Get-AutomateNOWFolder failed to locate the Folder [$Folder] under Set-AutomateNOWDashboard."
                }
                [string]$folder_display = $folder_object | ConvertTo-JSON -Compress -Depth 100
                Write-Verbose -Message "Adding folder $folder_display to [ANOWDashboard] [$Dashboard_id]"
                $BodyMetaData.'folder' = $Folder
            }
            ElseIf ($UnsetFolder -eq $true) {
                $BodyMetaData.'folder' = $null
            }
            If ($CodeRepository.Id.Length -gt 0) {
                [string]$CodeRepository_Id = $CodeRepository.Id
                $Error.Clear()
                Try {
                    [ANOWCodeRepository]$code_repository_object = Get-AutomateNOWCodeRepository -Id $CodeRepository_Id
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Get-AutomateNOWCodeRepository failed to confirm that the code repository [$CodeRepository_Id] actually existed under Set-AutomateNOWDashboard due to [$Message]"
                    Break
                }
                If ($code_repository_object.simpleId.Length -eq 0) {
                    Throw "Get-AutomateNOWCodeRepository failed to locate the Code Repository [$CodeRepository_Id] under Set-AutomateNOWDashboard."
                }
                $BodyMetaData.'codeRepository' = $CodeRepository_Id
            }
            ElseIf ($UnsetCodeRepository -eq $true) {
                $BodyMetaData.'codeRepository' = $null
            }
            If ($Title.Length -gt 0) {
                $BodyMetaData.'title' = $Title
            }
            Else {
                If ($Dashboard.title.Length -gt 0) {
                    [string]$Title = $Dashboard.title
                    $BodyMetaData.'title' = $Title
                }
            }
            If ($PublicDashboard -eq $true -and $Dashboard.publicDashboard -eq $false) {
                $BodyMetaData.'publicDashboard' = 'true'
            }
            ElseIf ($PublicDashboard -eq $false -and $Dashboard.publicDashboard -eq $true) {
                $BodyMetaData.'publicDashboard' = 'false'
            }
            [string]$old_values = $Dashboard.CreateOldValues()
            $BodyMetaData.'_oldValues' = $old_values
            $BodyMetaData.'_operationType' = 'update'
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_componentId' = 'isc_InfiniteDashboardEditor_0_dashboardEditor'
            $BodyMetaData.'_dataSource' = 'DashboardDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Dashboard_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            $Error.Clear()
            Try {
                [ANOWDashboard]$UpdatedDashboard = $results.response.data | Select-Object -First 1
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Was not able to parse the response from Set-AutomateNOWDashboard into an [ANOWDashboard] object due to [$Message]."
                Break
            }
            Write-Verbose -Message "Dashboard $Dashboard_id was successfully updated"
            If ($Quiet -ne $true) {
                Return $UpdatedDashboard
            }
        }
    }
    End {
    }
}

Function New-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Creates a Dashboard within an AutomateNOW! instance

    .DESCRIPTION
    Creates a Dashboard within an AutomateNOW! instance and returns back the newly created [ANOWDashboard] object

    .PARAMETER Id
    The intended unique Id of the Dashboard. For example: 'Dashboard1'. This value may not contain the domain in brackets.

    .PARAMETER Title
    The intended "Title" of the Dashboard. This is a display name which does not need to be unique and may not exceed 32 characters in length.

    .PARAMETER Description
    Optional description of the Dashboard (may not exceed 255 characters).

    .PARAMETER Tags
    Optional string array containing the CASE-SENSITIVE id's of the tags to assign to the new Dashboard.

    .PARAMETER Folder
    Optional name of the folder to place the Dashboard into.

    .PARAMETER iconSet
    Mandatory string representing a choice between three icon sets. Valid choices are: FAT_COW, FUGUE, FONT_AWESOME

    .PARAMETER iconCode
    The name of the icon which matches the chosen library. Must be lower-case.

    .PARAMETER CodeRepository
    Optional name of the code repository to place the Dashboard into.

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly created object

    .INPUTS
    None. You cannot pipe objects to New-AutomateNOWDashboard.

    .OUTPUTS
    An [ANOWDashboard] object representing the newly created Dashboard

    .EXAMPLE
    New-AutomateNOWDashboard -Id 'Dashboard1' -Description 'Dashboard1 description' -Tags 'Tag1', 'Tag2' -Folder 'Folder1' -iconSet 'FAT_COW' -iconCode 'paper_airplane' -CodeRepository 'Repository1'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The name (id) of the Dashboard must be unique (per domain). It may consist only of letters, numbers, underscore, dot or hyphen.

    The names of the icon is not enforced here! If you want to know the names of the available icons try running Import-AutomateNOWLocalIcon then review the $anow_assets.icon_library global variable.

    #>
    [OutputType([ANOWDashboard])]
    [CmdletBinding(DefaultParameterSetName = 'Default')]
    Param(
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $true, ParameterSetName = 'iconSet')]
        [string]$Id,
        [ValidateScript({ $_.length -le 32 })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $true, ParameterSetName = 'iconSet')]
        [string]$Title,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'iconSet', HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'iconSet')]
        [string[]]$Tags,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'iconSet')]
        [string]$Folder,
        [Parameter(Mandatory = $true, ParameterSetName = 'iconSet')]
        [ANOWIcon_IconsOnly]$iconSet,
        [ValidateScript({ $_ -match '^[a-z0-9-_]{1,}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'iconSet')]
        [string]$iconCode,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'iconSet')]
        [ANOWCodeRepository]$CodeRepository,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $false, ParameterSetName = 'iconSet')]
        [switch]$Quiet
    )
    If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
        Write-Warning -Message "There is not a valid token confirmed."
        Break
    }
    ## Begin warning ##
    ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
    $Error.Clear()
    Try {
        [boolean]$Dashboard_exists = ($null -ne (Get-AutomateNOWDashboard -Id $Id))
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Get-AutomateNOWDashboard failed to check if the Dashboard [$Id] already existed due to [$Message]."
        Break
    }
    If ($Dashboard_exists -eq $true) {
        [string]$current_domain = $anow_session.header.domain
        Write-Warning -Message "There is already a Dashboard with the Id [$Id] in [$current_domain]."
        Break
    }
    ## End warning ##
    [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
    $BodyMetaData.Add('id', $Id)
    $BodyMetaData.Add('title', $Title)
    If ($Description.Length -gt 0) {
        $BodyMetaData.Add('description', $Description)
    }
    If ($Tags.Count -gt 0) {
        [int32]$current_tag = 1
        ForEach ($tag_id in $Tags) {
            $Error.Clear()
            Try {
                [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] under New-AutomateNOWDashboard due to [$Message]"
                Break
            }
            If ($tag_object.simpleId.length -eq 0) {
                Throw "New-AutomateNOWDashboard has detected that the tag [$tag_id] does not appear to exist."
            }
            ElseIf (($tag_object.simpleId -eq $tag_id) -and ($tag_object.simpleId -cne $tag_id)) {
                [string]$tag_object_simpleId = $tag_object.simpleId
                Throw "Wait! Tags are case-sensitive. [$tag_object_simpleId] is not the same case as [$tag_id]. Please check more carefully..."
            }
            [string]$tag_name_sequence = ('tags' + $current_tag)
            $BodyMetaData.Add($tag_name_sequence, $tag_id)
            $current_tag++
        }
    }
    If ($Folder.Length -gt 0) {
        $Error.Clear()
        Try {
            [ANOWFolder]$folder_object = Get-AutomateNOWFolder -Id $Folder
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWFolder failed to confirm that the folder [$Folder] actually existed under New-AutomateNOWDashboard due to [$Message]"
            Break
        }
        If ($folder_object.simpleId.Length -eq 0) {
            Throw "Get-AutomateNOWFolder failed to locate the Folder [$Folder] under New-AutomateNOWDashboard."
        }
        [string]$folder_display = $folder_object | ConvertTo-JSON -Compress -Depth 100
        Write-Verbose -Message "Adding folder $folder_display to [ANOWDashboard] [$Id]"
        $BodyMetaData.Add('folder', $Folder)
    }
    If ($CodeRepository.id.Length -gt 0) {
        [string]$CodeRepository_Id = $CodeRepository.id
        $Error.Clear()
        Try {
            [ANOWCodeRepository]$code_repository_object = Get-AutomateNOWCodeRepository -Id $CodeRepository_Id
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWCodeRepository failed to confirm that the code repository [$CodeRepository_Id] existed under New-AutomateNOWDashboard due to [$Message]"
            Break
        }
        If ($code_repository_object.simpleId.Length -eq 0) {
            Throw "Get-AutomateNOWCodeRepository failed to locate the Code Repository [$CodeRepository_Id] under New-AutomateNOWDashboard."
        }
        Write-Verbose -Message "Adding Dashboard [$Id] to Code Repository $CodeRepository_Id"
        $BodyMetaData.Add('codeRepository', $CodeRepository_Id)
    }
    If ($iconSet.Length -gt 0) {
        $BodyMetaData.'iconSet' = $iconSet
    }
    If ($iconCode.Length -gt 0) {
        $BodyMetaData.'iconCode' = $iconCode
    }
    $BodyMetaData.'_operationType' = 'add'
    $BodyMetaData.'_textMatchStyle' = 'exact'
    $BodyMetaData.'_oldValues' = '{"publicDashboard":false}'
    $BodyMetaData.'_componentId' = 'DashboardCreateWindow_form'
    $BodyMetaData.'_dataSource' = 'DashboardDataSource'
    $BodyMetaData.'isc_metaDataPrefix' = '_'
    $BodyMetaData.'isc_dataFormat' = 'json'
    [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
    [string]$command = '/dashboard/create'
    [hashtable]$parameters = @{}
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'POST')
    $parameters.Add('Body', $Body)
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    [string]$parameters_display = $parameters | ConvertTo-JSON -Compress -Depth 100
    $Error.Clear()
    Try {
        [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] with parameters $parameters_display due to [$Message]."
        Break
    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
        Break
    }
    $Error.Clear()
    Try {
        [ANOWDashboard]$Dashboard = $results.response.data | Select-Object -First 1
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Failed to create a new [ANOWDashboard] object due to [$Message]."
        Break
    }
    If ($Dashboard.id.Length -eq 0) {
        Write-Warning -Message "The newly created [ANOWDashboard] object is empty!"
        Break
    }
    # Modify phase
    [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
    [string]$old_values = $Dashboard.CreateOldValues()
    $BodyMetaData.'id' = $Dashboard.id
    $BodyMetaData.'dashboardDefinition' = '{"numColumns":2,"colWidths":["*","*","*","*","*","*","*","*","*","*"],"portlets":[]}'
    $BodyMetaData.'_operationType' = 'update'
    $BodyMetaData.'_textMatchStyle' = 'exact'
    $BodyMetaData.'_oldValues' = $old_values
    $BodyMetaData.'_componentId' = 'isc_InfiniteDashboardEditor_0_dashboardEditor'
    $BodyMetaData.'_dataSource' = 'DashboardDataSource'
    $BodyMetaData.'isc_metaDataPrefix' = '_'
    $BodyMetaData.'isc_dataFormat' = 'json'
    [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
    [string]$command = '/dashboard/update'
    [hashtable]$parameters = @{}
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'POST')
    $parameters.Add('Body', $Body)
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    [string]$parameters_display = $parameters | ConvertTo-JSON -Compress -Depth 100
    $Error.Clear()
    Try {
        [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] with parameters $parameters_display due to [$Message]."
        Break
    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
        Break
    }
    $Error.Clear()
    Try {
        [ANOWDashboard]$Dashboard = $results.response.data | Select-Object -First 1
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Failed to finish modifying the newly created [ANOWDashboard] object due to [$Message]."
        Break
    }
    If ($Dashboard.id.Length -eq 0) {
        Write-Warning -Message "The newly created [ANOWDashboard] object (after being modified) is empty!"
        Break
    }
    If ($Quiet -ne $true) {
        Return $Dashboard
    }
}

Function Remove-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Removes a Dashboard from an AutomateNOW! instance

    .DESCRIPTION
    Removes a Dashboard from an AutomateNOW! instance

    .PARAMETER Dashboard
    Mandatory [ANOWDashboard] object representing the Dashboard that is being removed. Use Get-AutomateNOWDashboard to retrieve them.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present a [ANOWDashboard] object to the -Dashboard parameter (or to the pipeline).

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Forcibly removes a dashboard named 'Dashboard1' (one-liner format)

    Get-AutomateNOWDashboard -Id 'Dashboard1' | Remove-AutomateNOWDashboard -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWDashboard]$Dashboard,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/dashboard/delete'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWDashboard]$Dashboard = $_
        }
        [string]$Dashboard_id = $Dashboard.Id
        If ($Dashboard_id.Length -eq 0) {
            Write-Warning -Message "An empty Id was passed to this function (Remove-AutomateNOWDashboard)."
            Break
        }
        Else {
            Write-Verbose -Message "Received [$Dashboard_id] for the Id of the Dashboard Item to be removed"
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($Dashboard_id)")) -eq $true) {
            [string]$old_values = $Dashboard.CreateOldValues()
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.Add('id', $Dashboard_id )
            $BodyMetaData.Add('_oldValues', $old_values )
            $BodyMetaData.Add('_operationType', 'remove')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_componentId', 'DashboardList')
            $BodyMetaData.Add('_dataSource', 'DashboardDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Dashboard_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Dashboard $Dashboard_id was removed"
        }
    }
    End {

    }
}

Function Export-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Exports the Dashboards from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the Dashboards from an instance of AutomateNOW! to a local .csv file

    .PARAMETER Dashboard
    Mandatory [ANOWDashboard] object (Use Get-AutomateNOWDashboard to retrieve them)

    .INPUTS
    ONLY [ANOWDashboard] objects from the pipeline are accepted

    .OUTPUTS
    The [ANOWDashboard] objects are exported to the local disk in CSV format

    .EXAMPLE
    Get-AutomateNOWDashboard | Export-AutomateNOWDashboard

    .EXAMPLE
    Get-AutomateNOWDashboard -Id 'Dashboard01' | Export-AutomateNOWDashboard

    .EXAMPLE
    'Dashboard01', 'Dashboard02' | Get-AutomateNOWDashboard | Export-AutomateNOWDashboard

    .NOTES
    You must present [ANOWDashboard] objects to the pipeline to use this function.
    #>

    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWDashboard]$Dashboard
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-Dashboards-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWDashboard]$Dashboard = $_
        }
        $Error.Clear()
        Try {
            $Dashboard | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWDashboard] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function Copy-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Copies a Dashboard from an AutomateNOW! instance

    .DESCRIPTION
    Copies a Dashboard from an AutomateNOW! instance. AutomateNOW object id can never be changed, but we can copy the object to a new id and it will include all of the items therein.

    .PARAMETER Dashboard
    Mandatory [ANOWDashboard] object to be copied.

    .PARAMETER NewId
    The name (Id) of the new Dashboard. The new Id must be unique (per domain). It may consist only of letters, numbers, underscore, dot or hyphen (128 character maximum)

    .PARAMETER Title
    An optional different Title for the newly copied Dashboard (255 character maximum). If omitted, the title from the source Dashboard will be used.

    .PARAMETER Description
    Optional description to set on the new Dashboard object. If you do not set this, the new Dashboard object will copy the Description of the source object.

    .PARAMETER UnsetDescription
    Optional switch that will ensure that the newly created Dashboard will not have a description set.

    .PARAMETER Tags
    Optional string array of CASE-SENSITIVE Tag Id's to set on the new Dashboard object. If you do not set this, the new Dashboard object will apply the same Tags of the source object.

    .PARAMETER UnsetTags
    Optional switch that will ensure that the newly created Dashboard will not have any Tags set.

    .PARAMETER Folder
    Optional description to set a different folder on the new Dashboard object. If you do not set this, the new Dashboard object will use the same Folder of the source object.

    .PARAMETER UnsetFolder
    Optional switch that will ensure that the newly created Dashboard will not have a Folder set.

    .PARAMETER Force
    Force the copy without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly created object.

    .INPUTS
    ONLY an [ANOWDashboard] object is accepted. Pipeline support is intentionally unavailable.

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Creates a copy of a Dashboard named 'Dashboard1' to 'Dashboard2' and changes the description of the new Dashboard (multi-line format)

    $Dashboard1 = Get-AutomateNOWDashboard -Id 'Dashboard1'
    Copy-AutomateNOWDashboard -Dashboard $Dashboard1 -NewId 'Dashboard2' -Description 'This is Dashboard2'

    .EXAMPLE
    Creates a copy of a Dashboard named 'Dashboard1' to 'Dashboard2' and removes the description while adding two tags to the new Dashboard (multi-line format)

    $Dashboard1 = Get-AutomateNOWDashboard -Id 'Dashboard1'
    Copy-AutomateNOWDashboard -Dashboard (Get-AutomateNOWDashboard -Id 'Dashboard1') -NewId 'Dashboard2' -UnsetDescription -Tags 'Tag1', 'Tag2'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWDashboard])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWDashboard]$Dashboard,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,128}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [ValidateScript({ $_.length -le 32 })]
        [string]$Title,
        [Parameter(Mandatory = $false)]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetDescription,
        [Parameter(Mandatory = $false)]
        [string[]]$Tags,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetTags,
        [Parameter(Mandatory = $false)]
        [string]$Folder,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetFolder,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($UnsetDescription -eq $true -and $Description.Length -gt 0) {
            Write-Warning -Message "You cannot set the description and unset it at the same time. Please choose one or the other."
            Break
        }
        If ($UnsetFolder -eq $true -and $Folder.Length -gt 0) {
            Write-Warning -Message "You cannot set the Folder and unset it at the same time. Please choose one or the other."
            Break
        }
        If ($UnsetTags -eq $true -and $Tags.Count -gt 0) {
            Write-Warning -Message "You cannot set the Tags and unset them at the same time. Please choose one or the other. Tags from the source object will be carried over to the new object if you do not specify any tag-related parameters."
            Break
        }
        ## Begin warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$Dashboard_exists = ($null -ne (Get-AutomateNOWDashboard -Id $NewId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWDashboard failed to check if the Dashboard [$NewId] already existed due to [$Message]."
            Break
        }
        If ($Dashboard_exists -eq $true) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is already a Dashboard named [$NewId] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        ## End warning ##
        [string]$command = '/dashboard/copy'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($PermissionToProceed -ne $false) {
            [string]$Dashboard_oldId = $Dashboard.id
            [string]$Dashboard_simpleId = $Dashboard.simpleId
            If ($Dashboard_oldId -eq $NewId) {
                Write-Warning -Message "The new id cannot be the same as the old id."
                Break
            }
            If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Copy the Dashboard $($Dashboard_simpleId) to $($NewId)?")) -eq $true) {
                [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
                If ($UnsetFolder -eq $True) {
                    $BodyMetaData.'folder' = $Null
                }
                ElseIf ($Folder.Length -gt 0) {
                    $BodyMetaData.'folder' = $Folder
                }
                Else {
                    If ($Dashboard.folder.Length -gt 0) {
                        $BodyMetaData.'folder' = $Dashboard.folder
                    }
                }
                If ($Tags.Count -gt 0) {
                    ForEach ($tag_id in $Tags) {
                        $Error.Clear()
                        Try {
                            [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
                        }
                        Catch {
                            [string]$Message = $_.Exception.Message
                            Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] running under Copy-AutomateNOWDashboard due to [$Message]"
                            Break
                        }
                        If ($tag_object.simpleId.length -eq 0) {
                            Throw "Get-AutomateNOWTag failed to confirm that the tag [$tag_id] actually exists under Copy-AutomateNOWDashboard."
                        }
                    }
                    [int32]$tag_count = 1
                    ForEach ($tag in $Tags) {
                        $BodyMetaData.('tags' + $tag_count ) = $tag
                        $tag_count++
                    }
                }
                ElseIf ($UnsetTags -eq $true) {
                    $BodyMetaData.'tags' = $Null
                }
                Else {
                    If ($Dashboard.Tags.Count -gt 0) {
                        [int32]$tag_count = 1
                        ForEach ($tag in $Dashboard.tags) {
                            $BodyMetaData.('tags' + $tag_count ) = $tag
                            $tag_count++
                        }
                    }
                }
                $BodyMetaData.'oldId' = $Dashboard_oldId
                $BodyMetaData.'domain' = $Dashboard.domain
                $BodyMetaData.'id' = $NewId
                If ($UnsetDescription -ne $true) {
                    If ($Description.Length -gt 0) {
                        $BodyMetaData.'description' = $Description
                    }
                    Else {
                        $BodyMetaData.'description' = $Dashboard.description
                    }
                }
                If ($Title.Length -eq 0) {
                    [string]$Title = $Dashboard.title
                }
                $BodyMetaData.'title' = $Title
                $BodyMetaData.'_operationType' = 'add'
                $BodyMetaData.'_operationId' = 'copy'
                $BodyMetaData.'_textMatchStyle' = 'exact'
                $BodyMetaData.'_dataSource' = 'DashboardDataSource'
                $BodyMetaData.'isc_metaDataPrefix' = '_'
                $BodyMetaData.'isc_dataFormat' = 'json'
                [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
                $parameters.Body = $Body
                $Error.Clear()
                Try {
                    [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Dashboard_oldId] due to [$Message]."
                    Break
                }
                [int32]$response_code = $results.response.status
                If ($response_code -ne 0) {
                    [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                    Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                    Break
                }
                $Error.Clear()
                Try {
                    [ANOWDashboard]$NewDashboard = $results.response.data | Select-Object -First 1
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to create copied [ANOWDashboard] object [$NewId] due to [$Message]."
                    Break
                }
                If ($NewDashboard.id.Length -eq 0) {
                    Write-Warning -Message "The newly created (copied) [ANOWDashboard] object [$NewId] is empty!"
                    Break
                }
                If ($Quiet -ne $true) {
                    Return $NewDashboard
                }
            }
        }
    }
    End {

    }
}

Function Rename-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Renames a Dashboard on an AutomateNOW! instance

    .DESCRIPTION
    Performs a pseudo-rename operation of a Dashboard from an AutomateNOW! instance by copying it first and then deleting the source. This function merely combines Copy-AutomateNOWDashboard and Remove-AutomateNOWDashboard therefore it is to be considered destructive.

    .PARAMETER Dashboard
    An [ANOWDashboard] object representing the Dashboard to be renamed.

    .PARAMETER NewId
    Mandatory string indicating the new id or name of the Dashboard. The Id is the same as a primary key, it must be unique. The console will provide the old Id + '_COPY' in the UI when making a copy. The Id is limited to 1024 characters.

    .PARAMETER Force
    Force the renaming without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly renamed object.

    .INPUTS
    ONLY [ANOWDashboard] objects are accepted. There is intentionally no support for the pipeline.

    .OUTPUTS
    The newly renamed [ANOWDashboard] object will be returned.

    .EXAMPLE
    Renames a Dashboard named 'Dashboard1' to 'Dashboard2' (multi-line format)

    $Dashboard = Get-AutomateNOWDashboard -Id 'Dashboard1'
    Rename-AutomateNOWDashboard -Dashboard $Dashboard -NewId 'Dashboard2'

    .EXAMPLE
    Forcibly and quietly renames a Dashboard named 'Dashboard1' to 'Dashboard2' (one-liner format)

    Rename-AutomateNOWDashboard -Dashboard (Get-AutomateNOWDashboard -Id 'Dashboard1') -NewId 'Dashboard2' -Force -Quiet

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    When renaming, you may only specify a different Id (name).

    #>
    [OutputType([ANOWDashboard])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWDashboard]$Dashboard,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,1024}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        ## Begin standard warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$new_Dashboard_exists = ($null -ne (Get-AutomateNOWDashboard -Id $NewId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWDashboard failed to check if the Dashboard [$NewId] already existed due to [$Message]."
            Break
        }
        If ($new_Dashboard_exists -eq $true) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is already a Dashboard named [$NewId] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        #[string]$Dashboard_id = $Dashboard.id
        [string]$Dashboard_id = $Dashboard.simpleId
        $Error.Clear()
        Try {
            [boolean]$old_Dashboard_exists = ($null -ne (Get-AutomateNOWDashboard -Id $Dashboard_id))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWDashboard failed to check if the Dashboard [$Dashboard_id] already existed due to [$Message]."
            Break
        }
        If ($old_Dashboard_exists -eq $false) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is not a Dashboard named [$Dashboard_id] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        ## End standard warning ##
    }
    Process {
        If ($PermissionToProceed -ne $false) {
            If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($Dashboard_id)")) -eq $true) {
                $Error.Clear()
                Try {
                    [ANOWDashboard]$new_Dashboard = Copy-AutomateNOWDashboard -Dashboard $Dashboard -NewId $NewId -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Copy-AutomateNOWDashboard failed to create a new Dashboard [$NewId] as Part 1 of the renaming process due to [$Message]."
                    Break
                }
                If ($new_Dashboard.simpleId -eq $NewId) {
                    Write-Verbose -Message "Part 1: Dashboard [$Dashboard_id] successfully copied to [$NewId]"
                }
                Else {
                    Write-Warning -Message "The first phase (Copy-AutomateNOWDashboard) failed."
                    Break
                }
                $Error.Clear()
                Try {
                    Remove-AutomateNOWDashboard -Dashboard $Dashboard -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Remove-AutomateNOWDashboard failed to remove [$Dashboard_id] as Part 2 of the renaming process due to [$Message]."
                    Break
                }
                Write-Verbose -Message "Part 2: Dashboard [$Dashboard_id] removed"
                Write-Verbose -Message "Dashboard [$Dashboard_id] successfully renamed to [$NewId]"
                If ($Quiet -ne $true) {
                    Return $new_Dashboard
                }
            }
        }
        Else {
            Write-Warning -Message "No action was taken because either the source object didn't exist or the new object already existed"
        }
    }
    End {
    }
}

Function Push-AutomateNOWDashboard {
    <#
    .SYNOPSIS
    Moves (pushes) a Dashboard to the top of the list.

    .DESCRIPTION
    Moves (pushes) a Dashboard to the top of the list.

    .PARAMETER Dashboard
    An [ANOWDashboard] object representing the Dashboard to be moved (popped) to the top of the list (stack).

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    ONLY [ANOWDashboard] objects are accepted (including from the pipeline)

    .OUTPUTS
    A verbose information message will be sent indicating success

    .EXAMPLE
    Forcibly pushes a Dashboard named 'Dashboard1' to the top of the list (one-liner format)

    Get-AutomateNOWDashboard -Id 'Dashboard1' | Push-AutomateNOWDashboard -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    This function is equivalent to selecting a Dashboard and clicking 'Move Up' until it is at the top.

    This function will reset the sort order of all Dashboards starting from 0

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWDashboard]$Dashboard,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/dashboard/update'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.Id.Length -gt 0) {
            [ANOWDashboard]$Dashboard = $_
        }
        [string]$Dashboard_id = $Dashboard.id
        [string]$Dashboard_title = $Dashboard.title
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("'$($Dashboard_title)' (a.k.a. $($Dashboard_id)) to the top of the sort order?")) -eq $true) {
            $Error.Clear()
            Try {
                [ANOWDashboard[]]$Dashboards = Get-AutomateNOWDashboard -startRow 0 -endRow 10000
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWDashboard failed to parse the response into [ANOWDashboard] objects under Push-AutomateNOWDashboard due to [$Message]."
                Break
            }
            If ($Dashboards.count -eq 0) {
                Write-Warning -Message "There are no Dashboards at all on this instance."
                Break
            }
            [string]$old_values = $Dashboard.CreateOldValues()
            [PSCustomObject[]]$Dashboard_collection = (@($Dashboard | Select-Object -Property id, title, sortOrder) + @($Dashboards | Sort-Object -Property sortOrder | Where-Object { $_.id -ne $Dashboard_id } | Select-Object -Property id, title, sortOrder))
            [int32]$Dashboard_order_count = $Dashboard_collection.count
            Write-Verbose -Message "Discovered [$Dashboard_order_count] Dashboards"
            [int32]$current_dashboard = 0
            ForEach ($temp_dashboard in $Dashboard_collection) {
                [string]$temp_Dashboard_id = $temp_dashboard.id
                [string]$temp_Dashboard_title = $temp_dashboard.title
                [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
                $BodyMetaData.Add('id', $temp_Dashboard_id )
                $BodyMetaData.Add('sortOrder', $current_dashboard )
                $BodyMetaData.Add('_operationType', 'update')
                $BodyMetaData.Add('_textMatchStyle', 'exact')
                $BodyMetaData.Add('_oldValues', $old_values)
                $BodyMetaData.Add('_componentId', 'DashboardList')
                $BodyMetaData.Add('_dataSource', 'DashboardDataSource')
                $BodyMetaData.Add('isc_metaDataPrefix', '_')
                $BodyMetaData.Add('isc_dataFormat', 'json')
                [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
                If ($null -eq $parameters.'Body') {
                    $parameters.Add('Body', $Body)
                }
                Else {
                    $parameters.'Body' = $Body
                }
                $Error.Clear()
                Try {
                    [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on ($temp_Dashboard_title / $temp_Dashboard_id) due to [$Message]."
                    Break
                }
                [int32]$response_code = $results.response.status
                If ($response_code -ne 0) {
                    [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                    Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                    Break
                }
                Write-Verbose -Message "Dashboard ($temp_Dashboard_title / $temp_Dashboard_id) was successfully set to sortOrder [$current_dashboard]"
                $current_dashboard++
            }
        }
        Write-Verbose -Message "Dashboard ($Dashboard_title / $Dashboard_id) should now be at the top of the list."
    }
    End {

    }
}

