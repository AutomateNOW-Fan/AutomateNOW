    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
        Break
    }
    $Error.Clear()
    Try {
        [ANOWNotificationGroup]$NotificationGroup = $results.response.data | Select-Object -First 1
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Failed to parse the response into a valid [ANOWNotificationGroup] object due to [$Message]."
        Break
    }
    If ($NotificationGroup.id.Length -eq 0) {
        Write-Warning -Message "The newly created [ANOWNotificationGroup] object is empty!"
        Break
    }
    If ($Quiet -ne $true) {
        Return $NotificationGroup
    }
}

