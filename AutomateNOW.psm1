#region - Code Repository OutOfSync Item

Function Get-AutomateNOWCodeRepositoryOutOfSyncItem {
    <#
    .SYNOPSIS
    Gets a page of out-of-sync items from a local Code Repository in an AutomateNOW! instance.

    .DESCRIPTION
    Clean stages and an integral-zero acknowledgment precede strict output. Raw parent scope must agree before enrichment; exact Group Item IDs cannot return another ID or multiple rows. Clean empty lists remain valid. A diagnostic stops remaining inputs without retry; native repository behavior is not established by offline qualification.

    Gets a page of out-of-sync items from a local Code Repository in an AutomateNOW! instance. The default page is rows 0 through 100.

    .PARAMETER CodeRepository
    Mandatory [ANOWCodeRepository] object (Use Get-AutomateNOWCodeRepository to retrieve them)

    .PARAMETER startRow
    Integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .INPUTS
    You must present [ANOWCodeRepository] objects

    .OUTPUTS
    [ANOWCodeRepositoryOutOfSyncItem] objects

    .EXAMPLE
    Gets the first page of Out-Of-Sync items from a Code Repository named 'CodeRepository1'

    Get-AutomateNOWCodeRepository -Id 'CodeRepository1' | Get-AutomateNOWCodeRepositoryOutOfSyncItem

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWCodeRepositoryOutOfSyncItem[]])]
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [ANOWCodeRepository]$CodeRepository,
        [Parameter(Mandatory = $False)]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False)]
        [int32]$endRow = 100
    )

    Begin {
        $stopped=-not (Confirm-ANOWPreservationSession)
        if($stopped){Write-Warning 'There is not a clean valid token confirmed; remaining OutOfSync inputs were stopped.'}
        if($endRow -le $startRow){$stopped=$true;Write-Warning 'The endRow must be greater than the startRow. Please try again.'}
    }
    Process {
        if($stopped){return}
        try {
            $items=@(Read-ANOWCodeRepositoryCollection -Kind OutOfSync -CodeRepository $CodeRepository -StartRow $startRow -EndRow $endRow)
            $items
        }catch{$stopped=$true;Write-Warning "Code Repository OutOfSync read failed due to [$($_.Exception.Message)]; remaining inputs were stopped."}
    }
}

