    Read-AutomateNOWProcessingTemplateAction -Id '01234567-89ab-cdef-0123-456789abcdef' | Push-AutomateNOWProcessingTemplateAction -Force

    .EXAMPLE
    Pushes the first Processing Template Action from a Workflow Template named 'WorkflowTemplate1' to the top of the action list (multi-line format)

    $workflow_template = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1'
    $actions = $workflow_template | Read-AutomateNOWProcessingTemplateAction
    $action_to_push = $actions | Select-Object -First 1
    Push-AutomateNOWProcessingTemplateAction -ProcessingTemplateAction $action_to_push

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    This function is equivalent to selecting a Processing Template Action and clicking 'Move Up' until it is at the top of the Processing Template.

    This function will reset the processingActionOrder of all Processing Template Actions within the same context starting from 0

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessingTemplateAction]$ProcessingTemplateAction,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/processingTemplateAction/update'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.Id.Length -gt 0) {
            [ANOWProcessingTemplateAction]$ProcessingTemplateAction = $_
        }
        [string]$ProcessingTemplateAction_id = $ProcessingTemplateAction.id
        If ($ProcessingTemplateAction_id.Length -eq 0) {
            Write-Warning -Message "The ProcessingTemplateAction object has an empty id."
            Break
        }
        [ANOWProcessingTemplate]$ProcessingTemplate = $ProcessingTemplateAction.workflow
        If ($null -eq $ProcessingTemplate) {
            Write-Warning -Message "The ProcessingTemplateAction object does not have a workflow property set."
            Break
        }
        [string]$ProcessingTemplate_id = $ProcessingTemplate.id
        [string]$ProcessingTemplate_simpleId = $ProcessingTemplate.simpleId
        [ANOWProcessingTemplateItem]$ProcessingTemplateItem = $ProcessingTemplateAction.workflowItem
        [string]$context_description = $ProcessingTemplate_simpleId
        If ($null -ne $ProcessingTemplateItem) {
            [string]$ProcessingTemplateItem_name = $ProcessingTemplateItem.name
            [string]$context_description = "$ProcessingTemplateItem_name within $ProcessingTemplate_simpleId"
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$ProcessingTemplateAction_id to the top of $context_description's action list?")) -eq $true) {
            $Error.Clear()
            Try {
                If ($null -eq $ProcessingTemplateItem) {
                    [ANOWProcessingTemplateAction[]]$ProcessingTemplateActions = Read-AutomateNOWProcessingTemplateAction -ProcessingTemplate $ProcessingTemplate -startRow 0 -endRow 10000
                }
                Else {
                    [ANOWProcessingTemplateAction[]]$ProcessingTemplateActions = Read-AutomateNOWProcessingTemplateAction -ProcessingTemplateItem $ProcessingTemplateItem -startRow 0 -endRow 10000
                }
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Read-AutomateNOWProcessingTemplateAction failed to retrieve actions from $context_description under Push-AutomateNOWProcessingTemplateAction due to [$Message]."
                Break
            }
            If ($ProcessingTemplateActions.count -eq 0) {
                Write-Warning -Message "There are no Processing Template Actions in $context_description."
                Break
            }
            [string]$old_values = $ProcessingTemplateAction.CreateOldValues()
            [PSCustomObject[]]$ProcessingTemplateAction_collection = (@($ProcessingTemplateActions | Where-Object { $_.Id -eq $ProcessingTemplateAction_id } | Select-Object -Property id, processingActionOrder) + @($ProcessingTemplateActions | Sort-Object -Property processingActionOrder, Id | Where-Object { $_.Id -ne $ProcessingTemplateAction_id } | Select-Object -Property id, processingActionOrder))
            [int32]$ProcessingTemplateAction_order_count = $ProcessingTemplateAction_collection.count
            Write-Verbose -Message "Discovered [$ProcessingTemplateAction_order_count] Processing Template Actions within $context_description"
            [int32]$current_action_order = 0
            ForEach ($temp_action in $ProcessingTemplateAction_collection) {
                [string]$temp_ProcessingTemplateAction_id = $temp_action.id
                [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
                $BodyMetaData.Add('id', $temp_ProcessingTemplateAction_id )
                $BodyMetaData.Add('processingActionOrder', $current_action_order )
                $BodyMetaData.Add('_operationType', 'update')
                $BodyMetaData.Add('_textMatchStyle', 'exact')
                $BodyMetaData.Add('_oldValues', $old_values)
                $BodyMetaData.Add('_componentId', 'ProcessingTemplateActionList')
                $BodyMetaData.Add('_dataSource', 'ProcessingTemplateActionDataSource')
                $BodyMetaData.Add('isc_metaDataPrefix', '_')
                $BodyMetaData.Add('isc_dataFormat', 'json')
                [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
                If ($null -eq $parameters.'Body') {
                    $parameters.Add('Body', $Body)
                }
                Else {
                    $parameters.'Body' = $Body
                }
                $Error.Clear()
                Try {
                    [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on Processing Template Action ($temp_ProcessingTemplateAction_id) due to [$Message]."
                    Break
                }
                [int32]$response_code = $results.response.status
                If ($response_code -ne 0) {
                    [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                    Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                    Break
                }
                Write-Verbose -Message "Processing Template Action ($temp_ProcessingTemplateAction_id) was successfully set to processingActionOrder [$current_action_order]"
                $current_action_order++
            }
            Write-Verbose -Message "Processing Template Action ($ProcessingTemplateAction_id) should now be at the top of the action list in $context_description."
        }
    }
    End {

    }
}

