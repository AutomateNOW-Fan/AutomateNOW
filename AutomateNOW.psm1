        [Parameter(Mandatory = $false, HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [string[]]$Tags,
        [Parameter(Mandatory = $false)]
        [string]$Folder,
        [Parameter(Mandatory = $false)]
        [ANOWDesignTemplate]$DesignTemplate,
        [Parameter(Mandatory = $false)]
        [string]$Workspace,
        [Parameter(Mandatory = $false)]
        [ANOWCodeRepository]$CodeRepository,
        [Parameter(Mandatory = $true, ParameterSetName = 'NodeTask')]
        [Parameter(Mandatory = $true, ParameterSetName = 'MonitorTask')]
        [Parameter(Mandatory = $true, ParameterSetName = 'SensorTask')]
        [ANOWProcessingTemplate_serverNodeType]$ServerNodeType,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
        Write-Warning -Message "There is not a valid token confirmed."
        Break
    }
    ## Begin warning ##
    ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
    $Error.Clear()
    Try {
        [boolean]$TaskTemplate_exists = ($null -ne (Get-AutomateNOWTaskTemplate -Id $Id))
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Get-AutomateNOWTaskTemplate failed to check if the Task Template [$Id] already existed due to [$Message]."
        Break
    }
    If ($TaskTemplate_exists -eq $true) {
        [string]$current_domain = $anow_session.header.domain
        Write-Warning -Message "There is already a Task Template named [$Id] in [$current_domain]."
        Break
    }
    ## End warning ##
    [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
    $BodyMetaData.Add('id', $Id)
    If ($MonitorType.Length -gt 0) {
        [string[]]$ValidServerNodeTypes = Resolve-AutomateNOWMonitorType2ServerNodeType -MonitorType $MonitorType
        [string]$TaskType = $MonitorType
        [string]$processingType = 'SERVICE'
        [string]$old_values = ('{"processingType":"' + $processingType + '","monitorType":"' + $MonitorType + '","serverNodeType":"' + $ServerNodeType + '"}')
        $BodyMetaData.Add('serviceType', 'MONITOR')
        $BodyMetaData.Add('monitorType', $MonitorType)
    }
    ElseIf ($SensorType.Length -gt 0) {
        [string[]]$ValidServerNodeTypes = Resolve-AutomateNOWSensorType2ServerNodeType -SensorType $SensorType
        [string]$TaskType = $SensorType
        [string]$processingType = 'SERVICE'
        [string]$old_values = ('{"processingType":"' + $processingType + '","sensorType":"' + $SensorType + '","serverNodeType":"' + $ServerNodeType + '"}')
        $BodyMetaData.Add('serviceType', 'SENSOR')
        $BodyMetaData.Add('sensorType', $SensorType)
    }
    Else {
        [string]$processingType = 'TASK'
        [string]$old_values = ('{"processingType":"' + $processingType + '","taskType":"' + $TaskType + '","serverNodeType":"' + $ServerNodeType + '"}')
        If ($InternalTaskType.Length -gt 0) {
            [string]$TaskType = $InternalTaskType
            [string]$ServerNodeType = 'INTERNAL'
            [string[]]$ValidServerNodeTypes = @($ServerNodeType)
        }
        Else {
            [string]$TaskType = $TaskType
            [string[]]$ValidServerNodeTypes = Resolve-AutomateNOWTaskType2ServerNodeType -TaskType $TaskType
        }
        $BodyMetaData.Add('taskType', $TaskType)
    }
    [int32]$ValidServerNodeTypesCount = $ValidServerNodeTypes.Count
    If ($ValidServerNodeTypesCount -eq 0) {
        Write-Warning -Message "The ServerNodeType lookup failed!"
        Break
    }
    Else {
        If ($ServerNodeType -notin $ValidServerNodeTypes -and $InternalTaskType.Length -eq 0) {
            [string]$ValidServerNodeTypesDisplay = $ValidServerNodeTypes -join ', '
            Write-Warning -Message "[$ServerNodeType] is not a valid server node type for a [$TaskType] task. Please use one of these instead: $ValidServerNodeTypesDisplay"
            Break
        }
    }
    $BodyMetaData.Add('processingType', $processingType)
    $BodyMetaData.Add('serverNodeType', $ServerNodeType)
    If ($Description.Length -gt 0) {
        $BodyMetaData.Add('description', $Description)
    }
    If ($Tags.Count -gt 0) {
        [int32]$current_tag = 1
        ForEach ($tag_id in $Tags) {
            $Error.Clear()
            Try {
                [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] running under New-AutomateNOWTaskTemplate due to [$Message]"
                Break
            }
            If ($tag_object.simpleId.length -eq 0) {
                Throw "New-AutomateNOWTaskTemplate has detected that the tag [$tag_id] does not appear to exist."
            }
            ElseIf (($tag_object.simpleId -eq $tag_id) -and ($tag_object.simpleId -cne $tag_id)) {
                [string]$tag_object_simpleId = $tag_object.simpleId
                Throw "Wait! Tags are case-sensitive. [$tag_object_simpleId] is not the same case as [$tag_id]. Please check more carefully..."
            }
            [string]$tag_name_sequence = ('tags' + $current_tag)
            $BodyMetaData.Add($tag_name_sequence, $tag_id)
            $current_tag++
        }
    }
    If ($Folder.Length -gt 0) {
        $Error.Clear()
        Try {
            [ANOWFolder]$folder_object = Get-AutomateNOWFolder -Id $Folder
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWFolder failed to confirm that the folder [$Folder] actually existed while running under New-AutomateNOWTaskTemplate due to [$Message]"
            Break
        }
        If ($folder_object.simpleId.Length -eq 0) {
            Throw "Get-AutomateNOWFolder failed to locate the Folder [$Folder] running under New-AutomateNOWTaskTemplate."
        }
        [string]$folder_display = $folder_object | ConvertTo-JSON -Compress -Depth 100
        Write-Verbose -Message "Adding folder $folder_display to [ANOWTaskTemplate] [$Id]"
        $BodyMetaData.Add('folder', $Folder)
    }
    If ($DesignTemplate.id.Length -gt 0) {
        [string]$DesignTemplateId = $DesignTemplate.id
        Write-Verbose -Message "Adding Design Template $DesignTemplateId to [ANOWServiceManagerTemplate] [$Id]"
        $BodyMetaData.Add('designTemplate', $DesignTemplateId)
    }
    If ($Workspace.Length -gt 0) {
        $Error.Clear()
        Try {
            [ANOWWorkspace]$workspace_object = Get-AutomateNOWWorkspace -Id $Workspace
        }
        Catch {
            [string]$Message = $_.Exception.Message
            [string]$Workspace_id = $Workspace.Id
            Write-Warning -Message "Get-AutomateNOWWorkspace failed to confirm that the workspace [$Workspace_id] actually existed while running under New-AutomateNOWTaskTemplate due to [$Message]"
            Break
        }
        If ($workspace_object.simpleId.Length -eq 0) {
            Throw "Get-AutomateNOWWorkspace failed to locate the Workspace [$Workspace] running under New-AutomateNOWTaskTemplate."
        }
        [string]$workspace_display = $workspace_object | ConvertTo-JSON -Compress -Depth 100
        Write-Verbose -Message "Adding workspace $workspace_display to [ANOWTaskTemplate] [$Id]"
        $BodyMetaData.Add('workspace', $Workspace)
    }
    If ($CodeRepository.id.Length -gt 0) {
        [string]$CodeRepository_Id = $CodeRepository.id
        $Error.Clear()
        Try {
            [ANOWCodeRepository]$code_repository_object = Get-AutomateNOWCodeRepository -Id $CodeRepository_Id
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWCodeRepository failed to confirm that the code repository [$CodeRepository_Id] existed under New-AutomateNOWTaskTemplate due to [$Message]"
            Break
        }
        If ($code_repository_object.simpleId.Length -eq 0) {
            Throw "Get-AutomateNOWCodeRepository failed to locate the Code Repository [$CodeRepository_Id] under New-AutomateNOWTaskTemplate."
        }
        Write-Verbose -Message "Adding Task Template [$Id] to Code Repository $CodeRepository_Id"
        $BodyMetaData.'codeRepository' = $CodeRepository_Id
    }
    $BodyMetaData.'_textMatchStyle' = 'exact'
    $BodyMetaData.'_operationType' = 'add'
    $BodyMetaData.'_oldValues' = $old_values
    $BodyMetaData.'_componentId' = 'ProcessingTemplateCreateWindow_form'
    $BodyMetaData.'_dataSource' = 'ProcessingTemplateDataSource'
    $BodyMetaData.'isc_metaDataPrefix' = '_'
    $BodyMetaData.'isc_dataFormat' = 'json'
    [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
    [hashtable]$parameters = @{}
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    [string]$command = '/processingTemplate/create'
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'POST')
    $parameters.Add('Body', $Body)
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    [string]$parameters_display = $parameters | ConvertTo-JSON -Compress -Depth 100
    $Error.Clear()
    Try {
        [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] with parameters $parameters_display due to [$Message]."
        Break
    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
        Break
    }
    $Error.Clear()
    Try {
        [ANOWTaskTemplate]$TaskTemplate = $results.response.data | Select-Object -First 1
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Failed to create [ANOWTaskTemplate] object due to [$Message]."
        Break
    }
    If ($TaskTemplate.id.Length -eq 0) {
        Write-Warning -Message "The newly created [ANOWTaskTemplate] is empty!"
        Break
    }
    $Error.Clear()
    Try {
        [ANOWTaskTemplate]$TaskTemplate = Get-AutomateNOWTaskTemplate -Id $Id
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Get-AutomateNOWTaskTemplate failed to confirm that the [ANOWTaskTemplate] object [$Id] was created due to [$Message]."
        Break
    }
    If ($Quiet -ne $true) {
        Return $TaskTemplate
    }
}

Function Remove-AutomateNOWTaskTemplate {
    <#
    .SYNOPSIS
    Removes a Task Template from an AutomateNOW! instance

    .DESCRIPTION
    Removes a Task Template from an AutomateNOW! instance

    .PARAMETER TaskTemplate
    An [ANOWTaskTemplate] object representing the Task Template to be deleted.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    ONLY [ANOWTaskTemplate] objects are accepted (including from the pipeline)

    .OUTPUTS
    No success-stream object. A numeric-zero acknowledgment is reported with Write-Verbose. Refusal, diagnostics or uncertain acknowledgment stop subsequent pipeline removals without retry or automatic reference deletion.

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate01' | Remove-AutomateNOWTaskTemplate

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate01', 'TaskTemplate02' | Remove-AutomateNOWTaskTemplate

    .EXAMPLE
    @( 'Task1', 'Task2', 'Task3') | Get-AutomateNOWTaskTemplate | Remove-AutomateNOWTaskTemplate

    .EXAMPLE
    Get-AutomateNOWTaskTemplate | ? { $_.serverTaskType -eq 'LINUX' } | Remove-AutomateNOWTaskTemplate

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $false, ValueFromPipeline = $True)]
        [ANOWTaskTemplate]$TaskTemplate,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'A valid session was not confirmed without diagnostics. No template removals were submitted.'
        }
        [string]$command = '/processingTemplate/delete'
        [hashtable]$parameters = @{
            Command = $command
            Method = 'POST'
            ContentType = 'application/x-www-form-urlencoded; charset=UTF-8'
        }
        if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
    }
    Process {
        if ($batchStopped) { return }
        If ($_.id.Length -gt 0) {
            [ANOWTaskTemplate]$TaskTemplate = $_
        }
        [string]$TaskTemplate_id = $TaskTemplate.id
        if ($TaskTemplate_id.Length -eq 0) {
            $batchStopped = $true
            Write-Warning 'An object with an empty Id was passed to this function. Subsequent removals are stopped.'
            return
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($TaskTemplate_id)")) -eq $true) {
            $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWTemplateRemovalBody) -OperationParameters @{
                Template = $TaskTemplate
                ComponentId = 'ProcessingTemplateList'
            }
            if (-not $prepared.Succeeded -or $prepared.Data.Count -ne 1 -or
                $prepared.Data[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($prepared.Data[0])) {
                $batchStopped = $true
                Write-Warning 'Task template removal preparation failed or emitted a diagnostic. No request was submitted for this input; subsequent removals are stopped.'
                return
            }
            $parameters.Body = $prepared.Data[0]
            $request = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if (-not $request.Succeeded) {
                $batchStopped = $true
                Write-Warning 'Task template removal failed or emitted a diagnostic. Its server-side outcome may be uncertain; subsequent removals are stopped and no request is retried.'
                return
            }
            $results = if ($request.Data.Count -eq 1) { $request.Data[0] } else { $null }
            if (-not (Test-ANOWB2Response -Envelopes $request.Data -AcknowledgmentOnly)) {
                $batchStopped = $true
                if ($null -ne $results -and $results.response.data -is [string] -and
                    $results.response.data -match 'Object may still be in use') {
                    Write-Warning 'Task template is still in use and cannot be removed. Use Find-AutomateNOWObjectReferral to inspect its references. Subsequent removals are stopped; no references were removed.'
                }
                else {
                    Write-Warning 'Task template removal did not return one numeric-zero acknowledgment. Its server-side outcome may be uncertain; subsequent removals are stopped and no request is retried.'
                }
                return
            }
            Write-Verbose -Message "Task $TaskTemplate_id successfully removed"
        }
    }
    End {
    }
}

Function Copy-AutomateNOWTaskTemplate {
    <#
    .SYNOPSIS
    Copies a Task Template from an AutomateNOW! instance

    .DESCRIPTION
    Copies a Task Template from an AutomateNOW! instance. AutomateNOW object id can never be changed, but we can copy the object to a new id and it will include all of the items therein.

    .PARAMETER TaskTemplate
    Mandatory [ANOWTaskTemplate] object to be copied.

    .PARAMETER NewId
    Mandatory string indicating the new id or name of the Task Template. The Id is the same as a primary key, it must be unique. The console will provide the old Id + '_COPY' in the UI when making a copy. The Id is limited to 1024 characters.

    .PARAMETER Description
    Optional description of the Task Template (may not exceed 255 characters). You may send an empty string here to ensure that the description is blanked out. Do not use this parameter if your intention is to keep the description from the previous Task Template.

    .PARAMETER UnsetDescription
    Optional switch that will ensure that the newly created Task Template will not carry over its previous description.

    .PARAMETER Tags
    Optional string array containing the CASE-SENSITIVE id's of the tags to assign to the new Task Template.

    .PARAMETER UnsetTags
    Optional switch that will purposely omit the previously existing tags on the new copy of the Task Template. You can still specify new tags with -Tags but the old previous ones will not be carried over. In the UI, this is accomplished by clicking the existing tags off.

    .PARAMETER Folder
    Optional name of the folder to place the Task Template into. The UnsetFolder parameter overrides this setting.

    .PARAMETER UnsetFolder
    Optional switch that will ensure that the newly created Task Template will not be placed in a folder.

    .PARAMETER Force
    Force the copy without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly created object.

    .INPUTS
    ONLY [ANOWTaskTemplate] objects are accepted. Pipeline support is intentionally unavailable.

    .OUTPUTS
    A verified [ANOWTaskTemplate] is returned after acknowledgment, exact destination identity and strict conversion. Quiet suppresses this object while retaining validation.

    .EXAMPLE
    Creates a copy of a TaskTemplate named 'TaskTemplate1' to 'TaskTemplate2' (multi-line)

    $task_template = Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1'
    Copy-AutomateNOWTaskTemplate -TaskTemplate $task_template -NewId 'TaskTemplate2'

    .EXAMPLE
    Creates a copy of a TaskTemplate named 'TaskTemplate1' to 'TaskTemplate2' (one-liner)

    Copy-AutomateNOWTaskTemplate -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1') -NewId 'TaskTemplate2'

    .NOTES
    Collision, tag, preparation and request diagnostics stop the copy without retry. After dispatch, an unverified result is uncertain and a destination may already exist. Explicitly empty Description is sent as empty; omission retains the source description. Inherited tags are preserved literally unless UnsetTags is selected.

    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The new id (name) of the Task Template must be unique (per domain). It may consist only of letters, numbers, underscore, dot or hyphen.
    #>
    [OutputType([ANOWTaskTemplate])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWTaskTemplate]$TaskTemplate,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,1024}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetDescription,
        [Parameter(Mandatory = $false)]
        [string[]]$Tags,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetTags,
        [Parameter(Mandatory = $false)]
        [string]$Folder,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetFolder,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        $batchStopped = $false
        $copyContext = $null
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'Template copy session validation failed or emitted a diagnostic. No request was submitted; the copy was stopped.'
        }
    }
    Process {
        if ($batchStopped) { return }
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Copy '$($TaskTemplate.id)' to '$NewId'")) -eq $true) {
            $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-ANOWTemplateCopyContext) -OperationParameters @{Kind='Task';Source=$TaskTemplate;NewId=$NewId}
            if (-not $checked.Succeeded -or $checked.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Template copy source or collision check failed or emitted a diagnostic. No request was submitted; the copy was stopped.'
                return
            }
            $copyContext = $checked.Data[0]
            $options = @{};foreach ($key in $PSBoundParameters.Keys) { $options[$key]=$PSBoundParameters[$key] }
            $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWTemplateCopyBody) -OperationParameters @{Context=$copyContext;Options=$options}
            if (-not $prepared.Succeeded -or $prepared.Data.Count -ne 1 -or $prepared.Data[0] -isnot [string]) {
                $batchStopped = $true
                Write-Warning 'Template copy preparation failed or emitted a diagnostic. No request was submitted; the copy was stopped.'
                return
            }
            $parameters = @{Command='/processingTemplate/copy';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$prepared.Data[0]}
            if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure=$true }
            $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            $verified = if ($sent.Succeeded) { Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWTemplateCopyResponse) -OperationParameters @{Envelopes=$sent.Data;Context=$copyContext} } else { $null }
            if ($null -eq $verified -or -not $verified.Succeeded -or $verified.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Template copy acknowledgment or output was not verified. The outcome is uncertain and a destination may already have been created; do not repeat the request. The copy was stopped.'
                return
            }
            Write-Verbose "Task Template '$NewId' was successfully copied"
            if (-not $Quiet) { $verified.Data[0] }
        }
    }
    End {}
}

Function Rename-AutomateNOWTaskTemplate {
    <#
    .SYNOPSIS
    Renames a Task Template from an AutomateNOW! instance

    .DESCRIPTION
    Performs a pseudo-rename operation of a Task Template from an AutomateNOW! instance by copying it first and then deleting the source. This function merely combines Copy-AutomateNOWTaskTemplate and Remove-AutomateNOWTaskTemplate therefore it is to be considered destructive.

    .PARAMETER TaskTemplate
    An [ANOWTaskTemplate] object representing the Task Template to be renamed.

    .PARAMETER NewId
    Mandatory string indicating the new id or name of the Task Template. The Id is the same as a primary key, it must be unique. The console will provide the old Id + '_COPY' in the UI when making a copy. The Id is limited to 1024 characters.

    .PARAMETER Force
    Force the renaming without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly renamed object.

    .INPUTS
    ONLY [ANOWTaskTemplate] objects are accepted. There is intentionally no support for the pipeline.

    .OUTPUTS
    The newly renamed [ANOWTaskTemplate] object will be returned.

    .EXAMPLE
    $task_template = Get-AutomateNOWTaskTemplate -Id 'TaskTemplate01'
    Rename-AutomateNOWTaskTemplate -TaskTemplate $task_template -NewId 'Task_TEMPLATE_01'

    .EXAMPLE
    Rename-AutomateNOWTaskTemplate -TaskTemplate (Get-AutomateNOWTaskTemplate -Id 'TaskTemplate01') -NewId 'Task_TEMPLATE_01'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    When renaming, you may only specify a different Id (name).

    This action will be blocked if any existing referrals are found on the object.
    #>
    [OutputType([ANOWTaskTemplate])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWTaskTemplate]$TaskTemplate,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,1024}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        ## Begin standard warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$new_task_template_exists = ($null -ne (Get-AutomateNOWTaskTemplate -Id $NewId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWTaskTemplate failed to check if the Task Template [$NewId] already existed due to [$Message]."
            Break
        }
        If ($new_task_template_exists -eq $true) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is already a Task Template named [$NewId] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        [string]$TaskTemplate_id = $TaskTemplate.id
        $Error.Clear()
        Try {
            [boolean]$old_Task_template_exists = ($null -ne (Get-AutomateNOWTaskTemplate -Id $TaskTemplate.simpleId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWTaskTemplate failed to check if the Task Template [$TaskTemplate_id] already existed due to [$Message]."
            Break
        }
        If ($old_Task_template_exists -eq $false) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is not a Task Template named [$TaskTemplate_id] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        ## End standard warning ##
        ## Begin referrals warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [int32]$referrals_count = Find-AutomateNOWObjectReferral -TaskTemplate $TaskTemplate -Sum | Select-Object -Expandproperty referrals
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Find-AutomateNOWObjectReferral failed to extract the referrals on Task Template [$TaskTemplate_id] due to [$Message]."
            Break
        }
        If ($referrals_count -gt 0) {
            Write-Warning -Message "Unfortunately, you cannot rename a Task Template that has referrals. This is because the rename is not actually renaming but copying anew and deleting the old. Please, use the Find-AutomateNOWObjectReferral function to identify referrals and remove them."
            Break
        }
        Else {
            Write-Verbose -Message "The Task Template [$TaskTemplate_id] does not have any referrals. It is safe to proceed."
        }
    }
    Process {
        If ($PermissionToProceed -ne $false) {
            If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($TaskTemplate_id)")) -eq $true) {
                $Error.Clear()
                Try {
                    [ANOWTaskTemplate]$new_task_template = Copy-AutomateNOWTaskTemplate -TaskTemplate $TaskTemplate -NewId $NewId -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Copy-AutomateNOWTaskTemplate failed to create a new Task Template [$NewId] as Part 1 of the renaming process due to [$Message]."
                    Break
                }
                If ($new_Task_template.simpleId -eq $NewId) {
                    Write-Verbose -Message "Part 1: Task Template [$TaskTemplate_id] successfully copied to [$NewId]"
                }
                Else {
                    Write-Warning -Message "The first phase (Copy-AutomateNOWTaskTemplate) failed."
                    Break
                }
                $Error.Clear()
                Try {
                    Remove-AutomateNOWTaskTemplate -TaskTemplate $TaskTemplate -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Remove-AutomateNOWTaskTemplate failed to remove [$TaskTemplate_id] as Part 2 of the renaming process due to [$Message]."
                    Break
                }
                Write-Verbose -Message "Part 2: Task Template [$TaskTemplate_id] removed"
                Write-Verbose -Message "Task [$TaskTemplate_id] successfully renamed to [$NewId]"
                If ($Quiet -ne $true) {
                    Return $new_task_template
                }
            }
        }
        Else {
            Write-Warning -Message "No action was taken because either the source object didn't exist or the new object already existed"
        }
    }
    End {
    }
}

Function ConvertTo-AutomateNOWStartedTask {
    [CmdletBinding()]
    Param(
        [AllowNull()][object]$InputObject,
        [switch]$Synchronous
    )
    $result = [pscustomobject][ordered]@{
        Success = $false
        Task = $null
        RunId = $null
        FailureCode = $null
        FieldName = $null
        ExpectedType = $null
    }
    try {
        $values = [Collections.Generic.Dictionary[string,object]]::new([StringComparer]::OrdinalIgnoreCase)
        if ($InputObject -is [Collections.IDictionary]) {
            foreach ($key in $InputObject.Keys) {
                if ($key -isnot [string]) { $result.FailureCode = 'row-member-invalid'; return $result }
                if ($values.ContainsKey($key)) { $result.FailureCode = 'row-field-duplicate'; return $result }
                $values.Add($key, $InputObject[$key])
            }
        }
        elseif ($null -ne $InputObject -and $InputObject.GetType() -eq [System.Management.Automation.PSCustomObject]) {
            foreach ($property in $InputObject.PSObject.Properties) {
                if ($property.MemberType -ne [System.Management.Automation.PSMemberTypes]::NoteProperty) {
                    $result.FailureCode = 'row-member-invalid'; return $result
                }
                if ($values.ContainsKey($property.Name)) { $result.FailureCode = 'row-field-duplicate'; return $result }
                $values.Add($property.Name, $property.Value)
            }
        }
        else { $result.FailureCode = 'row-shape-invalid'; return $result }

        if (-not $values.ContainsKey('id')) { $result.FailureCode = 'run-id-missing'; return $result }
        $idValue = $values['id']
        $idText = $null
        if ($idValue -is [string]) { $idText = $idValue }
        elseif ($idValue -is [sbyte] -or $idValue -is [byte] -or $idValue -is [int16] -or
            $idValue -is [uint16] -or $idValue -is [int32] -or $idValue -is [uint32] -or
            $idValue -is [int64] -or $idValue -is [uint64]) {
            $idText = [Convert]::ToString($idValue, [Globalization.CultureInfo]::InvariantCulture)
        }
        [long]$runId = 0
        if ($null -eq $idText -or $idText -cnotmatch '^[0-9]+$' -or
            -not [long]::TryParse($idText, [Globalization.NumberStyles]::None, [Globalization.CultureInfo]::InvariantCulture, [ref]$runId) -or
            $runId -le 0) { $result.FailureCode = 'run-id-invalid'; return $result }
        $result.RunId = $runId

        $properties = [Collections.Generic.Dictionary[string,Reflection.PropertyInfo]]::new([StringComparer]::OrdinalIgnoreCase)
        foreach ($property in [ANOWTask].GetProperties([Reflection.BindingFlags]'Public,Instance')) {
            if ($property.CanWrite -and $property.GetIndexParameters().Count -eq 0) { $properties.Add($property.Name, $property) }
        }
        if ($Synchronous) {
            if (-not $values.ContainsKey('processingType')) { $result.FailureCode = 'synchronous-processing-type-invalid'; return $result }
            $classification = $values['processingType']
            $classificationType = $properties['processingType'].PropertyType
            $enumType = [Nullable]::GetUnderlyingType($classificationType)
            if ($null -eq $enumType) { $enumType = $classificationType }
            $isTask = $classification -is [string] -and $classification -ceq 'TASK'
            if (-not $isTask -and $null -ne $classification -and $classification.GetType() -eq $enumType) {
                $isTask = [Enum]::GetName($enumType, $classification) -ceq 'TASK'
            }
            if (-not $isTask) { $result.FailureCode = 'synchronous-processing-type-invalid'; return $result }
        }

        $staged = [Collections.Generic.Dictionary[string,object]]::new([StringComparer]::Ordinal)
        foreach ($name in $values.Keys) {
            if (-not $properties.ContainsKey($name)) { $result.FailureCode = 'row-field-unknown'; return $result }
            $property = $properties[$name]
            $value = $values[$name]
            $converted = $null
            $canConvert = $false
            if ($null -eq $value -and $property.PropertyType.IsValueType -and
                $null -eq [Nullable]::GetUnderlyingType($property.PropertyType)) {
                $canConvert = $false
            }
            else {
                try {
                    $canConvert = [System.Management.Automation.LanguagePrimitives]::TryConvertTo(
                        $value, $property.PropertyType, [Globalization.CultureInfo]::InvariantCulture, [ref]$converted)
                }
                catch { $canConvert = $false }
            }
            if (-not $canConvert) {
                $result.FailureCode = 'field-conversion-failed'
                $result.FieldName = $property.Name
                $result.ExpectedType = $property.PropertyType.FullName
                return $result
            }
            $staged.Add($property.Name, $converted)
        }
        # Assign the complete validated row directly. The ANOWProcessing copy
        # constructor omits fields and must not be used as a conversion bridge.
        $task = [ANOWTask]::new()
        foreach ($name in $staged.Keys) {
            try { $task.$name = $staged[$name] }
            catch {
                $result.FailureCode = 'field-conversion-failed'
                $result.FieldName = $properties[$name].Name
                $result.ExpectedType = $properties[$name].PropertyType.FullName
                return $result
            }
        }
        $result.Task = $task
        $result.Success = $true
        return $result
    }
    catch {
        $result.Task = $null
        $result.FailureCode = 'task-construction-failed'
        $result.FieldName = $null
        $result.ExpectedType = $null
        return $result
    }
}

Function Start-AutomateNOWTaskTemplate {
    <#
    .SYNOPSIS
    Starts a Task Template from an AutomateNOW! instance

    .DESCRIPTION
    Starts a Task Template from an AutomateNOW! instance

    .PARAMETER TaskTemplate
    An [ANOWTaskTemplate] object representing the Task Template to be started.

    .PARAMETER TaskTemplateId
    A string representing the Id of the Task Template. Do not include the domain prefix.

    .PARAMETER TaskParameters
    An optional [hashtable] containing the parameters to start the Task Template with. Example: @{"parameter1"="ABC";"parameter2"="123";}

    .PARAMETER Synchronous
    Uses /executeProcessingSync instead of /executeNow and returns the actual task processing object with its real run ID, rather than an observer or trigger run ID. This switch is intentional when the caller needs the task run ID; it does not wait for the task to complete. Without this switch, routing remains /executeNow.

    .PARAMETER UseAutomaticName
    A switch parameter that is ENABLED BY DEFAULT. You do not need to enable this as it is defaulted to on. This parameter simulates the default format of the executed task name (see 'Name' below)

    .PARAMETER Name
    Name assigned to the user trigger for this execution request. If omitted, a name is generated for each input template. With -Synchronous, the returned child task can have its own template-derived name; inspect the associated user trigger to verify the requested name.

    .PARAMETER Description
    Optional description assigned to the user trigger (may not exceed 255 characters). With -Synchronous, the returned child task can retain its template description rather than this trigger description.

    .PARAMETER Tags
    Optional string array containing the CASE-SENSITIVE id's of the tags to assign to the new Task.

    .PARAMETER Folder
    Optional name of the folder to place the executed task into.

    .PARAMETER ProcessingTimestamp
    Optional timestamp sent with the execution request. Leave this blank to use the current UTC timestamp. The accepted parameter format is a UTC datestamp string: 2029-12-31T23:59:59.999. The user trigger and child task can expose different processing timestamps; the child task can use a normalized processing date. Do not use child-task timestamp equality to verify the trigger request.

    .PARAMETER DelayedStartTime
    Optional string that allows processing items to start on a specific date or time or delay the execution for a period ranging from days to seconds. Example 1: 2029-12-31, Example 2: 2029-12-31 23:59:59, Example 3: 23:59:59

    .PARAMETER TimeZone
    Optional [ANOWTimeZone] object that modifies (it is unknown exactly what this property modifies since it is not defined in the documentation yet)

    .PARAMETER Priority
    Optional integer between 0 and 1000 to specify the priority of the executed task. Defaults to 0.

    .PARAMETER Hold
    Optional switch to set the 'On Hold' property of the executed task to enabled. This is $false by default but in the console the checkbox is enabled.

    .PARAMETER VerboseMode
    Optional switch that will cause the Workflow to "produce more events with minor performance impact"

    .PARAMETER ForceLoad
    Optional switch that overrides any 'Ignore Condition' that might exist on the Task Template

    .PARAMETER Quiet
    Switch parameter to silence the newly created [ANOWTask] object

    .INPUTS
    ONLY [ANOWTaskTemplate] objects are accepted (including from the pipeline)

    .OUTPUTS
    An [ANOWTask] object validated from the complete returned row. With -Synchronous, its id is the actual task run ID. With -Quiet, no task object is emitted. A failed response conversion does not mean the execution request was undone; do not repeat the start automatically.

    .EXAMPLE
    Starts a Task Template by name

    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Start-AutomateNOWTaskTemplate

    .EXAMPLE
    Starts a Task Template by name with parameters

    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Start-AutomateNOWTaskTemplate -TaskParameters @{"parameter1"="abc";"parameter2"="123";}

    .EXAMPLE
    Starts a Task Template by name with tags, a custom description and the Hold+ForceLoad flags enabled

    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Start-AutomateNOWTaskTemplate -Name 'Manual Execution - TaskTemplate1' -Tags 'Tag1', 'Tag2' -ForceLoad -Hold -Priority 100 -Description 'My executed task'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Avoid using the -Name parameter unless you really need to use it and know what you're doing. If -Name is not supplied, the automatic name will be generated (i.e. -UseAutomaticName) which simulates the behavior of the console.

    Use Wait-AutomateNOWTask (Wait-AutomateNOWProcessing) with the returned task when completion must be awaited. -Synchronous selects the actual task run ID; it does not wait for completion.

    #>
    [OutputType([ANOWTask])]
    [CmdletBinding(DefaultParameterSetName = 'Object')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Object', ValueFromPipeline = $True)]
        [ANOWTaskTemplate]$TaskTemplate,
        [Parameter(Mandatory = $true, ParameterSetName = 'Id')]
        [string]$TaskTemplateId,
        [Parameter(Mandatory = $false)]
        [hashtable]$TaskParameters,
        [Parameter(Mandatory = $false)]
        [switch]$Synchronous,
        [Parameter(Mandatory = $false)]
        [boolean]$UseAutomaticName = $true,
        [Parameter(Mandatory = $false)]
        [string]$Name,
        [Parameter(Mandatory = $false, HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [string[]]$Tags,
        [Parameter(Mandatory = $false)]
        [string]$Folder = '',
        [ValidateScript({ $_ -match '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}' })]
        [Parameter(Mandatory = $false)]
        [string]$ProcessingTimestamp,
        [ValidateScript({ $_ -match '([0-9]{4}-[0-9]{2}-[0-9]{2}){0,}( {0,}[0-9]{2}:[0-9]{2}:[0-9]{2}){0,}' })]
        [Parameter(Mandatory = $false)]
        [string]$DelayedStartTime,
        [Parameter(Mandatory = $false)]
        [ANOWTimeZone]$TimeZone,
        [ValidateRange(0, 1000)]
        [Parameter(Mandatory = $false)]
        [int32]$Priority = 0,
        [Parameter(Mandatory = $false)]
        [switch]$Hold,
        [Parameter(Mandatory = $false)]
        [switch]$VerboseMode,
        [Parameter(Mandatory = $false)]
        [switch]$ForceLoad,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        $startStopped = $false
        # Every dependency runs inside this stream boundary. A diagnostic cannot
        # become a task result, and original error records are never re-emitted.
        $invokeStartStage = {
            param([scriptblock]$Action)
            $VerbosePreference = 'Continue'
            $DebugPreference = 'Continue'
            $InformationPreference = 'Continue'
            $ProgressPreference = 'SilentlyContinue'
            $WarningPreference = 'Stop'
            $ErrorActionPreference = 'Stop'
            $failed = $false
            $completed = $false
            $records = @()
            try {
                # Several maintained helpers use Break. Contain it here instead
                # of allowing it to escape the caller's processing pipeline.
                do {
                    $records = @(& $Action *>&1)
                    $completed = $true
                } while ($false)
            }
            catch { $failed = $true }
            if (-not $completed) { $failed = $true }
            $outputs = [Collections.Generic.List[object]]::new()
            foreach ($record in $records) {
                if ($record -is [System.Management.Automation.WarningRecord] -or $record -is [System.Management.Automation.ErrorRecord]) {
                    $failed = $true
                }
                elseif ($record -isnot [System.Management.Automation.VerboseRecord] -and
                    $record -isnot [System.Management.Automation.DebugRecord] -and
                    $record -isnot [System.Management.Automation.InformationRecord]) { $outputs.Add($record) }
            }
            [pscustomobject]@{ Success = -not $failed; Values = $outputs.ToArray() }
        }
        $getStartOwnValue = {
            param([object]$Object, [string]$Name)
            $found = $false
            $value = $null
            if ($Object -is [Collections.IDictionary]) {
                foreach ($key in $Object.Keys) {
                    if ($key -is [string] -and [string]::Equals($key, $Name, [StringComparison]::OrdinalIgnoreCase)) {
                        if ($found) { return [pscustomobject]@{ Success = $false; Value = $null } }
                        $found = $true
                        $value = $Object[$key]
                    }
                }
            }
            elseif ($null -ne $Object -and $Object.GetType() -eq [System.Management.Automation.PSCustomObject]) {
                foreach ($property in $Object.PSObject.Properties) {
                    if ([string]::Equals($property.Name, $Name, [StringComparison]::OrdinalIgnoreCase)) {
                        if ($found -or $property.MemberType -ne [System.Management.Automation.PSMemberTypes]::NoteProperty) {
                            return [pscustomobject]@{ Success = $false; Value = $null }
                        }
                        $found = $true
                        $value = $property.Value
                    }
                }
            }
            [pscustomobject]@{ Success = $found; Value = $value }
        }
        $writeStartFailure = {
            param([string]$Stage, [bool]$Submitted, [Nullable[long]]$RunId, [object]$Conversion)
            $message = 'Task start stopped at stage ' + $Stage + '.'
            if ($null -ne $RunId -and $RunId -gt 0) { $message += ' Returned run ID: ' + $RunId.ToString([Globalization.CultureInfo]::InvariantCulture) + '.' }
            if ($null -ne $Conversion -and $Conversion.FailureCode -ceq 'field-conversion-failed') {
                foreach ($property in [ANOWTask].GetProperties([Reflection.BindingFlags]'Public,Instance')) {
                    if ($Conversion.FieldName -ceq $property.Name -and $Conversion.ExpectedType -ceq $property.PropertyType.FullName) {
                        $message += ' Field ' + $property.Name + ' could not be converted to ' + $property.PropertyType.FullName + '.'
                        break
                    }
                }
            }
            if ($Submitted) { $message += ' A start request was attempted; a run may already exist. Do not repeat the start.' }
            else { $message += ' No start request was sent.' }
            Write-Warning -Message $message
        }
        $sessionResult = & $invokeStartStage { Confirm-AutomateNOWSession -Quiet }
        if (-not $sessionResult.Success -or $sessionResult.Values.Count -ne 1 -or
            $sessionResult.Values[0] -isnot [bool] -or -not $sessionResult.Values[0]) {
            $startStopped = $true
            & $writeStartFailure 'session' $false $null $null
        }
        if ($Synchronous) { $command = '/processing/executeProcessingSync' }
        else { $command = '/processing/executeNow' }
    }
    Process {
        if ($startStopped) { return }
        $submitted = $false
        $safeRunId = $null
        $failedConversion = $null
        $stage = 'request'
        try {
            $domain = [string]$anow_session.current_domain
            if ($null -ne $TaskTemplate -and -not [string]::IsNullOrEmpty($TaskTemplate.id)) {
                $TaskTemplate_id = $TaskTemplate.id
                $TaskTemplate_simpleId = $TaskTemplate.simpleId
            }
            elseif (-not [string]::IsNullOrEmpty($TaskTemplateId)) {
                $TaskTemplate_id = '[' + $domain + ']' + $TaskTemplateId
                $TaskTemplate_simpleId = $TaskTemplateId
            }
            else { throw 'task-start-input-invalid' }
            $parameters = @{
                Command = $command
                Method = 'POST'
                ContentType = 'application/x-www-form-urlencoded; charset=UTF-8'
            }
            if ($anow_session.NotSecure -eq $true) { $parameters.Add('NotSecure', $true) }
            $BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.Add('id', $TaskTemplate_id)
            $BodyMetaData.Add('runId', $TaskTemplate_id)
            $BodyMetaData.Add('priority', $Priority)
            if ($null -ne $TimeZone) { $BodyMetaData.Add('timeZone', $TimeZone.id) }
            $effectiveTimestamp = if ($PSBoundParameters.ContainsKey('ProcessingTimestamp')) { $ProcessingTimestamp }
                else { [DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fff', [Globalization.CultureInfo]::InvariantCulture) }
            $BodyMetaData.Add('processingTimestamp', $effectiveTimestamp)
            if ($PSBoundParameters.ContainsKey('Description')) { $BodyMetaData.Add('description', $Description) }
            $stage = 'tags'
            $tagSequence = 1
            foreach ($tagId in $Tags) {
                $tagResult = & $invokeStartStage { Get-AutomateNOWTag -Id $tagId }
                if (-not $tagResult.Success -or $tagResult.Values.Count -ne 1 -or
                    $tagResult.Values[0].simpleId -cne $tagId) { throw 'task-start-tag-invalid' }
                $BodyMetaData.Add(('tags' + $tagSequence), $tagId)
                $tagSequence++
            }
            if (-not [string]::IsNullOrEmpty($Folder)) {
                $stage = 'folder'
                $folderResult = & $invokeStartStage { Get-AutomateNOWFolder -Id $Folder }
                if (-not $folderResult.Success -or $folderResult.Values.Count -ne 1 -or
                    $folderResult.Values[0].simpleId -cne $Folder) { throw 'task-start-folder-invalid' }
                $BodyMetaData.Add('folder', $Folder)
            }
            $BodyMetaData.Add('hold', $(if ($Hold) { 'true' } else { 'false' }))
            $BodyMetaData.Add('forceLoad', $(if ($ForceLoad) { 'true' } else { 'false' }))
            $BodyMetaData.Add('verboseMode', $(if ($VerboseMode) { 'true' } else { 'false' }))
            if (-not [string]::IsNullOrEmpty($DelayedStartTime)) { $BodyMetaData.Add('delayedStartTime', $DelayedStartTime) }
            $stage = 'serialization'
            if ($null -ne $TaskParameters -and $TaskParameters.Count -gt 0) {
                $serialized = & $invokeStartStage { $TaskParameters | ConvertTo-Json -Compress -Depth 100 }
                if (-not $serialized.Success -or $serialized.Values.Count -ne 1 -or
                    $serialized.Values[0] -isnot [string]) { throw 'task-start-serialization-invalid' }
                $BodyMetaData.Add('parameters', $serialized.Values[0])
            }
            else { $BodyMetaData.Add('parameters', '{}') }
            $stage = 'name'
            if (-not [string]::IsNullOrEmpty($Name)) { $BodyMetaData.Add('name', $Name) }
            elseif ($UseAutomaticName) {
                $nameResult = & $invokeStartStage { New-AutomateNOWDefaultProcessingTitle -simpleId $TaskTemplate_simpleId }
                if (-not $nameResult.Success -or $nameResult.Values.Count -ne 1 -or
                    $nameResult.Values[0] -isnot [string] -or [string]::IsNullOrEmpty($nameResult.Values[0])) { throw 'task-start-name-invalid' }
                $BodyMetaData.Add('name', $nameResult.Values[0])
            }
            else { throw 'task-start-name-invalid' }
            $BodyMetaData.Add('_operationType', 'add')
            $BodyMetaData.Add('_operationId', 'executeNow')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_dataSource', 'ProcessingDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            $stage = 'encoding'
            $encoded = & $invokeStartStage { ConvertTo-QueryString -InputObject $BodyMetaData }
            if (-not $encoded.Success -or $encoded.Values.Count -ne 1 -or
                $encoded.Values[0] -isnot [string] -or [string]::IsNullOrEmpty($encoded.Values[0])) { throw 'task-start-encoding-invalid' }
            $parameters.Add('Body', $encoded.Values[0])
            $stage = 'transport'
            $submitted = $true
            $apiResult = & $invokeStartStage { Invoke-AutomateNOWAPI @parameters }
            if (-not $apiResult.Success -or $apiResult.Values.Count -ne 1) { throw 'task-start-transport-invalid' }
            $stage = 'response'
            $response = & $getStartOwnValue $apiResult.Values[0] 'response'
            if (-not $response.Success) { throw 'task-start-envelope-invalid' }
            $status = & $getStartOwnValue $response.Value 'status'
            if (-not $status.Success) { throw 'task-start-status-missing' }
            $statusValue = $status.Value
            $numericStatus = $statusValue -is [sbyte] -or $statusValue -is [byte] -or
                $statusValue -is [int16] -or $statusValue -is [uint16] -or $statusValue -is [int32] -or
                $statusValue -is [uint32] -or $statusValue -is [int64] -or $statusValue -is [uint64] -or
                $statusValue -is [single] -or $statusValue -is [double] -or $statusValue -is [decimal]
            if (-not $numericStatus -or $statusValue -ne 0) { throw 'task-start-status-invalid' }
            $data = & $getStartOwnValue $response.Value 'data'
            if (-not $data.Success -or $null -eq $data.Value) { throw 'task-start-data-invalid' }
            if ($data.Value -is [array] -or $data.Value -is [Collections.IList]) {
                if ($data.Value.Count -ne 1) { throw 'task-start-data-cardinality-invalid' }
                $row = $data.Value[0]
            }
            else { $row = $data.Value }
            $stage = 'conversion'
            $conversionResult = & $invokeStartStage { ConvertTo-AutomateNOWStartedTask -InputObject $row -Synchronous:$Synchronous }
            if (-not $conversionResult.Success -or $conversionResult.Values.Count -ne 1) { throw 'task-start-conversion-invalid' }
            $conversion = $conversionResult.Values[0]
            if ($conversion.RunId -is [long] -and $conversion.RunId -gt 0) { $safeRunId = $conversion.RunId }
            if ($conversion.Success -isnot [bool] -or -not $conversion.Success -or
                $conversion.Task -isnot [ANOWTask] -or $null -eq $safeRunId) {
                $failedConversion = $conversion
                throw 'task-start-conversion-invalid'
            }
            Write-Verbose -Message ('Task start returned run ID ' + $safeRunId.ToString([Globalization.CultureInfo]::InvariantCulture) + '.')
            if (-not $Quiet) { return $conversion.Task }
        }
        catch {
            $startStopped = $true
            & $writeStartFailure $stage $submitted $safeRunId $failedConversion
            return
        }
    }
    End { }
}

Function Resume-AutomateNOWTaskTemplate {
    <#
    .SYNOPSIS
    Resumes a Task Template that is on hold (suspended) on an AutomateNOW! instance

    .DESCRIPTION
    Resumes a Task Template that is on hold (suspended) on an AutomateNOW! instance

    .PARAMETER TaskTemplate
    An [ANOWTaskTemplate] object representing the Task Template to be resumed

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to silence the emitted [ANOWTaskTemplate] object

    .INPUTS
    ONLY [ANOWTaskTemplate] objects are accepted (including from the pipeline)

    .OUTPUTS
    The resumed [ANOWTaskTemplate] object will be returned

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate01' | Resume-AutomateNOWTaskTemplate -Force

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate01', 'TaskTemplate02' | Resume-AutomateNOWTaskTemplate

    .EXAMPLE
    @( 'Task1', 'Task2', 'Task3') | Resume-AutomateNOWTaskTemplate

    .EXAMPLE
    Get-AutomateNOWTaskTemplate | ? { $_.serverTaskType -eq 'LINUX' } | Resume-AutomateNOWTaskTemplate

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWTaskTemplate])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $false, ValueFromPipeline = $True)]
        [ANOWTaskTemplate]$TaskTemplate,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/processingTemplate/resume'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
