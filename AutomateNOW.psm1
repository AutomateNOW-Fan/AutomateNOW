            [string]$unique_object_types_display = $unique_object_types -join ', '
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            ForEach ($ObjectType in $unique_object_types) {
                [string[]]$qualifying_objects = $ObjectList | Where-Object { $_.ObjectType -eq $ObjectType } | Select-Object -ExpandProperty ObjectId | Sort-Object -Unique
