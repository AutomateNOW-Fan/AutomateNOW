        [Parameter(Mandatory = $True, ParameterSetName = 'Id', ValueFromPipeline = $true)]
        [string]$Id,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$endRow = 100
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If ($_.Length -gt 0 ) {
            [string]$Id = $_
        }
        If ($Id.Length -gt 0) {
            $BodyMetaData.'id' = $Id
            $BodyMetaData.'_operationId' = 'read'
            [string]$textMatchStyle = 'exactCase'
        }
        Else {
            $BodyMetaData.'_componentId' = 'SecretVaultList'
            $BodyMetaData.'_startRow' = $startRow
            $BodyMetaData.'_endRow' = $endRow
            [string]$textMatchStyle = 'exact'
        }
        $BodyMetaData.'_operationType' = 'fetch'
        $BodyMetaData.'_textMatchStyle' = $textMatchStyle
        $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
        $BodyMetaData.'isc_metaDataPrefix' = '_'
        $BodyMetaData.'isc_dataFormat' = 'json'
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/secretVault/read?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.Command = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        $Error.Clear()
        Try {
            [ANOWSecretVault[]]$SecretVaults = $results.response.data
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Failed to help parse the response into a series of [ANOWSecretVault] objects due to [$Message]."
            Break
        }
        If ($SecretVaults.Count -gt 0) {
            Return $SecretVaults
        }
    }
    End {

    }
}

Function Export-AutomateNOWSecretVault {
    <#
    .SYNOPSIS
    Exports the Secret Vaults from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the Secret Vaults from an instance of AutomateNOW! to a local .csv file

    .PARAMETER SecretVault
    Mandatory [ANOWSecretVault] object (Use Get-AutomateNOWSecretVault to retrieve them)

    .INPUTS
    ONLY [ANOWSecretVault] objects from the pipeline are accepted

    .OUTPUTS
    The [ANOWSecretVault] objects are exported to the local disk in CSV format

    .EXAMPLE
    Exports the first page of Secret Vaults
    Get-AutomateNOWSecretVault | Export-AutomateNOWSecretVault

    .EXAMPLE
    Exports a single Secret Vault by Id
    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Export-AutomateNOWSecretVault

    .EXAMPLE
    Exports a series of Secret Vaults by sending the Id's across the pipeline
    'SecretVault1', 'SecretVault2' | Get-AutomateNOWSecretVault | Export-AutomateNOWSecretVault

    .NOTES
    You must present [ANOWSecretVault] objects to the pipeline to use this function.

    #>

    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWSecretVault]$SecretVault
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-SecretVaults-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWSecretVault]$SecretVault = $_
        }
        $Error.Clear()
        Try {
            $SecretVault | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWSecretVault] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function New-AutomateNOWSecretVault {
    <#
    .SYNOPSIS
    Creates a Secret Vault within an AutomateNOW! instance

    .DESCRIPTION
    Creates a Secret Vault within an AutomateNOW! instance and returns back the newly created [ANOWSecretVault] object

    .PARAMETER Id
    The intended name of the Secret Vault. For example: 'SecretVault1'. This value may not contain the domain in brackets.

    .PARAMETER SecretVaultType
    Mandatory string indicator the type of the Secret Vault. Valid choices are: HASHI_CORP; AZURE; CYBER_ARK; CYBER_ARK_CONJUR; AWS;

    .PARAMETER Description
    Optional description of the Secret Vault (may not exceed 255 characters).

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly created object.

    .INPUTS
    None. You cannot pipe objects to New-AutomateNOWSecretVault.

    .OUTPUTS
    An [ANOWSecretVault] object representing the newly created Secret Vault

    .EXAMPLE
    Creates a new Secret Vault

    New-AutomateNOWSecretVault -Id 'SecretVault1' -Description 'This is a secret vault' -SecretVaultType 'HASHICORP'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The name (id) of the SecretVault must be unique (per domain). It may consist only of letters, numbers, underscore, dot or hyphen.

    #>
    [OutputType([ANOWSecretVault])]
    [CmdletBinding()]
    Param(
        [ValidateScript({ $_ -match '^[0-9a-z_.-]{1,}$' })]
        [Parameter(Mandatory = $true)]
        [string]$Id,
        [Parameter(Mandatory = $true)]
        [ANOWSecretVault_secretVaultType]$SecretVaultType,
        [Parameter(Mandatory = $false, HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
        Write-Warning -Message "There is not a valid token confirmed."
        Break
    }
    ## Begin warning ##
    ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
    $Error.Clear()
    Try {
        [boolean]$SecretVault_exists = ($null -ne (Get-AutomateNOWSecretVault -Id $Id))
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Get-AutomateNOWSecretVault failed to check if the Secret Vault [$Id] already existed due to [$Message]."
        Break
    }
    If ($SecretVault_exists -eq $true) {
        [string]$current_domain = $anow_session.header.domain
        Write-Warning -Message "There is already a Secret Vault named $Id in [$current_domain]."
        Break
    }
    ## End warning ##
    [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
    $BodyMetaData.'id' = $Id
    $BodyMetaData.'secretVaultType' = $SecretVaultType
    If ($Description.Length -gt 0) {
        $BodyMetaData.'description' = $Description
    }
    $BodyMetaData.'_operationType' = 'add'
    $BodyMetaData.'_textMatchStyle' = 'exact'
    $BodyMetaData.'_oldValues' = '{}'
    $BodyMetaData.'_componentId' = 'SecretVaultCreateWindow_form'
    $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
    $BodyMetaData.'isc_metaDataPrefix' = '_'
    $BodyMetaData.'isc_dataFormat' = 'json'
    [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
    [string]$command = '/secretVault/create'
    [hashtable]$parameters = @{}
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'POST')
    $parameters.Add('Body', $Body)
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    [string]$parameters_display = $parameters | ConvertTo-JSON -Compress -Depth 100
    $Error.Clear()
    Try {
        [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] with parameters $parameters_display due to [$Message]."
        Break
    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
        Break
    }
    $Error.Clear()
    Try {
        [ANOWSecretVault]$SecretVault = $results.response.data | Select-Object -First 1
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Failed to create [ANOWSecretVault] object due to [$Message]."
        Break
    }
    If ($SecretVault.id.Length -eq 0) {
        Write-Warning -Message 'The newly created [ANOWSecretVault] object is empty!'
        Break
    }
    If ($Quiet -ne $true) {
        Return $SecretVault
    }
}

Function Remove-AutomateNOWSecretVault {
    <#
    .SYNOPSIS
    Removes a Secret Vault from an AutomateNOW! instance

    .DESCRIPTION
    Removes a Secret Vault from an AutomateNOW! instance

    .PARAMETER SecretVault
    An [ANOWSecretVault] object representing the Secret Vault to be deleted.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    ONLY [ANOWSecretVault] objects are accepted (including from the pipeline)

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Removes a single Secret Vault

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Remove-AutomateNOWSecretVault

    .EXAMPLE
    Forcefully removes three Secret Vaults by way of the pipeline

    'SecretVault1', 'SecretVault2', 'SecretVault3' | Get-AutomateNOWSecretVault | Remove-AutomateNOWSecretVault -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $false, ValueFromPipeline = $True)]
        [ANOWSecretVault]$SecretVault,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/secretVault/delete'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWSecretVault]$SecretVault = $_
        }
        [string]$SecretVault_id = $SecretVault.id
        If ($SecretVault_id.Length -eq 0) {
            Write-Warning -Message "An object with an empty Id was passed to this function."
            Break
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($SecretVault_id)")) -eq $true) {
            [string]$old_values = $SecretVault.CreateOldValues()
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'id' = $SecretVault_id
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_operationType' = 'remove'
            $BodyMetaData.'_oldValues' = $old_values
            $BodyMetaData.'_componentId' = 'SecretVaultList'
            $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters["Body"]) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$SecretVault_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Secret Vault [$SecretVault_id] successfully removed"
        }
    }
    End {

    }
}

Function Copy-AutomateNOWSecretVault {
    <#
    .SYNOPSIS
    Copies a Secret Vault from an AutomateNOW! instance

    .DESCRIPTION
    Copies a Secret Vault from an AutomateNOW! instance. AutomateNOW object id can never be changed, but we can copy the object to a new id and it will include all of the items therein.

    .PARAMETER SecretVault
    Mandatory [ANOWSecretVault] object to be copied.

    .PARAMETER NewId
    The name (Id) of the new Secret Vault. The new Id must be unique (per domain). It may consist only of letters, numbers, underscore, dot or hyphen.

    .PARAMETER Description
    Optional description to set on the new Secret Vault object. If you do not set this, the new Secret Vault object will copy the Description of the source object.

    .PARAMETER UnsetDescription
    Optional switch that will ensure that the newly created Secret Vault will not have a description set.

    .PARAMETER Force
    Force the copy without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly created object.

    .INPUTS
    ONLY [ANOWSecretVault] object is accepted. Pipeline support is intentionally unavailable.

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Creates a copy of a Secret Vault and changes the description (multi-line format)
    $SecretVault1 = Get-AutomateNOWSecretVault -Id 'SecretVault1'
    Copy-AutomateNOWSecretVault -SecretVault $SecretVault1 -NewId 'SecretVault1_production' -Description 'Secret Vault 1 Production'

    .EXAMPLE
    Creates a copy of a Secret Vault that omits the description (one-liner format)
    Copy-AutomateNOWSecretVault -SecretVault (Get-AutomateNOWSecretVault -Id 'SecretVault1') -NewId 'SecretVault1_production' -UnsetDescription

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWSecretVault])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWSecretVault]$SecretVault,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,1024}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetDescription,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($UnsetDescription -eq $true -and $Description.Length -gt 0) {
            Write-Warning -Message "You cannot set the description and unset it at the same time. Please choose one or the other."
            Break
        }
        ## Begin warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$SecretVault_exists = ($null -ne (Get-AutomateNOWSecretVault -Id $NewId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWSecretVault failed to check if the Secret Vault [$NewId] already existed due to [$Message]."
            Break
        }
        If ($SecretVault_exists -eq $true) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is already a Secret Vault named [$NewId] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        ## End warning ##
        [string]$command = '/secretVault/copy'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($PermissionToProceed -ne $false) {
            [string]$SecretVault_oldId = $SecretVault.id
            [string]$SecretVault_simpleId = $SecretVault.simpleId
            If ($SecretVault_oldId -eq $NewId) {
                Write-Warning -Message "The new id cannot be the same as the old id."
                Break
            }
            If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Copy the Secret Vault $($SecretVault_simpleId) to $($NewId)?")) -eq $true) {
                [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
                $BodyMetaData.'oldId' = $SecretVault_oldId
                $BodyMetaData.'domain' = $SecretVault.domain
                $BodyMetaData.'id' = $NewId
                If ($UnsetDescription -ne $true) {
                    If ($Description.Length -gt 0) {
                        $BodyMetaData.'description' = $Description
                    }
                    Else {
                        $BodyMetaData.'description' = $SecretVault.description
                    }
                }
                $BodyMetaData.'_operationType' = 'add'
                $BodyMetaData.'_operationId' = 'copy'
                $BodyMetaData.'_textMatchStyle' = 'exact'
                $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
                $BodyMetaData.'isc_metaDataPrefix' = '_'
                $BodyMetaData.'isc_dataFormat' = 'json'
                [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
                $parameters.Body = $Body
                $Error.Clear()
                Try {
                    [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$SecretVault_oldId] due to [$Message]."
                    Break
                }
                [int32]$response_code = $results.response.status
                If ($response_code -ne 0) {
                    [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                    Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                    Break
                }
                $Error.Clear()
                Try {
                    [ANOWSecretVault]$NewSecretVault = $results.response.data | Select-Object -First 1
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to create copied [ANOWSecretVault] object [$NewId] due to [$Message]."
                    Break
                }
                If ($NewSecretVault.id.Length -eq 0) {
                    Write-Warning -Message "The newly created (copied) [ANOWSecretVault] object [$NewId] is empty!"
                    Break
                }
                If ($Quiet -ne $true) {
                    Return $NewSecretVault
                }
            }
        }
    }
    End {

    }
}

Function Rename-AutomateNOWSecretVault {
    <#
    .SYNOPSIS
    Renames a Secret Vault on an AutomateNOW! instance

    .DESCRIPTION
    Performs a pseudo-rename operation of a Secret Vault from an AutomateNOW! instance by copying it first and then deleting the source. This function merely combines Copy-AutomateNOWSecretVault and Remove-AutomateNOWSecretVault therefore it is to be considered destructive.

    .PARAMETER SecretVault
    An [ANOWSecretVault] object representing the Secret Vault to be renamed.

    .PARAMETER NewId
    Mandatory string indicating the new id or name of the Secret Vault. The Id is the same as a primary key, it must be unique. The console will provide the old Id + '_COPY' in the UI when making a copy. The Id is limited to 1024 characters.

    .PARAMETER Force
    Force the renaming without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly renamed object.

    .INPUTS
    ONLY [ANOWSecretVault] objects are accepted. There is intentionally no support for the pipeline.

    .OUTPUTS
    The newly renamed [ANOWSecretVault] object will be returned.

    .EXAMPLE
    Renames a Secret Vault named 'SecretVault1' to 'SecretVault2' (multi-line)

    $SecretVault = Get-AutomateNOWSecretVault -Id 'SecretVault1'
    Rename-AutomateNOWSecretVault -SecretVault $SecretVault -NewId 'SecretVault2'

    .EXAMPLE
    Forcibly renames a Secret Vault named 'SecretVault1' to 'SecretVault2' (one-liner)

    Rename-AutomateNOWSecretVault -SecretVault (Get-AutomateNOWSecretVault -Id 'SecretVault1') -NewId 'SecretVault2' -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    When renaming, you may only specify a different Id (name).

    This action will be blocked if any existing referrals are found on the object.
    #>
    [OutputType([ANOWSecretVault])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWSecretVault]$SecretVault,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,1024}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        ## Begin standard warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$new_SecretVault_exists = ($null -ne (Get-AutomateNOWSecretVault -Id $NewId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWSecretVault failed to check if the Secret Vault [$NewId] already existed due to [$Message]."
            Break
        }
        If ($new_SecretVault_exists -eq $true) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is already a Secret Vault named [$NewId] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        [string]$SecretVault_id = $SecretVault.Id
        $Error.Clear()
        Try {
            [boolean]$old_SecretVault_exists = ($null -ne (Get-AutomateNOWSecretVault -Id $SecretVault_id))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWSecretVault failed to check if the SecretVault [$SecretVault_id] already existed due to [$Message]."
            Break
        }
        If ($old_SecretVault_exists -eq $false) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is not a SecretVault named [$SecretVault_id] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        ## End standard warning ##
    }
    Process {
        If ($PermissionToProceed -ne $false) {
            If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($SecretVault_id)")) -eq $true) {
                $Error.Clear()
                Try {
                    [ANOWSecretVault]$new_SecretVault = Copy-AutomateNOWSecretVault -SecretVault $SecretVault -NewId $NewId -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Copy-AutomateNOWSecretVault failed to create a new Secret Vault [$NewId] as Part 1 of the renaming process due to [$Message]."
                    Break
                }
                If ($new_SecretVault.simpleId -eq $NewId) {
                    Write-Verbose -Message "Part 1: Secret Vault [$SecretVault_id] successfully copied to [$NewId]"
                }
                Else {
                    Write-Warning -Message "The first phase (Copy-AutomateNOWSecretVault) failed."
                    Break
                }
                $Error.Clear()
                Try {
                    Remove-AutomateNOWSecretVault -SecretVault $SecretVault -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Remove-AutomateNOWSecretVault failed to remove [$SecretVault_id] as Part 2 of the renaming process due to [$Message]."
                    Break
                }
                Write-Verbose -Message "Part 2: Secret Vault [$SecretVault_id] removed"
                Write-Verbose -Message "Secret Vault [$SecretVault_id] successfully renamed to [$NewId]"
                If ($Quiet -ne $true) {
                    Return $new_SecretVault
                }
            }
        }
        Else {
            Write-Warning -Message "No action was taken because either the source object didn't exist or the new object already existed"
        }
    }
    End {
    }
}

Function Set-AutomateNOWSecretVault {
    <#
    .SYNOPSIS
    Changes the settings of a Secret Vault on an AutomateNOW! instance

    .DESCRIPTION
    Changes the settings of a Secret Vault on an AutomateNOW! instance

    .PARAMETER SecretVault
    An [ANOWSecretVault] object representing the Secret Vault to be changed.

    .PARAMETER Description
    A text description between 1 and 255 characters. UTF-8 characters are allowed.

    .PARAMETER UnsetDescription
    Switch parameter that will remove the description.

    .PARAMETER UseVaultCache
    Boolean parameter that enables or disables usage of the vault cache.

    .PARAMETER AuthenticationTypeAWS
    Authentication mode for AWS Secrets Manager (ACCESS_KEY or USER_PROFILE) when using the AWS parameter set.

    .PARAMETER AuthenticationTypeAZURE
    Authentication mode for Azure Key Vault (USER, CLIENT_SECRET, DEFAULT, or MANAGED) when using the Azure parameter set.

    .PARAMETER AuthenticationTypeCONJUR
    Authentication mode for CyberArk Conjur vaults when using the CYBER_ARK_CONJUR parameter set.

    .PARAMETER AuthenticationTypeCYBER
    Authentication mode for CyberArk Digital Vault when using the CYBER_ARK parameter set.

    .PARAMETER AuthenticationTypeHASHI
    Authentication mode for HashiCorp Vault (TOKEN, USER, or APP_ROLE) when using the HASHI_CORP parameter set.

    .PARAMETER Url
    Base service URL or endpoint for the target vault provider (AWS, Azure, CyberArk, Conjur, or HashiCorp) as required by each parameter set.

    .PARAMETER User
    Username used by providers that require it (Azure USER, CyberArk, Conjur, or HashiCorp USER flows).

    .PARAMETER Password
    Secure string password used with User-based authentication flows (Azure USER, CyberArk, Conjur, HashiCorp USER).

    .PARAMETER Token
    Secure string token used with HashiCorp Vault when AuthenticationTypeHASHI is TOKEN.

    .PARAMETER SecretPath
    Secret or mount path inside HashiCorp Vault indicating where credentials are stored.

    .PARAMETER Namespace
    Optional HashiCorp Vault namespace to scope the request.

    .PARAMETER SecretId
    Secure string secret ID for HashiCorp App Role authentication.

    .PARAMETER AppRoleId
    HashiCorp App Role identifier used with the APP_ROLE authentication type.

    .PARAMETER AuthenticationUrl
    CyberArk Conjur authentication URL used to obtain session tokens.

    .PARAMETER ApplianceUrl
    CyberArk Conjur appliance (core service) URL.

    .PARAMETER ConjurAccount
    CyberArk Conjur account name to target when authenticating.

    .PARAMETER Region
    AWS region for the target Secrets Manager instance.

    .PARAMETER AccessKeyId
    Secure string AWS access key ID used with the ACCESS_KEY authentication type.

    .PARAMETER SecretAccessKey
    Secure string AWS secret access key used with the ACCESS_KEY authentication type.

    .PARAMETER RoleARN
    AWS role ARN to assume when using USER_PROFILE authentication.

    .PARAMETER ProfileType
    AWS user profile source type (SOURCE_PROFILE or CREDENTIAL_SOURCE) when using USER_PROFILE authentication.

    .PARAMETER SourceProfile
    Named AWS source profile to read credentials from when ProfileType is SOURCE_PROFILE.

    .PARAMETER ExternalId
    Optional AWS external ID used when assuming the role for USER_PROFILE authentication.

    .PARAMETER CredentialSource
    AWS credential source (for example ecsContainer) when ProfileType is CREDENTIAL_SOURCE.

    .PARAMETER JsonStructure
    Switch to emit AWS user-profile settings as JSON structure (adds jsonStructure flag, optionally with SecretName).

    .PARAMETER SecretName
    Optional AWS secret name to include when JsonStructure is used for USER_PROFILE authentication.

    .PARAMETER ClientId
    Azure application (client) ID used with CLIENT_SECRET authentication.

    .PARAMETER ClientSecret
    Secure string Azure client secret used with CLIENT_SECRET authentication.

    .PARAMETER TenantId
    Azure tenant ID used with CLIENT_SECRET authentication.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Suppresses the return of the updated object.

    .INPUTS
    ONLY [ANOWSecretVault] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWSecretVault] object will be returned

    .EXAMPLE
    Forcibly and quietly sets the description on any type of Secret Vault (in this case named 'SecretVault1') and enables the default status (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -Description 'This is a description' -UseVaultCache $true -Force -Quiet

    .EXAMPLE
    Sets the description on any type of Secret Vault (in this case named 'SecretVault1') and disables default status (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -UnsetDescription -UseVaultCache $false

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type CyberArk Conjur (CYBER_ARK_CONJUR) (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeCONJUR 'USER' -User 'user' -Password ('password' | ConvertTo-SecureString -AsPlainText -Force) -AuthenticationUrl 'authentication url' -ApplianceUrl 'appliance url' -ConjurAccount 'Conjur Account' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type CyberArk Digital Vault (CYBER_ARK) (one-liner)

    Set-AutomateNOWSecretVault -AuthenticationTypeCYBER USER -Url 'the url' -User 'user' -Password ('password' | ConvertTo-SecureString -AsPlainText -Force) -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type HashiCorp Vault (HASHI_CORP) with Authentication Type of Token (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeHASHI 'TOKEN' -Token ('token' | ConvertTo-SecureString -AsPlainText -Force) -Url 'the url!' -SecretPath 'secret path' -Namespace 'namespace' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type HashiCorp Vault (HASHI_CORP) with Authentication Type of User (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeHASHI 'USER' -Password ('password' | ConvertTo-SecureString -AsPlainText -Force) -User 'user' -Url 'the url' -SecretPath 'secret path' -Namespace 'the namespace' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type HashiCorp Vault (HASHI_CORP) with Authentication Type of App Role (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeHASHI 'APP_ROLE' -SecretId ('secret id' | ConvertTo-SecureString -AsPlainText -Force) -AppRoleId 'app role id' -Url 'the url' -SecretPath 'secret path' -Namespace 'namespace' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type AWS Secrets Manager with Authentication Type of ACCESS_KEY (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeAWS 'ACCESS_KEY' -AccessKeyId ('access key id' | ConvertTo-SecureString -AsPlainText -Force) -SecretAccessKey ('secret access key' | ConvertTo-SecureString -AsPlainText -Force) -Url 'the url' -Region 'the region' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type AWS Secrets Manager with Authentication Type of USER_PROFILE and a Profile Type of SOURCE_PROFILE (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeAWS USER_PROFILE -URL 'the url' -Region 'region' -ProfileType SOURCE_PROFILE -roleArn 'roleArn' -externalId 'ext id' -SourceProfile 'source profile' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVault1' of vault type AWS Secrets Manager with Authentication Type of USER_PROFILE and a Profile Type of CREDENTIAL_SOURCE and a credential source of 'ecsContainer' (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeAWS USER_PROFILE -URL 'the url' -Region 'region' -ProfileType CREDENTIAL_SOURCE -roleArn 'roleArn' -externalId 'ext id' -CredentialSource ecsContainer -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVaul1' of vault type Azure Key Vault and an authenticaion type of USER (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeAZURE USER -URL 'the url' -User 'user' -Password ('password' | ConvertTo-SecureString -AsPlainText -Force) -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVaul1' of vault type Azure Key Vault and an authenticaion type of CLIENT_SECRET (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeAZURE 'CLIENT_SECRET' -URL 'the url' -ClientSecret ('Client Secret' | ConvertTo-SecureString -AsPlainText -Force) -ClientId 'Client Id' -TenantId 'Tenant Id' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVaul1' of vault type Azure Key Vault and an authenticaion type of DEFAULT (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeAZURE 'DEFAULT' -URL 'the url' -Force

    .EXAMPLE
    Sets the credentials for a Secret Vault named 'SecretVaul1' of vault type Azure Key Vault and an authenticaion type of MANAGED (one-liner)

    Get-AutomateNOWSecretVault -Id 'SecretVault1' | Set-AutomateNOWSecretVault -AuthenticationTypeAZURE 'MANAGED' -URL 'the url' -Force

    Credential conversion releases each temporary Windows PowerShell buffer before encryption. Preparation failures stop before submission; uncertain changes stop later pipeline inputs without retry.

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    This function is a little different from other Set-AutomateNOW* functions. Because these are authentication related objects and in line with the UI, when configuring the authentication properties you must include all of the needed properties. Be sure to review the examples carefully and if possible, review the parameter sets and the UI as well so everything is clear.

    The examples in this function which includes the password in the command line are for 'one-liner' demonstration purposes only. You should never allow passwords to be recorded in your command history.

    #>
    [OutputType([ANOWSecretVault])]
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Default', ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Default', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'AWS', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'AZURE', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK_CONJUR', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK', ValueFromPipeline = $true)]
        [Parameter(Mandatory = $true, ParameterSetName = 'HASHI_CORP', ValueFromPipeline = $true)]
        [ANOWSecretVault]$SecretVault,
        [ValidateScript({ $_.Length -le 255 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'Default', HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [string]$Description,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [switch]$UnsetDescription,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [Nullable[boolean]]$UseVaultCache,
        [Parameter(Mandatory = $true, ParameterSetName = 'AWS')]
        [ANOWSecurityVault_authenticationTypeAWS]$AuthenticationTypeAWS,
        [Parameter(Mandatory = $true, ParameterSetName = 'AZURE')]
        [ANOWSecurityVault_authenticationTypeAZURE]$AuthenticationTypeAZURE,
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK_CONJUR')]
        [ANOWSecurityVault_authenticationTypeCONJUR]$AuthenticationTypeCONJUR,
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK')]
        [ANOWSecurityVault_authenticationTypeCYBER]$AuthenticationTypeCYBER,
        [Parameter(Mandatory = $true, ParameterSetName = 'HASHI_CORP')]
        [ANOWSecurityVault_authenticationTypeHASHI]$AuthenticationTypeHASHI,
        [Parameter(Mandatory = $true, ParameterSetName = 'HASHI_CORP')]
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK')]
        [Parameter(Mandatory = $true, ParameterSetName = 'AZURE')]
        [Parameter(Mandatory = $true, ParameterSetName = 'AWS')]
        [string]$Url,
        [Parameter(Mandatory = $false, ParameterSetName = 'AZURE')]
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK')]
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK_CONJUR')]
        [Parameter(Mandatory = $false, ParameterSetName = 'HASHI_CORP')]
        [string]$User,
        [Parameter(Mandatory = $false, ParameterSetName = 'AZURE')]
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK')]
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK_CONJUR')]
        [Parameter(Mandatory = $false, ParameterSetName = 'HASHI_CORP')]
        [securestring]$Password,
        [Parameter(Mandatory = $false, ParameterSetName = 'HASHI_CORP')]
        [SecureString]$Token,
        [Parameter(Mandatory = $true, ParameterSetName = 'HASHI_CORP')]
        [string]$SecretPath,
        [Parameter(Mandatory = $false, ParameterSetName = 'HASHI_CORP')]
        [string]$Namespace,
        [Parameter(Mandatory = $false, ParameterSetName = 'HASHI_CORP')]
        [SecureString]$SecretId,
        [Parameter(Mandatory = $false, ParameterSetName = 'HASHI_CORP')]
        [string]$AppRoleId,
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK_CONJUR')]
        [string]$AuthenticationUrl,
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK_CONJUR')]
        [string]$ApplianceUrl,
        [Parameter(Mandatory = $true, ParameterSetName = 'CYBER_ARK_CONJUR')]
        [string]$ConjurAccount,
        [Parameter(Mandatory = $true, ParameterSetName = 'AWS')] # Access Key, User Profile
        [string]$Region,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # Access Key
        [SecureString]$AccessKeyId,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # Access Key
        [SecureString]$SecretAccessKey,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # User Profile
        [string]$RoleARN,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # User Profile
        [ANOWSecurityVault_sourceTypeAWS]$ProfileType,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # User Profile
        [string]$SourceProfile,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # User Profile
        [string]$ExternalId,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # User Profile
        [ANOWSecurityVault_credentialSourceAWS]$CredentialSource,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # Access Key, User Profile
        [Nullable[boolean]]$JsonStructure,
        [Parameter(Mandatory = $false, ParameterSetName = 'AWS')] # Access Key, User Profile
        [string]$SecretName,
        [Parameter(Mandatory = $false, ParameterSetName = 'AZURE')] # Client Secret
        [string]$ClientId,
        [Parameter(Mandatory = $false, ParameterSetName = 'AZURE')] # Client Secret
        [SecureString]$ClientSecret,
        [Parameter(Mandatory = $false, ParameterSetName = 'AZURE')] # Client Secret
        [string]$TenantId,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin { $batchStopped = $false }
    Process {
        if ($batchStopped) { return }
        $targetId = $SecretVault.id
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess($targetId, 'Update SecretVault') -eq $true)) {
            $arguments = @{}
            foreach ($key in $PSBoundParameters.Keys) {
                if ($key -notin @('WhatIf','Confirm','Verbose','Debug','ErrorAction','ErrorVariable','WarningAction','WarningVariable','InformationAction','InformationVariable','OutVariable','OutBuffer','PipelineVariable','ProgressAction')) { $arguments[$key] = $PSBoundParameters[$key] }
            }
            $arguments['SecretVault'] = $SecretVault
            $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWUpdateSecretVaultRequest) -OperationParameters $arguments
            if (-not $prepared.Succeeded -or @($prepared.Data).Count -ne 1 -or $prepared.Data[0] -isnot [hashtable]) {
                $batchStopped = $true
                Write-Warning 'Credential request preparation was not verified. No change was submitted; later pipeline inputs were stopped.'
                return
            }
            $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $prepared.Data[0]
            if (-not $sent.Succeeded -or -not (Test-ANOWB2Response -Envelopes $sent.Data)) {
                $batchStopped = $true
                Write-Warning 'The change outcome is uncertain. Do not repeat the operation; later pipeline inputs were stopped.'
                return
            }
            $row = @($sent.Data[0].response.data)[0]; $expectedId = $targetId
            $converted = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-ANOWB2Result) -OperationParameters @{InputObject=$row;Family='SecretVault';ExpectedId=$expectedId}
            if (-not $converted.Succeeded -or @($converted.Data).Count -ne 1 -or -not $converted.Data[0].Success) {
                $batchStopped = $true
                Write-Warning 'The change result could not be represented by the loaded class. The change may already have occurred; do not repeat the operation. Later pipeline inputs were stopped.'
                return
            }
            Write-Verbose 'The change response and typed result were verified.'
            if (-not $Quiet) { $converted.Data[0].Value }
        }
    }
}

Function Test-AutomateNOWSecretVault {
    <#
    .SYNOPSIS
    Tests the connection to a Secret Vault on an AutomateNOW! instance

    .DESCRIPTION
    Tests the connection to a Secret Vault on an AutomateNOW! instance

    .PARAMETER SecretVault
    An [ANOWSecretVault] object representing the Secret Vault to be tested

    .INPUTS
    An [ANOWSecretVault] object is required which can be sent across the pipeline.

    .OUTPUTS
    An information message will be emitted

    .EXAMPLE
    Tests a secret vault named 'SecretVault1' (one-liner)

    'SecretVault1' | Get-AutomateNOWSecretVault | Test-AutomateNOWSecretVault

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWSecretVault]$SecretVault
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/secretVault/testVaultConnection'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWSecretVault]$SecretVault = $_
        }
        [string]$SecretVault_Id = $SecretVault.simpleId
        ## Begin warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$SecretVault_exists = ($null -ne (Get-AutomateNOWSecretVault -Id $SecretVault_Id))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWSecretVault failed to check if the Secret Vault [$SecretVault_Id] already existed due to [$Message]."
            Break
        }
        If ($SecretVault_exists -eq $false) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is not a Secret Vault with Id [$SecretVault_Id] in the current domain [$current_domain]."
            Break
        }
        ## End warning ##
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        $BodyMetaData.'id' = $SecretVault_Id
        $BodyMetaData.'_operationType' = 'custom'
        $BodyMetaData.'_operationId' = 'testVaultConnection'
        $BodyMetaData.'_textMatchStyle' = 'exact'
        $BodyMetaData.'_dataSource' = 'SecretVaultDataSource'
        $BodyMetaData.'isc_metaDataPrefix' = '_'
        $BodyMetaData.'isc_dataFormat' = 'json'
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        If ($null -eq $parameters.Body) {
            $parameters.Add('Body', $Body)
        }
        Else {
            $parameters.Body = $Body
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        Else {
            Write-Information -MessageData "The connection to Secret Vault [$SecretVault_Id] was successful."
        }
    }
    End {
    }
}

Function Set-AutomateNOWSecretVaultDefault {
    <#
    .SYNOPSIS
    Sets a Secret Vault on an AutomateNOW! instance to the default vault

    .DESCRIPTION
    Sets a Secret Vault on an AutomateNOW! instance to the default vault

    .PARAMETER SecretVault
