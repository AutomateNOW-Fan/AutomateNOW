Function Get-AutomateNOWViewSetup {
    <#
    .SYNOPSIS
    Gets the View Setup Objects from an AutomateNOW! instance

    .DESCRIPTION
    Gets the View Setup Objects from an AutomateNOW! instance

    .PARAMETER Id
    Optional CASE-SENSITIVE string containing the Id of the View Setup object

    .PARAMETER startRow
    Integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .PARAMETER sortBy
    Optional string parameter to sort the results by (may not be used with the Id parameter). Valid choices are: id*, name, iconCode, dateCreated, lastUpdated, createdBy, lastUpdatedBy

    .PARAMETER Descending
    Optional switch parameter to sort in descending order

    .PARAMETER PublicOnly
    Optional switch parameter to limit the results to Views that are public.

    .PARAMETER PrivateOnly
    Optional switch parameter to limit the results to Views that are private.

    .INPUTS
    A single Id or a string of Id's across the pipeline will be accepted.

    .OUTPUTS
    Either one or more [ANOWViewSetup] objects

    .EXAMPLE
    Gets the first page of View Setup objects

    Get-AutomateNOWViewSetup

    .EXAMPLE
    Gets a single View Setup named 'ViewSetup1'

    Get-AutomateNOWViewSetup -Id 'ViewSetup1'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWViewSetup[]])]
    [CmdletBinding(DefaultParameterSetName = 'Default')]
    Param(
        [Parameter(Mandatory = $True, ParameterSetName = 'Id', ValueFromPipeline = $true)]
        [string]$Id,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Public')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Private')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Public')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Private')]
        [int32]$endRow = 100,
        [ValidateSet('id', 'name', 'iconCode', 'dateCreated', 'lastUpdated', 'createdBy', 'lastUpdatedBy', IgnoreCase = $false)]
        [Parameter(Mandatory = $False, ParameterSetName = 'Public')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Private')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [string]$sortBy = 'id',
        [Parameter(Mandatory = $False, ParameterSetName = 'Public')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Private')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [switch]$Descending,
        [Parameter(Mandatory = $False, ParameterSetName = 'Public')]
        [switch]$PublicOnly,
        [Parameter(Mandatory = $False, ParameterSetName = 'Private')]
        [switch]$PrivateOnly
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If (($_.Length -gt 0 -or $Id.Length -gt 0) ) {
            If ($_.Length -gt 0) {
                $BodyMetaData.'id' = $_
            }
            Else {
                $BodyMetaData.'id' = $Id
            }
            [string]$textMatchStyle = 'exactCase'
        }
        Else {
            $BodyMetaData.'_constructor' = 'AdvancedCriteria'
            $BodyMetaData.'operator' = 'and'
            If ($PublicOnly -eq $true) {
                $BodyMetaData.'criteria1' = '{"fieldName":"publicSetup","operator":"equals","value":"true"}'
            }
            ElseIf ($PrivateOnly -eq $true) {
                $BodyMetaData.'criteria1' = '{"fieldName":"publicSetup","operator":"equals","value":"false"}'
            }
            $BodyMetaData.'_componentId' = 'ViewSetupList'
            $BodyMetaData.'_startRow' = $startRow
            $BodyMetaData.'_endRow' = $endRow
            [string]$textMatchStyle = 'substring'
            If ($Descending -eq $true) {
                $BodyMetaData.'_sortBy' = '-' + $sortBy
            }
            Else {
                $BodyMetaData.'_sortBy' = $sortBy
            }
        }
        $BodyMetaData.'_operationId' = 'read'
        $BodyMetaData.'_operationType' = 'fetch'
        $BodyMetaData.'_textMatchStyle' = $textMatchStyle
        $BodyMetaData.'_dataSource' = 'ViewSetupDataSource'
        $BodyMetaData.'isc_metaDataPrefix' = '_'
        $BodyMetaData.'isc_dataFormat' = 'json'
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/viewSetup/read?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.Command = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        $Error.Clear()
        Try {
            [ANOWViewSetup[]]$ViewSetups = $results.response.data
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Failed to parse the response into a series of [ANOWViewSetup] objects due to [$Message]."
            Break
        }
        If ($ViewSetups.Count -gt 0) {
            Return $ViewSetups
        }
    }
    End {

    }
}

Function Set-AutomateNOWViewSetup {
    <#
    .SYNOPSIS
    Changes the settings of a View Setup from an AutomateNOW! instance

    .DESCRIPTION
    Changes the settings of a View Setup from an AutomateNOW! instance

    .PARAMETER ViewSetup
    An [ANOWViewSetup] object representing the View Setup to be changed.

    .PARAMETER Title
    Alternative display title for the View Setup.

    .PARAMETER unsetTitle
    A switch parameter that will remove the Title from the View Setup.

    .PARAMETER textColor
    Optional hex RGB for the foreground (text) color or you can select 'transparent'. Colors require the # character and it is case sensitive.

    .PARAMETER backgroundColor
    Optional hex RGB for the background color or you can select 'transparent'. Colors require the # character and it is case sensitive.

    .PARAMETER iconSet
    Optional name of the icon library. Possible choices are: FAT_COW, FUGUE and FONT_AWESOME.

    .PARAMETER iconCode
    Mandatory (if -iconSet is used) name of the icon from the selected library. These are case-sensitive.

    .PARAMETER RemoveIcon
    A switch parameter that will remove the Icon from the View Setup.

    .PARAMETER Public
    A boolean parameter that will set the View Setup as public or not.

    .PARAMETER CommandText
    A string parameter (JSON COMPLIANT!) for setting the content of the View Setup. This parameter is not recommended and should be considered experimental. The UI only offers the ability to edit the raw text of this content. You must send a JSON compliant string. Do not include the opening and closing parenthesis as this function will take care of that.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false.

    .PARAMETER Quiet
    A switch parameter that will suppress the output of the updated View Setup.

    .INPUTS
    ONLY [ANOWViewSetup] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWViewSetup] object will be returned

    .EXAMPLE
    Forcibly and quietly changes the title, text color, background color, icon and public visibility on a View Setup named 'ViewSetup1' (one-liner)

    Get-AutomateNOWViewSetup -Id 'ViewSetup1' | Set-AutomateNOWViewSetup -Title 'Title!' -textColor '#49531A' -backgroundColor 'transparent' -iconCode 'abacus' -iconSet FAT_COW -Public $true -Force

    .EXAMPLE
    Unsets the title, icon and public visibility on a View Setup named 'ViewSetup1' (one-liner)

    Get-AutomateNOWViewSetup -Id 'ViewSetup1' | Set-AutomateNOWViewSetup -unsetTitle -RemoveIcon -Public $true

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    If the -iconSet parameter is specified then -iconCode must also be specified. You cannot specify one without the other nor can you combine these with -RemoveIcon.

    #>
    [OutputType([ANOWViewSetup])]
    [CmdletBinding(SupportsShouldProcess = $true, DefaultParameterSetName = 'Default', ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [ANOWViewSetup]$ViewSetup,
        [Parameter(Mandatory = $false)]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Title,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetTitle,
        [Parameter(Mandatory = $false, HelpMessage = "Enter a hexadecimal RGB (#FF0000) or the word transparent in lower case")]
        [ValidateScript( { $_ -cmatch '^#[0-9A-F]{6}$' -or $_ -cmatch '^transparent$' } ) ]
        [string]$textColor,
        [Parameter(Mandatory = $false, HelpMessage = "Enter a hexadecimal RGB (#FF0000) or the word transparent in lower case")]
        [ValidateScript( { $_ -cmatch '^#[0-9A-F]{6}$' -or $_ -cmatch '^transparent$' } ) ]
        [string]$backgroundColor,
        [Parameter(Mandatory = $true, ParameterSetName = 'WithIcon')]
        [ANOWIcon_iconSet]$iconSet,
        [ValidateScript({ $_ -match '^[a-z0-9-_]{1,}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'WithIcon')]
        [string]$iconCode,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [switch]$RemoveIcon,
        [Parameter(Mandatory = $false)]
        [Nullable[boolean]]$Public,
        [ValidateScript({ (($_ | ConvertFrom-Json).field.Length) -gt 0 })]
        [Parameter(Mandatory = $false)]
        [string]$commandText,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($unsetTitle -eq $true -and $Title.Length -gt 0) {
            Write-Warning -Message "You cannot set the Title and unset it at the same time"
            Break
        }
        [string]$command = '/ViewSetup/update'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWViewSetup]$ViewSetup = $_
        }
        [string]$ViewSetup_simpleId = $ViewSetup.simpleId
        [string]$ViewSetup_id = $ViewSetup.id
        [string]$ViewSetup_viewId = $ViewSetup.viewId
        [string]$ViewSetup_CommandText = $ViewSetup.viewSetup
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($ViewSetup_simpleId)")) -eq $true) {
            ## Begin warning ##
            ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
            $Error.Clear()
            Try {
                [boolean]$ViewSetup_exists = ($null -eq (Get-AutomateNOWViewSetup -Id $ViewSetup_simpleId))
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWViewSetup failed to check if the View Setup [$ViewSetup_simpleId] already existed due to [$Message]."
                Break
            }
            If ($ViewSetup_exists -eq $true) {
                [string]$current_domain = $anow_session.header.domain
                Write-Warning -Message "There is not a View Setup named [$ViewSetup_simpleId] in the current domain [$current_domain]."
                Break
            }
            ## End warning ##
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'id' = $ViewSetup_id
            $BodyMetaData.'viewId' = $ViewSetup_viewId
            If ($CommandText.Length -gt 0) {
                [string]$FixedCommandText = ('(' + $CommandText + ')')
                $BodyMetaData.'viewSetup' = $FixedCommandText
            }
            Else {
                $BodyMetaData.'viewSetup' = $ViewSetup_CommandText
            }
            If ($Public -eq $true) {
                $BodyMetaData.'publicSetup' = 'true'
                $BodyMetaData.'privateSetup' = 'true'
            }
            ElseIf ($Public -eq $false) {
                $BodyMetaData.'publicSetup' = 'false'
                $BodyMetaData.'privateSetup' = 'false'
            }
            Else {
                $BodyMetaData.'publicSetup' = $ViewSetup.publicSetup
                $BodyMetaData.'privateSetup' = $ViewSetup.privateSetup
            }
            If ($Title.Length -gt 0) {
                $BodyMetaData.'title' = $Title
            }
            ElseIf ($UnsetTitle -eq $true) {
                $BodyMetaData.'title' = $null
            }
            If ($textColor.Length -gt 0) {
                $BodyMetaData.'textColor' = $textColor
            }
            If ($backgroundColor.Length -gt 0) {
                $BodyMetaData.'backgroundColor' = $backgroundColor
            }
            If ($RemoveIcon -eq $true) {
                $BodyMetaData.'iconCode' = $null
                $BodyMetaData.'iconSet' = $null
            }
            If ($iconCode.Length -gt 0) {
                $BodyMetaData.'iconCode' = $iconCode
            }
            If ($iconSet.Length -gt 0) {
                $BodyMetaData.'iconSet' = $iconSet
            }
            [string]$old_values = $ViewSetup.CreateOldValues()
            $BodyMetaData.'_oldValues' = $old_values
            $BodyMetaData.'_operationType' = 'update'
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_componentId' = 'ViewSetupEditForm'
            $BodyMetaData.'_dataSource' = 'ViewSetupDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$ViewSetup_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "View Setup $ViewSetup_simpleId was successfully updated"
            $Error.Clear()
            Try {
                [ANOWViewSetup]$UpdatedViewSetup = $results.response.data | Select-Object -First 1
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to parse the returned updated object to an [ANOWViewSetup] object due to [$Message]. The object was still updated though."
                Break
            }
            If ($Quiet -ne $true) {
                Return $UpdatedViewSetup
            }
        }
    }
    End {
    }
}

Function New-AutomateNOWViewSetup {
    <#
    .SYNOPSIS
    Creates a View Setup on an AutomateNOW! instance

    .DESCRIPTION
    Creates a View Setup on an AutomateNOW! instance

    .PARAMETER Id
    The Id of the View. This will be used as the display title if the title is not specified. This property is permanent and cannot be changed after the fact.

    .PARAMETER ViewId
    The type of View. This is mandatory. Options are: admin_configuration; admin_deleted_domain_list; admin_domain; admin_domain_list; admin_failed_events; admin_license; admin_log_queue; admin_monitoring; admin_processing_function_list; admin_security; archive_event_log; archive_list; archive_overview; collaborate_approval_configuration_list; collaborate_migration_export; collaborate_migration_import; collaborate_note_list; collaborate_note_wall; collaborate_workspace_list; dashboard; design_business_view_list; design_interface_list; design_list; design_result_mapping_list; domain_audit_log; domain_cost_center_list; domain_deleted_object_list; domain_design_template_list; domain_diagram; domain_folder_list; domain_processing_consumption_log_list; domain_processing_type_list; domain_secret_vault_list; domain_tag_list; domain_trigger_log; domain_view_setup_list; node_agent_list; node_endpoint_list; node_event_log; node_group_list; node_list; node_tree; processing_business_view_list; processing_calendar; processing_domain_failed_events; processing_event_log; processing_list; processing_overview; processing_overview_across_domain; processing_runtime_action_edit; processing_runtime_action_list; processing_state; processing_tiles; processing_timeline; processing_week; report_adhoc; report_dashboard; report_user; resource_anomaly_list; resource_data_source_list; resource_event_log; resource_list; schedule_calendar; schedule_item_calendar; schedule_item_instance_list; schedule_items; schedule_list; schedule_timeline; schedule_time_triggers; self_service_design; self_service_processing; welcome; collaborate_notification_channel_list; collaborate_notification_group_list; collaborate_notification_list; collaborate_notification_message_template_list; self_service_trigger;

    .PARAMETER Title
    Alternative display title for the View Setup. This is what the user will see. This property can be changed later on.

    .PARAMETER textColor
    Optional hex RGB for the foreground (text) color or you can select 'transparent'. Colors require the # character and it is case sensitive. The default value is '#FFFFFF'.

    .PARAMETER backgroundColor
    Optional hex RGB for the background color or you can select 'transparent'. Colors require the # character and it is case sensitive. The default value is '#FF0000'.

    .PARAMETER iconSet
    Optional name of the icon library. Possible choices are: FAT_COW, FUGUE and FONT_AWESOME.

    .PARAMETER iconCode
    Mandatory (if -iconSet is used) name of the icon from the selected library. These are case-sensitive.

    .PARAMETER Public
    A switch parameter that will set the View Setup as public. Note that this option is not available in the UI during creation of the view but it is available later when editing.

    .PARAMETER CommandText
    A string parameter (JSON COMPLIANT!) for setting the content of the View Setup. You'd better know what you are doing here.

    .PARAMETER Quiet
    A switch parameter that will suppress the output of the newly created View Setup.

    .INPUTS
    Id's can be sent across the pipeline.

    .OUTPUTS
    The newly created [ANOWViewSetup] object will be returned

    .EXAMPLE
    Creates a View Setup named 'ViewSetup1' of type processing-list with a text color of '#111111', a background color of '#FFFFFF', the abacus icon from the Fat Cow set and the content of the view itself.

    New-AutomateNOWViewSetup -Id 'ViewSetup1' -ViewId 'processing-list' -textColor '#111111' -backgroundColor '#FFFFFF' -iconCode 'abacus' -IconSet 'FAT_COW' -CommandText '{field:"[{name:\"id\"},{name:\"flags\",width:80},{name:\"description\"},{name:\"workspace\",width:150},{name:\"codeRepository\",width:80},{name:\"tags\",width:120},{name:\"type\",width:220},{name:\"serverNodeType\",width:100},{name:\"node\",width:150},{name:\"endpoint\",width:150}]",sort:{fieldName:"id",sortDir:"ascending",sortSpecifiers:[{property:"id",direction:"ascending"}]},filter:{_constructor:"AdvancedCriteria",operator:"and",criteria:[{fieldName:"processingType",operator:"inSet",value:["TASK","WORKFLOW"]}]},hilite:null}'

    .EXAMPLE
    Creates a View Setup named 'ViewSetup1' same as previous example but without any content.

    New-AutomateNOWViewSetup -Id 'ViewSetup11' -ViewId 'processing-list' -textColor '#111111' -backgroundColor '#FFFFFF' -iconCode 'abacus' -IconSet 'FAT_COW'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    If the -iconSet parameter is specified then -iconCode must also be specified. You cannot specify one without the other nor can you combine these with -RemoveIcon.

    Do make sure you know what you are doing with respect to the -CommandText parameter. This must be a valid payload.

    #>
    [OutputType([ANOWViewSetup])]
    [CmdletBinding()]
    Param(
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,}$' })]
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [string]$Id,
