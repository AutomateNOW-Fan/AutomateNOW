#region - Code Repository

Function Get-AutomateNOWCodeRepository {
    <#
    .SYNOPSIS
    Gets the Code Repositories from an AutomateNOW! instance

    .DESCRIPTION
    Gets the Code Repositories from an AutomateNOW! instance

    .PARAMETER Id
    Mandatory string containing the simple id of the Code Repository to fetch. You can pipeline a series of simple id strings, but may not enter an array. This parameter cannot be combined with -Folder or -Tags.

    .PARAMETER startRow
    Integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .PARAMETER Folder
    Optional string to filter the repository list by a particular Folder. This parameter cannot be combined with -Id.

    .PARAMETER Tags
    Optional string array of Tags to filter the repository list. The 'containsAny' operator is used. This parameter cannot be combined with -Id.

    .INPUTS
    Accepts a string representing the simple id of the Code Repository from the pipeline or individually (but not an array).

    .OUTPUTS
    An array of one or more [ANOWCodeRepository] class objects

    .EXAMPLE
    Gets the first page of Code Repository objects

    Get-AutomateNOWCodeRepository

    .EXAMPLE
    Gets a Code Repository object named 'CodeRepository1'

    Get-AutomateNOWCodeRepository -Id 'CodeRepository1'

    .EXAMPLE
    'CodeRepository1', 'CodeRepository2' | Get-AutomateNOWCodeRepository

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWCodeRepository[]])]
    [CmdletBinding(DefaultParameterSetName = 'Default')]
    Param(
        [Parameter(Mandatory = $True, ParameterSetName = 'Id', ValueFromPipeline = $true)]
        [string]$Id,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$endRow = 100,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [string]$Folder,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [string[]]$Tags
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($Tags.Count -gt 0) {
            ForEach ($tag_id in $Tags) {
                $Error.Clear()
                Try {
                    [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] running under Get-AutomateNOWCodeRepository due to [$Message]"
                    Break
                }
                If ($tag_object.simpleId.length -eq 0) {
                    Throw "Get-AutomateNOWTag failed to confirm that the tag [$tag_id] actually exists under Get-AutomateNOWCodeRepository. Please check the tag name and try again."
                }
            }
        }
        If ($endRow -le $startRow) {
            Write-Warning -Message "The endRow must be greater than the startRow. Please try again."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If ($_.Length -gt 0 -or $Id.Length -gt 0) {
            If ($_.Length -gt 0 ) {
                $BodyMetaData.'id' = $_
            }
            Else {
                $BodyMetaData.'id' = $Id
            }
            $BodyMetaData.'_textMatchStyle' = 'exact'
        }
        Else {
            $BodyMetaData.'_constructor' = 'AdvancedCriteria'
            $BodyMetaData.'operator' = 'and'
            $BodyMetaData.'_startRow' = $startRow
            $BodyMetaData.'_endRow' = $endRow
            $BodyMetaData.'_textMatchStyle' = 'substring'
            If ($Folder.Length -gt 0) {
                $BodyMetaData.'criteria1' = ('{"fieldName":"folder","operator":"equals","value":"' + $Folder + '"}')
            }
            If ($Tags.Count -gt 0) {
                If ($Tags.Count -gt 1) {
                    $Error.Clear()
                    Try {
                        [string]$TagString = $Tags | ConvertTo-JSON -Compress -Depth 100
                    }
                    Catch {
                        [string]$Message = $_.Exception.Message
                        Write-Warning -Message "ConvertTo-Json failed to convert the provided tag names under Get-AutomateNOWCodeRepository due to [$Message]."
                        Break
                    }
                }
                Else {
                    [string]$TagString = $Tags
                }
                $BodyMetaData.'criteria2' = ('{"fieldName":"tags","operator":"containsAny","value":' + $TagString + '}')
            }
        }
        $BodyMetaData.'_operationType' = 'fetch'
        $BodyMetaData.'_componentId' = 'CodeRepositoryList'
        $BodyMetaData.'_dataSource' = 'CodeRepositoryDataSource'
        $BodyMetaData.'isc_metaDataPrefix' = '_'
        $BodyMetaData.'isc_dataFormat' = 'json'
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/codeRepository/read?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.Command = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        $Error.Clear()
        Try {
            [ANOWCodeRepository[]]$CodeRepositories = $results.response.data
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Failed to parse the response into a series of [ANOWCodeRepository] objects due to [$Message]."
            Break
        }
        If ($CodeRepositories.Count -gt 0) {
            Return $CodeRepositories
        }
    }
    End {

    }
}

Function New-ANOWTemplateStartRequest {
    [CmdletBinding()]
    param([string]$Family, [hashtable]$Arguments)
    $ErrorActionPreference = 'Stop'
    $WarningPreference = 'Stop'
    if ((Confirm-AutomateNOWSession -Quiet) -ne $true) { throw 'Session not confirmed.' }
    $template = $Arguments[$Family + 'Template']
    $id = $template.id
    if ($Family -eq 'Schedule' -and $Arguments.ContainsKey('ScheduleTemplateId')) {
        if ([string]::IsNullOrEmpty($anow_session.current_domain)) { throw 'Domain missing.' }
        $id = '[' + $anow_session.current_domain + ']' + $Arguments.ScheduleTemplateId
    }
    if ([string]::IsNullOrEmpty($id)) { throw 'Template identity missing.' }
    $body = [ordered]@{ id = $id; runId = $id }
    if ($Family -ne 'Workflow' -or $Arguments.Priority -gt 0) {
        $body.priority = if ($Arguments.ContainsKey('Priority')) { $Arguments.Priority } else { 0 }
    }
    if ($null -ne $Arguments.TimeZone) { $body.timeZone = $Arguments.TimeZone.id }
    if ($Arguments.ContainsKey('ProcessingTimestamp')) {
        $body.processingTimestamp = if ($Family -eq 'Schedule') {
            $Arguments.ProcessingTimestamp.ToString('yyyy-MM-ddTHH:mm:ss.fff', [Globalization.CultureInfo]::InvariantCulture)
        } else { $Arguments.ProcessingTimestamp }
    } else {
        $body.processingTimestamp = [datetime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ss.fff', [Globalization.CultureInfo]::InvariantCulture)
    }
    $sequence = 1
    foreach ($tagId in $Arguments.Tags) {
        $tags = @(Get-AutomateNOWTag -Id $tagId)
        if ($tags.Count -ne 1 -or $tags[0].simpleId -cne $tagId) { throw 'Tag identity not confirmed.' }
        $body['tags' + $sequence] = $tagId
        $sequence++
    }
    if (-not [string]::IsNullOrEmpty($Arguments.Folder)) {
        $folders = @(Get-AutomateNOWFolder -Id $Arguments.Folder)
        if ($folders.Count -ne 1 -or $folders[0].simpleId -cne $Arguments.Folder) { throw 'Folder identity not confirmed.' }
        $body.folder = $Arguments.Folder
    }
    foreach ($option in @('hold', 'forceLoad', 'verboseMode')) {
        $body[$option] = if ($Arguments[$option] -eq $true) { 'true' } else { 'false' }
    }
    if (-not [string]::IsNullOrEmpty($Arguments.DelayedStartTime)) { $body.delayedStartTime = $Arguments.DelayedStartTime }
    $values = $Arguments[$Family + 'Parameters']
    $body.parameters = if ($null -ne $values -and $values.Count -gt 0) { ConvertTo-Json -InputObject $values -Compress -Depth 100 } else { '{}' }
    if ($Family -ne 'Schedule') {
        if (-not [string]::IsNullOrEmpty($Arguments.Name)) { $name = $Arguments.Name }
        elseif (-not $Arguments.ContainsKey('UseAutomaticName') -or $Arguments.UseAutomaticName -eq $true) {
            $names = @(New-AutomateNOWDefaultProcessingTitle -simpleId $template.simpleId)
            if ($names.Count -ne 1 -or $names[0] -isnot [string] -or [string]::IsNullOrEmpty($names[0])) { throw 'Name not confirmed.' }
            $name = $names[0]
        } else { throw 'Name missing.' }
        $body.name = $name
        if ($Arguments.ContainsKey('Description')) { $body.description = $Arguments.Description }
    }
    $body._operationType = if ($Family -eq 'Schedule') { 'update' } else { 'add' }
    $body._operationId = if ($Family -eq 'Schedule') { 'executeScheduleNow' } else { 'executeNow' }
    $body._textMatchStyle = 'exact'
    $body._dataSource = 'ProcessingDataSource'
    $body.isc_metaDataPrefix = '_'
    $body.isc_dataFormat = 'json'
    $form = ConvertTo-QueryString -InputObject $body
    if ($form -isnot [string] -or [string]::IsNullOrEmpty($form)) { throw 'Request encoding failed.' }
    $request = @{Command='/processing/executeNow';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$form}
    if ($Arguments.Synchronous -eq $true) { $request.Command = '/processing/executeProcessingSync' }
    if ($anow_session.NotSecure -eq $true) { $request.NotSecure = $true }
    return $request
}

Function ConvertTo-ANOWB2Result {
    [CmdletBinding()]
    param([object]$InputObject, [ValidateSet('Workflow','ServiceManager','Schedule','CodeRepository','SecretVault')][string]$Family,
        [switch]$Synchronous, [string]$ExpectedId)
    $result = [pscustomobject]@{Success=$false;Value=$null;RunId=$null}
    $type = switch ($Family) {
        Workflow { [ANOWWorkflow] }; ServiceManager { [ANOWServiceManager] }; Schedule { [ANOWSchedule] }
        CodeRepository { [ANOWCodeRepository] }; SecretVault { [ANOWSecretVault] }
    }
    $runtime = $Family -in @('Workflow','ServiceManager','Schedule')
    $values = [Collections.Generic.Dictionary[string,object]]::new([StringComparer]::OrdinalIgnoreCase)
    if ($InputObject -is [Collections.IDictionary]) {
        foreach ($key in $InputObject.Keys) {
            if ($key -isnot [string] -or $values.ContainsKey($key)) { return $result }
            $values.Add($key, $InputObject[$key])
        }
    } elseif ($null -ne $InputObject -and ($InputObject.GetType() -eq [System.Management.Automation.PSCustomObject] -or $InputObject.GetType() -eq $type)) {
        foreach ($property in $InputObject.PSObject.Properties) {
            if ($property.MemberType -notin @('NoteProperty','Property') -or $values.ContainsKey($property.Name)) { return $result }
            $values.Add($property.Name, $property.Value)
        }
    } else { return $result }
    if (-not $values.ContainsKey('id')) { return $result }
    $id = $values['id']
    if ($runtime) {
        if ($id -isnot [string] -and $id -isnot [sbyte] -and $id -isnot [byte] -and $id -isnot [int16] -and
            $id -isnot [uint16] -and $id -isnot [int32] -and $id -isnot [uint32] -and $id -isnot [int64] -and $id -isnot [uint64]) { return $result }
        [long]$runId = 0
        $idText = [Convert]::ToString($id, [Globalization.CultureInfo]::InvariantCulture)
        if ($idText -cnotmatch '^[0-9]+$' -or -not [long]::TryParse($idText, [Globalization.NumberStyles]::None,
                [Globalization.CultureInfo]::InvariantCulture, [ref]$runId) -or $runId -le 0) { return $result }
        $result.RunId = $runId
    } elseif ($id -isnot [string] -or [string]::IsNullOrEmpty($id) -or ($ExpectedId -and $id -cne $ExpectedId)) { return $result }
    if ($Synchronous -and $runtime) {
        $expectedType = if ($Family -eq 'Workflow') { 'WORKFLOW' } else { 'SERVICE' }
        if (-not $values.ContainsKey('processingType') -or [string]$values['processingType'] -cne $expectedType) { return $result }
    }
    $properties = [Collections.Generic.Dictionary[string,Reflection.PropertyInfo]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($property in $type.GetProperties([Reflection.BindingFlags]'Public,Instance')) {
        if ($property.CanWrite -and $property.GetIndexParameters().Count -eq 0) { $properties.Add($property.Name, $property) }
    }
    $staged = @{}
    foreach ($name in $values.Keys) {
        if (-not $properties.ContainsKey($name)) { return $result }
        $target = $properties[$name].PropertyType
        $underlying = [Nullable]::GetUnderlyingType($target)
        if ($null -eq $underlying) { $underlying = $target }
        $value = $values[$name]
        if ($null -eq $value -and $target.IsValueType -and $target -eq $underlying) { return $result }
        if ($null -ne $value -and $underlying -eq [bool] -and $value -isnot [bool]) { return $result }
        $converted = $null
        if (-not [System.Management.Automation.LanguagePrimitives]::TryConvertTo($value, $target,
                [Globalization.CultureInfo]::InvariantCulture, [ref]$converted)) { return $result }
        if ($null -ne $converted -and $underlying.IsEnum -and -not [Enum]::IsDefined($underlying, $converted)) { return $result }
        $staged[$properties[$name].Name] = $converted
    }
    # Assign every validated field directly; the processing copy constructors omit fields.
    $item = [Activator]::CreateInstance($type)
    foreach ($name in $staged.Keys) { $item.$name = $staged[$name] }
    $result.Value = $item
    $result.Success = $true
    return $result
}

Function Test-ANOWB2Response {
    [CmdletBinding()]
    param([object[]]$Envelopes, [switch]$AcknowledgmentOnly)
    if ($Envelopes.Count -ne 1 -or $null -eq $Envelopes[0].response -or
        -not (Test-ANOWSuccessStatus -Response $Envelopes[0].response)) { return $false }
    if (-not $AcknowledgmentOnly -and @($Envelopes[0].response.data).Count -ne 1) { return $false }
    return $true
}

Function ConvertTo-ANOWProtectedCredential {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][SecureString]$SecureValue, [switch]$IncludePrefix)
    $ErrorActionPreference = 'Stop'
    $WarningPreference = 'Stop'
    $plaintext = $null
    try {
        if ($PSVersionTable.PSVersion.Major -ge 7) {
            $plaintext = ConvertFrom-SecureString -SecureString $SecureValue -AsPlainText
        } else {
            [IntPtr]$pointer = [IntPtr]::Zero
            try {
                $pointer = ConvertTo-ANOWSecureStringBSTR -SecureString $SecureValue
                if ($pointer -eq [IntPtr]::Zero) { throw 'Credential allocation failed.' }
                $plaintext = ConvertFrom-ANOWSecureStringBSTR -Pointer $pointer
            } finally {
                if ($pointer -ne [IntPtr]::Zero) { Clear-ANOWSecureStringBSTR -Pointer $pointer }
            }
        }
        $encrypted = @(Protect-AutomateNOWEncryptedString -String $plaintext -IncludePrefix:$IncludePrefix)
        if ($encrypted.Count -ne 1 -or $encrypted[0] -isnot [string] -or
            [string]::IsNullOrEmpty($encrypted[0]) -or $encrypted[0] -ceq 'ENCRYPTED::') { throw 'Credential encryption failed.' }
        return $encrypted[0]
    } finally { $plaintext = $null }
}

Function New-ANOWUpdateCodeRepositoryRequest {
    [CmdletBinding(DefaultParameterSetName='Default')]
    Param(
