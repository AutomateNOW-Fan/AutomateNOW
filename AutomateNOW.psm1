Function Export-AutomateNOWDocumentation {
    <#
    .SYNOPSIS
    Exports User Documentation from an instance of AutomateNOW!

    .DESCRIPTION
    Exports User Documentation from an instance of AutomateNOW! to a local .csv file

    .PARAMETER Documentation
    Mandatory [ANOWDocumentationItem] object (Use Read-AutomateNOWDocumentation to retrieve them)

    .INPUTS
    ONLY [ANOWDocumentationItem] objects from the pipeline are accepted

    .OUTPUTS
    The [ANOWDocumentationItem] objects are exported to the local disk in CSV format

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Read-AutomateNOWDocumentation | Export-AutomateNOWDocumentation

    .NOTES
    You must present [ANOWDocumentationItem] objects to the pipeline to use this function.
    #>

    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWDocumentationItem]$Documentation
    )
    Begin {
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWDocumentationItem]$Documentation = $_
        }
        [string]$documentation_simpleid = ''
        If ($Documentation.id -match '\]') {
            [string]$documentation_simpleid = $Documentation.id -split ']' | Select-Object -Last 1
        }
        If ($documentation_simpleid.Length -eq 0) {
            Write-Warning -Message "It was not possible to extract the simple id from the provided documentation object"
            Break
        }
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-Documentation-' + $documentation_simpleid + '-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
        $Error.Clear()
        Try {
            $Documentation | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWDocumentationItem] object on the pipeline due to [$Message]"
            Break
        }
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
    End {
    }
}

