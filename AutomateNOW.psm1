                $batchStopped = $true
                Write-Warning 'Item update preparation failed or emitted a diagnostic. No request was submitted; later inputs were stopped.'
                return
            }
            $parameters = @{Command='/processingTemplateItem/update';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$prepared.Data[0].Body}
            if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
            $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            $verified = if ($sent.Succeeded) { Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWTemplateItemResponse) -OperationParameters @{Envelopes=$sent.Data;Context=$context} } else { $null }
            if ($null -eq $verified -or -not $verified.Succeeded -or $verified.Data.Count -ne 1) {
