    <#
    .SYNOPSIS
    Loads (updates) all of the Workflow Items within a waiting (on hold) Workflow in Lazy Mode so the items execute normally instead of in Lazy Mode on an AutomateNOW! instance

    .DESCRIPTION
    Loads (updates) all of the Workflow Items within a waiting (on hold) Workflow in Lazy Mode so the items execute normally instead of in Lazy Mode on an AutomateNOW! instance

    .PARAMETER Workflow
    An [ANOWWorkflow] object (on hold, waiting and in lazy mode) representing the Workflow to have items bypass the lazy mode and load normally.

    .PARAMETER Force
    Force the update without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to silence the informational message that is emitted

    .INPUTS
    ONLY [ANOWWorkflow] objects are accepted (including from the pipeline)

    .OUTPUTS
    An informational message will be written to the host

    .EXAMPLE
    Loads the items normally instead of in lazy mode for a Workflow with an Id (i.e. RunId) of 12345

    Get-AutomateNOWWorkflow -Id 12345 | Update-AutomateNOWWorkflowLazyItem

    .NOTES
    This function may only be used on Workflows in Lazy Mode that are in WAITING status due to a Hold status. To achieve this with a completed workflow, set it to Hold then Restart from beginning.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [ValidateScript({ ($_.lazyLoad -eq $true) -and ($_.processingType -eq 'WORKFLOW') -and ($_.processingStatus -eq 'WAITING') -and ($_.waitingReason -eq 'WAITING_RESUME') })]
        [Parameter(Mandatory = $false, ValueFromPipeline = $True)]
        [ANOWWorkflow]$Workflow,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = ('/processing/loadLazyItems')
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id -gt 0) {
            [ANOWWorkflow]$Workflow = $_
        }
        [int64]$Workflow_id = $Workflow.id
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess($($Workflow_id))) -eq $true) {
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.Add('id', $Workflow_id )
            $BodyMetaData.Add('comment', $null )
            $BodyMetaData.Add('reason', $null )
            $BodyMetaData.Add('_operationType', 'custom')
            $BodyMetaData.Add('_operationId', 'loadLazyItems')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_dataSource', 'ProcessingDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Workflow_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Successfully loaded the items Workflow Id: $Workflow_id normally instead of in lazy mode"
        }
    }
    End {

    }
}

Function Complete-AutomateNOWWorkflow {
    <#
    .SYNOPSIS
    Force Completes or Force Fails a Workflow on an AutomateNOW! instance

    .DESCRIPTION
    Force Completes or Force Fails a Workflow on an AutomateNOW! instance

    .PARAMETER Workflow
    An [ANOWWorkflow] object representing the Workflow to be completed

    .PARAMETER ForceFail
    Switch parameter that alters this function set 'Force Failed' instead of 'Force Completed'

    .PARAMETER KeepForcedStatus
    Optional switch parameter that keeps the 'Forced' status after the Agent updates.

    .PARAMETER ForbidChildrenStart
    Optional switch parameter that disallows child items from starting

    .PARAMETER AbortChildren
    Optional switch parameter that softly aborts executing items within the workflow

    .PARAMETER KillChildren
    Optional switch parameter that hard kills executing items within the workflow

    .PARAMETER ForceChildren
    Optional switch parameter that recursively force completes child items

    .PARAMETER Force
    Force the restart without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to suppress the informational message and the Force Completed Workflow

    .INPUTS
    ONLY [ANOWWorkflow] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWWorkflow] object is returned unless -Quiet is used

    .EXAMPLE
    Force Completes a Workflow with a (Run) Id of 123456. This is the equivalent to: Allow children processing | Restate status on child status change
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow

    .EXAMPLE
    Force Completes a Workflow with a (Run) Id of 123456. This is the equivalent to: Allow children processing | Keep completed status on child status change
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -KeepForcedStatus

    .EXAMPLE
    Force Completes a Workflow with a (Run) Id of 123456. This is the equivalent to: Disallow children processing | Disallow start but allow executing items to complete
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -KeepForcedStatus -ForbidChildrenStart

    .EXAMPLE
    Force Completes a Workflow with a (Run) Id of 123456. This is the equivalent to: Disallow children processing | Disallow start and softly abort executing items
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -KeepForcedStatus -ForbidChildrenStart -abortChildren

    .EXAMPLE
    Force Completes a Workflow with a (Run) Id of 123456. This is the equivalent to: Disallow children processing | Disallow start and hard kill executing items
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -KeepForcedStatus -ForbidChildrenStart -KillChildren

    .EXAMPLE
    Force Completes a Workflow with a (Run) Id of 123456. This is the equivalent to: Recursively force complete child items
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -ForceChildren

    .EXAMPLE
    Force Fails a Workflow with a (Run) Id of 123456. This is the equivalent to: Allow children processing | Restate status on child status change
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -ForceFail

    .EXAMPLE
    Force Fails a Workflow with a (Run) Id of 123456. This is the equivalent to: Allow children processing | Keep completed status on child status change
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -ForceFail -KeepForcedStatus

    .EXAMPLE
    Force Fails a Workflow with a (Run) Id of 123456. This is the equivalent to: Disallow children processing | Disallow start but allow executing items to complete
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -ForceFail -KeepForcedStatus -ForbidChildrenStart

    .EXAMPLE
    Force Fails a Workflow with a (Run) Id of 123456. This is the equivalent to: Disallow children processing | Disallow start and softly abort executing items
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -ForceFail -KeepForcedStatus -ForbidChildrenStart -abortChildren

    .EXAMPLE
    Force Fails a Workflow with a (Run) Id of 123456. Disallow children processing | Disallow start and hard kill executing items
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -ForceFail -KeepForcedStatus -ForbidChildrenStart -KillChildren

    .EXAMPLE
    Force Fails a Workflow with a (Run) Id of 123456. This is the equivalent to: Recursively force complete child items
    123456 | Get-AutomateNOWWorkflow | Complete-AutomateNOWWorkflow -ForceFail -ForceChildren

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Use the below table to achieve the equivalent effect from the UI:

    Allow children processing | Keep completed status on child status change            | -KeepForcedStatus
    Allow children processing | Restate status on child status change                   | (no parameters)
    Disallow children processing | Disallow start but allow executing items to complete | -KeepForcedStatus -ForbidChildrenStart
    Disallow children processing | Disallow start and softly abort executing items      | -KeepForcedStatus -ForbidChildrenStart -AbortChildren
    Disallow children processing | Disallow start and hard kill executing items         | -KeepForcedStatus -ForbidChildrenStart -KillChildren
    Recursively force complete child items                                              | -ForceChildren

    #>
    [OutputType([ANOWWorkflow])]
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'Default', ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWWorkflow]$Workflow,
        [Parameter(Mandatory = $false)]
        [switch]$ForceFail,
        [Parameter(Mandatory = $true, ParameterSetName = 'KeepForcedStatus')]
        [Parameter(Mandatory = $true, ParameterSetName = 'ForbidChildrenStart')]
        [Parameter(Mandatory = $true, ParameterSetName = 'abortChildren')]
        [Parameter(Mandatory = $true, ParameterSetName = 'killChildren')]
        [switch]$KeepForcedStatus,
        [Parameter(Mandatory = $true, ParameterSetName = 'ForbidChildrenStart')]
        [Parameter(Mandatory = $true, ParameterSetName = 'abortChildren')]
        [Parameter(Mandatory = $true, ParameterSetName = 'killChildren')]
        [switch]$ForbidChildrenStart,
        [Parameter(Mandatory = $true, ParameterSetName = 'abortChildren')]
        [switch]$AbortChildren,
        [Parameter(Mandatory = $true, ParameterSetName = 'killChildren')]
        [switch]$KillChildren,
        [Parameter(Mandatory = $true, ParameterSetName = 'ForceChildren')]
        [switch]$ForceChildren,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($ForceFail -ne $true) {
            [string]$command = '/processing/forceCompleted'
            [string]$operationId = 'forceCompleted'
            [string]$action = 'Force Completed'
        }
        Else {
            [string]$command = '/processing/forceFailed'
            [string]$operationId = 'forceFailed'
            [string]$action = 'Force Failed'
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_ -is [ANOWWorkflow]) {
            [ANOWWorkflow]$Workflow = $_
        }
        [int64]$Workflow_id = $Workflow.id
        [string]$current_Workflow_status = $current_Workflow.processingStatus
        If (($current_Workflow_status -eq 'FAILED') -and ($operationId -eq 'forceFailed')) {
            Write-Warning -Message "You cannot Force Fail an already failed Workflow"
            Break
        }
        ElseIf (($current_Workflow_status -eq 'COMPLETED') -and ($operationId -eq 'forceCompleted')) {
            Write-Warning -Message "You cannot Force Complete an already completed Workflow"
            Break
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($Workflow_id)")) -eq $true) {
            ## Begin warning ##
            ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
            $Error.Clear()
            Try {
                [ANOWWorkflow]$current_workflow = Get-AutomateNOWWorkflow -Id $Workflow_id
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWWorkflow failed to check if the Workflow [$Workflow_id] existed under Complete-AutomateNOWWorkflow due to [$Message]."
                Break
            }
            If ($current_workflow.id -eq 0) {
                Write-Warning -Message "The Workflow you specified does not seem to exist under Complete-AutomateNOWWorkflow"
                Break
            }
            [string]$current_workflow_status = $current_workflow.processingStatus
            If ($current_workflow_status -notin [ANOWProcessing_processingStatus].GetEnumNames()) {
                Write-Warning -Message "The processing status of the Workflow [$Workflow_id] cannot be read under Complete-AutomateNOWWorkflow"
                Break
            }
            ## End warning ##
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            If ($KeepForcedStatus -eq $true) {
                $BodyMetaData.Add('keepForcedStatus', 'true')
            }
            Else {
                $BodyMetaData.Add('keepForcedStatus', 'false')
            }
            If ($ForbidChildrenStart -eq $true) {
                $BodyMetaData.Add('forbidChildrenStart', 'true')
            }
            Else {
                $BodyMetaData.Add('forbidChildrenStart', 'false')
            }
            If ($KillChildren -eq $true) {
                $BodyMetaData.Add('killChildren', 'true')
            }
            Else {
                $BodyMetaData.Add('killChildren', 'false')
            }
            If ($AbortChildren -eq $true) {
                $BodyMetaData.Add('abortChildren', 'true')
            }
            Else {
                $BodyMetaData.Add('abortChildren', 'false')
            }
            If ($ForceChildren -eq $true) {
                $BodyMetaData.Add('forceChildren', 'true')
            }
            $BodyMetaData.Add('id', $Workflow_id )
            $BodyMetaData.Add('_operationType', 'custom')
            $BodyMetaData.Add('_operationId', $operationId)
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_dataSource', 'ProcessingDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Workflow_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            If ($Quiet -ne $true) {
                $Error.Clear()
                Try {
                    [ANOWWorkflow]$completed_workflow = Get-AutomateNOWWorkflow -Id $Workflow_id
                }
                Catch {
                    Write-Warning -Message "Get-AutomateNOWWorkflow failed to retrieve the Workflow (after it was already '$action') due to [$Message]"
                    Break
                }
                Return $completed_workflow
            }
        }
    }
    End {

    }
}

