                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            [int32]$preloaded_count = $results.response.data
            If ($Quiet -ne $true) {
                Write-Information -MessageData "$preloaded_count items were preloaded to $ScheduleTemplate_id"
