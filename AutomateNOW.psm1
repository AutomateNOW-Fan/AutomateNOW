    This function has aliases for backward compatibility: Set-AutomateNOWWorkflowTemplateItem, Set-AutomateNOWServiceManagerTemplateItem, Set-AutomateNOWScheduleTemplateItem

    #>
    [OutputType([ANOWProcessingTemplateItem])]
    [Alias('Set-AutomateNOWWorkflowTemplateItem', 'Set-AutomateNOWServiceManagerTemplateItem', 'Set-AutomateNOWScheduleTemplateItem')]
    [CmdletBinding(DefaultParameterSetName = 'WorkflowTemplateItem', SupportsShouldProcess, ConfirmImpact = 'High')]
