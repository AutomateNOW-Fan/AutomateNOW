    [PSCustomObject]$ANOWLookupTaskTypeToServerNodeType = $ANOWLookupTaskTypeToServerNodeType_JSON | ConvertFrom-JSON
    If ($TaskType.Length -gt 0) {
        [string[]]$TaskTypes = $ANOWLookupTaskTypeToServerNodeType."$TaskType"
        If ($TaskTypes.Count -gt 0) {
            Return $TaskTypes | Sort-Object
        }
        Else {
            Write-Warning -Message "There are no Task Types that match [$TaskType]"
        }
    }
    ElseIf ($ServerNodeType.Length -gt 0) {
        [string[]]$ServerNodeTypes = ForEach ($property in $ANOWLookupTaskTypeToServerNodeType.PSObject.Properties) {
            If ($property.Value -contains "$ServerNodeType") {
                $property.Name
            }
        }
        If ($ServerNodeTypes.Count -gt 0) {
            Return $ServerNodeTypes | Sort-Object
        }
        Else {
            Write-Warning -Message "There are no Server Node Types that match [$ServerNodeType]"
        }
    }
    ElseIf ($All -eq $true) {
        Return $ANOWLookupTaskTypeToServerNodeType | Sort-Object
    }
    Else {
        Write-Warning -Message "Unable to resolve which output to return!"
        Break
    }
}

