#region - Audit Log

Function Read-AutomateNOWAuditLog {
    <#
    .SYNOPSIS
    Reads the Audit log from an instance of AutomateNOW!

    .DESCRIPTION
    The `Read-AutomateNOWAuditLog` cmdlet gets the Audit log from an instance of AutomateNOW!

    .PARAMETER TableName
    An optional string to filter the results based on the name of the table. The list of tables is not defined. Some examples are: server_node, processing_template.

    .PARAMETER ObjectId
    An optional string to filter the results based on the name of the object. This is the Id of the object which means the domain is prefixed in brackets (see examples).

    .PARAMETER ActionType
    An optional string to filter the results based on type. Valid choices are: UPDATE, INSERT and DELETE

    .PARAMETER startRow
    An optional int32 representing what row to start the download from. The default is 0.

    .PARAMETER endRow
    An optional int32 representing how many rows of data to receive. The default is 100.

    .PARAMETER Ascending
    Optional switch parameter which changes the sort order (of the actionTimestamp property) from the default descending to ascending

    .INPUTS
    None. You cannot pipe objects to Read-AutomateNOWAuditLog.

    .OUTPUTS
    An array of PSCustomObjects

    .EXAMPLE
    Gets the most recent 100 audit log entries

    Read-AutomateNOWAuditLog

    .EXAMPLE
    Gets the most recent 1000 audit log entries

    Read-AutomateNOWAuditLog -startRow 0 -endRow 1000

    .EXAMPLE
    Gets the most recent 1000 audit log entries of type UPDATE (which means INSERT and DELETE are not included)

    Read-AutomateNOWAuditLog -startRow 0 -endRow 1000 -ActionType UPDATE

    .EXAMPLE
    Gets the oldest 1000 audit log entries

    Read-AutomateNOWAuditLog -startRow 0 -endRow 1000 -Ascending

    .EXAMPLE
    Gets the first 100 audit log entries pertaining to server nodes.

    Read-AutomateNOWAuditLog -TableName 'server_node'

    .EXAMPLE
    Gets the first page of audit log entries pertaining to a server node named 'ServerNode1' on a domain called 'Domain1'.

    Read-AutomateNOWAuditLog -ObjectId '[Domain1]ServerNode1'

    .EXAMPLE
    Gets the first page of audit log entries for a processing template named 'TaskTemplate1' in a domain named 'Domain1'. This approach works for users without domain admin rights.

    Read-AutomateNOWAuditLog -TableName 'processing_template' -ObjectId '[Domain1]TaskTemplate1'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The sort order from the console is by timestamp which is NOT ACCURATE! This function will sort by Id instead which is guaranteed to be unique.

    Sorting does not seem to work when using -ObjectId and possibly other parameters. You may need to sort the results again in that case.

    By default this function uses the AuditLog/read endpoint which requires domain admin rights. However, if both TableName and ObjectID are specified then this function will use the AuditLog/get endpoint which does not require domain admin rights.

    #>
    [OutputType([ANOWAuditLog[]])]
    [Alias('Get-AutomateNOWAuditLog')]
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $False)]
        [ANOWAuditLog_tableName]$TableName,
        [ValidateScript({ $_ -match '^\[[0-9a-zA-Z_.-]{1,255}][0-9a-zA-Z_.-]{1,}$' })]
        [Parameter(Mandatory = $False)]
        [string]$ObjectId,
        [ValidateSet('UPDATE', 'INSERT', 'DELETE', IgnoreCase = $false)]
        [Parameter(Mandatory = $False)]
        [string]$ActionType,
        [Parameter(Mandatory = $False)]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False)]
        [int32]$endRow = 100,
        [Parameter(Mandatory = $False)]
        [switch]$Ascending
    )
    If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
        Write-Warning -Message "There is not a valid token confirmed."
        Break
    }
    If ($endRow -lt $startRow) {
        Write-Warning -Message "The end row must be higher then the start row"
        Break
    }
    If ($TableName.Length -gt 0 -and $ObjectId.Length -gt 0) {
        [string]$mode = 'get'
        [string]$TextMatchStyle = 'exact'
    }
    Else {
        [string]$mode = 'read'
        [string]$TextMatchStyle = 'substring'
    }
    [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
    If ($mode -eq 'read') {
        If (($ActionType.Length -gt 0) -or ($TableName.Length -gt 0) -or ($ObjectId.Length -gt 0)) {
            $BodyMetaData.Add('operator', 'and')
            $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
            If ($ActionType.Length -gt 0) {
                $BodyMetaData.Add('criteria1', '{"fieldName":"actionType","operator":"equals","value":"' + $ActionType + '"}')
            }
            If ($TableName.Length -gt 0) {
                $BodyMetaData.Add('criteria2', '{"fieldName":"tableName","operator":"equals","value":"' + $TableName + '"}')
            }
            If ($ObjectId.Length -gt 0) {
                $BodyMetaData.Add('criteria3', '{"fieldName":"objectId","operator":"equals","value":"' + $ObjectId + '"}')
            }
        }
    }
    Else {
        $BodyMetaData.Add('tableName', $TableName)
        $BodyMetaData.Add('objectId', $ObjectId)
        If ($ActionType.Length -gt 0) {
            $BodyMetaData.Add('actionType', $ActionType)
        }
    }
    $BodyMetaData.Add('_operationType', 'fetch')
    $BodyMetaData.Add('_startRow', $startRow)
    $BodyMetaData.Add('_endRow', $endRow)
    If ($Ascending -ne $true) {
        $BodyMetaData.Add('_sortBy', '-id')
    }
    Else {
        $BodyMetaData.Add('_sortBy', 'id')
    }
    $BodyMetaData.Add('_textMatchStyle', $TextMatchStyle)
    If ($mode -eq 'Get') {
        $BodyMetaData.Add('_operationId', 'get')
        [string]$componentId = 'AuditLogEventListWindow_list'
    }
    Else {
        [string]$componentId = 'AuditLogEventList'
    }
    $BodyMetaData.Add('_componentId', $componentId)
    $BodyMetaData.Add('_dataSource', 'AuditLogDataSource')
    $BodyMetaData.Add('isc_metaDataPrefix', '_')
    $BodyMetaData.Add('isc_dataFormat', 'json')
    [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
    [string]$command = ('/auditLog/' + $mode + '?' + $Body)
    [string]$Instance = $anow_session.Instance
    [hashtable]$parameters = @{}
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'GET')
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    $parameters.Add('Instance', $Instance)
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    $Error.Clear()
    Try {
        [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
        Break
    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
        Break
    }
    [int32]$AuditLogs_count = $results.response.data.Count
    If ($AuditLogs_count -eq 0 -and $startRow -gt 0) {
        Write-Warning -Message "There are not any more rows of data past this point. Please try different -startRow value."
        Break
    }
    $Error.Clear()
    Try {
        [ANOWAuditLog[]]$AuditLogs = ForEach ($entry in $results.response.data) {
            Try {
                $entry | Add-Member -MemberType NoteProperty -Name changedValuesText -TypeName String -Value ''
                $entry | Add-Member -MemberType NoteProperty -Name changedValues -TypeName PSCustomObject -Value ''
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Add-Member failed to add the NoteProperty changedValues to an audit log UPDATE entry due to [$Message]."
                Break
            }
            If ($entry.actionType -eq 'UPDATE') {
                $Error.Clear()
                Try {
                    [PSCustomObject]$ChangedValues = Compare-ObjectProperty -ReferenceObject $entry.oldValues -DifferenceObject $entry.newValues
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Compare-ObjectProperty failed to compare an audit log UPDATE entry due to [$Message]."
                    Break
                }
                $Error.Clear()
                Try {
                    [PSCustomObject[]]$ObjectValues = $ChangedValues | ForEach-Object { [PSCustomObject]@{ name = $_.PropertyName; oldValue = $_.RefValue; newValue = $_.DiffValue; } }
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "ForEach-Object failed to format an audit log UPDATE entry due to [$Message]."
                    Break
                }
                $Error.Clear()
                Try {
                    [string]$JSONValues = $ObjectValues | Sort-Object -Property name | ConvertTo-Json -Compress -Depth 100
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "ConvertTo-Json failed to convert an audit log UPDATE entry due to [$Message]."
                    Break
                }
                $entry.changedValues = $ObjectValues
                $entry.changedValuesText = $JSONValues
            }
            $entry
        }
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Failed to parse the returned AuditLog entries under Read-AutomateNOWAuditLog due to [$Message]."
        Break
    }
    Return $AuditLogs
}

Function Invoke-ANOWReadRequest {
    [CmdletBinding()]
    param([Collections.IDictionary]$Metadata,[hashtable]$Parameters)
    $ErrorActionPreference='Stop'
    $query=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$Metadata}
    if(-not $query.Succeeded -or $query.Data.Count -ne 1 -or $query.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($query.Data[0])){
        throw 'The read query was not cleanly serialized.'
    }
    $requestParameters=@{}
    foreach($key in $Parameters.Keys){$requestParameters[$key]=$Parameters[$key]}
    if($requestParameters.Method -ceq 'GET'){$requestParameters.Command+='?'+$query.Data[0]}
    elseif($requestParameters.Method -ceq 'POST'){$requestParameters.Body=$query.Data[0]}
    else{throw 'The selected read method is unsupported.'}
    $request=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $requestParameters
    if(-not $request.Succeeded -or -not (Test-ANOWPreservationAcknowledgment $request.Data)){
        throw 'The read did not return one clean integral-zero acknowledgment.'
    }
    $data=$request.Data[0].response.data
    [object[]]$rows=@()
    if($null -ne $data){$rows=@($data)}
    return [pscustomobject]@{Rows=$rows}
}

Function ConvertFrom-ANOWScopedReadRows {
    [CmdletBinding()]
    param(
        [ValidateSet('Branch','Conflict','OutOfSync','Tag','Processing','Group')][string]$Kind,
        [AllowEmptyCollection()][object[]]$Rows,[ANOWCodeRepository]$CodeRepository,
        [ANOWServerNodeGroup]$ServerNodeGroup,[string]$ExactId,[string]$BranchName,[ANOWServerNode]$ServerNode
    )
    $ErrorActionPreference='Stop'
    $WarningPreference='Stop'
    $type=switch -CaseSensitive ($Kind){
        Branch{[ANOWCodeRepositoryBranch]} Conflict{[ANOWCodeRepositoryConflictItem]}
        OutOfSync{[ANOWCodeRepositoryOutOfSyncItem]} Tag{[ANOWCodeRepositoryTag]}
        Processing{[ANOWProcessing]} Group{[ANOWServerNodeGroupItem]}
    }
    [ANOWCodeRepository]$repository=$CodeRepository
    [ANOWServerNodeGroup]$group=$ServerNodeGroup
    if($ExactId.Length -gt 0 -and $Rows.Count -gt 1){
        throw "Ambiguous exact $Kind lookup [$ExactId]: $($Rows.Count) rows were returned."
    }
    [long]$expectedProcessing=0
    [guid]$expectedGroup=[guid]::Empty
    if($ExactId.Length -gt 0){
        if($Kind -ceq 'Processing' -and (-not [long]::TryParse($ExactId,[ref]$expectedProcessing) -or $expectedProcessing -le 0)){
            throw 'A positive integral Processing ID is required.'
        }
        if($Kind -ceq 'Group' -and -not [guid]::TryParse($ExactId,[ref]$expectedGroup)){throw 'A valid Group Item GUID is required.'}
    }
    $allowed=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach($property in $type.GetProperties()){$null=$allowed.Add($property.Name)}
    $converted=[Collections.Generic.List[object]]::new()
    foreach($row in $Rows){
        if($null -eq $row -or ($row -isnot [Collections.IDictionary] -and
            $row -isnot [Management.Automation.PSCustomObject] -and -not $type.IsInstanceOfType($row))){
            throw "A strict $Kind response object is required."
        }
        $names=if($row -is [Collections.IDictionary]){@($row.Keys)}else{@($row.PSObject.Properties.Name)}
        foreach($name in $names){if($name -isnot [string] -or -not $allowed.Contains($name)){throw "The $Kind response has an unsupported member [$name]."}}
        if($Kind -ceq 'Processing'){
            [long]$returnedId=0
            if(($row.id -isnot [int] -and $row.id -isnot [long] -and $row.id -isnot [string]) -or
                -not [long]::TryParse([string]$row.id,[ref]$returnedId) -or $returnedId -le 0){throw 'The returned Processing ID is invalid.'}
            if($ExactId.Length -gt 0 -and $returnedId -ne $expectedProcessing){
                throw "Requested Processing [$ExactId] but received [$returnedId]."
            }
        }else{
            if($row.id -isnot [string] -or [string]::IsNullOrWhiteSpace($row.id)){throw "The returned $Kind object has no string identity."}
            if($Kind -ceq 'Group' -and $ExactId.Length -gt 0){
                [guid]$returnedGroup=[guid]::Empty
                if(-not [guid]::TryParse($row.id,[ref]$returnedGroup) -or $returnedGroup -ne $expectedGroup){
                    throw "Requested Group Item [$ExactId] but received [$($row.id)]."
                }
            }
        }
        $parentProperty=if($Kind -ceq 'Group'){'serverNodeGroup'}elseif($Kind -cin @('Branch','Conflict','OutOfSync','Tag')){'codeRepository'}else{''}
        if($parentProperty.Length -gt 0){
            $reference=$row.$parentProperty
            if($null -ne $reference -and -not ($reference -is [string] -and $reference.Length -eq 0)){
                if($reference -is [string]){$referenceId=$reference}
                elseif($Kind -ceq 'Group'){
                    [ANOWServerNodeGroup]$rawGroup=$reference
                    $referenceId=$rawGroup.id
                }elseif($Kind -cne 'Tag'){
                    [ANOWCodeRepository]$rawRepository=$reference
                    $referenceId=$rawRepository.id
                }else{throw 'The returned tag repository reference must be a string.'}
                $expectedParent=if($Kind -ceq 'Group'){$group.id}else{$repository.id}
                if($referenceId -isnot [string] -or $referenceId -cne $expectedParent){
                    throw "The raw $Kind parent [$referenceId] does not match [$expectedParent]."
                }
            }
        }
        if($Kind -ceq 'Group' -and $null -ne $ServerNode){
            if($row.serverNode -isnot [string] -or
                ($row.serverNode -cne $ServerNode.id -and
                 ([string]::IsNullOrEmpty($ServerNode.simpleId) -or $row.serverNode -cne $ServerNode.simpleId))){
                throw 'The returned Group Item does not reference the selected Server Node.'
            }
        }
        # Hashtable conversion also preserves native nullable DateTime values.
        $candidate=@{}
        foreach($name in $names){$candidate[$name]=$row.$name}
        if($Kind -ceq 'Group'){$candidate['serverNodeGroup']=$group}
        elseif($Kind -cin @('Branch','Conflict','OutOfSync')){$candidate['codeRepository']=$repository}
        $item=switch -CaseSensitive ($Kind){
            Branch{[ANOWCodeRepositoryBranch]$candidate} Conflict{[ANOWCodeRepositoryConflictItem]$candidate}
            OutOfSync{[ANOWCodeRepositoryOutOfSyncItem]$candidate} Tag{[ANOWCodeRepositoryTag]$candidate}
            Processing{[ANOWProcessing]$candidate} Group{[ANOWServerNodeGroupItem]$candidate}
        }
        if(($Kind -ceq 'Group' -and ($null -eq $item.serverNodeGroup -or $item.serverNodeGroup.id -cne $group.id)) -or
            ($Kind -cin @('Branch','Conflict','OutOfSync') -and ($null -eq $item.codeRepository -or $item.codeRepository.id -cne $repository.id))){
            throw "Strict $Kind conversion did not preserve the selected parent identity."
        }
        $converted.Add($item)
    }
    $items=$converted.ToArray()
    if($Kind -ceq 'Branch' -and $BranchName.Length -gt 0){
        $items=@($items|Where-Object {[string]::Equals($_.id,$BranchName,[StringComparison]::Ordinal)})
        if($items.Count -gt 1){throw "Ambiguous exact Branch name [$BranchName]: $($items.Count) matches were returned."}
    }
    return $items
}

Function Read-ANOWCodeRepositoryCollection {
    [CmdletBinding()]
    param(
        [ValidateSet('Branch','Conflict','OutOfSync','Tag')][string]$Kind,
        [ANOWCodeRepository]$CodeRepository,[int]$StartRow,[int]$EndRow,[string]$Name,[switch]$StringOnly
    )
    $ErrorActionPreference='Stop'
    if($null -eq $CodeRepository -or [string]::IsNullOrWhiteSpace($CodeRepository.id)){throw 'An identified Code Repository is required.'}
    $route=switch -CaseSensitive ($Kind){
        Branch{@('/codeRepositoryBranch/read','CodeRepositoryBranchList','CodeRepositoryBranchDataSource')}
        Conflict{@('/codeRepositoryConflict/read','CodeRepositoryConflictList','CodeRepositoryConflictDataSource')}
        OutOfSync{@('/outOfSyncObject/read','OutOfSyncListWindow_list','OutOfSyncObjectDataSource')}
        Tag{@('/codeRepositoryTag/read','CodeRepositoryTagList','CodeRepositoryTagDataSource')}
    }
    $metadata=[ordered]@{codeRepository=$CodeRepository.id}
    if($Kind -ceq 'Tag'){$metadata['_operationType']='fetch'}
    $metadata['_startRow']=$StartRow;$metadata['_endRow']=$EndRow
    if($Kind -cne 'Tag'){$metadata['_operationType']='fetch'}
    $metadata['_textMatchStyle']='exact';$metadata['_componentId']=$route[1];$metadata['_dataSource']=$route[2]
    $metadata['isc_metaDataPrefix']='_';$metadata['isc_dataFormat']='json'
    $parameters=@{Command=$route[0];Method='GET'}
    if($anow_session.NotSecure -eq $true){$parameters['NotSecure']=$true}
    $response=Invoke-ANOWReadRequest -Metadata $metadata -Parameters $parameters
    $items=@(ConvertFrom-ANOWScopedReadRows -Kind $Kind -Rows $response.Rows -CodeRepository $CodeRepository -BranchName $Name)
    if($StringOnly){foreach($item in $items){[string]$item.id}}else{$items}
}

Function New-ANOWProcessingListMetadata {
    [CmdletBinding()]
    param([hashtable]$Options)
    $ErrorActionPreference='Stop'
    [string]$id=$Options.Id
    if($id.Length -gt 0){
        [long]$number=0
        if(-not [long]::TryParse($id,[ref]$number) -or $number -le 0){throw 'A positive integral Processing ID is required.'}
    }
    $metadata=[ordered]@{}
    [string]$component=''
    if($Options.ParameterSet -ceq 'Id' -and -not $Options.ItemsOnly){
        $metadata['id']=$id;$metadata['_operationId']='read';$style='exactCase'
    }else{
        $metadata['_constructor']='AdvancedCriteria';$metadata['operator']='and'
        $metadata['_startRow']=$Options.startRow;$metadata['_endRow']=$Options.endRow
        $metadata['_operationType']='fetch';$style='substring'
        if(([string]$Options.sortBy).Length -gt 0){
            $metadata['_sortBy']=if($Options.Descending){'-'+$Options.sortBy}else{$Options.sortBy}
        }
        $criteria=[Collections.Generic.List[object]]::new()
        $criteria.Add([ordered]@{fieldName='isProcessing';operator='equals';value=$true})
        if($Options.OnlyArchived){$criteria.Add([ordered]@{fieldName='archived';operator='equals';value=$true})}
        elseif(-not $Options.IncludeArchived -and $id.Length -eq 0){$criteria.Add([ordered]@{fieldName='archived';operator='equals';value=$false})}
        if($id.Length -gt 0){
            $criteria.Add([ordered]@{fieldName='parent';value=[string]$number;operator='equals'})
            $component='ProcessingItemList'
        }elseif($Options.Overview){
            $criteria.Add([ordered]@{fieldName='parent';value=$null;operator='equals'})
            $criteria.Add([ordered]@{fieldName='isRoot';value=$true;operator='equals'})
            $component='ProcessingTreeGrid';$metadata['_operationId']='ProcessingDataSource_fetch';$style='exact'
        }elseif($Options.launchedById -gt 0){
            $criteria.Add([ordered]@{fieldName='parent';value=$null;operator='equals'})
            $criteria.Add([ordered]@{fieldName='launchedById';operator='equals';value=[string]$Options.launchedById})
            $criteria.Add([ordered]@{fieldName='isRoot';operator='equals';value=$true})
        }else{$component='ProcessingList'}
        if($Options.ContainsKey('ProcessingType')){$criteria.Add([ordered]@{fieldName='processingType';operator='equals';value=[string]$Options.ProcessingType})}
        if($Options.ContainsKey('ProcessingStatus')){$criteria.Add([ordered]@{fieldName='processingStatus';operator='equals';value=[string]$Options.ProcessingStatus})}
        if(([string]$Options.Folder).Length -gt 0){$criteria.Add([ordered]@{fieldName='folder';operator='equals';value=$Options.Folder})}
        if($null -ne $Options.Tags -and $Options.Tags.Count -gt 0){
            $tagValue=if($Options.Tags.Count -eq 1){[string]$Options.Tags[0]}else{,[string[]]$Options.Tags}
            $criteria.Add([ordered]@{fieldName='tags';operator='containsAny';value=$tagValue})
        }
        $index=0
        foreach($criterion in $criteria){
            $json=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-Json) -OperationParameters @{InputObject=$criterion;Compress=$true;Depth=10}
            if(-not $json.Succeeded -or $json.Data.Count -ne 1 -or $json.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($json.Data[0])){
                throw 'A processing criterion was not cleanly serialized.'
            }
            $parsed=ConvertFrom-ANOWPrivateJson -Json $json.Data[0]
            if(-not $parsed.Succeeded -or $parsed.Value.fieldName -cne $criterion.fieldName -or $parsed.Value.operator -cne $criterion.operator){
                throw 'A processing criterion is not valid matching JSON.'
            }
            $index++;$metadata['criteria'+$index]=$json.Data[0]
        }
    }
    $metadata['_componentId']=$component;$metadata['_dataSource']='ProcessingDataSource'
    $metadata['_textMatchStyle']=$style;$metadata['isc_metaDataPrefix']='_';$metadata['isc_dataFormat']='json'
    return $metadata
}

Function Export-AutomateNOWAuditLog {
    <#
    .SYNOPSIS
    Exports the AuditLog entries from an instance of AutomateNOW!

    .DESCRIPTION
    CSV explicitly excludes oldValues/newValues/changedValues while preserving their text counterparts, metadata, rows and tab delimiter in both supported hosts.

    Exports the AuditLog entries from an instance of AutomateNOW! to a local .csv file

    .PARAMETER AuditLog
    Mandatory [ANOWAuditLog] object (Use Read-AutomateNOWAuditLog to retrieve them)

    .INPUTS
    ONLY [ANOWAuditLog] objects are accepted (including from the pipeline)

    .OUTPUTS
    The [ANOWAuditLog] objects are exported to the local disk in CSV format

    .EXAMPLE
    Read-AutomateNOWAuditLog | Export-AutomateNOWAuditLog

    .NOTES
    You must present [ANOWAuditLog] objects to the pipeline to use this function.
    #>

    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWAuditLog]$AuditLog
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-AuditLogs-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        $parameters.Add('Delimiter', "`t")
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWAuditLog]$AuditLog = $_
        }
        $Error.Clear()
        Try {
            $AuditLog | Select-Object -Property * -ExcludeProperty oldValues, newValues, changedValues | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWAuditLog] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function Write-AutomateNOWObjectVersion {
    <#
    .SYNOPSIS
    Writes to disk all versions of a supplied object that exist in the Design Modification Log (a.k.a. the audit log)

    .DESCRIPTION
    c:\temp\AutomateNOWTesting\[Test]TestPythonTask.py_version-20250910231156-111120-INSERT.json

    .PARAMETER Object
    Mandatory ANOW object to write from.

    .PARAMETER DestinationPath
    Optional path for the outgoing exported objects to be written to. Use this if you want the exported JSON file to be written somewhere other than the current path.

    .PARAMETER Quiet
    Switch parameter that suppresses the informational message when each previous version of the object is written to disk.

    .INPUTS
    An ANOW object

    .OUTPUTS
    Up to 10,000 versions of the provided .json file will be generated to disk. Example: '[Test]MyPowerShellScript.ps1_version-20350719074533-UPDATE.json'

    .EXAMPLE
    Writes all of the versions of a Task Template named 'TaskTemplate1' to disk (one-liner)

    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Write-AutomateNOWObjectVersion

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    This function will always overwrite the output file if it exists.

    This function should be considered experimental.

    The format of the outgoing filename is: (the Id of the object) + '_version-' + (the timestamp of the log entry) + (the unique id of the log entry) + (the type of log entry) + '.json'

    WARNING: do not attempt to import the output objects into the Migration Import feature. These are not the same.

    #>
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [Base]$Object,
        [ValidateScript({ (Test-Path -Path "$_") -eq $true })]
        [Parameter(Mandatory = $false)]
        [string]$DestinationPath = ".",
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
    }
    Process {
        If ($null -ne $_) {
            [Base]$Object = $_
        }
        [string]$ObjectId = $Object.id
        [string]$TableName = Resolve-AutomateNOWObject2TableName -Object $Object
        If ($TableName -eq 'table_not_found') {
            [string]$object_type_name = $Object.GetType().FullName
            Write-Warning -Message "$ObjectId is of type $object_type_name but it could not be found in the lookup table."
            Break
        }
        $Error.Clear()
        Try {
            [ANOWAuditLog[]]$log_entries = Read-AutomateNOWAuditLog -ObjectId $ObjectId -TableName $TableName -startRow 0 -endRow 10000 | Sort-Object -Property id -Descending
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Read-AutomateNOWAuditLog failed to retrieve the entries about $ObjectID (under Write-AutomateNOWObjectVersion) due to [$Message]."
            Break
        }
        If ($log_entries.count -eq 0) {
            Write-Verbose -Message "There were no audit log entries for $ObjectId in the current domain."
            Return
        }
        Else {
            $log_entries_count = $log_entries.count
            If ($log_entries_count -eq 10000) {
                Write-Warning -Message "Unfortunately, $ObjectId has more Audit Log entries than is allowed."
                Break
            }
            Else {
                Write-Verbose -Message "Extracted $log_entries_count log entries for $ObjectId"
            }
        }
        If (($log_entries | Select-Object -Last 1 | Select-Object -ExpandProperty actionType) -eq 'INSERT') {
            Write-Verbose -Message "The oldest entry in the Audit Log for $ObjectID is an INSERT statement. This means we should be able to restore every version from the beginning."
        }
        ElseIf (($log_entries | Select-Object -Last 1 | Select-Object -ExpandProperty actionType) -eq 'UPDATE') {
            Write-Verbose -Message "The oldest entry in the Audit Log for $ObjectID is an UPDATE statement, not an INSERT. This means we don't have the complete history of this object from beginning to end."
        }
        ElseIf (($log_entries | Select-Object -Last 1 | Select-Object -ExpandProperty actionType) -eq 'DELETE') {
            Write-Warning -Message "The oldest entry in the Audit Log for $ObjectID is a DELETE statement, not an INSERT. This means we do not have the complete history of this object from beginning to end."
        }
        Else {
            Write-Warning -Message "It was not possible to process the extracted Audit Log entries for $ObjectId"
            Break
        }
        [ANOWAuditLog[]]$update_log_entries = $log_entries | Where-Object { ((-not ($_.changedvalues.count -eq 1 -and $_.changedvalues.name -eq 'last_updated')) -and ($_.actionType -eq 'UPDATE')) -or ($_.actionType -eq 'INSERT') }
        [int32]$update_log_entries_count = $update_log_entries.count
        If ($update_log_entries_count -eq 0) {
            Write-Warning -Message "The available audit log entries for $ObjectId only contain changes to the 'last_updated' property"
        }
        ForEach ($log_entry in $update_log_entries) {
            $Error.Clear()
            Try {
                [string]$actionTimestamp = $log_entry.actionTimestamp | Get-Date -Format 'yyyyMMddHHmmss'
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-Date failed to parse the parse the actionTimestamp into a date (under Write-AutomateNOWObjectVersion) due to [$Message]."
                Break
            }
            [int64]$log_entry_id = $log_entry.id
            If ($log_entry_id -eq 0) {
                Write-Warning -Message "The id of the provided log entry was 0. This cannot be possible."
                Break
            }
            [string]$actionType = $log_entry.actionType
            If ($actionType.Length -eq 0) {
                Write-Warning -Message "The actionType for this log entry (Id: $log_entry_id) is empty. How did this happen?"
                Break
            }
            [string]$outgoing_file_name = ($ObjectId + "_version-$actionTimestamp-$log_entry_id-$actionType.json")
            [string]$outgoing_file_path = Join-Path -Path $DestinationPath -ChildPath $outgoing_file_name
            If ($actionType.Length -eq 0) {
                Write-Warning -Message "The actionType of this log entry (Id: $log_entry_id) (under Write-AutomateNOWObjectVersion) could not be read."
                Break
            }
            [PSCustomObject]$new_values = $log_entry.newValues
            If ($null -eq $new_values) {
                Write-Warning -Message "The newValues value of this log entry (Id: $log_entry_id) (under Write-AutomateNOWObjectVersion) could not be read."
            }
            $Error.Clear()
            Try {
                [string]$new_values_json = @(, @($new_values)) | ConvertTo-Json -Depth 100 # Note this forces the json into a json array which is required for importing.
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "ConvertTo-Json failed to parse the newValues within this log entry (Id: $log_entry_id) (under Write-AutomateNOWObjectVersion) due to [$Message]."
                Break
            }
            $Error.Clear()
            Try {
                ("`n" + $new_values_json ) | Out-File -LiteralPath $outgoing_file_path -Force #Note the newline character (byte 0A) being prepended to the payload. This is to mimic the behavior of the ANOW console.
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Out-File failed to write this log entry (Id: $log_entry_id) to $outgoing_file_path (under Write-AutomateNOWObjectVersion) due to [$Message]."
                Break
            }
            If ($Quiet -ne $true) {
                If ((Test-Path -LiteralPath $outgoing_file_path) -eq $true) {
                    $Error.Clear()
                    Try {
                        [System.IO.FileSystemInfo]$outgoing_file_info = Get-Item -LiteralPath "$outgoing_file_path"
                    }
                    Catch {
                        [string]$Message = $_.Exception.Message
                        Write-Warning -Message "Get-Item failed to read the current exported file $outgoing_file_path (under Write-AutomateNOWObjectVersion) due to [$Message]."
                        Break
                    }
                    [int32]$filelength = $outgoing_file_info.Length
                    [string]$filelength_display = [math]::Round(($filelength / 1024), 2, 'ToZero')
                    Write-Information -MessageData "Saved '$outgoing_file_name' to disk ($filelength_display kb)"
                }
            }
        }
    }
    End {

    }
}

