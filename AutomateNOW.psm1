                $BodyMetaData.Add('processingActionOrder', $current_action_order )
                $BodyMetaData.Add('_operationType', 'update')
                $BodyMetaData.Add('_textMatchStyle', 'exact')
                $BodyMetaData.Add('_oldValues', $old_values)
                $BodyMetaData.Add('_componentId', 'ProcessingTemplateActionList')
                $BodyMetaData.Add('_dataSource', 'ProcessingTemplateActionDataSource')
                $BodyMetaData.Add('isc_metaDataPrefix', '_')
                $BodyMetaData.Add('isc_dataFormat', 'json')
                [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
                If ($null -eq $parameters.'Body') {
                    $parameters.Add('Body', $Body)
                }
                Else {
                    $parameters.'Body' = $Body
                }
                $Error.Clear()
                Try {
                    [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on Processing Template Action ($temp_ProcessingTemplateAction_id) due to [$Message]."
                    Break
                }
                [int32]$response_code = $results.response.status
                If ($response_code -ne 0) {
                    [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                    Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                    Break
                }
                Write-Verbose -Message "Processing Template Action ($temp_ProcessingTemplateAction_id) was successfully set to processingActionOrder [$current_action_order]"
                $current_action_order++
            }
            Write-Verbose -Message "Processing Template Action ($ProcessingTemplateAction_id) should now be at the bottom of the action list in $context_description."
        }
    }
    End {

    }
}

#endregion

#region - Processing Template Design Parameter

Function Read-AutomateNOWProcessingTemplateDesignParameter {
    <#
    .SYNOPSIS
    Reads the Design Parameter objects (also known as Processing Template Input or Output Parameter in the UI) that are associated with a Processing Template on an AutomateNOW! instance

    .DESCRIPTION
    Reads the Design Parameter objects (also known as Processing Template Input or Output Parameter in the UI) that are associated with a Processing Template on an AutomateNOW! instance

    .PARAMETER ProcessingTemplate
    An [ANOWProcessingTemplate] object representing the Processing Template to read the design parameters from.

    .PARAMETER Outputs
    A switch parameter that retrieves Output instead of Inputs. By default Inputs are retrieved.

    .PARAMETER Id
    A string containing the 36-character guid Id of the Design Parameter object to fetch.

    .PARAMETER startRow
    Optional integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Optional integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .PARAMETER SortBy
    Optional string to indicate the property to sort the results by. Default is 'sortOrder'.

    .INPUTS
    An [ANOWProcessingTemplate] object or a string representing a Design Parameter Id (pipeline capable).

    .OUTPUTS
    [ANOWDesignParameter] objects will be returned

    .EXAMPLE
    Gets the Processing Template Design Parameters (Input) from a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateDesignParameter

    .EXAMPLE
    Gets the Processing Template Design Parameters (Output) from a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateDesignParameter -Outputs

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    All Processing Templates have Inputs but only Task Templates and Service Manager Templates have Outputs.

    Inputs can be overridden at the Processing Template Item level but Outputs cannot.

    You cannot fetch Design Parameters from Processing Template Items with this function. As mentioned above, only Inputs can be overridden at the Processing Template Item Level. In that case, to see any overrides, you would need to check the 'templateParameters' property of the Processing Template Item object itself. This may be added as a function in the future.

    #>
    [OutputType([ANOWDesignParameter[]])]
    [CmdletBinding(DefaultParameterSetName = 'ProcessingTemplate')]
    Param(
        [ValidateScript({ $_.processingType -ne 'TRIGGER' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplate', ValueFromPipeline = $true)]
        [ANOWProcessingTemplate]$ProcessingTemplate,
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplate')]
        [switch]$Outputs,
        [ValidateScript({ $_ -match '^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Id', ValueFromPipeline = $true)]
        [string]$Id,
        [Parameter(Mandatory = $False)]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False)]
        [int32]$endRow = 100,
        [Parameter(Mandatory = $False)]
        [string]$SortBy = 'sortOrder'
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($endRow -le $startRow) {
            Write-Warning -Message "The endRow must be greater than the startRow. Please try again."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id -match '^[0-9a-zA-Z_.-]{1,}$') {
            Try {
                [ANOWProcessingTemplate]$ProcessingTemplate = $_
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to convert the pipeline item to an [ANOWProcessingTemplate] object due to [$Message]."
                Break
            }
        }
        ElseIf ($_ -match '^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}$') {
            [string]$Id = $_
        }
        [string]$componentId = 'ProcessingTemplateParameterList'
        [string]$ProcessingTemplate_simpleId = ''
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If ($Id -match '^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}$') {
            $BodyMetaData.Add('id', $Id )
            [string]$textMatchStyle = 'exactCase'
        }
        Else {
            If ($null -eq $ProcessingTemplate -or $ProcessingTemplate.id.Length -eq 0) {
                Write-Warning -Message "The Processing Template that was supplied has an empty id or was not provided."
                Break
            }
            [string]$ProcessingTemplate_simpleId = $ProcessingTemplate.simpleId
            [string]$textMatchStyle = 'substring'
            $BodyMetaData.Add('criteria1', '{"fieldName":"designObjectId","operator":"equals","value":"' + $ProcessingTemplate_simpleId + '"}')
            $BodyMetaData.Add('criteria2', '{"fieldName":"designObjectType","operator":"equals","value":"PROCESSING"}')
            If ($Outputs -ne $true) {
                [string]$componentId = 'ProcessingTemplateParameterList'
                $BodyMetaData.Add('criteria3', '{"fieldName":"editorType","operator":"notEqual","value":"OUTPUT"}')
            }
            Else {
                If ($ProcessingTemplate.processingType -eq 'WORKFLOW') {
                    Write-Warning -Message "Workflow Templates cannot have Outputs. Please check again."
                    Break
                }
                [string]$componentId = 'ProcessingTemplateOutputParameterList'
                $BodyMetaData.Add('criteria3', '{"fieldName":"editorType","operator":"equals","value":"OUTPUT"}')
            }
            $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
            $BodyMetaData.Add('operator', 'and')
            $BodyMetaData.Add('_operationType', 'fetch')
            $BodyMetaData.Add('_startRow', $startRow)
            $BodyMetaData.Add('_endRow', $endRow)
            $BodyMetaData.Add('_sortBy', $SortBy)
        }
        $BodyMetaData.Add('_textMatchStyle', $textMatchStyle)
        $BodyMetaData.Add('_componentId', $componentId)
        $BodyMetaData.Add('_dataSource', 'DesignParameterDataSource')
        $BodyMetaData.Add('isc_metaDataPrefix', '_')
        $BodyMetaData.Add('isc_dataFormat', 'json')
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/designParameter/read' + '?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.'Command' = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        If ($results.response.data.count -gt 0) {
            $Error.Clear()
            Try {
                [ANOWDesignParameter[]]$ProcessingTemplateDesignParameters = $results.response.data
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to convert the response data to [ANOWDesignParameter] objects due to [$Message]."
                Break
            }
            If ($ProcessingTemplate_simpleId.Length -gt 0) {
                Write-Verbose -Message "Processing Template Design Parameters successfully read from $ProcessingTemplate_simpleId"
            }
            Else {
                Write-Verbose -Message "Processing Template Design Parameters successfully read"
            }
            Return $ProcessingTemplateDesignParameters
        }
        Else {
            If ($ProcessingTemplate_simpleId.Length -gt 0) {
                Write-Verbose -Message "There were no Processing Template Design Parameters within $ProcessingTemplate_simpleId"
            }
            Else {
                Write-Verbose -Message "There were no Processing Template Design Parameters returned"
            }
        }
    }
    End {

    }
}

Function Export-AutomateNOWProcessingTemplateDesignParameter {
    <#
    .SYNOPSIS
    Exports the Processing Template Design Parameter objects from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the Processing Template Design Parameter objects from an instance of AutomateNOW!

    .PARAMETER DesignParameter
    Mandatory [ANOWDesignParameter] object (Use Read-AutomateNOWProcessingTemplateDesignParameter to retrieve them)

    .INPUTS
    ONLY [ANOWDesignParameter] objects are accepted (including from the pipeline)

    .OUTPUTS
    The [ANOWDesignParameter] objects are exported to the local disk in CSV format

    .EXAMPLE
    Exports the first page of Output Design Parameters from a Task Template named 'TaskTemplate1' (one-liner)

    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Read-AutomateNOWProcessingTemplateDesignParameter -Outputs | Export-AutomateNOWProcessingTemplateDesignParameter

    .EXAMPLE
    Exports the first page of Input Design Parameters from a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateDesignParameter | Export-AutomateNOWProcessingTemplateDesignParameter

    .NOTES
    You must present [ANOWDesignParameter] objects to the pipeline to use this function.

    #>

    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWDesignParameter]$DesignParameter
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-ProcessingTemplateDesignParameters-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWDesignParameter]$DesignParameter = $_
        }
        $Error.Clear()
        Try {
            $DesignParameter | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWDesignParameter] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function Remove-AutomateNOWProcessingTemplateDesignParameter {
    <#
    .SYNOPSIS
    Removes a Processing Template Design Parameter from a Processing Template

    .DESCRIPTION
    Removes a Processing Template Design Parameter from a Processing Template

    .PARAMETER DesignParameter
    Mandatory [ANOWDesignParameter] object representing the Processing Template Design Parameter that will be removed. Use Read-AutomateNOWProcessingTemplateDesignParameter to fetch these.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present one or more [ANOWDesignParameter] object to the DesignParameter parameter or the pipeline

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Removes the first page of Processing Template Input Design Parameters from a Processing Template named 'WorkflowTemplate1' (one-liner)
    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateDesignParameter | Remove-AutomateNOWProcessingTemplateDesignParameter

    .EXAMPLE
    Removes the first page of Processing Template Output Design Parameters from a Processing Template named 'TaskTemplate1' (one-liner)
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Read-AutomateNOWProcessingTemplateDesignParameter -Outputs | Remove-AutomateNOWProcessingTemplateDesignParameter

    .EXAMPLE
    Removes a Processing Template Design Parameter by its Id (one-liner)
    Read-AutomateNOWProcessingTemplateDesignParameter -Id '07a2cf58-2cc6-4d96-a20b-6c7406279771' | Remove-AutomateNOWProcessingTemplateDesignParameter

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWDesignParameter]$DesignParameter,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/designParameter/delete'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWDesignParameter]$DesignParameter = $_
        }
        [string]$DesignParameter_id = $DesignParameter.id
        If ($DesignParameter_id.Length -eq 0) {
            Write-Warning -Message "An object with an empty Id was passed to this function."
            Break
        }
        If ($DesignParameter_id -notmatch '^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}$') {
            Write-Warning -Message "Was expecting the Id of the Processing Template Design Parameter object to match a 36-character GUID, instead received [$DesignParameter_id]."
            Break
        }
        Else {
            Write-Verbose -Message "Received [$DesignParameter_id] for the Id of the Processing Template Design Parameter to be removed"
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($DesignParameter_id)")) -eq $true) {
            $Error.Clear()
            Try {
                [ANOWDesignParameter]$DesignParameter_Check = Read-AutomateNOWProcessingTemplateDesignParameter -Id $DesignParameter_id
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Read-AutomateNOWProcessingTemplateDesignParameter failed to Read [$DesignParameter_id] under Remove-AutomateNOWProcessingTemplateDesignParameter due to [$Message]."
                Break
            }
            If ($DesignParameter_id -ne $DesignParameter_Check.id ) {
                [string]$unexpected_id = $DesignParameter_Check.id
                Write-Warning -Message "The Processing Template Design Parameter with id $DesignParameter_id was not the same as the checked object $unexpected_id. Please check this."
                Break
            }
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.Add('id', $DesignParameter_id )
            $BodyMetaData.Add('_componentId', 'ProcessingTemplateParameterList')
            $BodyMetaData.Add('_operationType', 'remove')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_dataSource', 'DesignParameterDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$DesignParameter_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Processing Template Design Parameter $DesignParameter_id has been removed"
        }
    }
    End {

    }
}

#endregion

#region - Processing Template Dependency

Function Read-AutomateNOWProcessingTemplateDependency {
    <#
    .SYNOPSIS
    Reads the Processing Template Dependency objects that are associated with a Processing Template or a Processing Template Item.

    .DESCRIPTION
    Reads the Processing Template Dependency objects that are associated with a Processing Template or a Processing Template Item.

    .PARAMETER ProcessingTemplate
    An [ANOWProcessingTemplate] object representing the Processing Template to read the Processing Template Dependencies from. Use Get-AutomateNOWWorkflowTemplate (et al) to retrieve these.

    .PARAMETER ProcessingTemplateItem
    An [ANOWProcessingTemplateItem] object representing the Processing Template Item to read the dependencies from. Use Read-AutomateNOWWorkflowTemplateItem (et al) to retrieve these.

    .PARAMETER Successors
    Switch parameter that forces only successor Processing Template Item dependencies to be returned. If you do not provide this switch then predecessor dependencies are returned.

    .PARAMETER Id
    A string containing the 36-character guid Id of the Processing Template Dependency object to fetch.

    .PARAMETER dependencyType
    An optional string that will filter the results based on the type of dependency. Valid choices are: PREDECESSOR; PROCESSING_TEMPLATE; WORKFLOW_ITEM; EVENT; CHRONOLOGY; AND; OR; XOR; NAND; NOR; XNOR;

    .PARAMETER startRow
    Optional integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Optional integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .INPUTS
    Accepts [ANOWProcessingTemplate], [ANOWProcessingTemplateItem], or a string Id representing a Processing Template Dependency (pipeline capable).

    .OUTPUTS
    [ANOWProcessingTemplateDependency] objects will be returned

    .EXAMPLE
    Imagine a Workflow Template named 'WorkflowTemplate1' that contains two Task Templates named 'TaskTemplate1' and 'TaskTemplate2' where 'TaskTemplate2' has been configured as a successor of 'TaskTemplate1'.

    Gets the -name- of the successor Workflow Template Item for a Task named 'TaskTemplate1' within a Workflow Template named 'WorkflowTemplate1'. Note the use of the -Successors switch parameter (one-liner format)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem -Name 'TaskTemplate1' | Read-AutomateNOWWorkflowTemplateDependency -Successors | Select-Object -ExpandProperty sourceTitle

    .EXAMPLE
    Imagine a Workflow Template named 'WorkflowTemplate1' that contains two Task Templates named 'TaskTemplate1' and 'TaskTemplate2' where 'TaskTemplate2' has been configured as a successor of 'TaskTemplate1'.

    Gets the -name- of the predecessor Workflow Template Item for a Task named 'TaskTemplate2' within a Workflow Template named 'WorkflowTemplate1'. Note the lack of -Successors switch parameter (one-liner format).

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem -Name 'TaskTemplate2' | Read-AutomateNOWWorkflowTemplateDependency | Select-Object -ExpandProperty predecessor

    .EXAMPLE
    Gets the first page of successor Processing Template Dependency objects from a Processing Template Item with an id of 'a7c1290d-89f4-4d37-9bfb-7ffaf9ce6c89' (one-liner format)

    Read-AutomateNOWProcessingTemplateItem -Id 'a7c1290d-89f4-4d37-9bfb-7ffaf9ce6c89' | Read-AutomateNOWProcessingTemplateDependency -Successors

    .EXAMPLE
    Gets a specific Workflow Template Dependency object with an id of 'c680bdfc-ba66-4645-971d-1c3ada3d545b'

    Read-AutomateNOWWorkflowTemplateDependency -Id 'c680bdfc-ba66-4645-971d-1c3ada3d545b'

    .EXAMPLE
    Verbally iterates through the dependencies and successors within the Workflow Template Items within a Workflow Template named 'WorkflowTemplate1'

    $workflow_template = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1'
    $items = $workflow_template | Read-AutomateNOWWorkflowTemplateItem -startRow 0 -endRow 10000
    ForEach($item in $items){
        $dependency = $item | Read-AutomateNOWWorkflowTemplateDependency | Select-Object -First 1
        $successor = $item | Read-AutomateNOWWorkflowTemplateDependency -Successors | Select-Object -First 1
        $item_title = $item.title
        $dependency_title = $dependency.title
        $successor_source_title = $successor.sourceTitle
        Write-Information -MessageData "$item_title has a dependency on $dependency_title and is succeeded by $successor_source_title"
    }

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Do not overlook the -Successors switch parameter.

    Although 'RESOURCE' is technically just another dependencyType, it is blocked from usage within this function as this objects should be fetched with Read-AutomateNOWProcessingTemplateResourceDependency instead.

    Oddly, the ANOW UI does not include a startRow/endRow when retrieving the dependencies for a Processing Template but it does for a Processing Template Item. This function utilizes startRow/endRow in both cases.

    #>
    [OutputType([ANOWProcessingTemplateDependency[]])]
    [CmdletBinding(DefaultParameterSetName = 'ProcessingTemplateItem')]
    [Alias('Read-AutomateNOWWorkflowTemplateDependency', 'Read-AutomateNOWServiceManagerTemplateDependency')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplate', ValueFromPipeline = $true)]
        [ANOWProcessingTemplate]$ProcessingTemplate,
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplateItem', ValueFromPipeline = $true)]
        [ANOWProcessingTemplateItem]$ProcessingTemplateItem,
        [Parameter(Mandatory = $false, ParameterSetName = 'ProcessingTemplateItem')]
        [switch]$Successors,
        [ValidateScript({ $_ -match '^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Id', ValueFromPipeline = $true)]
        [string]$Id,
        [ValidateScript({ $_ -ne 'RESOURCE' })]
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplate')]
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplateItem')]
        [ANOWProcessingTemplateDependency_dependencyType]$dependencyType,
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplate')]
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplateItem')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplate')]
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplateItem')]
        [int32]$endRow = 100
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($endRow -le $startRow) {
            Write-Warning -Message "The endRow must be greater than the startRow. Please try again."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        [string]$ProcessingTemplateItem_Name = ''
        [string]$ProcessingTemplate_id = ''
        [string]$ProcessingTemplate_simpleId = ''
        If ($PSCmdlet.ParameterSetName -eq 'ProcessingTemplateItem') {
            [string]$ProcessingTemplateItem_Name = $ProcessingTemplateItem.name
            [ANOWProcessingTemplate]$ProcessingTemplate = $ProcessingTemplateItem.workflow
            If ([string]::IsNullOrEmpty($ProcessingTemplateItem_Name) -or
                $null -eq $ProcessingTemplate -or [string]::IsNullOrEmpty($ProcessingTemplate.id)) {
                Write-Warning -Message 'The Processing Template Item requires a nonempty name and typed parent identity.'
                Break
            }
        }
        ElseIf ($PSCmdlet.ParameterSetName -eq 'Id') {
            $ProcessingTemplate = $null
        }
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If ($Id.Length -eq 36) {
            $BodyMetaData.Add('id', $Id )
        }
        Else {
            If ($ProcessingTemplate.id.Length -eq 0 -and $ProcessingTemplateItem.id.Length -eq 0) {
                Write-Warning -Message "The Processing Template or Processing Template Item that was supplied has an empty id."
                Break
            }
            If ($ProcessingTemplateItem.id.Length -gt 0) {
                [string]$ProcessingTemplate_id = $ProcessingTemplateItem.workflow.id
                [string]$ProcessingTemplate_simpleId = $ProcessingTemplateItem.workflow.simpleId
            }
            Else {
                [string]$ProcessingTemplate_id = $ProcessingTemplate.id
                [string]$ProcessingTemplate_simpleId = $ProcessingTemplate.simpleId
            }
            $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
            $BodyMetaData.Add('_startRow', $startRow)
            $BodyMetaData.Add('_endRow', $endRow)
        }
        If ($Successors -eq $true) {
            If ($ProcessingTemplateItem_Name.Length -eq 0) {
                Write-Warning -Message "The -Successors switch requires a ProcessingTemplateItem with a valid name property."
                Break
            }
            $BodyMetaData.Add('operator', 'or')
            $BodyMetaData.Add('criteria1', '{"_constructor":"AdvancedCriteria","operator":"and","criteria":[{"fieldName":"dependencyType","operator":"equals","value":"PREDECESSOR"},{"fieldName":"workflow","operator":"equals","value":"' + $ProcessingTemplate_id + '"},{"fieldName":"predecessor","operator":"equals","value":"' + $ProcessingTemplateItem_Name + '"}]}')
            $BodyMetaData.Add('criteria2', '{"_constructor":"AdvancedCriteria","operator":"and","criteria":[{"fieldName":"dependencyType","operator":"equals","value":"PROCESSING_TEMPLATE"},{"fieldName":"processingTemplate","operator":"equals","value":"' + $ProcessingTemplateItem_Name + '"}]}')
            $BodyMetaData.Add('criteria3', '{"_constructor":"AdvancedCriteria","operator":"and","criteria":[{"fieldName":"dependencyType","operator":"equals","value":"WORKFLOW_ITEM"},{"fieldName":"workflowTemplateItem","operator":"equals","value":"' + $ProcessingTemplateItem_Name + '"},{"fieldName":"workflowTemplate","operator":"equals","value":"' + $ProcessingTemplate_simpleId + '"}]}')
            [string]$componentId = 'ProcessingTemplateSuccessorList'
        }
        Else {
            $BodyMetaData.Add('operator', 'and')
            $BodyMetaData.Add('criteria1', ('{"fieldName":"workflow","operator":"equals","value":"' + $ProcessingTemplate_id + '"}'))
            If ($ProcessingTemplateItem_Name.Length -gt 0) {
                $BodyMetaData.Add('criteria2', ('{"fieldName":"workflowItem","operator":"equals","value":"' + $ProcessingTemplateItem_Name + '"}'))
            }
            Else {
                $BodyMetaData.Add('criteria2', ('{"fieldName":"workflowItem","operator":"isNull"}'))
            }
            $BodyMetaData.Add('criteria3', ('{"operator":"or","criteria":[{"fieldName":"resourceType","operator":"isNull"},{"fieldName":"resourceType","operator":"notInSet","value":["STOCK","LOCK"]}]}'))
            If ($dependencyType.Length -gt 0) {
                $BodyMetaData.Add('criteria4', ('{"fieldName":"dependencyType","operator":"equals","value":"' + $dependencyType + '"}'))
            }
            [string]$componentId = 'ProcessingTemplateDependencyList'
            [string]$operationId = 'ProcessingTemplateDependencyDataSource_fetch'
            $BodyMetaData.Add('_operationId', $operationId)
        }
        $BodyMetaData.Add('_componentId', $componentId)
        $BodyMetaData.Add('_textMatchStyle', 'exact')
        $BodyMetaData.Add('_operationType', 'fetch')
        $BodyMetaData.Add('_dataSource', 'ProcessingTemplateDependencyDataSource')
        $BodyMetaData.Add('isc_metaDataPrefix', '_')
        $BodyMetaData.Add('isc_dataFormat', 'json')
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/processingTemplateDependency/read' + '?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.'Command' = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        If ($results.response.data.count -gt 0) {
            If ($Id.Length -eq 36) {
                If ($results.response.data.workflow.length -eq 0) {
                    Write-Warning -Message "The workflow property of the retrieved Processing Template Dependency object was empty."
                    Break
                }
                [string]$ProcessingTemplate_id = $results.response.data | Select-Object -First 1 -ExpandProperty workflow
                [string]$ProcessingTemplate_simpleId = $ProcessingTemplate_id -split ']' | Select-Object -Last 1
                $Error.Clear()
                Try {
                    [ANOWProcessingTemplate]$ProcessingTemplate = Get-AutomateNOWProcessingTemplate -Id $ProcessingTemplate_simpleId
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to extract a valid Processing Template ($ProcessingTemplate_simpleId) from Processing Template Dependency ($Id) due to [$Message]."
                    Break
                }
            }
            [ANOWProcessingTemplateDependency[]]$ProcessingTemplateDependencies = ForEach ($result in $results.response.data) {
                $Error.Clear()
                Try {
                    $result.workflow = $ProcessingTemplate
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to parse the Processing Template Dependencies due to [$Message]"
                    Break
                }
                $result
            }
            Write-Verbose -Message "Processing Template Dependencies successfully read"
            Return $ProcessingTemplateDependencies
        }
        Else {
            Write-Verbose -Message "There were no Processing Template Dependencies returned"
        }
    }
    End {

    }
}

Function Export-AutomateNOWProcessingTemplateDependency {
    <#
    .SYNOPSIS
    Exports the Processing Template dependencies from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the Processing Template dependencies from an instance of AutomateNOW!

    .PARAMETER ProcessingTemplateDependency
    Mandatory [ANOWProcessingTemplateDependency] object (Use Read-AutomateNOWProcessingTemplateDependency to retrieve them)

    .INPUTS
    ONLY [ANOWProcessingTemplateDependency] objects are accepted (including from the pipeline)

    .OUTPUTS
    The [ANOWProcessingTemplateDependency] objects are exported to the local disk in CSV format

    .EXAMPLE
    Exports the first page of Processing Template Dependencies from the first page of Processing Template Items from a Processing Template named 'ProcessingTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem | Read-AutomateNOWWorkflowTemplateDependency | Export-AutomateNOWWorkflowTemplateDependency

    .NOTES
    You must present [ANOWProcessingTemplateDependency] objects to the pipeline to use this function.

    #>
    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    [Alias('Export-AutomateNOWWorkflowTemplateDependency', 'Export-AutomateNOWServiceManagerTemplateDependency')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-ProcessingTemplateDependencies-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency = $_
        }
        $Error.Clear()
        Try {
            $ProcessingTemplateDependency | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWProcessingTemplateDependency] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function Get-ANOWDependencyCreationIdentity {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][object]$Source)
    $ErrorActionPreference = 'Stop'
    if ([string]::IsNullOrWhiteSpace($Source.simpleId) -or [string]::IsNullOrWhiteSpace($Source.domain) -or
        $Source.id -cne ('[' + $Source.domain + ']' + $Source.simpleId) -or $Source.simpleId -match '[$\{\}]') {
        throw 'One consistent literal qualified identity is required.'
    }
    [pscustomobject]@{Id=$Source.id;SimpleId=$Source.simpleId;Domain=$Source.domain}
}

Function Assert-ANOWDependencyCreationItem {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][ANOWProcessingTemplateItem]$Item,[Parameter(Mandatory=$true)][ANOWProcessingTemplate]$Owner)
    $ErrorActionPreference = 'Stop'
    if ($Item.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' -or
        [string]::IsNullOrWhiteSpace($Item.name) -or [string]::IsNullOrWhiteSpace($Item.processingTemplate) -or
        $null -eq $Item.workflow -or $Item.workflow.id -cne $Owner.id -or
        ($Item.domain -and $Item.domain -cne $Owner.domain)) {
        throw 'A named item with a valid GUID and matching typed owner is required.'
    }
}

Function New-ANOWDependencyCreationRequest {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][ANOWProcessingTemplate]$Owner,
        [Parameter(Mandatory=$true)][string]$DependencyType,[Parameter(Mandatory=$true)][string]$ParameterSet,
        [Parameter(Mandatory=$true)][hashtable]$Options)
    $ErrorActionPreference = 'Stop'
    $identity = Get-ANOWDependencyCreationIdentity -Source $Owner
    $groups = @('AND','OR','XOR','NAND','NOR','XNOR')
    $resourceTypes = @{Semaphore='BINARY_SEMAPHORE';TimeWindow='TIME_SEMAPHORE';Variable='VARIABLE';PhysicalResource='PHYSICAL_RESOURCE';Metric='METRIC';Event='EVENT'}
    $cross = $ParameterSet -in @('ProcessingCross','WorkflowItemCross')
    $group = $ParameterSet -eq 'Simple' -and $DependencyType -in $groups
    $chronology = $ParameterSet -eq 'Simple' -and $DependencyType -eq 'CHRONOLOGY'
    $legacy = $ParameterSet -eq 'Predecessor' -and $DependencyType -eq 'PREDECESSOR'
    if (-not ($legacy -or $group -or $chronology -or
        ($resourceTypes.ContainsKey($ParameterSet) -and $DependencyType -eq 'RESOURCE') -or
        ($ParameterSet -eq 'ProcessingCross' -and $DependencyType -eq 'PROCESSING_TEMPLATE') -or
        ($ParameterSet -eq 'WorkflowItemCross' -and $DependencyType -eq 'WORKFLOW_ITEM'))) {
        throw 'DependencyType does not match the selected creation parameters.'
    }
    if (-not $legacy -and ($Owner.processingType -ne 'WORKFLOW' -or
        $Owner -is [ANOWServiceManagerTemplate] -or $Owner -is [ANOWScheduleTemplate])) {
        throw 'New dependency creation requires a Workflow template owner.'
    }
    $itemName = ''
    if ($Options.ContainsKey('ProcessingTemplateItem')) {
        if ($chronology) { throw 'Chronology is supported only at the template root.' }
        Assert-ANOWDependencyCreationItem -Item $Options.ProcessingTemplateItem -Owner $Owner
        $itemName = $Options.ProcessingTemplateItem.name
    }
    if ($legacy -and -not $itemName) { throw 'Predecessor creation requires an owner item.' }
    [System.Collections.Specialized.OrderedDictionary]$fields = [ordered]@{workflow=$identity.Id}
    if ($itemName) { $fields.workflowItem = $itemName }
    $fields.dependencyType = $DependencyType
    $echoes = @{dependencyType=$DependencyType}
    $aliases = @{}
    $component = 'ProcessingTemplateDependencyEditForm'
    if ($legacy) {
        Assert-ANOWDependencyCreationItem -Item $Options.Predecessor -Owner $Owner
        if ($Options.Predecessor.id -ieq $Options.ProcessingTemplateItem.id -or $Options.Predecessor.name -ceq $itemName) {
            throw 'An item cannot be its own predecessor.'
        }
        $fields.predecessor = $Options.Predecessor.name
        $echoes.predecessor = $fields.predecessor
        $fields._oldValues = '{}'
        $component = 'ProcessingTemplateDependencyList'
    } elseif ($group) {
        $component = 'ProcessingTemplateDependencyList'
        if ($Options.ContainsKey('ParentGroup')) {
            $parent = $Options.ParentGroup
            if ($null -eq $parent -or $parent.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' -or
                $parent.dependencyType -notin $groups -or -not $parent.isFolder -or $null -eq $parent.workflow -or
                $parent.workflow.id -cne $Owner.id -or [string]$parent.workflowItem -cne $itemName -or
                ($parent.domain -and $parent.domain -cne $identity.Domain)) { throw 'A logical parent in the same owner context is required.' }
            $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingTemplateDependency) -OperationParameters @{Id=$parent.id}
            if (-not $checked.Succeeded -or $checked.Data.Count -ne 1 -or $checked.Data[0] -isnot [ANOWProcessingTemplateDependency]) {
                throw 'The exact parent lookup did not return one clean typed dependency.'
            }
            $fresh = $checked.Data[0]
            if ($fresh.id -ine $parent.id -or $fresh.dependencyType -ne $parent.dependencyType -or -not $fresh.isFolder -or
                $null -eq $fresh.workflow -or $fresh.workflow.id -cne $Owner.id -or [string]$fresh.workflowItem -cne $itemName -or
                ($fresh.domain -and $fresh.domain -cne $identity.Domain)) { throw 'The exact logical parent context was not verified.' }
            $fields.parent = $fresh.id
            $echoes.parent = $fresh.id
        }
    } elseif ($chronology) {
        if ($Options.ContainsKey('ParentGroup')) { throw 'Chronology does not accept a parent group.' }
        $fields.domain = $identity.Domain
        $component = ''
    } else {
        # These empty controls are present in the captured dialog-save forms.
        $fields.valueOperator = $null
        $fields.statusCodeOperator = $null
        if ($resourceTypes.ContainsKey($ParameterSet)) {
            $resource = $Options[$ParameterSet]
            $resourceIdentity = Get-ANOWDependencyCreationIdentity -Source $resource
            if ([string]$resource.resourceType -cne $resourceTypes[$ParameterSet] -or $resourceIdentity.Domain -cne $identity.Domain) {
                throw 'Resource type or domain does not match the selected condition.'
            }
            $fields.resourceType = $resourceTypes[$ParameterSet]
            $fields.resource = $resourceIdentity.Id
            $echoes.resourceType = $fields.resourceType
            $echoes.resource = $resourceIdentity.SimpleId
            if ($ParameterSet -in @('Semaphore','TimeWindow')) {
                $fields.semaphoreState = [string]$Options.SemaphoreState
                $echoes.semaphoreState = $fields.semaphoreState
            } elseif ($ParameterSet -in @('Variable','PhysicalResource','Metric')) {
                $fields.valueOperator = [string]$Options.ValueOperator
                $echoes.valueOperator = $fields.valueOperator
                if ($fields.valueOperator -in @('IS_NULL','IS_NOT_NULL')) {
                    if ($Options.ContainsKey('Value')) { throw 'Null tests require omission of Value.' }
                } else {
                    if (-not $Options.ContainsKey('Value') -or $Options.Value -isnot [string]) { throw 'The comparison requires a literal Value.' }
                    $fields.value = $Options.Value
                    $echoes.value = $fields.value
                }
            }
        } elseif ($cross) {
            if ($ParameterSet -eq 'ProcessingCross') {
                $required = $Options.RequiredProcessingTemplate
                $targetIdentity = Get-ANOWDependencyCreationIdentity -Source $required
                if ($targetIdentity.Domain -cne $identity.Domain -or
                    ($required.processingType -eq 'TRIGGER' -and $required.triggerType -ne 'SELF_SERVICE')) {
                    throw 'The required processing template is outside the captured target-picker contract.'
                }
                $fields.processingTemplate = $targetIdentity.SimpleId
                $echoes.processingTemplate = $fields.processingTemplate
            } else {
                $required = $Options.RequiredWorkflow
                $targetIdentity = Get-ANOWDependencyCreationIdentity -Source $required
                if ($required.processingType -ne 'WORKFLOW' -or $targetIdentity.Domain -cne $identity.Domain) { throw 'The required target must be a Workflow in the same domain.' }
                Assert-ANOWDependencyCreationItem -Item $Options.RequiredWorkflowItem -Owner $required
                $fields.workflowTemplate = $targetIdentity.SimpleId
                $fields.workflowTemplateItem = $Options.RequiredWorkflowItem.name
                $echoes.workflowTemplate = $fields.workflowTemplate
                $echoes.workflowTemplateItem = $fields.workflowTemplateItem
            }
            $status = if ($Options.ContainsKey('ProcessingStatus')) { [string]$Options.ProcessingStatus } else { 'COMPLETED' }
            $fields.processingStatus = $status
            $echoes.processingStatus = $status
            if ($Options.ContainsKey('Optional')) {
                $fields.optional = ([bool]$Options.Optional).ToString().ToLowerInvariant()
                $echoes.optional = [bool]$Options.Optional
            }
            if ($Options.ContainsKey('StatusCodeOperator')) {
                if ($status -notin @('COMPLETED','FAILED')) { throw 'Status-code conditions require COMPLETED or FAILED.' }
                $operator = [string]$Options.StatusCodeOperator
                $fields.statusCodeOperator = $operator
                $echoes.statusCodeOperator = $operator
                if ($operator -in @('IS_NULL','IS_NOT_NULL')) {
                    if ($Options.ContainsKey('StatusCode') -or $Options.ContainsKey('StatusCodeCalendar')) { throw 'Null code tests require omission of the code operand.' }
                } elseif ($operator -in @('CAL','NOT_IN_CAL')) {
                    if (-not $Options.ContainsKey('StatusCodeCalendar') -or $Options.ContainsKey('StatusCode')) { throw 'This code condition requires only StatusCodeCalendar.' }
                    $calendarIdentity = Get-ANOWDependencyCreationIdentity -Source $Options.StatusCodeCalendar
                    if ($Options.StatusCodeCalendar.resourceType -ne 'CALENDAR' -or $calendarIdentity.Domain -cne $identity.Domain) { throw 'A matching Calendar identity is required.' }
                    $fields.statusCode = $calendarIdentity.Id
                    $echoes.statusCode = $calendarIdentity.SimpleId
                    $aliases.statusCode = $calendarIdentity.Id
                } else {
                    if (-not $Options.ContainsKey('StatusCode') -or [string]::IsNullOrEmpty($Options.StatusCode) -or $Options.ContainsKey('StatusCodeCalendar')) { throw 'The code condition requires only a nonempty literal StatusCode.' }
                    $fields.statusCode = $Options.StatusCode
                    $echoes.statusCode = $fields.statusCode
                }
            } elseif ($Options.ContainsKey('StatusCode') -or $Options.ContainsKey('StatusCodeCalendar')) { throw 'A code operand requires StatusCodeOperator.' }
        }
        $timestampKeys = @('TimestampRelation','TimestampSelector','TimestampCalendar','SpecificTimestamp')
        if ($Options.ContainsKey('TimestampRelation')) {
            $relation = [string]$Options.TimestampRelation
            $fields.timestampRelation = $relation
            $echoes.timestampRelation = $relation
            $selector = if ($Options.ContainsKey('TimestampSelector')) { [string]$Options.TimestampSelector } else { '' }
            $needDate = $false; $needCalendar = $false
            if ($relation -eq 'ANY') {
                if ($selector) { throw 'ANY does not accept a timestamp selector.' }
            } elseif ($relation -eq 'IN_CALENDAR') {
                if ($selector) { throw 'IN_CALENDAR does not accept a timestamp selector.' }
                $needCalendar = $true
            } elseif ($relation -in @('EQ','NE','LT','GT','LE','GE')) {
                if (-not $selector -or $selector -eq 'OFFSET') { throw 'A supported timestamp selector is required.' }
                $fields.timestampSelector = $selector
                $echoes.timestampSelector = $selector
                $needDate = $selector -eq 'SPECIFIC_DATE'
                $needCalendar = $selector -in @('NEXT_CAL_DAY','PREV_CAL_DAY')
            } else { throw 'This timestamp relation is not supported by the bounded creation contract.' }
            if ($needDate) {
                $parsedDate = [datetime]::MinValue
                if (-not $Options.ContainsKey('SpecificTimestamp') -or
                    -not [datetime]::TryParseExact($Options.SpecificTimestamp,'yyyy-MM-dd',[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::None,[ref]$parsedDate)) { throw 'SpecificTimestamp requires an exact valid yyyy-MM-dd date.' }
                $fields.specificTimestamp = $Options.SpecificTimestamp
                $echoes.specificTimestamp = $fields.specificTimestamp
            } elseif ($Options.ContainsKey('SpecificTimestamp')) { throw 'SpecificTimestamp requires SPECIFIC_DATE.' }
            if ($needCalendar) {
                if (-not $Options.ContainsKey('TimestampCalendar')) { throw 'This timestamp condition requires TimestampCalendar.' }
                $calendarIdentity = Get-ANOWDependencyCreationIdentity -Source $Options.TimestampCalendar
                if ($Options.TimestampCalendar.resourceType -ne 'CALENDAR' -or $calendarIdentity.Domain -cne $identity.Domain) { throw 'A matching Calendar identity is required.' }
                $fields.timestampCalendar = $calendarIdentity.Id
                $echoes.timestampCalendar = $calendarIdentity.SimpleId
                $aliases.timestampCalendar = $calendarIdentity.Id
            } elseif ($Options.ContainsKey('TimestampCalendar')) { throw 'This timestamp condition does not accept a calendar.' }
        } else {
            foreach ($key in $timestampKeys | Select-Object -Skip 1) { if ($Options.ContainsKey($key)) { throw 'Timestamp operands require TimestampRelation.' } }
        }
    }
    $fields._operationType = 'add'
    $fields._textMatchStyle = 'exact'
    if ($component) { $fields._componentId = $component }
    $fields._dataSource = 'ProcessingTemplateDependencyDataSource'
    $fields.isc_metaDataPrefix = '_'
    $fields.isc_dataFormat = 'json'
    $body = @(ConvertTo-QueryString -InputObject $fields)
    if ($body.Count -ne 1 -or $body[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($body[0])) { throw 'One nonempty creation body is required.' }
    [pscustomobject]@{Body=$body[0];Owner=$Owner;Domain=$identity.Domain;ItemName=$itemName;Echoes=$echoes;Aliases=$aliases;Legacy=$legacy;Group=$group;Chronology=$chronology;Parent=if($fields.Contains('parent')){$fields.parent}else{''}}
}

Function ConvertFrom-ANOWDependencyCreationResponse {
    [CmdletBinding()]
    param([object[]]$Envelopes,[Parameter(Mandatory=$true)][object]$Context)
    $ErrorActionPreference = 'Stop'
    if ($Envelopes.Count -ne 1 -or $null -eq $Envelopes[0].response) { throw 'One creation acknowledgment is required.' }
    $status = $Envelopes[0].response.status
    if (($status -isnot [int32] -and $status -isnot [int64]) -or -not (Test-ANOWB2Response -Envelopes $Envelopes)) { throw 'An explicit integral-zero acknowledgment and one row are required.' }
    $rows = @($Envelopes[0].response.data)
    $row = $rows[0]
    if ($null -eq $row -or $row -is [string] -or $row -is [array]) { throw 'A dependency object is required.' }
    foreach ($name in @('id','workflow','workflowItem','domain','resource','parent','processingTemplate','workflowTemplate','workflowTemplateItem')) {
        $member = $row.PSObject.Properties[$name]
        if ($null -ne $member -and $null -ne $member.Value -and $member.Value -isnot [string]) { throw 'Dependency identity echoes must be scalar strings.' }
    }
    if ($row.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' -or
        $row.workflow -cne $Context.Owner.id -or [string]$row.workflowItem -cne $Context.ItemName -or
        ($row.domain -and $row.domain -cne $Context.Domain)) { throw 'The created dependency identity or owner was not verified.' }
    foreach ($name in $Context.Echoes.Keys) {
        $member = $row.PSObject.Properties[$name]
        if ($null -eq $member -or $null -eq $member.Value) { throw 'A required dependency echo was omitted.' }
        if ($name -eq 'optional') {
            if ($member.Value -isnot [bool] -or $member.Value -ne $Context.Echoes[$name]) { throw 'The optional flag was not verified.' }
        } elseif ($member.Value -isnot [string] -or ($member.Value -cne $Context.Echoes[$name] -and
            (-not $Context.Aliases.ContainsKey($name) -or $member.Value -cne $Context.Aliases[$name]))) { throw 'A dependency setting or target echo was not verified.' }
    }
    if (-not $Context.Legacy) {
        if ($row.isFolder -isnot [bool] -or $row.isFolder -ne $Context.Group -or $row.optional -isnot [bool] -or
            (-not $Context.Echoes.ContainsKey('optional') -and $row.optional)) { throw 'The dependency folder or optional flags were not verified.' }
        if ([string]$row.parent -cne $Context.Parent) { throw 'The created group parent was not verified.' }
        if ($row.workspace) { throw 'Workspace ownership is outside this creation contract.' }
        if ($Context.Chronology -and $row.processingStatus -cne 'COMPLETED') { throw 'Chronology did not match the observed completion contract.' }
    }
    $properties = [ordered]@{}
    foreach ($member in $row.PSObject.Properties) { $properties[$member.Name] = $member.Value }
    $properties.workflow = $Context.Owner
    if ($Context.Legacy -and $row.workspace) {
        $workspaceId = [string]$row.workspace
        $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWWorkspace) -OperationParameters @{Id=$workspaceId}
        if (-not $checked.Succeeded -or $checked.Data.Count -ne 1 -or $checked.Data[0] -isnot [ANOWWorkspace] -or $checked.Data[0].id -cne $workspaceId) { throw 'The returned workspace context was not verified.' }
        $properties.workspace = $checked.Data[0]
    }
    [ANOWProcessingTemplateDependency][pscustomobject]$properties
}

Function Add-AutomateNOWProcessingTemplateDependency {
    <#
    .SYNOPSIS
    Adds a predecessor, resource condition, cross dependency, logical group or root Chronology dependency.

    .DESCRIPTION
    Creates one ordinary template dependency and requires one explicit integral-zero acknowledgment, matching identity/settings and strict typed conversion, including Quiet. New branches support Workflow template roots and items; legacy predecessor owner types remain supported. Diagnostics stop the operation without retry; an unverified dispatched result has an uncertain server-side outcome.

    .PARAMETER ProcessingTemplate
    Required typed owner. New creation branches require a Workflow template with consistent qualified id, simpleId and domain.
    .PARAMETER ProcessingTemplateItem
    Required for PREDECESSOR, optional for new conditions/cross dependencies/groups, prohibited for Chronology. Its instance name and typed workflow identify the owner context.
    .PARAMETER DependencyType
    Explicit selector: PREDECESSOR, RESOURCE, PROCESSING_TEMPLATE, WORKFLOW_ITEM, AND, OR, XOR, NAND, NOR, XNOR or CHRONOLOGY. It must agree with the supplied typed target. Event conditions use RESOURCE and Event.
    .PARAMETER Predecessor
    Typed item in the same owner; its instance name is submitted. An item cannot be its own predecessor.
    .PARAMETER Semaphore
    Typed ANOWSemaphore for a RESOURCE/BINARY_SEMAPHORE condition.
    .PARAMETER TimeWindow
    Typed ANOWTimeWindow for a RESOURCE/TIME_SEMAPHORE condition.
    .PARAMETER Variable
    Typed ANOWVariable for a RESOURCE/VARIABLE condition.
    .PARAMETER PhysicalResource
    Typed ANOWPhysicalResource for a RESOURCE/PHYSICAL_RESOURCE condition.
    .PARAMETER Metric
    Typed ANOWMetric for a RESOURCE/METRIC condition.
    .PARAMETER Event
    Typed ANOWEvent for a RESOURCE/EVENT condition.
    .PARAMETER SemaphoreState
    Required ON/OFF state for Semaphore or TimeWindow. Time Window ON means Open; OFF means Closed.
    .PARAMETER ValueOperator
    Required resource comparison operator. IS_NULL/IS_NOT_NULL require omission of Value; all other operators require a bound literal Value.
    .PARAMETER Value
    Literal string comparison operand. Explicit empty strings, numeric/date text and Unicode are preserved without coercion.
    .PARAMETER RequiredProcessingTemplate
    Typed Processing Cross target. Its simpleId is sent; non-self-service triggers are excluded by the captured picker contract.
    .PARAMETER RequiredWorkflow
    Typed Workflow target for WORKFLOW_ITEM. Its simpleId is sent.
    .PARAMETER RequiredWorkflowItem
    Typed item belonging to RequiredWorkflow. Its instance name is sent, independently of its child-template name.
    .PARAMETER ProcessingStatus
    Cross dependency status: EXECUTING, COMPLETED (default) or FAILED.
    .PARAMETER StatusCodeOperator
    Optional cross status-code comparison, allowed only with COMPLETED or FAILED. Null tests omit operands; CAL/NOT_IN_CAL use StatusCodeCalendar; other operators require StatusCode.
    .PARAMETER StatusCode
    Nonempty literal cross status-code operand.
    .PARAMETER StatusCodeCalendar
    Typed Calendar operand for CAL/NOT_IN_CAL status-code comparisons.
    .PARAMETER TimestampRelation
    Optional Semaphore, Variable or cross timestamp condition: ANY, EQ, NE, LT, GT, LE, GE or IN_CALENDAR. Omitted controls stay omitted.
    .PARAMETER TimestampSelector
    Required for timestamp comparisons: SAME, PREV_DAY, NEXT_DAY, PREV_CAL_DAY, NEXT_CAL_DAY or SPECIFIC_DATE. Calendar-day selectors require TimestampCalendar; SPECIFIC_DATE requires SpecificTimestamp.
    .PARAMETER TimestampCalendar
    Typed Calendar for IN_CALENDAR or PREV_CAL_DAY/NEXT_CAL_DAY. Qualified identity is submitted; simple or qualified matching calendar echoes are accepted.
    .PARAMETER SpecificTimestamp
    Exact valid yyyy-MM-dd literal date for SPECIFIC_DATE.
    .PARAMETER Optional
    Cross dependency optional flag. Sent only when explicitly bound, including Optional:$false.
    .PARAMETER ParentGroup
    Existing typed logical folder in the same owner/item context for a new nested group. One exact clean reader lookup verifies it before creation. This does not move or reparent existing dependencies; groupId is not a parent alias.
    .PARAMETER Force
    Skips confirmation while preserving explicit and ambient WhatIf.
    .PARAMETER Quiet
    Suppresses output after full acknowledgment, echo and strict conversion checks.

    .INPUTS
    Typed owner and targets supplied by named parameters. Pipeline input is not supported.
    .OUTPUTS
    ANOWProcessingTemplateDependency, unless Quiet is supplied.
    .EXAMPLE
    $workflow = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1'
    $first = $workflow | Read-AutomateNOWWorkflowTemplateItem -Name 'TaskTemplate1'
    $second = $workflow | Read-AutomateNOWWorkflowTemplateItem -Name 'TaskTemplate2'
    Add-AutomateNOWProcessingTemplateDependency -ProcessingTemplate $workflow -ProcessingTemplateItem $second -Predecessor $first -DependencyType PREDECESSOR
    .EXAMPLE
    Add-AutomateNOWProcessingTemplateDependency -ProcessingTemplate $workflow -DependencyType RESOURCE -Semaphore $semaphore -SemaphoreState OFF -TimestampRelation EQ -TimestampSelector NEXT_CAL_DAY -TimestampCalendar $calendar
    .EXAMPLE
    Add-AutomateNOWProcessingTemplateDependency -ProcessingTemplate $workflow -ProcessingTemplateItem $second -DependencyType RESOURCE -Variable $variable -ValueOperator EQ_NUM -Value '007.50'
    .EXAMPLE
    Add-AutomateNOWProcessingTemplateDependency -ProcessingTemplate $workflow -DependencyType WORKFLOW_ITEM -RequiredWorkflow $requiredWorkflow -RequiredWorkflowItem $requiredItem -ProcessingStatus COMPLETED -StatusCodeOperator EQ -StatusCode 'OK' -Optional
    .EXAMPLE
    $group = Add-AutomateNOWProcessingTemplateDependency -ProcessingTemplate $workflow -DependencyType AND
    Add-AutomateNOWProcessingTemplateDependency -ProcessingTemplate $workflow -DependencyType NOR -ParentGroup $group
    .EXAMPLE
    Add-AutomateNOWProcessingTemplateDependency -ProcessingTemplate $workflow -DependencyType CHRONOLOGY
    .NOTES
    Connect-AutomateNOW is required. Resources and calendars must have literal qualified identities in the owner's domain. Chronology uses only the captured immediate root-add fields; it exposes no status/editor options.

    Stock/Lock allocation remains in Add-AutomateNOWProcessingTemplateResourceDependency. Existing readers and acknowledgment-only removers remain usable. Ordinary condition editing uses Set-AutomateNOWProcessingTemplateDependency. Creation does not implement calculated resource names, existing-row reparenting, ordering/Push/Pop, inheritance or runtime condition evaluation. OFFSET/SELECTED_DATES timestamp encodings and broader new owner contexts remain unqualified.
    #>
    [OutputType([ANOWProcessingTemplateDependency])]
    [Alias('Add-AutomateNOWWorkflowTemplateDependency', 'Add-AutomateNOWServiceManagerTemplateDependency')]
    [CmdletBinding(DefaultParameterSetName='Simple', SupportsShouldProcess=$true, ConfirmImpact='High')]
    Param(
        [Parameter(Mandatory=$true,Position=0)]
        [ANOWProcessingTemplate]$ProcessingTemplate,
        [Parameter(Mandatory=$True,ParameterSetName='Predecessor',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='Simple',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='Semaphore',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='TimeWindow',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='Variable',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='PhysicalResource',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='Metric',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='Event',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross',Position=1)]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross',Position=1)]
        [ANOWProcessingTemplateItem]$ProcessingTemplateItem,
        [Parameter(Mandatory=$true,Position=2)]
        [ANOWProcessingTemplateDependency_dependencyType]$DependencyType,
        [Parameter(Mandatory=$true,Position=3,ParameterSetName='Predecessor')]
        [ANOWProcessingTemplateItem]$Predecessor,
        [Parameter(Mandatory=$true,ParameterSetName='Semaphore')][ANOWSemaphore]$Semaphore,
        [Parameter(Mandatory=$true,ParameterSetName='TimeWindow')][ANOWTimeWindow]$TimeWindow,
        [Parameter(Mandatory=$true,ParameterSetName='Variable')][ANOWVariable]$Variable,
        [Parameter(Mandatory=$true,ParameterSetName='PhysicalResource')][ANOWPhysicalResource]$PhysicalResource,
        [Parameter(Mandatory=$true,ParameterSetName='Metric')][ANOWMetric]$Metric,
        [Parameter(Mandatory=$true,ParameterSetName='Event')][ANOWEvent]$Event,
        [Parameter(Mandatory=$true,ParameterSetName='Semaphore')]
        [Parameter(Mandatory=$true,ParameterSetName='TimeWindow')]
        [ANOWProcessingTemplateDependency_semaphoreState]$SemaphoreState,
        [Parameter(Mandatory=$True,ParameterSetName='Variable')]
        [Parameter(Mandatory=$True,ParameterSetName='PhysicalResource')]
        [Parameter(Mandatory=$True,ParameterSetName='Metric')]
        [ANOWProcessingTemplateDependency_valueOperator]$ValueOperator,
        [Parameter(Mandatory=$False,ParameterSetName='Variable')]
        [Parameter(Mandatory=$False,ParameterSetName='PhysicalResource')]
        [Parameter(Mandatory=$False,ParameterSetName='Metric')]
        [AllowNull()][AllowEmptyString()][object]$Value,
        [Parameter(Mandatory=$true,ParameterSetName='ProcessingCross')][ANOWProcessingTemplate]$RequiredProcessingTemplate,
        [Parameter(Mandatory=$true,ParameterSetName='WorkflowItemCross')][ANOWWorkflowTemplate]$RequiredWorkflow,
        [Parameter(Mandatory=$true,ParameterSetName='WorkflowItemCross')][ANOWProcessingTemplateItem]$RequiredWorkflowItem,
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [ValidateSet('EXECUTING','COMPLETED','FAILED')][ANOWProcessingTemplateDependency_processingStatus]$ProcessingStatus='COMPLETED',
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [ANOWProcessingTemplateDependency_statusCodeOperator]$StatusCodeOperator,
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [string]$StatusCode,
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [ANOWCalendar]$StatusCodeCalendar,
        [Parameter(Mandatory=$False,ParameterSetName='Semaphore')]
        [Parameter(Mandatory=$False,ParameterSetName='Variable')]
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [ValidateSet('ANY','EQ','NE','LT','GT','LE','GE','IN_CALENDAR')][ANOWProcessingTemplateDependency_timestampRelation]$TimestampRelation,
        [Parameter(Mandatory=$False,ParameterSetName='Semaphore')]
        [Parameter(Mandatory=$False,ParameterSetName='Variable')]
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [ValidateSet('SAME','PREV_DAY','NEXT_DAY','PREV_CAL_DAY','NEXT_CAL_DAY','SPECIFIC_DATE')][ANOWProcessingTemplateDependency_timestampSelector]$TimestampSelector,
        [Parameter(Mandatory=$False,ParameterSetName='Semaphore')]
        [Parameter(Mandatory=$False,ParameterSetName='Variable')]
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [ANOWCalendar]$TimestampCalendar,
        [Parameter(Mandatory=$False,ParameterSetName='Semaphore')]
        [Parameter(Mandatory=$False,ParameterSetName='Variable')]
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [string]$SpecificTimestamp,
        [Parameter(Mandatory=$False,ParameterSetName='ProcessingCross')]
        [Parameter(Mandatory=$False,ParameterSetName='WorkflowItemCross')]
        [switch]$Optional,
        [Parameter(ParameterSetName='Simple')][ANOWProcessingTemplateDependency]$ParentGroup,
        [Parameter(Position=4)][switch]$Force,
        [Parameter(Position=5)][switch]$Quiet
    )
    if (-not (Test-ANOWB3Session)) {
        Write-Warning 'Dependency creation session validation failed or emitted a diagnostic. No request was submitted.'
        return
    }
    if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$DependencyType within $($ProcessingTemplate.id)")) -eq $true) {
        $options = @{};foreach ($key in $PSBoundParameters.Keys) { $options[$key]=$PSBoundParameters[$key] }
        $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWDependencyCreationRequest) -OperationParameters @{Owner=$ProcessingTemplate;DependencyType=[string]$DependencyType;ParameterSet=$PSCmdlet.ParameterSetName;Options=$options}
        if (-not $prepared.Succeeded -or $prepared.Data.Count -ne 1) {
            Write-Warning 'Dependency creation preparation failed, emitted a diagnostic or did not match the bounded owner/target/condition contract. No request was submitted; the operation stopped.'
            return
        }
        $context = $prepared.Data[0]
        $parameters = @{Command='/processingTemplateDependency/create';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$context.Body}
        if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure=$true }
        $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
        if (-not $sent.Succeeded) {
            Write-Warning 'Dependency creation request failed or emitted a diagnostic. The server-side outcome is uncertain; the operation stopped and no request is retried.'
            return
        }
        $converted = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWDependencyCreationResponse) -OperationParameters @{Envelopes=$sent.Data;Context=$context}
        if (-not $converted.Succeeded -or $converted.Data.Count -ne 1 -or $converted.Data[0] -isnot [ANOWProcessingTemplateDependency]) {
            Write-Warning 'Dependency creation acknowledgment, identity/settings or strict conversion was not verified. The server-side outcome is uncertain; the operation stopped and no request is retried.'
            return
        }
        Write-Verbose "A Processing Template Dependency was successfully added to $($ProcessingTemplate.id)"
        if (-not $Quiet) { return $converted.Data[0] }
    }
}

Function Get-ANOWDependencyEditIdentity {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][ANOWProcessingTemplateDependency]$Dependency)
    $ErrorActionPreference='Stop'
    if($Dependency.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' -or
        $Dependency.isFolder -or $null -ne $Dependency.workspace -or $null -eq $Dependency.workflow -or
        $Dependency.workflow.processingType -ne 'WORKFLOW' -or $Dependency.workflow -is [ANOWScheduleTemplate] -or
        $Dependency.workflow -is [ANOWServiceManagerTemplate]){throw 'A nonfolder dependency owned by a Workflow root or item is required.'}
    $owner=Get-ANOWDependencyCreationIdentity -Source $Dependency.workflow
    if($Dependency.domain -and $Dependency.domain -cne $owner.Domain){throw 'The dependency domain does not match its owner.'}
    $kind=[string]$Dependency.dependencyType
    if($kind -eq 'RESOURCE'){
        if([string]$Dependency.resourceType -notin @('BINARY_SEMAPHORE','TIME_SEMAPHORE','VARIABLE','PHYSICAL_RESOURCE','METRIC') -or
            [string]::IsNullOrWhiteSpace($Dependency.resource) -or $Dependency.resource -match '[$\{\}]'){throw 'This resource dependency is outside the bounded editing contract.'}
    }elseif($kind -in @('PREDECESSOR','PROCESSING_TEMPLATE','WORKFLOW_ITEM')){
        $names=if($kind -eq 'PREDECESSOR'){@($Dependency.workflowItem,$Dependency.predecessor)}elseif($kind -eq 'PROCESSING_TEMPLATE'){@($Dependency.processingTemplate)}else{@($Dependency.workflowTemplate,$Dependency.workflowTemplateItem)}
        foreach($name in $names){if([string]::IsNullOrWhiteSpace($name) -or $name -match '[$\{\}]'){throw 'Literal existing dependency target identities are required.'}}
    }else{throw 'This dependency type has no selected ordinary edit contract.'}
    $identity=@{id=$Dependency.id.ToLowerInvariant();workflow=$owner.Id;ownerDomain=$owner.Domain}
    foreach($name in @('workflowItem','domain','dependencyType','resourceType','resource','predecessor','processingTemplate','workflowTemplate','workflowTemplateItem','parent','groupId')){
        $identity[$name]=[string]$Dependency.$name
    }
    $identity
}

Function New-ANOWDependencyEditRequest {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][ANOWProcessingTemplateDependency]$Target,
        [Parameter(Mandatory=$true)][ANOWProcessingTemplateDependency]$Fresh,[Parameter(Mandatory=$true)][hashtable]$Options)
    $ErrorActionPreference='Stop'
    $identity=Get-ANOWDependencyEditIdentity -Dependency $Fresh
    $original=Get-ANOWDependencyEditIdentity -Dependency $Target
    foreach($key in $identity.Keys){if($identity[$key] -cne $original[$key]){throw 'The fresh dependency does not match the immutable supplied context.'}}
    $kind=[string]$Fresh.dependencyType;$resource=[string]$Fresh.resourceType
    $state=$kind -eq 'RESOURCE' -and $resource -in @('BINARY_SEMAPHORE','TIME_SEMAPHORE')
    $valueCondition=$kind -eq 'RESOURCE' -and $resource -in @('VARIABLE','PHYSICAL_RESOURCE','METRIC')
    $statusCondition=$kind -in @('PREDECESSOR','PROCESSING_TEMPLATE','WORKFLOW_ITEM')
    $cross=$kind -in @('PROCESSING_TEMPLATE','WORKFLOW_ITEM')
    $timeCondition=$cross -or ($kind -eq 'RESOURCE' -and $resource -in @('BINARY_SEMAPHORE','VARIABLE'))
    foreach($key in $Options.Keys){
        if($key -in @('ClearStatusCode','ClearTimestamp') -and -not [bool]$Options[$key]){continue}
        if(($key -eq 'SemaphoreState' -and -not $state) -or
            ($key -in @('ValueOperator','Value') -and -not $valueCondition) -or
            ($key -in @('ProcessingStatus','StatusCodeOperator','StatusCode','StatusCodeCalendar','ClearStatusCode') -and -not $statusCondition) -or
            ($key -eq 'Optional' -and -not $cross) -or
            ($key -in @('TimestampRelation','TimestampSelector','TimestampCalendar','SpecificTimestamp','ClearTimestamp') -and -not $timeCondition)){
            throw 'An edit option is not applicable to this dependency family.'
        }
    }
    $fields=[ordered]@{};$expected=@{};$aliases=@{}
    foreach($name in @('semaphoreState','valueOperator','value','processingStatus','statusCodeOperator','statusCode','timestampRelation','timestampSelector','timestampOffset','timestampCalendar','specificTimestamp','selectedDates','optional')){$expected[$name]=$Fresh.$name}
    if($Options.ContainsKey('SemaphoreState')){$fields.semaphoreState=[string]$Options.SemaphoreState}
    if($Options.ContainsKey('ValueOperator') -or $Options.ContainsKey('Value')){
        $operator=if($Options.ContainsKey('ValueOperator')){[string]$Options.ValueOperator}else{[string]$Fresh.valueOperator}
        if(-not $operator){throw 'A value edit requires an existing or supplied comparison operator.'}
        if($Options.ContainsKey('ValueOperator')){$fields.valueOperator=$operator}
        if($operator -in @('IS_NULL','IS_NOT_NULL')){
            if($Options.ContainsKey('Value')){throw 'Null comparisons do not accept a supplied Value.'}
            $fields.value=$null
        }elseif($Options.ContainsKey('Value')){
            if($Options.Value -isnot [string]){throw 'Value must be a literal string, including an explicitly empty string.'}
            $fields.value=$Options.Value
        }elseif($operator -cne [string]$Fresh.valueOperator){throw 'Changing the value operator requires an explicit replacement Value.'}
    }
    $codeKeys=@('StatusCodeOperator','StatusCode','StatusCodeCalendar')
    $clearCode=$Options.ContainsKey('ClearStatusCode') -and [bool]$Options.ClearStatusCode
    if($clearCode){foreach($key in $codeKeys){if($Options.ContainsKey($key)){throw 'ClearStatusCode conflicts with supplied code settings.'}}}
    $status=if($Options.ContainsKey('ProcessingStatus')){[string]$Options.ProcessingStatus}else{[string]$Fresh.processingStatus}
    if($Options.ContainsKey('ProcessingStatus')){
        $fields.processingStatus=$status
        if($status -cne [string]$Fresh.processingStatus){$fields.statusCodeOperator=$null;$fields.statusCode=$null}
    }
    if($clearCode){$fields.statusCodeOperator=$null;$fields.statusCode=$null}
    if(@($codeKeys|Where-Object {$Options.ContainsKey($_)}).Count){
        if($status -notin @('COMPLETED','FAILED')){throw 'Status-code conditions require COMPLETED or FAILED.'}
        $operator=if($Options.ContainsKey('StatusCodeOperator')){[string]$Options.StatusCodeOperator}elseif($fields.Contains('statusCodeOperator')){''}else{[string]$Fresh.statusCodeOperator}
        if(-not $operator){throw 'A status-code operand requires a valid operator.'}
        if($Options.ContainsKey('StatusCodeOperator')){$fields.statusCodeOperator=$operator}
        if($operator -in @('IS_NULL','IS_NOT_NULL')){
            if($Options.ContainsKey('StatusCode') -or $Options.ContainsKey('StatusCodeCalendar')){throw 'Null code comparisons do not accept an operand.'}
            $fields.statusCode=$null
        }elseif($operator -in @('CAL','NOT_IN_CAL')){
            if($Options.ContainsKey('StatusCode') -or -not $Options.ContainsKey('StatusCodeCalendar')){throw 'A calendar code comparison requires only StatusCodeCalendar.'}
            $calendar=Get-ANOWDependencyCreationIdentity -Source $Options.StatusCodeCalendar
            if($Options.StatusCodeCalendar.resourceType -ne 'CALENDAR' -or $calendar.Domain -cne $identity.ownerDomain){throw 'A same-domain Calendar is required.'}
            $fields.statusCode=$calendar.Id;$aliases.statusCode=@($calendar.Id,$calendar.SimpleId)
        }elseif($Options.ContainsKey('StatusCode')){
            if([string]::IsNullOrEmpty($Options.StatusCode) -or $Options.ContainsKey('StatusCodeCalendar')){throw 'A nonempty literal status code is required.'}
            $fields.statusCode=$Options.StatusCode
        }elseif($Options.ContainsKey('StatusCodeCalendar') -or $operator -cne [string]$Fresh.statusCodeOperator -or $fields.Contains('statusCode')){throw 'Changing the code operator or status requires an explicit code operand.'}
    }
    if($Options.ContainsKey('Optional')){$fields.optional=([bool]$Options.Optional).ToString().ToLowerInvariant();$expected.optional=[bool]$Options.Optional}
    $timeKeys=@('TimestampRelation','TimestampSelector','TimestampCalendar','SpecificTimestamp')
    $clearTime=$Options.ContainsKey('ClearTimestamp') -and [bool]$Options.ClearTimestamp
    $hasTime=@($timeKeys|Where-Object {$Options.ContainsKey($_)}).Count -gt 0
    if($clearTime -or $hasTime){
        if($Fresh.timestampRelation -eq 'SELECTED_DATES' -or $Fresh.timestampSelector -eq 'OFFSET' -or $Fresh.selectedDates){throw 'Editing an existing OFFSET or SELECTED_DATES condition is outside this batch.'}
        if($clearTime -and $hasTime){throw 'ClearTimestamp conflicts with supplied timestamp settings.'}
        foreach($name in @('timestampRelation','timestampSelector','timestampOffset','timestampCalendar','specificTimestamp')){$fields[$name]=$null}
        if($hasTime){
            if(-not $Options.ContainsKey('TimestampRelation')){throw 'Timestamp options require an explicit replacement TimestampRelation.'}
            $relation=[string]$Options.TimestampRelation;$fields.timestampRelation=$relation
            $selector=if($Options.ContainsKey('TimestampSelector')){[string]$Options.TimestampSelector}else{''}
            $needCalendar=$false;$needDate=$false
            if($relation -eq 'ANY'){
                if($selector){throw 'ANY does not accept a selector.'}
            }elseif($relation -eq 'IN_CALENDAR'){
                if($selector){throw 'IN_CALENDAR does not accept a selector.'};$needCalendar=$true
            }else{
                if(-not $selector){throw 'A timestamp comparison requires a supported selector.'}
                $fields.timestampSelector=$selector;$needCalendar=$selector -in @('PREV_CAL_DAY','NEXT_CAL_DAY');$needDate=$selector -eq 'SPECIFIC_DATE'
            }
            if($needDate){
                $parsed=[datetime]::MinValue
                if(-not $Options.ContainsKey('SpecificTimestamp') -or -not [datetime]::TryParseExact($Options.SpecificTimestamp,'yyyy-MM-dd',[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::None,[ref]$parsed)){throw 'SpecificTimestamp requires an exact valid yyyy-MM-dd date.'}
                $fields.specificTimestamp=$Options.SpecificTimestamp
            }elseif($Options.ContainsKey('SpecificTimestamp')){throw 'SpecificTimestamp requires SPECIFIC_DATE.'}
            if($needCalendar){
                if(-not $Options.ContainsKey('TimestampCalendar')){throw 'The timestamp condition requires a Calendar.'}
                $calendar=Get-ANOWDependencyCreationIdentity -Source $Options.TimestampCalendar
                if($Options.TimestampCalendar.resourceType -ne 'CALENDAR' -or $calendar.Domain -cne $identity.ownerDomain){throw 'A same-domain Calendar is required.'}
                $fields.timestampCalendar=$calendar.Id;$aliases.timestampCalendar=@($calendar.Id,$calendar.SimpleId)
            }elseif($Options.ContainsKey('TimestampCalendar')){throw 'The timestamp condition does not accept a Calendar.'}
        }
    }
    if($fields.Count -eq 0){throw 'At least one applicable condition change is required.'}
    foreach($name in $fields.Keys){if($name -ne 'optional'){$expected[$name]=$fields[$name]}}
    $fields.id=$Target.id;$fields._oldValues=$Fresh.CreateOldValues();$fields.lastUpdated=$null
    $fields._operationType='update';$fields._textMatchStyle='exact';$fields._componentId='ProcessingTemplateDependencyEditForm'
    $fields._dataSource='ProcessingTemplateDependencyDataSource';$fields.isc_metaDataPrefix='_';$fields.isc_dataFormat='json'
    $body=@(ConvertTo-QueryString -InputObject $fields)
    if($body.Count -ne 1 -or $body[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($body[0])){throw 'One nonempty update form is required.'}
    [pscustomobject]@{Body=$body[0];Fresh=$Fresh;Identity=$identity;Expected=$expected;Aliases=$aliases}
}

Function Confirm-ANOWDependencyEditAcknowledgment {
    [CmdletBinding()]
    param([object[]]$Envelopes,[Parameter(Mandatory=$true)][object]$Context)
    $ErrorActionPreference='Stop'
    if(-not (Test-ANOWPreservationAcknowledgment -Envelopes $Envelopes)){throw 'One explicit integral-zero update acknowledgment is required.'}
    $dataMember=$Envelopes[0].response.PSObject.Properties['data']
    $rows=@()
    if($null -ne $dataMember){$rows=@($dataMember.Value|Where-Object {$null -ne $_})}
    if($rows.Count -gt 1){throw 'The update returned multiple dependency rows.'}
    if($rows.Count -eq 1){
        $row=$rows[0]
        if($row -isnot [System.Management.Automation.PSCustomObject] -or $row.id -isnot [string] -or $row.id -ine $Context.Fresh.id){throw 'A returned acknowledgment row must identify the same dependency.'}
        $type=[ANOWProcessingTemplateDependency];$properties=@{}
        foreach($property in $type.GetProperties([Reflection.BindingFlags]'Public,Instance')){if($property.CanWrite){$properties[$property.Name]=$property}}
        $seen=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
        $staged=@{}
        foreach($member in $row.PSObject.Properties){
            $name=$member.Name;$value=$member.Value
            if(-not $seen.Add($name) -or -not $properties.ContainsKey($name)){throw 'A returned dependency member is unknown or repeated.'}
            if($name -ieq 'workflow'){
                if($value -isnot [string] -or $value -cne $Context.Fresh.workflow.id){throw 'The returned owner does not match.'}
                $value=$Context.Fresh.workflow
            }elseif($name -ieq 'workspace'){
                if($null -ne $value -and ($value -isnot [string] -or $value.Length -ne 0)){throw 'Workspace output is outside this edit contract.'};$value=$null
            }elseif($name -ieq 'isFolder'){
                if($value -isnot [bool] -or $value){throw 'The acknowledgment is not an ordinary dependency row.'}
            }elseif($name -ieq 'id'){
                if($value -ine $Context.Fresh.id){throw 'The returned dependency ID differs.'}
            }elseif($Context.Identity.ContainsKey($name)){
                if(($null -ne $value -and $value -isnot [string]) -or [string]$value -cne $Context.Identity[$name]){throw 'A returned dependency identity differs.'}
            }elseif($Context.Expected.ContainsKey($name)){
                if($name -ieq 'optional'){
                    if($value -isnot [bool] -or $value -ne $Context.Expected[$name]){throw 'The returned Optional flag differs.'}
                }elseif([string]$value -cne [string]$Context.Expected[$name] -and
                    (-not $Context.Aliases.ContainsKey($name) -or $Context.Aliases[$name] -cnotcontains $value)){throw 'A returned condition differs from the intended result.'}
            }
            $propertyType=$properties[$name].PropertyType;$underlying=[Nullable]::GetUnderlyingType($propertyType)
            if($null -eq $underlying){$underlying=$propertyType}
            if($null -eq $value -and $propertyType.IsValueType -and $propertyType -eq $underlying){throw 'A nonnullable returned field is null.'}
            if($null -ne $value -and $underlying -eq [bool] -and $value -isnot [bool]){throw 'A returned Boolean field is not native Boolean.'}
            if($null -ne $value -and $underlying -eq [string] -and $value -isnot [string]){throw 'A returned string field is not a scalar string.'}
            $converted=$null
            if(-not [Management.Automation.LanguagePrimitives]::TryConvertTo($value,$propertyType,[Globalization.CultureInfo]::InvariantCulture,[ref]$converted)){throw 'Strict dependency member conversion failed.'}
            if($null -ne $converted -and $underlying.IsEnum -and -not [Enum]::IsDefined($underlying,$converted)){throw 'A returned enum value is unsupported.'}
            $staged[$properties[$name].Name]=$converted
        }
        $typed=[ANOWProcessingTemplateDependency]::new()
        foreach($name in $staged.Keys){$typed.$name=$staged[$name]}
    }
    $true
}

Function Confirm-ANOWDependencyEditReadback {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][ANOWProcessingTemplateDependency]$Dependency,[Parameter(Mandatory=$true)][object]$Context)
    $ErrorActionPreference='Stop'
    $identity=Get-ANOWDependencyEditIdentity -Dependency $Dependency
    foreach($name in $Context.Identity.Keys){if($identity[$name] -cne $Context.Identity[$name]){throw 'The independently read dependency identity changed.'}}
    foreach($name in $Context.Expected.Keys){
        $value=$Dependency.$name
        if($name -eq 'optional'){
            if($value -ne $Context.Expected[$name]){throw 'The independently read Optional flag differs.'}
        }elseif([string]$value -cne [string]$Context.Expected[$name] -and
            (-not $Context.Aliases.ContainsKey($name) -or $Context.Aliases[$name] -cnotcontains [string]$value)){throw 'An independently read condition or clear was not verified.'}
    }
    $Dependency
}

Function Set-AutomateNOWProcessingTemplateDependency {
    <#
    .SYNOPSIS
    Edits conditions on an existing ordinary Workflow dependency and verifies the result independently.
    .DESCRIPTION
    Updates explicitly supplied condition fields after one clean exact prerequisite read. Owner, target, type and group placement remain fixed. Requires an integral-zero acknowledgment, strict validation of any returned row and one independent exact readback, including Quiet. Diagnostics or uncertainty stop later pipeline inputs without retry; a dispatched operation may already have changed the server.
    .PARAMETER ProcessingTemplateDependency
    Existing ANOWProcessingTemplateDependency from Read-AutomateNOWProcessingTemplateDependency. Supports Workflow roots/items, five value/state resource conditions, predecessor and both cross families. Stock/Lock use the existing resource-dependency setter.
    .PARAMETER SemaphoreState
    ON/OFF for Semaphore or Time Window. Time Window ON means Open; OFF means Closed.
    .PARAMETER ValueOperator
    Variable/Physical Resource/Metric comparison operator. Changing an operand operator requires an explicit Value. Null tests clear the old value and reject supplied operands.
    .PARAMETER Value
    Literal string operand; explicit empty text and original numeric/date spelling are preserved. A Value-only edit uses the fresh existing operator.
    .PARAMETER ProcessingStatus
    PREDECESSOR/Processing Cross/Workflow Item Cross status: EXECUTING, COMPLETED or FAILED. An actual change clears old status-code settings unless valid replacements are supplied.
    .PARAMETER StatusCodeOperator
    Status-code comparison for COMPLETED/FAILED. Null tests clear the operand; calendar operators require StatusCodeCalendar, others require a nonempty literal code when changing operators.
    .PARAMETER StatusCode
    Literal status-code operand.
    .PARAMETER StatusCodeCalendar
    Same-domain typed Calendar for CAL/NOT_IN_CAL code comparisons.
    .PARAMETER ClearStatusCode
    Clears the status-code operator and operand. Cannot be combined with code settings.
    .PARAMETER Optional
    Processing Cross/Workflow Item Cross optional flag. Explicit Optional:$false is preserved.
    .PARAMETER TimestampRelation
    Replacement timestamp group for Semaphore, Variable or a cross dependency: ANY, EQ, NE, LT, GT, LE, GE or IN_CALENDAR. Required when any timestamp control is supplied.
    .PARAMETER TimestampSelector
    SAME, PREV_DAY, NEXT_DAY, PREV_CAL_DAY, NEXT_CAL_DAY or SPECIFIC_DATE for comparison relations. Inapplicable timestamp controls are cleared.
    .PARAMETER TimestampCalendar
    Same-domain typed Calendar for IN_CALENDAR or calendar-day selectors.
    .PARAMETER SpecificTimestamp
    Exact valid yyyy-MM-dd date for SPECIFIC_DATE.
    .PARAMETER ClearTimestamp
    Clears the supported timestamp group; cannot be combined with timestamp settings. Existing OFFSET/SELECTED_DATES groups cannot be edited by this command.
    .PARAMETER Force
    Suppresses confirmation while preserving explicit and ambient WhatIf. WhatIf performs no prerequisite, update or readback request.
    .PARAMETER Quiet
    Suppresses the result after the same full verification.
    .INPUTS
    ANOWProcessingTemplateDependency, named or through the pipeline.
    .OUTPUTS
    ANOWProcessingTemplateDependency, unless Quiet is supplied.
    .EXAMPLE
    $dependency = Read-AutomateNOWProcessingTemplateDependency -Id 'c680bdfc-ba66-4645-971d-1c3ada3d545b'
    $dependency | Set-AutomateNOWProcessingTemplateDependency -SemaphoreState OFF
    .EXAMPLE
    Set-AutomateNOWProcessingTemplateDependency -ProcessingTemplateDependency $variableCondition -ValueOperator EQ_NUM -Value '007.50'
    .EXAMPLE
    $cross | Set-AutomateNOWProcessingTemplateDependency -ProcessingStatus FAILED -StatusCodeOperator EQ -StatusCode 'EXPECTED' -Optional:$false
    .EXAMPLE
    $cross | Set-AutomateNOWProcessingTemplateDependency -ClearStatusCode -TimestampRelation EQ -TimestampSelector SPECIFIC_DATE -SpecificTimestamp '2026-11-08'
    .EXAMPLE
    $semaphoreCondition | Set-AutomateNOWProcessingTemplateDependency -ClearTimestamp -Quiet
    .EXAMPLE
    $cross | Set-AutomateNOWProcessingTemplateDependency -Optional -Force -WhatIf
    .NOTES
    Requires Connect-AutomateNOW. Conditions use literal existing identities. This does not retarget, reparent, reorder, edit groups/Chronology/Event references, expand owner contexts or add calculated names/OFFSET/SELECTED_DATES encodings. Native clearing, concurrency and runtime evaluation require separate live qualification; no automatic retry or rollback is performed.
    #>
    [OutputType([ANOWProcessingTemplateDependency])]
    [CmdletBinding(SupportsShouldProcess=$true,ConfirmImpact='High')]
    param(
        [Parameter(Mandatory=$true,Position=0,ValueFromPipeline=$true)][ANOWProcessingTemplateDependency]$ProcessingTemplateDependency,
        [ANOWProcessingTemplateDependency_semaphoreState]$SemaphoreState,
        [ANOWProcessingTemplateDependency_valueOperator]$ValueOperator,
        [AllowNull()][AllowEmptyString()][object]$Value,
        [ValidateSet('EXECUTING','COMPLETED','FAILED')][ANOWProcessingTemplateDependency_processingStatus]$ProcessingStatus,
        [ANOWProcessingTemplateDependency_statusCodeOperator]$StatusCodeOperator,
        [string]$StatusCode,[ANOWCalendar]$StatusCodeCalendar,[switch]$ClearStatusCode,[switch]$Optional,
        [ValidateSet('ANY','EQ','NE','LT','GT','LE','GE','IN_CALENDAR')][ANOWProcessingTemplateDependency_timestampRelation]$TimestampRelation,
        [ValidateSet('SAME','PREV_DAY','NEXT_DAY','PREV_CAL_DAY','NEXT_CAL_DAY','SPECIFIC_DATE')][ANOWProcessingTemplateDependency_timestampSelector]$TimestampSelector,
        [ANOWCalendar]$TimestampCalendar,[string]$SpecificTimestamp,[switch]$ClearTimestamp,[switch]$Force,[switch]$Quiet
    )
    begin {
        $batchStopped=$false;$options=@{}
        foreach($name in @('SemaphoreState','ValueOperator','Value','ProcessingStatus','StatusCodeOperator','StatusCode','StatusCodeCalendar','ClearStatusCode','Optional','TimestampRelation','TimestampSelector','TimestampCalendar','SpecificTimestamp','ClearTimestamp')){
            if($PSBoundParameters.ContainsKey($name)){$options[$name]=$PSBoundParameters[$name]}
        }
        $effective=@($options.Keys|Where-Object {$_ -notin @('ClearStatusCode','ClearTimestamp') -or [bool]$options[$_]})
        if($effective.Count -eq 0){$batchStopped=$true;Write-Warning 'Dependency editing requires at least one explicit condition change. No request was submitted; subsequent inputs are stopped.';return}
        if(-not (Test-ANOWB3Session)){$batchStopped=$true;Write-Warning 'Dependency editing session validation failed or emitted a diagnostic. No request was submitted; subsequent inputs are stopped.';return}
    }
    process {
        if($batchStopped){return}
        $initial=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-ANOWDependencyEditIdentity) -OperationParameters @{Dependency=$ProcessingTemplateDependency}
        if(-not $initial.Succeeded -or $initial.Data.Count -ne 1){$batchStopped=$true;Write-Warning 'The supplied dependency is outside the literal Workflow condition-editing contract. No request was submitted; subsequent inputs are stopped.';return}
        $id=$ProcessingTemplateDependency.id
        if(($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess($id)) -eq $true){
            $checked=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingTemplateDependency) -OperationParameters @{Id=$id}
            if(-not $checked.Succeeded -or $checked.Data.Count -ne 1 -or $checked.Data[0] -isnot [ANOWProcessingTemplateDependency]){
                $batchStopped=$true;Write-Warning 'Dependency edit prerequisite failed, emitted a diagnostic or did not return one typed dependency. No update was submitted; subsequent inputs are stopped.';return
            }
            $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWDependencyEditRequest) -OperationParameters @{Target=$ProcessingTemplateDependency;Fresh=$checked.Data[0];Options=$options}
            if(-not $prepared.Succeeded -or $prepared.Data.Count -ne 1){$batchStopped=$true;Write-Warning 'Dependency edit identity or condition preparation failed or emitted a diagnostic. No update was submitted; subsequent inputs are stopped.';return}
            $context=$prepared.Data[0]
            $parameters=@{Command='/processingTemplateDependency/update';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$context.Body}
            if($anow_session.NotSecure -eq $true){$parameters.NotSecure=$true}
            $sent=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if(-not $sent.Succeeded){$batchStopped=$true;Write-Warning 'Dependency edit request failed or emitted a diagnostic. The server-side outcome may be uncertain; subsequent inputs are stopped without retry.';return}
            $ack=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Confirm-ANOWDependencyEditAcknowledgment) -OperationParameters @{Envelopes=$sent.Data;Context=$context}
            if(-not $ack.Succeeded -or $ack.Data.Count -ne 1 -or $ack.Data[0] -isnot [bool] -or -not $ack.Data[0]){
                $batchStopped=$true;Write-Warning 'Dependency edit acknowledgment or strict returned fields were not verified. The server-side outcome may be uncertain; subsequent inputs are stopped without retry.';return
            }
            $readback=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingTemplateDependency) -OperationParameters @{Id=$id}
            if(-not $readback.Succeeded -or $readback.Data.Count -ne 1 -or $readback.Data[0] -isnot [ANOWProcessingTemplateDependency]){
                $batchStopped=$true;Write-Warning 'Dependency edit independent readback failed, emitted a diagnostic or did not return one typed dependency. The server-side outcome may be uncertain; subsequent inputs are stopped without retry.';return
            }
            $verified=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Confirm-ANOWDependencyEditReadback) -OperationParameters @{Dependency=$readback.Data[0];Context=$context}
            if(-not $verified.Succeeded -or $verified.Data.Count -ne 1 -or $verified.Data[0] -isnot [ANOWProcessingTemplateDependency]){
                $batchStopped=$true;Write-Warning 'Dependency edit identity, conditions, clears or preservation were not independently verified. The server-side outcome may be uncertain; subsequent inputs are stopped without retry.';return
            }
            Write-Verbose "Processing Template Dependency $id has been updated and independently verified"
            if(-not $Quiet){$verified.Data[0]}
        }
    }
}


Function New-ANOWDependencyRemovalBody {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][ANOWProcessingTemplateDependency]$Dependency)
    # Fixed local preparation using the caller's unchanged oldValues contract.
    $ErrorActionPreference = 'Stop'
    [string]$oldValues = $Dependency.CreateOldValues()
    [System.Collections.Specialized.OrderedDictionary]$metadata = [ordered]@{
        id = $Dependency.id
        _oldValues = $oldValues
        _operationType = 'remove'
        _textMatchStyle = 'exact'
        _dataSource = 'ProcessingTemplateDependencyDataSource'
        isc_metaDataPrefix = '_'
        isc_dataFormat = 'json'
    }
    $body = @(ConvertTo-QueryString -InputObject $metadata)
    if ($body.Count -ne 1 -or $body[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($body[0])) {
        throw 'Dependency removal body preparation did not return one nonempty string.'
    }
    return $body[0]
}

Function Remove-AutomateNOWProcessingTemplateDependency {
    <#
    .SYNOPSIS
    Removes a Processing Template Dependency from a Processing Template Item within a Processing Template

    .DESCRIPTION
    Removes a Processing Template Dependency from a Processing Template Item within a Processing Template

    .PARAMETER ProcessingTemplateDependency
    Mandatory [ANOWProcessingTemplateDependency] object representing the Processing Template Dependency that will be removed. Use Read-AutomateNOWProcessingTemplateDependency to fetch these.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present one or more [ANOWProcessingTemplateDependency] objects to the ProcessingTemplateDependency parameter or across the pipeline

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Imagine a Workflow Template named 'WorkflowTemplate1' that contains two Task Templates named 'TaskTemplate1' and 'TaskTemplate2' where 'TaskTemplate2' has been configured as a successor of 'TaskTemplate1'.

    Removes a successor Workflow Template Dependency object between 'TaskTemplate1' and 'TaskTemplate2' within a Workflow Template named 'WorkflowTemplate1'

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem -Name 'TaskTemplate1' | Read-AutomateNOWProcessingTemplateDependency -Successors | Remove-AutomateNOWProcessingTemplateDependency

    .EXAMPLE
    Imagine a Service Manager Template named 'ServiceManagerTemplate1' that contains two Task Templates (Processing Deadline Monitors) named 'ProcessingDeadlineMonitor1' and 'ProcessingDeadlineMonitor2' where 'ProcessingDeadlineMonitor2' has been configured as a successor of 'ProcessingDeadlineMonitor1'.

    Removes a successor Service Manager Template Dependency object between 'ProcessingDeadlineMonitor1' and 'ProcessingDeadlineMonitor2' within a Service Manager Template named 'ServiceManagerTemplate1'

    Get-AutomateNOWServiceManagerTemplate -Id 'ServiceManagerTemplate1' | Read-AutomateNOWServiceManagerTemplateItem -Name 'ProcessingDeadlineMonitor1' | Read-AutomateNOWProcessingTemplateDependency -Successors | Remove-AutomateNOWProcessingTemplateDependency

    .EXAMPLE
    Removes a specific Processing Template Dependency object by its id (one-liner)

    Read-AutomateNOWProcessingTemplateDependency -Id '1e6da255-b2d5-458f-aff6-711b06c14921' | Remove-AutomateNOWProcessingTemplateDependency

    .NOTES
    A deletion requires one explicit integral-zero acknowledgment; absent or empty data is valid.
    Diagnostics stop subsequent inputs. No request is retried, and a dispatched failure may have an uncertain server-side outcome.

    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [Alias('Remove-AutomateNOWWorkflowTemplateDependency', 'Remove-AutomateNOWServiceManagerTemplateDependency')]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'Dependency removal session check failed or emitted a diagnostic. No request was submitted; subsequent removals are stopped.'
            return
        }
        [hashtable]$parameters = @{
            Command = '/processingTemplateDependency/delete'
            Method = 'POST'
            ContentType = 'application/x-www-form-urlencoded; charset=UTF-8'
        }
        if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
    }
    Process {
        if ($batchStopped) { return }
        If ($_.id.Length -gt 0) {
            [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency = $_
        }
        [string]$ProcessingTemplateDependency_id = $ProcessingTemplateDependency.id
        if ($ProcessingTemplateDependency_id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z') {
            $batchStopped = $true
            Write-Warning 'Dependency removal requires a nonempty hexadecimal D-form GUID. No request was submitted; subsequent removals are stopped.'
            return
        }
        Write-Verbose -Message "Received [$ProcessingTemplateDependency_id] for the Id of the Processing Template Dependency to be removed"
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($ProcessingTemplateDependency_id)")) -eq $true) {
            $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingTemplateDependency) -OperationParameters @{Id=$ProcessingTemplateDependency_id}
            if (-not $checked.Succeeded -or $checked.Data.Count -ne 1 -or
                $checked.Data[0] -isnot [ANOWProcessingTemplateDependency] -or
                $checked.Data[0].id -ine $ProcessingTemplateDependency_id) {
                $batchStopped = $true
                Write-Warning 'Dependency removal prerequisite failed, emitted a diagnostic or did not return one matching typed dependency. No request was submitted; subsequent removals are stopped.'
                return
            }
            $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWDependencyRemovalBody) -OperationParameters @{Dependency=$ProcessingTemplateDependency}
            if (-not $prepared.Succeeded -or $prepared.Data.Count -ne 1 -or
                $prepared.Data[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($prepared.Data[0])) {
                $batchStopped = $true
                Write-Warning 'Dependency removal preparation failed or emitted a diagnostic. No request was submitted for this input; subsequent removals are stopped.'
                return
            }
            $parameters.Body = $prepared.Data[0]
            $request = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if (-not $request.Succeeded) {
                $batchStopped = $true
                Write-Warning 'Dependency removal request failed or emitted a diagnostic. Its server-side outcome may be uncertain; subsequent removals are stopped and no request is retried.'
                return
            }
            $acknowledged = $false
            if ($request.Data.Count -eq 1) {
                $status = $request.Data[0].response.status
                $acknowledged = (($status -is [int32] -or $status -is [int64]) -and
                    (Test-ANOWB2Response -Envelopes $request.Data -AcknowledgmentOnly))
            }
            if (-not $acknowledged) {
                $batchStopped = $true
                Write-Warning 'Dependency removal did not return one explicit integral-zero acknowledgment. Its server-side outcome may be uncertain; subsequent removals are stopped and no request is retried.'
                return
            }
            [string]$ProcessingTemplate_id = $ProcessingTemplateDependency.workflow.id
            Write-Verbose -Message "Processing Template Dependency $ProcessingTemplateDependency_id has been removed from $ProcessingTemplate_id"
        }
    }
    End {
    }
}

#endregion

#region - Processing Template Item (PROCESSING_TEMPLATE_ITEM)

Function Read-AutomateNOWProcessingTemplateItem {
    <#
    .SYNOPSIS
    Reads the Processing Template Items and their sort order within a Processing Template from an AutomateNOW! instance

    .DESCRIPTION
    Reads the Processing Template Items and their sort order within a Processing Template (Workflow, Service Manager, or Schedule Template) from an AutomateNOW! instance

    .PARAMETER ProcessingTemplate
    An [ANOWProcessingTemplate] object representing the Processing Template to be read. Accepts Workflow Templates, Service Manager Templates, or Schedule Templates.

    .PARAMETER Id
    A string containing the 36-character guid Id of the Processing Template Item to fetch. This parameter is standalone and cannot be combined with -ProcessingTemplate.

    .PARAMETER Name
    A string containing the "name" to filter the results by. You must still include -ProcessingTemplate when using this parameter.

    .PARAMETER Title
    A string containing the "title" to filter the results by. You must still include -ProcessingTemplate when using this parameter.

    .PARAMETER startRow
    Optional integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Optional integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .INPUTS
    [ANOWProcessingTemplate] objects are accepted (including from the pipeline) or a single 36-character guid string representing the Id of the Processing Template Item.

    .OUTPUTS
    [ANOWProcessingTemplateItem[]] objects that represent the processing template items will be returned. Depending on the item type, these may be [ANOWScheduleTemplateItem], [ANOWWorkflowTemplateItem], [ANOWTaskTemplateItem], or [ANOWServiceManagerTemplateItem] objects.

    .EXAMPLE
    Gets the first page of Processing Template Items in a Workflow Template named 'WorkflowTemplate1' (multi-line)

    $workflow_template = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1'
    $workflow_template_items = $workflow_template | Read-AutomateNOWProcessingTemplateItem

    .EXAMPLE
    Gets the first page of Processing Template Items in a Service Manager Template named 'ServiceManagerTemplate1' (multi-line)

    $service_manager_template = Get-AutomateNOWServiceManagerTemplate -Id 'ServiceManagerTemplate1'
    $service_manager_template_items = $service_manager_template | Read-AutomateNOWProcessingTemplateItem

    .EXAMPLE
    Gets a specific Processing Template Item with a Title 'ProcessingTemplateItem1' from within a Workflow Template named 'WorkflowTemplate1' (one-liner format)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateItem -Title 'ProcessingTemplateItem1'

    .EXAMPLE
    Gets a specific Processing Template Item with an Id of '12342fde-7e1e-4a69-ae7c-bc15e19a0fe1'. Note that you do not need to include the -ProcessingTemplate in this scenario (one-liner format)

    Read-AutomateNOWProcessingTemplateItem -Id '12342fde-7e1e-4a69-ae7c-bc15e19a0fe1'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The Name property is not the same as the Title property. See the FAQ for more.

    Processing Template Items, by default, will not have a Title unless it is explicitly set.

    For Schedule Templates: The first item listed will be the Schedule itself which has a sort order of -1 (which is filtered out). The remaining child items will start at sort order 1 or above and are returned.

    This function has aliases for backward compatibility: Read-AutomateNOWWorkflowTemplateItem, Read-AutomateNOWServiceManagerTemplateItem, Read-AutomateNOWScheduleTemplateItem

    #>
    [OutputType([ANOWProcessingTemplateItem[]])]
    [Alias('Read-AutomateNOWWorkflowTemplateItem', 'Read-AutomateNOWServiceManagerTemplateItem', 'Read-AutomateNOWScheduleTemplateItem')]
    [CmdletBinding(DefaultParameterSetName = 'Default')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Default', ValueFromPipeline = $true)]
        [ANOWProcessingTemplate]$ProcessingTemplate,
        [ValidateScript({ $_ -match '^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Id')]
        [string]$Id,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [string]$Name,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [string]$Title,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'Default')]
        [int32]$endRow = 100
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($endRow -le $startRow) {
            Write-Warning -Message "The endRow must be greater than the startRow. Please try again."
            Break
        }
        If ($Name.Length -gt 0 -and $Title.Length -gt 0) {
            Write-Warning -Message "Please do not specify the -Name and the -Title"
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWProcessingTemplate]$ProcessingTemplate = $_
        }
        [string]$processingType = $ProcessingTemplate.processingType
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If ($Id.Length -gt 0) {
            [string]$current_command = 'read'
            $BodyMetaData.Add('id', $Id )
        }
        ElseIf ($Name.Length -gt 0) {
            [string]$current_command = 'read'
            [string]$ProcessingTemplate_id = $ProcessingTemplate.Id
            $BodyMetaData.Add('name', $Name )
            $BodyMetaData.Add('workflow', $ProcessingTemplate_id )
            $BodyMetaData.Add('_startRow', $startRow)
            $BodyMetaData.Add('_endRow', $endRow)
        }
        ElseIf ($Title.Length -gt 0) {
            [string]$current_command = 'read'
            [string]$ProcessingTemplate_id = $ProcessingTemplate.Id
            $BodyMetaData.Add('workflow', $ProcessingTemplate_id )
            $BodyMetaData.Add('_startRow', $startRow)
            $BodyMetaData.Add('_endRow', $endRow)
            $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
            $BodyMetaData.Add('operator', 'and')
            $BodyMetaData.Add('criteria1', ('{"fieldName":"title","operator":"equals","value":"' + $Title + '"}'))
        }
        ElseIf ($ProcessingTemplate.Id.Length -gt 0) {
            [string]$ProcessingTemplate_id = $ProcessingTemplate.Id
            If ($processingType -eq 'TRIGGER') {
                [string]$current_command = 'read'
                $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
                $BodyMetaData.Add('operator', 'and')
                $BodyMetaData.Add('criteria1', '{"fieldName":"workflow","operator":"equals","value":"' + $ProcessingTemplate_id + '"}')
                $BodyMetaData.Add('_startRow', $startRow)
                $BodyMetaData.Add('_endRow', $endRow)
                $BodyMetaData.Add('_sortBy', 'processingTemplate')
            }
            Else {
                [string]$current_command = 'readWorkflow'
                $BodyMetaData.Add('workflow', $ProcessingTemplate_id )
                $BodyMetaData.Add('_operationId', 'readWorkflow')
                $BodyMetaData.Add('_startRow', $startRow)
                $BodyMetaData.Add('_endRow', $endRow)
                $BodyMetaData.Add('_sortBy1', '-isMasterRecord')
                $BodyMetaData.Add('_sortBy2', 'sortOrder')
                $BodyMetaData.Add('_sortBy3', 'title')
            }
        }
        Else {
            Write-Warning -Message "Could not determine the arrangement under Read-AutomateNOWProcessingTemplateItem"
            Break
        }
        If ($processingType -eq 'TRIGGER') {
            $BodyMetaData.Add('_componentId', 'TriggerItemList')
        }
        Else {
            $BodyMetaData.Add('_componentId', 'ProcessingTemplateItemList')
        }
        $BodyMetaData.Add('_textMatchStyle', 'exact')
        $BodyMetaData.Add('_operationType', 'fetch')
        $BodyMetaData.Add('_dataSource', 'ProcessingTemplateItemDataSource')
        $BodyMetaData.Add('isc_metaDataPrefix', '_')
        $BodyMetaData.Add('isc_dataFormat', 'json')
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/processingTemplateItem/' + $current_command + '?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.'Command' = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$ProcessingTemplate_id] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        If ($results.response.data.count -eq 1) {
            If ($results.response.data.id -eq $ProcessingTemplate_id) {
                Write-Verbose -Message "No Processing Template Items found within $ProcessingTemplate_id"
                Return
            }
        }
        If ($results.response.data.count -gt 0) {
            $Error.Clear()
            Try {
                [ANOWProcessingTemplateItem[]]$ProcessingTemplateItems = $results.response.data | Where-Object { $_.sortOrder -ge 0 } | ForEach-Object {
                    If ($null -eq $ProcessingTemplate) {
                        [string]$processing_template_id = $results.response.data.workflow
                        [string]$ProcessingTemplate_simpleId = $processing_template_id -split ']' | Select-Object -Last 1
                        [ANOWProcessingTemplate]$ProcessingTemplate = Get-AutomateNOWProcessingTemplate -Id $ProcessingTemplate_simpleId
                    }
                    $_.workflow = $ProcessingTemplate
                    If ($_.processingType -eq 'TRIGGER' -or $_.parentProcessingType -eq 'TRIGGER') {
                        [ANOWScheduleTemplateItem]$_
                    }
                    ElseIf ($_.processingType -eq 'WORKFLOW' -or $_.parentProcessingType -eq 'WORKFLOW') {
                        [ANOWWorkflowTemplateItem]$_
                    }
                    ElseIf ($_.processingType -eq 'TASK' -or $_.parentProcessingType -eq 'TASK') {
                        [ANOWTaskTemplateItem]$_
                    }
                    ElseIf ($_.processingType -eq 'SERVICE' -or $_.parentProcessingType -eq 'SERVICE') {
                        [ANOWServiceManagerTemplateItem]$_
                    }
                    Else {
                        [string]$itemProcessingType = $_.processingType
                        [string]$parentProcessingType = $_.parentProcessingType
                        Write-Warning -Message "Unable to determine the type of Processing Template ($itemProcessingType / $parentProcessingType) under Read-AutomateNOWProcessingTemplateItem reading $ProcessingTemplate_id."
                        Break
                    }
                }
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to parse the Processing Template Items from $ProcessingTemplate_id due to [$Message]"
                Break
            }
            [int32]$ProcessingTemplateItems_Count = $ProcessingTemplateItems.Count
            Write-Verbose -Message "Returning $ProcessingTemplateItems_Count Processing Template Items from within $ProcessingTemplate_id"
            Return $ProcessingTemplateItems
        }
        Else {
            Write-Verbose -Message "There were no Processing Template Items within $ProcessingTemplate_id"
        }
    }
    End {

    }
}

Function Export-AutomateNOWProcessingTemplateItem {
    <#
    .SYNOPSIS
    Exports the Processing Template Items from an API User on an instance of AutomateNOW! to a local .csv file

    .DESCRIPTION
    Exports the Processing Template Items from an API User on an instance of AutomateNOW! to a local .csv file (the actual access token is not included)

    .PARAMETER ProcessingTemplateItem
    Mandatory [ANOWProcessingTemplateItem] object (Use Read-AutomateNOWProcessingTemplateItem to retrieve them). Supports Schedule Template Items, Service Manager Template Items, and Workflow Template Items.

    .INPUTS
    ONLY [ANOWProcessingTemplateItem] objects (or its subclasses) from the pipeline are accepted

    .OUTPUTS
    The [ANOWProcessingTemplateItem] objects are exported to the local disk in CSV format

    .EXAMPLE
    Exports the first page of Workflow Template Items from a Workflow Template named 'WorkflowTemplate1'

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateItem | Export-AutomateNOWProcessingTemplateItem

    .EXAMPLE
    Exports the first page of Schedule Template Items from a Schedule Template named 'ScheduleTemplate1'

    Get-AutomateNOWScheduleTemplate -Id 'ScheduleTemplate1' | Read-AutomateNOWProcessingTemplateItem | Export-AutomateNOWProcessingTemplateItem

    .EXAMPLE
    Exports the first page of Service Manager Template Items from a Service Manager Template named 'ServiceManagerTemplate1'

    Get-AutomateNOWServiceManagerTemplate -Id 'ServiceManagerTemplate1' | Read-AutomateNOWProcessingTemplateItem | Export-AutomateNOWProcessingTemplateItem

    .NOTES
    You must present [ANOWProcessingTemplateItem] objects to the pipeline to use this function.

    This function has aliases for backward compatibility: Export-AutomateNOWWorkflowTemplateItem, Export-AutomateNOWServiceManagerTemplateItem, Export-AutomateNOWScheduleTemplateItem

    #>

    [CmdletBinding()]
    [Alias('Export-AutomateNOWWorkflowTemplateItem', 'Export-AutomateNOWServiceManagerTemplateItem', 'Export-AutomateNOWScheduleTemplateItem')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [ANOWProcessingTemplateItem]$ProcessingTemplateItem
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = ''
        [string]$ExportFilePath = ''
        [hashtable]$parameters = @{}
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            $ProcessingTemplateItem = $_ # do not hard type this variable
        }
        If ($ExportFileName.Length -eq 0) {
            [string]$TypeName = $ProcessingTemplateItem.GetType().Name
            If ($TypeName -eq 'ANOWScheduleTemplateItem') {
                [string]$ExportFileName = "Export-AutomateNOW-ScheduleTemplateItems-" + $current_time + '.csv'
            }
            ElseIf ($TypeName -eq 'ANOWServiceManagerTemplateItem') {
                [string]$ExportFileName = "Export-AutomateNOW-ServiceManagerTemplateItems-" + $current_time + '.csv'
            }
            ElseIf ($TypeName -eq 'ANOWWorkflowTemplateItem') {
                [string]$ExportFileName = "Export-AutomateNOW-WorkflowTemplateItems-" + $current_time + '.csv'
            }
            ElseIf ($TypeName -eq 'ANOWTaskTemplateItem') {
                [string]$ExportFileName = "Export-AutomateNOW-TaskTemplateItems-" + $current_time + '.csv'
            }
            Else {
                [string]$ExportFileName = "Export-AutomateNOW-ProcessingTemplateItems-" + $current_time + '.csv'
            }
            [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
            $parameters.Add('Path', $ExportFilePath)
        }
        $Error.Clear()
        Try {
            $ProcessingTemplateItem | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWProcessingTemplateItem] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function Get-ANOWTemplateItemContext {
    [CmdletBinding()]
    param([ValidateSet('Set','Add','Remove')][string]$Action,[ANOWProcessingTemplateItem]$Item,
        [ANOWProcessingTemplate]$Parent,[ANOWProcessingTemplate]$Child,[hashtable]$Options=@{})
    if ($null -ne $Item) { $Parent = $Item.workflow }
    if ($null -eq $Parent -or [string]::IsNullOrWhiteSpace($Parent.id)) { throw 'A typed parent with a nonempty identity is required.' }
    $kind = switch ([string]$Parent.processingType) { WORKFLOW {'Workflow'} SERVICE {'ServiceManager'} TRIGGER {'Schedule'} default {throw 'Unsupported item parent type.'} }
    if ($Action -ne 'Add') {
        if ($null -eq $Item -or $Item.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z') { throw 'A hexadecimal D-form item GUID is required.' }
        if ($Item.domain -and $Parent.domain -and $Item.domain -cne $Parent.domain) { throw 'Item and parent domains contradict each other.' }
        if ($null -ne $Item.parentProcessingType -and [string]$Item.parentProcessingType -cne [string]$Parent.processingType) { throw 'Item parent type contradicts its parent.' }
    }
    if ($Action -eq 'Add') {
        if ($null -eq $Child -or [string]::IsNullOrWhiteSpace($Child.id) -or $null -eq $Child.processingType) { throw 'A typed child with a nonempty identity and type is required.' }
        if ($kind -eq 'ServiceManager' -and ($Child.processingType -ne 'SERVICE' -or $Child.serviceType -ne 'MONITOR' -or $Child.monitorType -ne 'PROCESSING_DEADLINE_MONITOR')) { throw 'Service managers require a processing deadline monitor child.' }
        if ($kind -eq 'Workflow' -and $Child.processingType -eq 'TRIGGER') { throw 'Workflow parents cannot contain Schedule templates.' }
    }
    if ($Action -eq 'Set') {
        $expected = $Options.ItemKind
        if ($kind -cne $expected) { throw 'Item input type and parent arrangement do not match.' }
        foreach ($name in @('Title','Tags','ServerNode','Endpoint','ResultMapping','Calendar','DelayedStartTime','TimeZone','Approval','Priority','Weight','TimestampOffset')) {
            $value = $Options[$name]
            $hasValue = if ($name -in @('Priority','Weight')) { $Options.ContainsKey($name) -and $value -ge 0 }
                elseif ($name -eq 'Tags') { @($value).Count -gt 0 -and $null -ne $value }
                elseif ($name -in @('ServerNode','Endpoint','ResultMapping','Calendar','TimeZone','Approval')) { $null -ne $value -and -not [string]::IsNullOrEmpty($value.id) }
                else { -not [string]::IsNullOrEmpty([string]$value) }
            if ($hasValue -and $Options['Unset'+$name]) { throw 'Set and unset options conflict.' }
        }
    }
    [pscustomobject]@{Action=$Action;Kind=$kind;Item=$Item;Parent=$Parent;Child=$Child;
        Domain=if($Parent.domain){$Parent.domain}elseif($null -ne $Item){$Item.domain}else{''}}
}

Function Get-ANOWTemplateItemMembers {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][object]$Context)
    $read = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingTemplateItem) -OperationParameters @{ProcessingTemplate=$Context.Parent;startRow=0;endRow=10000}
    if (-not $read.Succeeded) { throw 'Item membership read was not clean.' }
    $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    $last = -1
    foreach ($member in $read.Data) {
        if ($member -isnot [ANOWProcessingTemplateItem] -or $member.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' -or
            $null -eq $member.workflow -or $member.workflow.id -cne $Context.Parent.id -or
            ($member.domain -and $Context.Domain -and $member.domain -cne $Context.Domain) -or
            ($null -ne $member.parentProcessingType -and [string]$member.parentProcessingType -cne [string]$Context.Parent.processingType) -or
            -not $seen.Add($member.id) -or $member.sortOrder -lt 0) { throw 'Item membership identity was not verified.' }
        if ($member.sortOrder -gt $last) { $last = $member.sortOrder }
    }
    if ($Context.Action -eq 'Remove' -and -not $seen.Contains($Context.Item.id)) { throw 'The requested item was not verified in its parent.' }
    if ($last -eq [int32]::MaxValue) { throw 'Item order cannot be incremented.' }
    [pscustomobject]@{Members=@($read.Data);NextOrder=($last+1)}
}

Function Get-ANOWTemplateItemReference {
    [CmdletBinding()]
    param([ValidateSet('Tag','ServerNode','Endpoint','ResultMapping','Calendar','Approval')][string]$Kind,
        [string]$Id,[object]$Supplied)
    if ([string]::IsNullOrWhiteSpace($Id)) { throw 'A reference identity is required.' }
    $command = switch ($Kind) {
        Tag {Get-Command Get-AutomateNOWTag} ServerNode {Get-Command Get-AutomateNOWServerNode}
        Endpoint {Get-Command Get-AutomateNOWEndpoint} ResultMapping {Get-Command Get-AutomateNOWResultMapping}
        Calendar {Get-Command Get-AutomateNOWCalendar} Approval {Get-Command Get-AutomateNOWApproval}
    }
    $read = Invoke-ANOWPrivateCommand -OperationCommand $command -OperationParameters @{Id=$Id}
    if (-not $read.Succeeded -or $read.Data.Count -ne 1) { throw 'Reference read was not uniquely verified.' }
    $entry = $read.Data[0]
    $typed = switch ($Kind) {
        Tag {$entry -is [ANOWTag]} ServerNode {$entry -is [ANOWServerNode]} Endpoint {$entry -is [ANOWEndpoint]}
        ResultMapping {$entry -is [ANOWResultMapping]} Calendar {$entry -is [ANOWCalendar]} Approval {$entry -is [ANOWApproval]}
    }
    if (-not $typed -or $entry.simpleId -cne $Id -or [string]::IsNullOrWhiteSpace($entry.id) -or
        ($null -ne $Supplied -and ($entry.id -cne $Supplied.id -or ($Supplied.domain -and $entry.domain -cne $Supplied.domain)))) { throw 'Reference type or exact identity does not match.' }
    $entry
}

Function New-ANOWTemplateItemBody {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)][object]$Context,[hashtable]$Options=@{})
    $ErrorActionPreference = 'Stop'
    $metadata = [ordered]@{}
    if ($Context.Action -eq 'Add') {
        $members = Get-ANOWTemplateItemMembers -Context $Context
        $metadata.workflow = $Context.Parent.id
        $metadata.processingType = $Context.Child.processingType
        $metadata.processingTemplate = $Context.Child.id
        $metadata.taskType = if ($null -ne $Context.Child.taskType) { $Context.Child.taskType } else { '' }
        $metadata.sortOrder = $members.NextOrder
        $operation = 'add'
    } else {
        if ($Context.Action -eq 'Remove') { $null = Get-ANOWTemplateItemMembers -Context $Context }
        $metadata.id = $Context.Item.id
        [string]$oldValues = $Context.Item.CreateOldValues()
        if ($Context.Action -eq 'Set') {
            $strings = [ordered]@{Title='title';DelayedStartTime='delayedStartTime';TimestampOffset='timestampOffset';TimeZone='timeZone'}
            foreach ($name in $strings.Keys) {
                $value = if ($name -eq 'TimeZone') { $Options[$name].id } else { $Options[$name] }
                if (-not [string]::IsNullOrEmpty([string]$value)) { $metadata[$strings[$name]] = $value }
                elseif ($Options['Unset'+$name]) { $metadata[$strings[$name]] = $null }
            }
            foreach ($name in @('Priority','Weight')) {
                $wire = $name.ToLowerInvariant()
                if ($Options.ContainsKey($name) -and $Options[$name] -ge 0) { $metadata[$wire] = $Options[$name] }
                elseif ($Options['Unset'+$name]) { $metadata[$wire] = $null }
            }
            $booleans = [ordered]@{Hold='onHold';Skip='passBy';IgnoreProcessingRegistry='ignoreProcessingStateRegistry';VerboseMode='verboseMode';ForceLoad='forceLoad';Optional='optional';SkipProcessingVariables='skipProcessingVariables';DisallowConcurrentExecution='disallowConcurrentExecution'}
            foreach ($name in $booleans.Keys) {
                if ($Options.ContainsKey($name) -and $null -ne $Options[$name]) { $metadata[$booleans[$name]] = ([bool]$Options[$name]).ToString().ToLowerInvariant() }
            }
            if (@($Options.Tags).Count -gt 0 -and $null -ne $Options.Tags) {
                $sequence = 1
                foreach ($id in $Options.Tags) {
                    $null = Get-ANOWTemplateItemReference -Kind Tag -Id $id
                    $metadata['tags'+$sequence] = $id
                    $sequence++
                }
            } elseif ($Options.UnsetTags) { $metadata.tags = $null }
            foreach ($kind in @('ServerNode','Endpoint','ResultMapping','Calendar','Approval')) {
                $value = $Options[$kind]
                $wire = switch ($kind) {ServerNode {'serverNode'} Endpoint {'endpoint'} ResultMapping {'resultMapping'} Calendar {'calendar'} Approval {'approvalConfiguration'}}
                $assign = $null -ne $value -and -not [string]::IsNullOrEmpty($value.id)
                if (($assign -or $Options['Unset'+$kind]) -and $kind -in @('ServerNode','Endpoint') -and
                    ($Context.Item.processingType -ne 'TASK' -or $null -eq $Context.Item.taskType)) { throw 'Only the current task item can have a node or endpoint assignment.' }
                if ($assign) {
                    $verified = Get-ANOWTemplateItemReference -Kind $kind -Id $value.simpleId -Supplied $value
                    if ($kind -eq 'ServerNode') {
                        $types = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Resolve-AutomateNOWTaskType2ServerNodeType) -OperationParameters @{TaskType=$Context.Item.taskType}
                        if (-not $types.Succeeded -or $types.Data.Count -eq 0 -or $value.serverNodeType -ne $verified.serverNodeType -or [string]$verified.serverNodeType -notin $types.Data) { throw 'The current task and verified node types are not compatible.' }
                    }
                    $metadata[$wire] = if ($kind -in @('Calendar','Approval')) { $value.simpleId } else { $value.id }
                    if ($kind -eq 'Endpoint') { $metadata.endpointType = $value.endpointType }
                } elseif ($Options['Unset'+$kind]) {
                    $metadata[$wire] = $null
                    if ($kind -eq 'Endpoint') { $metadata.endpointType = $null }
                }
            }
        }
        $operation = if ($Context.Action -eq 'Remove') { 'remove' } else { 'update' }
        if ($Context.Action -eq 'Remove') { $metadata._oldValues = $oldValues }
    }
    $metadata._operationType = $operation
    $metadata._textMatchStyle = 'exact'
    if ($Context.Action -eq 'Set') {
        $metadata._oldValues = $oldValues
        $metadata._componentId = if ($Context.Kind -eq 'Schedule') { 'ItemEditForm' } else { 'ProcessingTemplateItemVM' }
    }
    $metadata._dataSource = 'ProcessingTemplateItemDataSource'
    $metadata.isc_metaDataPrefix = '_'; $metadata.isc_dataFormat = 'json'
    $body = @(ConvertTo-QueryString -InputObject $metadata)
    if ($body.Count -ne 1 -or $body[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($body[0])) { throw 'Exactly one prepared item body is required.' }
    [pscustomobject]@{Body=$body[0];SortOrder=if($Context.Action -eq 'Add'){$members.NextOrder}else{$null}}
}

Function ConvertFrom-ANOWTemplateItemResponse {
    [CmdletBinding()]
    param([object[]]$Envelopes,[Parameter(Mandatory=$true)][object]$Context,[Nullable[int]]$SortOrder)
    if ($Envelopes.Count -ne 1) { throw 'One acknowledgment envelope is required.' }
    $status = $Envelopes[0].response.status
    if (($status -isnot [int32] -and $status -isnot [int64]) -or
        -not (Test-ANOWB2Response -Envelopes $Envelopes -AcknowledgmentOnly:($Context.Action -eq 'Remove'))) { throw 'An explicit integral-zero acknowledgment is required.' }
    if ($Context.Action -eq 'Remove') { return [pscustomobject]@{Acknowledged=$true} }
    $rows = @($Envelopes[0].response.data)
    $row = $rows[0]
    if ($null -ne $row) {
        foreach ($name in @('id','domain','processingTemplate')) {
            $member = $row.PSObject.Properties[$name]
            if ($null -ne $member -and $null -ne $member.Value -and $member.Value -isnot [string]) { throw 'Returned item identity members must be scalar strings.' }
        }
    }
    if ($null -eq $row -or $row.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z') { throw 'A valid returned item GUID is required.' }
    if ($Context.Action -eq 'Set' -and $row.id -ine $Context.Item.id) { throw 'Returned item identity contradicts the requested item.' }
    if ($Context.Action -eq 'Set' -and $row.processingTemplate -and $Context.Item.processingTemplate -and $row.processingTemplate -cne $Context.Item.processingTemplate) { throw 'Returned child identity contradicts the requested item.' }
    $expected = if ($Context.Action -eq 'Add') { $Context.Child } else { $Context.Item }
    if ($Context.Action -eq 'Add') {
        $childMatches = $row.processingTemplate -ceq $expected.id
        if (-not $childMatches) {
            $childMatches =
                -not [string]::IsNullOrWhiteSpace($expected.simpleId) -and
                -not [string]::IsNullOrWhiteSpace($Context.Domain) -and
                $expected.domain -ceq $Context.Domain -and
                $expected.id -ceq ('[' + $Context.Domain + ']' + $expected.simpleId) -and
                $row.processingTemplate -ceq $expected.simpleId
        }
        if (-not $childMatches -or $null -eq $row.sortOrder -or
            [string]$row.sortOrder -cne [string]$SortOrder) {
            throw 'Created child identity or order was not verified.'
        }
    }
    if ($row.domain -and $Context.Domain -and $row.domain -cne $Context.Domain) { throw 'Returned item domain contradicts its parent.' }
    $parentId = if ($row.workflow -is [string]) { $row.workflow } elseif ($row.workflow -is [ANOWProcessingTemplate]) { $row.workflow.id } elseif ($null -ne $row.workflow) { throw 'Unsupported returned parent shape.' } else { '' }
    if ($parentId -and $parentId -cne $Context.Parent.id) { throw 'Returned parent identity contradicts its context.' }
    if ($null -ne $row.parentProcessingType -and [string]$row.parentProcessingType -cne '' -and [string]$row.parentProcessingType -cne [string]$Context.Parent.processingType) { throw 'Returned parent type contradicts its context.' }
    foreach ($property in @('processingType','taskType','workflowType','serviceType','monitorType')) {
        if ($null -ne $row.$property -and [string]$row.$property -ne '' -and [string]$row.$property -cne [string]$expected.$property) { throw 'Returned item type contradicts the requested child.' }
    }
    $properties = [ordered]@{}
    foreach ($property in $row.PSObject.Properties) { $properties[$property.Name] = $property.Value }
    $properties.workflow = $Context.Parent
    $complete = [pscustomobject]$properties
    switch ($Context.Kind) {
        Workflow {[ANOWWorkflowTemplateItem]$complete}
        ServiceManager {[ANOWServiceManagerTemplateItem]$complete}
        Schedule {[ANOWScheduleTemplateItem]$complete}
    }
}


Function Remove-AutomateNOWProcessingTemplateItem {
    <#
    .SYNOPSIS
    Removes a Processing Template Item from a Processing Template (Workflow Template, Service Manager Template, or Schedule Template) on an instance of AutomateNOW!

    .DESCRIPTION
    Removes a Processing Template Item from a Processing Template (Workflow Template, Service Manager Template, or Schedule Template) on an instance of AutomateNOW!

    .PARAMETER ProcessingTemplateItem
    Mandatory [ANOWProcessingTemplateItem] object representing the Processing Template Item that is being removed. Supports Schedule Template Items, Service Manager Template Items, and Workflow Template Items. Use Read-AutomateNOWProcessingTemplateItem to retrieve these.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    [ANOWProcessingTemplateItem] objects (or its subclasses) from the pipeline

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Removes a single Processing Template Item from a Workflow Template (multi-line format)

    $workflow_template = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1'
    $workflow_template_items = $workflow_template | Read-AutomateNOWProcessingTemplateItem
    $workflow_template_items[0] | Remove-AutomateNOWProcessingTemplateItem

    .EXAMPLE
    Forcibly removes all instances of a Workflow named 'Workflow1' that was added to a Schedule Template named 'ScheduleTemplate1' (multi-line format)

    $schedule_template = Get-AutomateNOWScheduleTemplate -Id 'ScheduleTemplate1'
    $workflow_items = $schedule_template | Read-AutomateNOWProcessingTemplateItem | Where-Object { $_.processingTemplate -eq 'Workflow1'}
    $workflow_items | Remove-AutomateNOWProcessingTemplateItem -Force

    .EXAMPLE
    Removes all Processing Template Items from a Workflow Template (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateItem | Remove-AutomateNOWProcessingTemplateItem

    .EXAMPLE
    Forcefully removes the first page of items (Processing Deadline Monitors) from a Service Level Agreement named 'ServiceLevelAgreement1' (one-liner)

    Get-AutomateNOWServiceManagerTemplate -Id 'ServiceLevelAgreement1' | Read-AutomateNOWProcessingTemplateItem | Remove-AutomateNOWProcessingTemplateItem -Force

    .NOTES
    Requires verified typed context and an explicit integral-zero acknowledgment. Diagnostics stop later inputs without retry. After dispatch, an unverified result is uncertain and the object may already have changed. Set/Add validate strict output even with Quiet; Remove returns no success object. Generic caller-derived oldValues are unchanged.

    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Remember that once a Processing Template is added to a Workflow Template or Schedule Template it becomes a Processing Template Item which have a 36-character GUID for the Id.

    This function has aliases for backward compatibility: Remove-AutomateNOWWorkflowTemplateItem, Remove-AutomateNOWServiceManagerTemplateItem, Remove-AutomateNOWScheduleTemplateItem

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    [Alias('Remove-AutomateNOWWorkflowTemplateItem', 'Remove-AutomateNOWServiceManagerTemplateItem', 'Remove-AutomateNOWScheduleTemplateItem')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessingTemplateItem]$ProcessingTemplateItem,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'Item removal session validation failed or emitted a diagnostic. No request was submitted; later inputs were stopped.'
        }
    }
    Process {
        if ($batchStopped) { return }
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($ProcessingTemplateItem.id)")) -eq $true) {
            $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-ANOWTemplateItemContext) -OperationParameters @{Action='Remove';Item=$ProcessingTemplateItem}
            if (-not $checked.Succeeded -or $checked.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Item removal identity or parent was not verified. No request was submitted; later inputs were stopped.'
                return
            }
            $context = $checked.Data[0]
            $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWTemplateItemBody) -OperationParameters @{Context=$context}
            if (-not $prepared.Succeeded -or $prepared.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Item removal membership or preparation failed or emitted a diagnostic. No request was submitted; later inputs were stopped.'
                return
            }
            $parameters = @{Command='/processingTemplateItem/delete';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$prepared.Data[0].Body}
            if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
            $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            $verified = if ($sent.Succeeded) { Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWTemplateItemResponse) -OperationParameters @{Envelopes=$sent.Data;Context=$context} } else { $null }
            if ($null -eq $verified -or -not $verified.Succeeded -or $verified.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Item removal acknowledgment was not verified. The outcome is uncertain and the item may already have been removed; do not repeat the request. Later inputs were stopped.'
                return
            }
            Write-Verbose "Processing Template Item [$($ProcessingTemplateItem.id)] was removed from '$($context.Parent.id)'"
        }
    }
    End {}
}

Function Add-AutomateNOWProcessingTemplateItem {
    <#
    .SYNOPSIS
    Adds a Processing Template as an item to another Processing Template (Schedule Template, Workflow Template, or Service Manager Template)

    .DESCRIPTION
    Adds a Processing Template as an item to another Processing Template. The parent template can be a Schedule Template, Workflow Template, or Service Manager Template. The child template can be a Task Template, Workflow Template, Service Manager Template, or Integration Template depending on the parent template type.

    For Schedule Templates: Can accept Task Templates, Workflow Templates, Service Manager Templates, or Integration Templates
    For Workflow Templates: Can accept Task Templates, Workflow Templates, Service Manager Templates, or Integration Templates (but NOT Schedule Templates)
    For Service Manager Templates (Service Level Agreements): Can only accept Processing Deadline Monitor templates

    .PARAMETER ProcessingTemplate
    Mandatory [ANOWProcessingTemplate] object representing the parent Processing Template (Schedule Template, Workflow Template, or Service Manager Template) that will receive the new item.

    .PARAMETER ChildTemplate
    Mandatory [ANOWProcessingTemplate] object representing the child Processing Template that is being added to the parent Processing Template as a new item.

    .PARAMETER Force
    Force the addition of the object without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to silence the emitted [ANOWProcessingTemplateItem] object

    .INPUTS
    [ANOWProcessingTemplate] objects are accepted (including from the pipeline) for the ChildTemplate parameter

    .OUTPUTS
    An [ANOWProcessingTemplateItem] subclass object will be emitted based on the parent template type: [ANOWScheduleTemplateItem], [ANOWWorkflowTemplateItem], or [ANOWServiceManagerTemplateItem]. Use the -Quiet parameter to suppress this.

    .EXAMPLE
    Adds a Task Template named 'TaskTemplate1' to a Schedule Template named 'ScheduleTemplate1'

    $task_template1 = Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1'
    $schedule_template1 = Get-AutomateNOWScheduleTemplate -Id 'ScheduleTemplate1'
    Add-AutomateNOWProcessingTemplateItem -ProcessingTemplate $schedule_template1 -ChildTemplate $task_template1

    .EXAMPLE
    Adds a Workflow Template named 'WorkflowTemplate1' to another Workflow Template named 'WorkflowTemplate2' using the Force parameter

    $workflow_template1 = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1'
    $workflow_template2 = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate2'
    Add-AutomateNOWProcessingTemplateItem -ProcessingTemplate $workflow_template2 -ChildTemplate $workflow_template1 -Force

    .EXAMPLE
    Adds a Processing Deadline Monitor to a Service Level Agreement using the pipeline

    $service_level_agreement = Get-AutomateNOWServiceManagerTemplate -Id 'ServiceLevelAgreement1'
    Get-AutomateNOWServiceManagerTemplate -Id 'ProcessingDeadlineMonitor1' | Add-AutomateNOWProcessingTemplateItem -ProcessingTemplate $service_level_agreement -Force

    .EXAMPLE
    Adds multiple Task Templates to a Workflow Template using the pipeline and suppresses output

    $workflow_template1 = Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1'
    Get-AutomateNOWTaskTemplate -Id 'Task1', 'Task2', 'Task3' | Add-AutomateNOWProcessingTemplateItem -ProcessingTemplate $workflow_template1 -Quiet -Force

    .NOTES
    Requires verified typed context and an explicit integral-zero acknowledgment. Diagnostics stop later inputs without retry. After dispatch, an unverified result is uncertain and the object may already have changed. Set/Add validate strict output even with Quiet; Remove returns no success object. Generic caller-derived oldValues are unchanged.

    You must use Connect-AutomateNOW to establish the token by way of global variable.

    For backward compatibility, you can also use the aliases:
    - Add-AutomateNOWScheduleTemplateItem
    - Add-AutomateNOWWorkflowTemplateItem
    - Add-AutomateNOWServiceManagerTemplateItem

    Schedule Templates (TRIGGER processing type) can contain: Task Templates, Workflow Templates, Service Manager Templates, Integration Templates
    Workflow Templates (WORKFLOW processing type) can contain: Task Templates, Workflow Templates, Service Manager Templates, Integration Templates
    Service Manager Templates (SERVICE processing type) (i.e. Service Level Agreements) can only contain: Processing Deadline Monitors (a type of Service Manager Template)

    #>
    [OutputType([ANOWProcessingTemplateItem])]
    [Alias('Add-AutomateNOWScheduleTemplateItem', 'Add-AutomateNOWWorkflowTemplateItem', 'Add-AutomateNOWServiceManagerTemplateItem')]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWProcessingTemplate]$ProcessingTemplate,
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessingTemplate]$ChildTemplate,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'Item creation session validation failed or emitted a diagnostic. No request was submitted; later inputs were stopped.'
        }
    }
    Process {
        if ($batchStopped) { return }
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Add '$($ChildTemplate.id)' to '$($ProcessingTemplate.id)'")) -eq $true) {
            $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-ANOWTemplateItemContext) -OperationParameters @{Action='Add';Parent=$ProcessingTemplate;Child=$ChildTemplate}
            if (-not $checked.Succeeded -or $checked.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Item creation parent or child was not verified. No request was submitted; later inputs were stopped.'
                return
            }
            $context = $checked.Data[0]
            $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWTemplateItemBody) -OperationParameters @{Context=$context}
            if (-not $prepared.Succeeded -or $prepared.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Item creation membership or preparation failed or emitted a diagnostic. No request was submitted; later inputs were stopped.'
                return
            }
            $parameters = @{Command='/processingTemplateItem/create';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$prepared.Data[0].Body}
            if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
            $sent = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            $verified = if ($sent.Succeeded) { Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWTemplateItemResponse) -OperationParameters @{Envelopes=$sent.Data;Context=$context;SortOrder=$prepared.Data[0].SortOrder} } else { $null }
            if ($null -eq $verified -or -not $verified.Succeeded -or $verified.Data.Count -ne 1) {
                $batchStopped = $true
                Write-Warning 'Item creation acknowledgment or output was not verified. The outcome is uncertain and an item may already have been added; do not repeat the request. Later inputs were stopped.'
                return
            }
            Write-Verbose "Processing Template Item [$($verified.Data[0].id)] successfully added to '$($ProcessingTemplate.id)'"
            if (-not $Quiet) { $verified.Data[0] }
        }
    }
    End {}
}

Function Set-AutomateNOWProcessingTemplateItem {
    <#
    .SYNOPSIS
    Changes (overwrites) the settings of a Processing Template Item within a Processing Template (Workflow Template, Service Manager Template, or Schedule Template).

    .DESCRIPTION
    Changes (overwrites) the settings of a Processing Template Item within a Processing Template. This consolidated function handles Workflow Template Items, Service Manager Template Items, and Schedule Template Items.

    .PARAMETER WorkflowTemplateItem
    Mandatory [ANOWWorkflowTemplateItem] object representing the Workflow Template Item that is being updated. This is the default parameter set.

    .PARAMETER ServiceManagerTemplateItem
    Mandatory [ANOWServiceManagerTemplateItem] object representing the Service Manager Template Item that is being updated.

    .PARAMETER ScheduleTemplateItem
    Mandatory [ANOWScheduleTemplateItem] object representing the Schedule Template Item that is being updated.

    .PARAMETER Title
    A string representing the "alias" or "Title" of the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER UnsetTitle
    A switch parameter that will remove the Title from the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER Tags
    Optional string array of CASE-SENSITIVE Tag Id's to assign to this Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER UnsetTags
    A switch parameter that will remove the Tags from the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER ServerNode
    An [ANOWServerNode] object representing the node to connect to the Workflow Template Item (Workflow only)

    .PARAMETER UnsetServerNode
    A switch parameter that will remove the Server Node from the Workflow Template Item (Workflow only)

    .PARAMETER Endpoint
    An [ANOWEndpoint] object representing the Endpoint object to assign to the Workflow Template Item (Workflow only)

    .PARAMETER UnsetEndpoint
    A switch parameter that will remove the Endpoint assignment from the Workflow Template Item (Workflow only)

    .PARAMETER ResultMapping
    An [ANOWResultMapping] object representing the Result Mapping object to set on the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER UnsetResultMapping
    A switch parameter that will remove the Result Mapping assignment from the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER Calendar
    An [ANOWCalendar] object representing the Calendar object to set on the Processing Template Item (All types)

    .PARAMETER UnsetCalendar
    A switch parameter that will remove the Calendar assignment from the Processing Template Item (All types)

    .PARAMETER DelayedStartTime
    Optional string that allows processing items to start on a specific date or time (Workflow and ServiceManager only)

    .PARAMETER UnsetDelayedStartTime
    A switch parameter that will remove the Delayed Start Time from the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER TimeZone
    Optional [ANOWTimeZone] object (Workflow and ServiceManager only)

    .PARAMETER UnsetTimeZone
    A switch parameter that will remove the Time Zone from the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER Approval
    A [ANOWApproval] object representing the Approval object to set on the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER UnsetApproval
    A switch parameter that will remove the Approval assignment from the Processing Template Item (Workflow and ServiceManager only)

    .PARAMETER Priority
    An integer representing the items priority which determines the order when queuing for resources (All types)

    .PARAMETER UnsetPriority
    A switch parameter that will set the Priority back to null (All types)

    .PARAMETER Weight
    An integer representing a logical measure of resources required to process the item (All types)

    .PARAMETER UnsetWeight
    A switch parameter that will set the Weight back to null (All types)

    .PARAMETER Hold
    A boolean to put the Processing Template Item on Hold status (All types)

    .PARAMETER Skip
    A boolean to put the Processing Template Item on Skip status (All types)

    .PARAMETER IgnoreProcessingRegistry
    A boolean setting that toggles 'Ignore Processing Registry' (Workflow and ServiceManager only)

    .PARAMETER VerboseMode
    A boolean setting that toggles "Verbose items produce more events with minor performance impact" (Workflow and ServiceManager only)

    .PARAMETER ForceLoad
    A boolean setting that toggles "Item will be loaded even if Ignore Condition is set" (All types)

    .PARAMETER Optional
    A boolean setting that toggles "Optional item failure will be treated as completion" (Workflow and ServiceManager only)

    .PARAMETER TimestampOffset
    A string that adjusts the Processing Timestamp according to the indicated offset value (All types)

    .PARAMETER UnsetTimestampOffset
    A switch parameter that will remove the Timestamp Offset from the Processing Template Item (All types)

    .PARAMETER SkipProcessingVariables
    A boolean to prevent the inheritance of the trigger's context variables (Schedule only)

    .PARAMETER DisallowConcurrentExecution
    A boolean that will cause the item to be loaded only after all previous executions have completed (Schedule only)

    .PARAMETER Force
    Switch parameter that forces the action without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to silence the emitted Processing Template Item object

    .INPUTS
    [ANOWWorkflowTemplateItem], [ANOWServiceManagerTemplateItem], or [ANOWScheduleTemplateItem] objects are accepted (including from the pipeline).

    .OUTPUTS
    An [ANOWWorkflowTemplateItem], [ANOWServiceManagerTemplateItem], or [ANOWScheduleTemplateItem] object will be emitted depending on the input type. Use the -Quiet parameter to suppress this.

    .EXAMPLE
    Updates a Workflow Template Item with Title, Tags, ServerNode, Priority, and Weight

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateItem -Title 'TaskTemplateScript1' | Set-AutomateNOWProcessingTemplateItem -Title 'TaskTemplateScript2' -Tags 'Tag1', 'Tag2' -ServerNode (Get-AutomateNOWServerNode -Id 'ServerNode1') -Priority 3 -Weight 4 -Force

    .EXAMPLE
    Updates a Schedule Template Item with Calendar, Priority, and SkipProcessingVariables

    Get-AutomateNOWScheduleTemplate -Id 'ScheduleTemplate1' | Read-AutomateNOWProcessingTemplateItem | Set-AutomateNOWProcessingTemplateItem -Calendar (Get-AutomateNOWCalendar -Id 'Calendar1') -Priority 10 -SkipProcessingVariables $true -Force

    .EXAMPLE
    Updates a Service Manager Template Item with ResultMapping and Approval

    Get-AutomateNOWServiceManagerTemplate -Id 'ServiceManagerTemplate1' | Read-AutomateNOWProcessingTemplateItem | Set-AutomateNOWProcessingTemplateItem -ResultMapping (Get-AutomateNOWResultMapping -Id 'ResultMapping1') -Approval (Get-AutomateNOWApproval -Id 'Approval1') -Force

    .NOTES
