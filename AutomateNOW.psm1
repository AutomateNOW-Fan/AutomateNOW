Function Remove-AutomateNOWDocumentation {
    <#
    .SYNOPSIS
    Clears User Documentation from an AutomateNOW! instance

    .DESCRIPTION
    Clears User Documentation from an AutomateNOW! instance

    .PARAMETER DocumentationObject
    Mandatory [ANOWDocumentationItem] object representing the User Documentation object that is being cleared. Use Read-AutomateNOWDocumentation to retrieve them.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present a [ANOWDocumentationItem] object to the -DocumentationObject parameter (or to the pipeline).

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Read-AutomateNOWDocumentation | Remove-AutomateNOWDocumentation -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The AutomateNOW! UI persists the string '<br>' when a user blanks out the documentation and saves it. This function uses that same persisted value so that clearing documentation matches observed backend behavior.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWDocumentationItem]$DocumentationObject,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/documentationItem/update'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If (($_.id.Length -gt 0)) {
            [ANOWDocumentationItem]$DocumentationObject = $_
        }
        [string]$DocumentationId = $DocumentationObject.id
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($DocumentationId)")) -eq $true) {
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            [string]$documentation_value = '<br>'
            $BodyMetaData.Add('id', $DocumentationId)
            $BodyMetaData.Add('documentation', $documentation_value)
            If ($null -ne $DocumentationObject) {
                [string]$old_values = $DocumentationObject.CreateOldValues()
                $BodyMetaData.Add('_oldValues', $old_values)
            }
            $BodyMetaData.Add('_operationType', 'update')
            $BodyMetaData.Add('_textMatchStyle', 'exact')
            $BodyMetaData.Add('_componentId', 'DocumentationItemEditForm')
            $BodyMetaData.Add('_dataSource', 'DocumentationItemDataSource')
            $BodyMetaData.Add('isc_metaDataPrefix', '_')
            $BodyMetaData.Add('isc_dataFormat', 'json')
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$DocumentationId] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Documentation object [$DocumentationId] was updated with the vendor placeholder string"
        }
    }
    End {

    }
}

Function Set-AutomateNOWDocumentation {
    <#
    .SYNOPSIS
    Changes the content of User Documentation on an AutomateNOW! instance

    .DESCRIPTION
    Changes the content of User Documentation on an AutomateNOW! instance

    .PARAMETER DocumentationObject
    An [ANOWDocumentationItem] object representing the User Documentation object to be modified.

    .PARAMETER Documentation
    A string parameter indicating what the Documentation content should be set to.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    An optional switch parameter that silences the output of this function

    .INPUTS
    ONLY [ANOWDocumentationItem] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWDocumentationItem] object will be returned

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Read-AutomateNOWDocumentation | Set-AutomateNOWDocumentation -Documentation '<p>Updated documentation</p>'

    .EXAMPLE
    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Read-AutomateNOWDocumentation | Set-AutomateNOWDocumentation -Documentation '<p>Updated documentation</p>' -Quiet

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The same rich-text markup rules apply here as in Add-AutomateNOWDocumentation. See ABOUT_DOCUMENTATION.md in the module directory for the full reference of confirmed and unconfirmed rich-text HTML capabilities.

    Blank or whitespace-only Documentation values are rejected. Use Remove-AutomateNOWDocumentation when you intend to clear documentation.

    #>
    [OutputType([ANOWDocumentationItem])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWDocumentationItem]$DocumentationObject,
        [Parameter(Mandatory = $true)]
        [string]$Documentation,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [hashtable]$parameters = @{}
        [string]$command = '/documentationItem/update'
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWDocumentationItem]$DocumentationObject = $_
        }
        [string]$DocumentationId = $DocumentationObject.id
        [string]$CurrentDocumentation = $DocumentationObject.documentation
        If ([string]::IsNullOrWhiteSpace($Documentation) -eq $true) {
            Write-Warning -Message "The Documentation parameter may not be empty. Use Remove-AutomateNOWDocumentation to clear existing documentation."
            Break
        }
        If ($Documentation -eq $CurrentDocumentation) {
            Write-Warning -Message "The Documentation content is already set to the requested value. No action is required."
            Break
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$DocumentationId")) -eq $true) {
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'documentation' = $Documentation
            $BodyMetaData.'id' = $DocumentationId
            [string]$old_values = $DocumentationObject.CreateOldValues()
            $BodyMetaData.'_oldValues' = $old_values
            $BodyMetaData.'_operationType' = 'update'
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_componentId' = 'DocumentationItemEditForm'
            $BodyMetaData.'_dataSource' = 'DocumentationItemDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters.Body) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$DocumentationId] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Documentation object [$DocumentationId] was successfully updated"
            $Error.Clear()
            Try {
                [ANOWDocumentationItem]$UpdatedDocumentation = $results.response.data | Select-Object -First 1
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to parse the successful result of Set-AutomateNOWDocumentation to an [ANOWDocumentationItem] object due to [$Message]."
                Break
            }
            If ($Quiet -ne $true) {
                Return $UpdatedDocumentation
            }
        }
    }
    End {
    }
}

