Function Get-ANOWSysoutPlan {
    param([ANOWProcessing]$Task,[int]$RestartNumber,[string]$NodeId,[switch]$All,[switch]$NoDeepSearch)
    $taskId=[string]$Task.id
    if($Task.processingType -ne 'TASK'){Write-Warning 'Sysout retrieval requires a TASK object.';return}
    $found=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWTask) -OperationParameters @{Id=$taskId}
    if(-not $found.Succeeded){Write-Warning "Task lookup for sysout [$taskId] failed or emitted a diagnostic.";return}
    if(@($found.Data).Count -eq 0){Write-Warning "Task [$taskId] was not found.";return}
    if(@($found.Data).Count -ne 1 -or $found.Data[0] -isnot [ANOWProcessing] -or
        [string]$found.Data[0].id -cne $taskId -or $found.Data[0].processingType -ne 'TASK'){
        Write-Warning "Task lookup for sysout [$taskId] did not return one matching typed task.";return
    }
    $times=[int]$Task.timesRestarted
    if($times -lt 0 -or $RestartNumber -lt 0 -or (-not $All -and $RestartNumber -gt $times)){
        Write-Warning "RestartNumber is outside the recorded range for task [$taskId].";return
    }
    $node=if($NodeId.Length -gt 0){$NodeId}else{[string]$Task.node}
    $events=@()
    if($times -gt 0 -and -not $NoDeepSearch -and -not $NodeId -and ($All -or $RestartNumber -lt $times)){
        $processing=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWProcessingList) -OperationParameters @{Id=$taskId}
        if(-not $processing.Succeeded -or @($processing.Data).Count -ne 1 -or
            $processing.Data[0] -isnot [ANOWProcessing] -or [string]$processing.Data[0].id -cne $taskId){
            Write-Warning "Processing lookup for sysout [$taskId] did not return one clean matching item.";return
        }
        $history=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingEventLog) -OperationParameters @{Processing=$processing.Data[0];startRow=0;endRow=10000}
        if(-not $history.Succeeded){Write-Warning "Processing events for sysout [$taskId] failed or emitted a diagnostic.";return}
        if(@($history.Data).Count -ge 10000){Write-Warning "The event page for task [$taskId] reached its 10000-row bound; restart locations are uncertain.";return}
        if(@($history.Data|Where-Object {$_ -isnot [ANOWProcessingEvent]}).Count){
            Write-Warning "Processing events for sysout [$taskId] contain an unsupported event.";return
        }
        $events=@($history.Data|Where-Object {$_.eventType -eq 'PROCESSING_FINISHED'})
        if($events.Count -eq 0){
            Write-Warning "No applicable restart events were found for task [$taskId]. Use explicit NodeId or NoDeepSearch only when its location is known.";return
        }
    }
    $restarts=if($All){@($times..0)}else{@($RestartNumber)}
    $locations=[Collections.Generic.List[object]]::new()
    foreach($restart in $restarts){
        $restartNode=$node;$restartLogName=[string]$Task.logFileName
        if($events.Count -gt 0){
            $matches=@($events|Where-Object {$null -ne $_.timesRestarted -and $_.timesRestarted -eq $restart})
            if($matches.Count -eq 0){Write-Warning "No authoritative node was found for task [$taskId], restart [$restart].";return}
            $first=$true
            foreach($event in $matches){
                if([string]::IsNullOrWhiteSpace($event.serverNode) -or
                    ($null -ne $event.processingId -and [string]$event.processingId -cne $taskId)){
                    Write-Warning "No authoritative node was found for task [$taskId], restart [$restart].";return
                }
                $eventLogName=$null
                if($null -ne $event.eventContext){
                    $property=$event.eventContext.PSObject.Properties['logFileName']
                    if($null -ne $property){$eventLogName=$property.Value}
                }
                if($null -ne $eventLogName -and $eventLogName -isnot [string]){
                    Write-Warning "Log metadata for task [$taskId], restart [$restart] is not a string.";return
                }
                if(-not $first -and (-not [string]::Equals($restartNode,$event.serverNode,[StringComparison]::Ordinal) -or
                    -not [string]::Equals($restartLogName,[string]$eventLogName,[StringComparison]::Ordinal))){
                    Write-Warning "Contradictory processing events for task [$taskId], restart [$restart] name different nodes or log metadata; no location was selected.";return
                }
                $restartNode=[string]$event.serverNode;$restartLogName=[string]$eventLogName;$first=$false
            }
        }
        if([string]::IsNullOrWhiteSpace($restartNode)){Write-Warning "The node id is empty for task [$taskId].";return}
        $locations.Add([pscustomobject]@{Restart=[int]$restart;Node=$restartNode;LogName=$restartLogName})
    }
    [pscustomobject]@{TaskId=$taskId;Locations=$locations.ToArray()}
}

Function Get-ANOWSysoutContent {
    param([string]$TaskId,[object]$Location)
    if([string]::IsNullOrWhiteSpace($Location.LogName)){
        Write-Warning "Task Id [$TaskId] logFileName is empty; attempting sysout retrieval by task id, server node, and restart number."
    }
    $body=[ordered]@{id=$TaskId;serverNode=$Location.Node;restartNumber=$Location.Restart;_operationType='custom';_operationId='getLog';_textMatchStyle='exact';_dataSource='ServerNodeDataSource';isc_metaDataPrefix='_';isc_dataFormat='json'}
    $query=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$body}
    if(-not $query.Succeeded -or @($query.Data).Count -ne 1 -or $query.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($query.Data[0])){
        Write-Warning "Sysout request preparation for task [$TaskId] failed or emitted a diagnostic.";return
    }
    $parameters=@{Command='/serverNode/getLogSync';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$query.Data[0]}
    if($anow_session.NotSecure){$parameters.NotSecure=$true}
    $request=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
    if(-not $request.Succeeded){Write-Warning "Sysout retrieval for task [$TaskId], restart [$($Location.Restart)] failed or emitted a diagnostic.";return}
    if(@($request.Data).Count -ne 1 -or $null -eq $request.Data[0].response -or
        $request.Data[0].response -is [array] -or -not (Test-ANOWSuccessStatus $request.Data[0].response)){
        Write-Warning 'Sysout retrieval did not return a numeric zero success status.';return
    }
    $response=$request.Data[0].response.data
    if($null -eq $response -or ($response -is [string] -and $response.Length -eq 0)){
        Write-Warning 'There was no response message after retrieving the log.';return
    }
    if($response -isnot [string]){Write-Warning 'Sysout retrieval did not return one log string.';return}
    if($response -eq 'Empty log returned'){Write-Warning "There was no log available for task [$TaskId], restart [$($Location.Restart)].";return}
    if($response -match '^File not found:'){
        Write-Warning "The log file was not found for task [$TaskId], restart [$($Location.Restart)], on node [$($Location.Node)].";return
    }
    return $response
}

Function Save-ANOWSysoutContent {
    [CmdletBinding()]
    param([string]$Text,[string]$Filename,[string]$Filepath,[string]$Encoding='UTF8')
    try {
        $outputName=$Filename
        if(-not $outputName){
            $firstLine=($Text -split "`n",2)[0].Trim()
            $candidates=@($firstLine -split '[/\\\]]'|Where-Object {$_ -cmatch '^[0-9]{15}\.[0-9]{3}\.out$'})
            if($candidates.Count -ne 1){Write-Warning 'A safe sysout basename could not be extracted from the first content line. Supply Filename explicitly.';return}
            $outputName=$candidates[0]
        }
        $destination=if($Filepath){$Filepath}else{(Get-Location -ErrorAction Stop).Path}
        $outputPath=Join-Path -Path $destination -ChildPath $outputName -ErrorAction Stop
        $providerInfo=$null;$driveInfo=$null
        $outputPath=$PSCmdlet.SessionState.Path.GetUnresolvedProviderPathFromPSPath($outputPath,[ref]$providerInfo,[ref]$driveInfo)
        if($providerInfo.Name -cne 'FileSystem'){throw 'The sysout destination must use the FileSystem provider.'}
        $writeErrors=@();$writeWarnings=@()
        $writeOutput=@(Out-File -LiteralPath $outputPath -InputObject $Text -Encoding $Encoding -NoNewline -Force -ErrorAction Stop -ErrorVariable writeErrors -WarningVariable writeWarnings)
        if($writeErrors.Count -gt 0 -or $writeWarnings.Count -gt 0){return}
        if($writeOutput.Count -gt 0){Write-Warning 'The local sysout write returned unexpected output; saving is uncertain.';return}
        $metadataErrors=@();$metadataWarnings=@()
        $metadata=@(Get-Item -LiteralPath $outputPath -ErrorAction Stop -ErrorVariable metadataErrors -WarningVariable metadataWarnings)
        if($metadataErrors.Count -gt 0 -or $metadataWarnings.Count -gt 0){return}
        if($metadata.Count -ne 1 -or $metadata[0] -isnot [IO.FileInfo] -or -not $metadata[0].Exists -or
            -not [string]::Equals($metadata[0].FullName,$outputPath,[StringComparison]::OrdinalIgnoreCase)){
            Write-Warning 'The saved sysout file could not be verified from one matching file metadata result.';return
        }
        $null=$metadata[0].Length
        return $metadata[0]
    } catch {
        Write-Error -ErrorRecord $_
    }
}

Function Get-AutomateNOWAgentSysOutLog {
    <#
    .SYNOPSIS
    Gets an Agent sysout log from an Agent on an AutomateNOW! instance

    .DESCRIPTION
    Processing events locate earlier restarts on round-robin nodes; contradictory node/log metadata is refused, not guessed. Infrastructure diagnostics prevent text or files, while blank filename metadata remains advisory. Get/GetAll continue with independent pipeline tasks; SaveAll stops remaining saves after uncertainty and retains earlier successful files.

    Gets an Agent sysout log from an Agent on an AutomateNOW! instance

    .PARAMETER Task
    An [ANOWProcessing] object representing the executed Task to retrieve the sysout log from. Use Get-AutomateNOWTask to retrieve these.

    .PARAMETER RestartNumber
    Optional int32 to specify which execution of the Task to retrieve the log from. The default is 0 (first-run). Specify this parameter only if you need a subsequent execution of the Task.

    .PARAMETER NodeId
    Optional string to specify the NodeId of the Agent where the sysout log resides. If not specified, the function will attempt to determine the correct NodeId from the Task object. You would only need this if you were trying to retrieve a sysout log from a Task that was executed on a different Node than the original execution (because the Task was restarted and is part of a round-robin load balancer).

    .PARAMETER GetAllRestartedLogs
    An optional switch parameter that will retrieve all sysout logs from all restarts of the Task. When this parameter is used, RestartNumber is ignored. Use with caution!

    .PARAMETER SaveAllRestartedLogs
    An optional switch parameter that will save (to disk) all sysout logs from all restarts of the Task. When this parameter is used, RestartNumber is ignored. Use with caution!

    .PARAMETER AsString
    An optional switch parameter that will provide the log as-is, one giant string.

    .PARAMETER NoDeepSearch
    An optional switch parameter that will prevent polling the processing event log in the event that the Task has been restarted at least once.

    .INPUTS
    ONLY [ANOWProcessing] objects (and only Tasks) are accepted (including from the pipeline)

    .OUTPUTS
    A string array containing the log output.

    .EXAMPLE
    Gets the log from a Task with an Id of 123456

    123456 | Get-AutomateNOWTask | Get-AutomateNOWAgentSysOutLog

    .EXAMPLE
    Gets all of the restarted logs as one giant array from a Task with an Id of 123456. Note that this will return multiple log files in one stream. This is intended for when you don't want to save the log content to disk but you need to parse all of the log content for a Task that was restarted.

    123456 | Get-AutomateNOWAgentSysOutLog -GetAllRestartedLogs

    .EXAMPLE
    Saves all of the restarted logs individually to disk from a Task with an Id of 123456.

    123456 | Get-AutomateNOWAgentSysOutLog -SaveAllRestartedLogs

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Technically as this function uses an endpoint from the serverNode branch, it should be classified as a ServerNode function instead of Agent. Practically, though, sysout logs are associated with the Agent they reside on.

    This function does not accept Workflows, Service Managers or Schedules. Only Tasks are accepted.

    #>
    [OutputType([string[]])]
    [CmdletBinding(DefaultParameterSetName = 'Default')]
    Param(
        [ValidateScript({ ($_.processingType -in @('TASK', 'TRIGGER')) })]
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessing]$Task,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [int32]$RestartNumber = 0,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [string]$NodeId,
        [Parameter(Mandatory = $true, ParameterSetName = 'GetAllRestartedLogs')]
        [switch]$GetAllRestartedLogs,
        [Parameter(Mandatory = $true, ParameterSetName = 'SaveAllRestartedLogs')]
        [switch]$SaveAllRestartedLogs,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [switch]$AsString,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [switch]$NoDeepSearch
    )

    Begin {
        $sessionReady=Confirm-ANOWPreservationSession
        $saveStopped=$false
        if(-not $sessionReady){Write-Warning 'There is not a valid token confirmed, or session validation emitted a diagnostic.'}
    }
    Process {
        if(-not $sessionReady -or $saveStopped){return}
        $plan=Get-ANOWSysoutPlan -Task $Task -RestartNumber $RestartNumber -NodeId $NodeId -All:($GetAllRestartedLogs -or $SaveAllRestartedLogs) -NoDeepSearch:$NoDeepSearch
        if($null -eq $plan){if($SaveAllRestartedLogs){$saveStopped=$true};return}
        if($Task.timesRestarted -eq 0 -and $GetAllRestartedLogs){
            Write-Warning "The Task [$($Task.id)] has not been restarted. There is only one log to retrieve. Ignoring the -GetAllRestartedLogs switch parameter."
        }
        foreach($location in $plan.Locations){
            $response=Get-ANOWSysoutContent -TaskId $plan.TaskId -Location $location
            if($null -eq $response){if($SaveAllRestartedLogs){$saveStopped=$true};return}
            if($SaveAllRestartedLogs){
                $saved=Save-ANOWSysoutContent -Text $response
                if($null -eq $saved){$saveStopped=$true;return}
                Write-Information "$($saved.Name) was saved to disk ($($saved.Length) bytes)"
            } elseif($AsString){$response}else{$response -split "`n"}
        }
    }
}

Function Save-AutomateNOWAgentSysOutLog {
    <#
    .SYNOPSIS
    Downloads to disk an Agent sysout log from an Agent on an AutomateNOW! instance

    .DESCRIPTION
    Endpoint-based retrieval does not require direct Agent disk access. Infrastructure diagnostics prevent saving. A saved-file report requires clean writing and matching file metadata, including NoStats; original local I/O diagnostics are retained. The remaining pipeline stops after failure without retry, cleanup or rollback.

    Downloads sysout text with its original line endings. Blank filename metadata is advisory; WarningAction Stop prevents retrieval. Filename must be a basename; otherwise a safe timestamp basename is derived from the first content line.

    .PARAMETER Task
    An [ANOWProcessing] object representing the executed Task to retrieve the sysout log from. Use Get-AutomateNOWTask to retrieve these.

    .PARAMETER RestartNumber
    Optional int32 to specify which execution of the Task to retrieve the log from. The default is 0 (first-run). Specify this parameter only if you need a subsequent execution of the Task.

    .PARAMETER NodeId
    Optional string to override the NodeId of the Agent where the sysout log resides.

    .PARAMETER Filename
    Optional string to specify the name of the sysout file.

    .PARAMETER Filepath
    Optional string to specify the path of the sysout file.

    .PARAMETER AsString
    An optional switch parameter that will provide the log as-is, one giant string.

    .PARAMETER NoStats
    Suppresses the saved-file information message. It does not suppress retrieval warnings.

    .PARAMETER Encoding
    An optional string parameter to override the default Encoding used by Out-File in this function (UTF8). Note that the acceptable values for this parameter differs between PowerShell Core and Windows PowerShell.

    .INPUTS
    ONLY [ANOWProcessing] objects (and only Tasks) are accepted (including from the pipeline)

    .OUTPUTS
    The output will be written to disk

    .EXAMPLE
    Gets the log from a Task with an Id of 123456

    123456 | Get-AutomateNOWTask | Save-AutomateNOWAgentSysOutLog

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Technically as this function uses an endpoint from the serverNode branch, it should be classified as a ServerNode function instead of Agent. Practically, though, sysout logs are associated with the Agent they reside on.

    This function does not accept Workflows, Service Managers or Schedules. Only Tasks are accepted.

    #>
    [OutputType([string[]])]
    [CmdletBinding()]
    Param(
        [ValidateScript({ ($_.processingType -eq 'TASK') })]
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessing]$Task,
        [Parameter(Mandatory = $false)]
        [int32]$RestartNumber = 0,
        [Parameter(Mandatory = $false, ParameterSetName = 'Default')]
        [string]$NodeId,
        [Parameter(Mandatory = $false)]
        [string]$Filename,
        [ValidateScript({ (Test-Path -Path "$_") -eq $true })]
        [Parameter(Mandatory = $false)]
        [string]$Filepath,
        [Parameter(Mandatory = $false)]
        [switch]$AsString,
        [Parameter(Mandatory = $false)]
        [switch]$NoStats,
        [Parameter(Mandatory = $false)]
        [string]$Encoding = 'UTF8'
    )

    Begin {
        $sessionReady=Confirm-ANOWPreservationSession
        $saveStopped=$false
        if(-not $sessionReady){Write-Warning 'There is not a valid token confirmed, or session validation emitted a diagnostic.'}
    }
    Process {
        if(-not $sessionReady -or $saveStopped){return}
        if($Filename -and ($Filename -in @('.', '..') -or $Filename.IndexOfAny([IO.Path]::GetInvalidFileNameChars()) -ge 0 -or $Filename -match '[/\\]')){
            $saveStopped=$true;Write-Warning 'Filename must be a safe basename without a directory or traversal.';return
        }
        $plan=Get-ANOWSysoutPlan -Task $Task -RestartNumber $RestartNumber -NodeId $NodeId
        if($null -eq $plan){$saveStopped=$true;return}
        $response=Get-ANOWSysoutContent -TaskId $plan.TaskId -Location $plan.Locations[0]
        if($null -eq $response){$saveStopped=$true;return}
        $saved=Save-ANOWSysoutContent -Text $response -Filename $Filename -Filepath $Filepath -Encoding $Encoding
        if($null -eq $saved){$saveStopped=$true;return}
        if(-not $NoStats){Write-Information "$($saved.Name) was saved to disk ($($saved.Length) bytes)"}
    }
}

