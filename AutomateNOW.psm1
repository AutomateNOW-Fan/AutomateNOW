Function Resolve-AutomateNOWObject2TableName {
    <#
    .SYNOPSIS
    Resolves a given ANOW object to its table name in the database.

    .DESCRIPTION
    Resolves a given ANOW object to its table name in the database.

    .PARAMETER Object
    An AutomateNOW object

    .EXAMPLE
    Returns the name of the table for a Task Template named 'TaskTemplate1'

    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Resolve-AutomateNOWObject2TableName

    .OUTPUTS
    A string containing the name of the table

    #>
    [OutputType([string])]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true) ]
        [Base]$Object
    )
    Begin {

    }
    Process {
        If ($null -ne $_) {
            [Base]$Object = $_
        }
        [string]$object_type_name = $Object.GetType().FullName
        If ($object_type_name.Length -eq 0) {
            Write-Warning -Message "The name of the object type could not be derived."
            Break
        }
        [string]$table_name = Switch ($object_type_name) {
            'ANOWAdhocReport' { 'adhoc_report'; Break; }
            'ANOWAgent' { 'agent'; Break; }
            'ANOWAnomaly' { 'anomaly'; Break; }
            'ANOWApplicationConfiguration' { 'application_configuration'; Break; }
            'ANOWApproval' { 'approval_configuration'; Break; }
            'ANOWBusinessView' { 'business_view'; Break; }
            'ANOWCalendar' { 'resource'; Break; }
            'ANOWCodeRepository' { 'code_repository'; Break; }
            'ANOWDashboard' { 'dashboard'; Break; }
            'ANOWDataSource' { 'data_source'; Break; }
            'ANOWDesignTemplate' { 'design_template'; Break; }
            'ANOWDomain' { 'domain'; Break; }
            'ANOWEndpoint' { 'endpoint'; Break; }
            'ANOWEvent' { 'resource'; Break; }
            'ANOWFolder' { 'folder'; Break; }
            'ANOWIntegration' { 'integration'; Break; }
            'ANOWIntegrationTemplate' { 'processing_template'; Break; }
            'ANOWLock' { 'resource'; Break; }
            'ANOWMenuCustomization' { 'UNKNOWN'; Break; }
            'ANOWMetric' { 'resource'; Break; }
            'ANOWNotificationChannel' { 'notification_channel'; Break; }
            'ANOWNotificationGroup' { 'notification_group'; Break; }
            'ANOWNotificationMessageTemplate' { 'notification_message_template'; Break; }
            'ANOWPhysicalResource' { 'resource'; Break; }
            'ANOWProcessingAction' { 'processing_action'; Break; }
            'ANOWProcessingFunction' { 'processing_function'; Break; }
            'ANOWProcessingTemplate' { 'processing_template'; Break; }
            'ANOWProcessingTemplateItem' { 'processing_template_item'; Break; }
            'ANOWResource' { 'resource'; Break; }
            'ANOWResultMapping' { 'result_mapping'; Break; }
            'ANOWScheduleTemplate' { 'processing_template'; Break; }
            'ANOWSecRole' { 'sec_role'; Break; }
            'ANOWSecUser' { 'sec_user'; Break; }
            'ANOWSemaphore' { 'resource'; Break; }
            'ANOWServerNode' { 'server_node'; Break; }
            'ANOWServerNodeGroup' { 'server_node_group'; Break; }
            'ANOWServiceManagerTemplate' { 'processing_template'; Break; }
            'ANOWStock' { 'resource'; Break; }
            'ANOWTag' { 'tag'; Break; }
            'ANOWTaskTemplate' { 'processing_template'; Break; }
            'ANOWTimeWindow' { 'resource'; Break; }
            'ANOWUserReport' { 'user_report'; Break; }
            'ANOWVariable' { 'resource'; Break; }
            'ANOWViewSetup' { 'view_setup'; Break; }
            'ANOWWorkflowTemplate' { 'processing_template'; Break; }
            'ANOWWorkspace' { 'workspace'; Break; }
            'Default' { 'table_not_found'; }
        }
        If ($table_name -eq 'table_not_found') {
            Write-Warning -Message "Could not find the table for $object_type_name."
        }
        Else {
            Return $table_name
        }
    }
    End {

    }
}

