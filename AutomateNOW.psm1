#region - Processing Template Resource Dependency

Function Read-AutomateNOWProcessingTemplateResourceDependency {
    <#
    .SYNOPSIS
    Reads the Processing Template Resource Dependency objects that are associated with a Processing Template on an AutomateNOW! instance

    .DESCRIPTION
    Reads the Processing Template Resource Dependency objects that are associated with a Processing Template on an AutomateNOW! instance

    Template and template-item collection queries select synchronized Stock and Lock resources. Workspace and exact-ID queries use the shared dependency data source without a resource-type filter; their results do not establish support for configuring other dependency kinds.

    .PARAMETER ProcessingTemplate
    An [ANOWProcessingTemplate] object representing the Processing Template to read the resource dependencies from. Note that Schedule Templates are not supported.

    .PARAMETER ProcessingTemplateItem
    An [ANOWProcessingTemplateItem] object representing the Processing Template Item to read the resource dependencies from. Note that only Service Manager Templates and Workflow Templates can have resource dependencies on their Processing Template Items. Also note that when this parameter is used the Processing Template does not need to be supplied with the -ProcessingTemplate parameter as it will be extracted from the Processing Template Item.

    .PARAMETER Workspace
    An [ANOWWorkspace] object representing the Workspace to read the Processing Template Resource Dependencies from.

    .PARAMETER Id
    A string containing the 36-character guid Id of the Processing Template Resource Dependency object to fetch.

    .PARAMETER NotInherited
    An option switch parameter that will attempt to filter out Processing Template Resource Dependencies that were inherited by the Processing Template Item and not added at the Processing Template level. The UI normally shows this so it is clear. If we want to distinguish between inherited vs. non-inherited then we need to use this switch. If you want to see Inherited Only then send the root Processing Template and not its item to this function.

    .PARAMETER startRow
    Optional integer to indicate the row to start from. This is intended for when you need to paginate the results. Default is 0.

    .PARAMETER endRow
    Optional integer to indicate the row to stop on. This is intended for when you need to paginate the results. Default is 100.

    .PARAMETER sortBy
    Optional string to indicate the field to sort the results by. Default is 'sortKey'.

    .INPUTS
    Accepts [ANOWProcessingTemplate], [ANOWWorkspace] or [ANOWProcessingTemplateItem] objects, or dependency GUID strings.

    .OUTPUTS
    [ANOWProcessingTemplateDependency] objects will be returned

    .EXAMPLE
    Gets the first page of Processing Template Resource Dependencies associated with a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateResourceDependency

    .EXAMPLE
    Gets the first page of Processing Template Resource Dependencies associated with a Workspace named 'Workspace1' (one-liner)

    Get-AutomateNOWWorkspace -Id 'Workspace1' | Read-AutomateNOWProcessingTemplateResourceDependency

    .EXAMPLE
    Gets the first page of non-inherited Processing Template Resource Dependencies associated with Processing Template Items within a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem | Read-AutomateNOWProcessingTemplateResourceDependency -NotInherited

    .EXAMPLE
    Gets the first page of Processing Template Resource Dependencies associated with Processing Template Items within a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem | Read-AutomateNOWProcessingTemplateResourceDependency

    .EXAMPLE
    Gets a specific Processing Template Resource Dependency by its 36-character guid Id (one-liner)

    Read-AutomateNOWProcessingTemplateResourceDependency -Id '27640d7e-9bb9-458b-995c-463ec44190d5'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Synchronized resources in the Resources tab allocate Stock permits or acquire a Lock in SHARED or EXCLUSIVE mode. These allocations are distinct from ordinary dependency conditions that check a resource state or value, including Stock or Lock conditions. The product's broader use of the word "resource" does not make every resource condition a synchronized allocation.

    AutomateNOW product documentation describes Dynamic Resource dependencies whose resource names are evaluated at runtime in the Dependencies tab. The module's resource-dependency helpers do not implement dynamic-name configuration.

    This function returns [ANOWProcessingTemplateDependency] objects from the shared dependency data source. The template/item Stock and Lock filter follows the synchronized Resources view; it is not a claim that the product supports only those dependency kinds.

    #>
    [OutputType([ANOWProcessingTemplateDependency[]])]
    [Alias('Read-AutomateNOWWorkflowTemplateResourceDependency', 'Read-AutomateNOWServiceManagerTemplateResourceDependency')]
    [CmdletBinding(DefaultParameterSetName = 'ProcessingTemplate')]
    Param(
        [ValidateScript({ $_.processingType -ne 'TRIGGER' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplate', ValueFromPipeline = $true)]
        [ANOWProcessingTemplate]$ProcessingTemplate,
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplateItem', ValueFromPipeline = $true)]
        [ANOWProcessingTemplateItem]$ProcessingTemplateItem,
        [Parameter(Mandatory = $true, ParameterSetName = 'Workspace', ValueFromPipeline = $true)]
        [ANOWWorkspace]$Workspace,
        [ValidateScript({ $_ -match '^[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}$' })]
        [Parameter(Mandatory = $true, ParameterSetName = 'Id', ValueFromPipeline = $true)]
        [string]$Id,
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplateItem')]
        [switch]$NotInherited,
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplate')]
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplateItem')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Workspace')]
        [int32]$startRow = 0,
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplate')]
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplateItem')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Workspace')]
        [int32]$endRow = 100,
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplate')]
        [Parameter(Mandatory = $False, ParameterSetName = 'ProcessingTemplateItem')]
        [Parameter(Mandatory = $False, ParameterSetName = 'Workspace')]
        [string]$SortBy = 'sortKey'
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($endRow -le $startRow) {
            Write-Warning -Message "The endRow must be greater than the startRow. Please try again."
            Break
        }
        [hashtable]$parameters = @{}
        $parameters.Add('Method', 'GET')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_ -is [ANOWProcessingTemplate]) {
            Try {
                [ANOWProcessingTemplate]$ProcessingTemplate = $_
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to convert the pipeline item to a [ANOWProcessingTemplate] object due to [$Message]."
                Break
            }
        }
        ElseIf ($_ -is [ANOWProcessingTemplateItem]) {
            Try {
                [ANOWProcessingTemplateItem]$ProcessingTemplateItem = $_
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to convert the pipeline item to a [ANOWProcessingTemplateItem] object due to [$Message]."
                Break
            }
        }
        ElseIf ($_ -is [ANOWWorkspace]) {
            Try {
                [ANOWWorkspace]$Workspace = $_
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to convert the pipeline item to a [ANOWWorkspace] object due to [$Message]."
                Break
            }
        }
        ElseIf ($_.length -eq 36) {
            [string]$Id = $_
        }
        [string]$item_name = ''
        [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
        If ($Id.Length -eq 36) {
            $BodyMetaData.Add('id', $Id )
            $BodyMetaData.Add('_operationId', 'read' )
            [string]$textMatchStyle = 'exactCase'
        }
        Else {
            [string]$ProcessingTemplateItem_Name = ''
            If ($ProcessingTemplate.id.Length -eq 0 -and $Workspace.id.Length -eq 0 -and $ProcessingTemplateItem.id.Length -eq 0) {
                Write-Warning -Message "The object that was supplied (Processing Template, Workspace or Processing Template Item) has an empty id."
                Break
            }
            If ($ProcessingTemplateItem.id.Length -gt 0) {
                [string]$ProcessingTemplateItem_Name = $ProcessingTemplateItem.name
                If ($ProcessingTemplateItem_Name.Length -eq 0) {
                    Write-Warning -Message "Unexpectedly, the 'name' of the Processing Template Item was empty."
                    Break
                }
                $Error.Clear()
                Try {
                    [ANOWProcessingTemplate]$ProcessingTemplate = $ProcessingTemplateItem.workflow
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to extract the Processing Template from Processing Template Item on [$ProcessingTemplateItem_Name] due to [$Message]."
                    Break
                }
            }
            $BodyMetaData.Add('_constructor', 'AdvancedCriteria')
            $BodyMetaData.Add('_startRow', $startRow)
            $BodyMetaData.Add('_endRow', $endRow)
            $BodyMetaData.Add('_sortBy', $SortBy)
            $BodyMetaData.Add('operator', 'and')
            [string]$textMatchStyle = 'exact'
            If ($null -ne $ProcessingTemplate) {
                [string]$ProcessingTemplate_id = $ProcessingTemplate.id
                [string]$ProcessingTemplate_simpleId = $ProcessingTemplate.simpleId
                $BodyMetaData.Add('criteria1', ('{"fieldName":"workflow","operator":"equals","value":"' + $ProcessingTemplate_id + '"}'))
                If ($ProcessingTemplateItem_Name.Length -gt 0) {
                    $BodyMetaData.Add('criteria2', ('{"fieldName":"workflowItem","operator":"equals","value":"' + $ProcessingTemplateItem_Name + '"}'))
                    [string]$item_name = $ProcessingTemplateItem_Name
                }
                Else {
                    $BodyMetaData.Add('criteria2', ('{"fieldName":"workflowItem","operator":"isNull"}'))
                    [string]$item_name = $ProcessingTemplate_id
                }
                $BodyMetaData.Add('criteria3', ('{"fieldName":"resourceType","operator":"inSet","value":["STOCK","LOCK"]}'))
                $BodyMetaData.Add('_componentId', 'ProcessingTemplateResourceList')
            }
            ElseIf ($null -ne $Workspace) {
                [string]$Workspace_id = $Workspace.id
                $BodyMetaData.Add('criteria1', ('{"fieldName":"workspace","operator":"equals","value":"' + $Workspace_id + '"}'))
                $BodyMetaData.Add('_componentId', 'WorkspaceDependencyList')
                [string]$item_name = $Workspace_id
            }
            Else {
                Write-Warning -Message "Somehow we were not able to determine the type of processing object being read"
                Break
            }
        }
        $BodyMetaData.Add('_operationType', 'fetch')
        $BodyMetaData.Add('_textMatchStyle', $textMatchStyle)
        $BodyMetaData.Add('_dataSource', 'ProcessingTemplateDependencyDataSource')
        $BodyMetaData.Add('isc_metaDataPrefix', '_')
        $BodyMetaData.Add('isc_dataFormat', 'json')
        [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
        [string]$command = ('/processingTemplateDependency/read' + '?' + $Body)
        If ($null -eq $parameters["Command"]) {
            $parameters.Add('Command', $command)
        }
        Else {
            $parameters.'Command' = $command
        }
        $Error.Clear()
        Try {
            [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$item_name] due to [$Message]."
            Break
        }
        [int32]$response_code = $results.response.status
        If ($response_code -ne 0) {
            [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
            Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
            Break
        }
        If ($results.response.data.count -gt 0) {
            if ($PSCmdlet.ParameterSetName -eq 'Id') {
                $contextRows = @($results.response.data)
                if ($contextRows.Count -ne 1 -or
                    -not [string]::Equals([string]$contextRows[0].id, $Id, [StringComparison]::OrdinalIgnoreCase)) {
                    Write-Warning 'Resource dependency exact-ID context requires one matching dependency. No parent is inferred; subsequent inputs are stopped.'
                    break
                }
                $workflowReference = $contextRows[0].workflow
                $workspaceReference = $contextRows[0].workspace
                if (($null -ne $workflowReference -and $workflowReference -isnot [string]) -or
                    ($null -ne $workspaceReference -and $workspaceReference -isnot [string])) {
                    Write-Warning 'Resource dependency exact-ID parent reference has an unsupported shape. No parent is inferred; subsequent inputs are stopped.'
                    break
                }
                $hasWorkflow = -not [string]::IsNullOrWhiteSpace([string]$workflowReference)
                $hasWorkspace = -not [string]::IsNullOrWhiteSpace([string]$workspaceReference)
                if ($hasWorkflow -eq $hasWorkspace) {
                    Write-Warning 'Resource dependency exact-ID context requires exactly one workflow or workspace reference. No parent is inferred; subsequent inputs are stopped.'
                    break
                }
                [string]$parentReference = if ($hasWorkflow) { $workflowReference } else { $workspaceReference }
                [string]$parentSimpleId = $parentReference
                $qualifiedReference = $parentReference.StartsWith('[', [StringComparison]::Ordinal)
                if ($qualifiedReference) {
                    $domainEnd = $parentReference.IndexOf(']')
                    if ($domainEnd -le 1 -or $domainEnd -ge ($parentReference.Length - 1)) {
                        Write-Warning 'Resource dependency exact-ID qualified parent reference is invalid. No parent is inferred; subsequent inputs are stopped.'
                        break
                    }
                    $parentSimpleId = $parentReference.Substring($domainEnd + 1)
                }
                try {
                    $parentCommand = if ($hasWorkflow) { Get-Command Get-AutomateNOWProcessingTemplate } else { Get-Command Get-AutomateNOWWorkspace }
                    $parentRead = Invoke-ANOWPrivateCommand -OperationCommand $parentCommand -OperationParameters @{Id=$parentSimpleId}
                    $parent = if ($parentRead.Succeeded -and $parentRead.Data.Count -eq 1) { $parentRead.Data[0] } else { $null }
                    $compatibleParent = if ($hasWorkflow) { $parent -is [ANOWProcessingTemplate] } else { $parent -is [ANOWWorkspace] }
                    $exactParent = $compatibleParent -and
                        -not [string]::IsNullOrEmpty([string]$parent.id) -and
                        [string]::Equals([string]$parent.simpleId, $parentSimpleId, [StringComparison]::Ordinal)
                    if ($exactParent) {
                        [string]$expectedParentId = $parentReference
                        if (-not $qualifiedReference) {
                            [string]$contextDomain = $anow_session.current_domain
                            if ([string]::IsNullOrWhiteSpace($contextDomain)) {
                                $exactParent = $false
                            }
                            else {
                                $expectedParentId = '[' + $contextDomain + ']' + $parentSimpleId
                            }
                        }
                        $exactParent = $exactParent -and [string]::Equals([string]$parent.id, $expectedParentId, [StringComparison]::Ordinal)
                    }
                    if (-not $exactParent) {
                        Write-Warning 'Resource dependency exact-ID parent resolution failed, emitted a diagnostic or returned an unsupported identity. No parent is inferred; subsequent inputs are stopped.'
                        break
                    }
                    if ($hasWorkflow) { $ProcessingTemplate = $parent } else { $Workspace = $parent }
                }
                catch {
                    Write-Warning 'Resource dependency exact-ID parent resolution failed. No parent is inferred; subsequent inputs are stopped.'
                    break
                }
            }

            If ($NotInherited -eq $true) {
                [string]$ItemTemplate_simpleId = $ProcessingTemplateItem.processingTemplate
                $Error.Clear()
                Try {
                    [ANOWProcessingTemplate]$ItemTemplate = Get-AutomateNOWProcessingTemplate -Id $ItemTemplate_simpleId
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Get-AutomateNOWProcessingTemplate failed to retrieve [$ItemTemplate_simpleId] (trying to filter out inherited resource dependencies) due to [$Message]."
                    Break
                }
                $Error.Clear()
                Try {
                    [ANOWProcessingTemplateDependency[]]$ItemTemplateDependencies = Read-AutomateNOWProcessingTemplateResourceDependency -ProcessingTemplate $ItemTemplate -startRow 0 -endRow 10000
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Read-AutomateNOWProcessingTemplateResourceDependency failed to retrieve any Processing Template Resource Dependencies from [$ItemTemplate_simpleId] (trying to filter out inherited resource dependencies) due to [$Message]."
                    Break
                }
                $results.response.data = $results.response.data | Where-Object { $_.resource -notin $ItemTemplateDependencies.resource }
            }
            $Error.Clear()
            Try {
                [ANOWProcessingTemplateDependency[]]$ProcessingTemplateDependencies = ForEach ($result in $results.response.data) {
                    If ($result.workflow.Length -gt 0) {
                        $result.workflow = $ProcessingTemplate
                    }
                    ElseIf ($result.workspace.Length -gt 0) {
                        $result.workspace = $Workspace
                    }
                    $result
                }
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Failed to parse the Processing Template Resource Dependencies from $item_name due to [$Message]"
                Break
            }
        }
        Else {
            Write-Verbose -Message "No Processing Template Resource Dependencies were found for $item_name"
            Break
        }
        Return $ProcessingTemplateDependencies
    }
    End {

    }
}

Function Export-AutomateNOWProcessingTemplateResourceDependency {
    <#
    .SYNOPSIS
    Exports the Processing Template Resource Dependencies from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the Processing Template Resource Dependencies from an instance of AutomateNOW!

    .PARAMETER ProcessingTemplateDependency
    Mandatory [ANOWProcessingTemplateDependency] objects of type RESOURCE (Use Read-AutomateNOWProcessingTemplateResourceDependency to retrieve them)

    .INPUTS
    ONLY [ANOWProcessingTemplateDependency] objects of type RESOURCE are accepted (including from the pipeline)

    .OUTPUTS
    The [ANOWProcessingTemplateDependency] objects (of type RESOURCE) are exported to the local disk in CSV format

    .EXAMPLE
    Exports the first page of Processing Template Resource Dependencies from a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWworkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateResourceDependency | Export-AutomateNOWProcessingTemplateResourceDependency

    .EXAMPLE
    Exports Processing Template Resource Dependencies from a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWworkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWProcessingTemplateResourceDependency | Export-AutomateNOWProcessingTemplateResourceDependency

    .EXAMPLE
    Exports the first page of non-inherited Processing Template Resource Dependencies from the first Processing Template Item within a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWworkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem | Select-Object -First 1 | Read-AutomateNOWProcessingTemplateResourceDependency -NotInherited | Export-AutomateNOWProcessingTemplateResourceDependency

    .NOTES
    You must present [ANOWProcessingTemplateDependency] objects of type RESOURCE to the pipeline to use this function.

    #>
    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    [Alias('Export-AutomateNOWWorkflowTemplateResourceDependency', 'Export-AutomateNOWServiceManagerTemplateResourceDependency')]
    Param(
        [ValidateScript({ $_.dependencyType -eq 'RESOURCE' })]
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-ProcessingTemplateResourceDependencies-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency = $_
        }
        $Error.Clear()
        Try {
            $ProcessingTemplateDependency | Export-CSV @parameters
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWProcessingTemplateDependency] object on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function Remove-AutomateNOWProcessingTemplateResourceDependency {
    <#
    .SYNOPSIS
    Removes a Processing Template Resource Dependency from a Processing Template or Processing Template Item from an instance of AutomateNOW!

    .DESCRIPTION
    Removes a Processing Template Resource Dependency from a Processing Template or Processing Template Item from an instance of AutomateNOW!

    .PARAMETER ProcessingTemplateDependency
    Mandatory [ANOWProcessingTemplateDependency] object representing the Processing Template Dependency that will be removed. Use Read-AutomateNOWProcessingTemplateResourceDependency to fetch these.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present one or more [ANOWProcessingTemplateDependency] objects to the ProcessingTemplateDependency parameter or across the pipeline

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Forcefully removes the first page of Processing Template Resource Dependencies assigned to a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateResourceDependency | Remove-AutomateNOWWorkflowTemplateResourceDependency -Force

    .EXAMPLE
    Removes the first page of non-inherited Processing Template Resource Dependencies assigned to the first Workflow Template Item within a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem | Select-Object -First 1 | Read-AutomateNOWWorkflowTemplateResourceDependency -NotInherited | Remove-AutomateNOWWorkflowTemplateResourceDependency

    .EXAMPLE
    Removes a specific Processing Template Dependency object by its id (one-liner)

    Read-AutomateNOWProcessingTemplateResourceDependency -Id '1e6da255-b2d5-458f-aff6-711b06c14921' | Remove-AutomateNOWProcessingTemplateResourceDependency

    .NOTES
    A deletion requires one explicit integral-zero acknowledgment; absent or empty data is valid.
    Diagnostics stop subsequent inputs. No request is retried, and a dispatched failure may have an uncertain server-side outcome.

    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    [Alias('Remove-AutomateNOWWorkflowTemplateResourceDependency', 'Remove-AutomateNOWServiceManagerTemplateResourceDependency')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        $batchStopped = $false
        if (-not (Test-ANOWB3Session)) {
            $batchStopped = $true
            Write-Warning 'Dependency removal session check failed or emitted a diagnostic. No request was submitted; subsequent removals are stopped.'
            return
        }
        [hashtable]$parameters = @{
            Command = '/processingTemplateDependency/delete'
            Method = 'POST'
            ContentType = 'application/x-www-form-urlencoded; charset=UTF-8'
        }
        if ($anow_session.NotSecure -eq $true) { $parameters.NotSecure = $true }
    }
    Process {
        if ($batchStopped) { return }
        If ($_.id.Length -gt 0) {
            [ANOWProcessingTemplateDependency]$ProcessingTemplateDependency = $_
        }
        [string]$ProcessingTemplateDependency_id = $ProcessingTemplateDependency.id
        if ($ProcessingTemplateDependency_id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z') {
            $batchStopped = $true
            Write-Warning 'Dependency removal requires a nonempty hexadecimal D-form GUID. No request was submitted; subsequent removals are stopped.'
            return
        }
        Write-Verbose -Message "Received [$ProcessingTemplateDependency_id] for the Id of the Processing Template Dependency to be removed"
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($ProcessingTemplateDependency_id)")) -eq $true) {
            $checked = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingTemplateResourceDependency) -OperationParameters @{Id=$ProcessingTemplateDependency_id}
            if (-not $checked.Succeeded -or $checked.Data.Count -ne 1 -or
                $checked.Data[0] -isnot [ANOWProcessingTemplateDependency] -or
                $checked.Data[0].id -ine $ProcessingTemplateDependency_id) {
                $batchStopped = $true
                Write-Warning 'Dependency removal prerequisite failed, emitted a diagnostic or did not return one matching typed dependency. No request was submitted; subsequent removals are stopped.'
                return
            }
            $prepared = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWDependencyRemovalBody) -OperationParameters @{Dependency=$ProcessingTemplateDependency}
            if (-not $prepared.Succeeded -or $prepared.Data.Count -ne 1 -or
                $prepared.Data[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($prepared.Data[0])) {
                $batchStopped = $true
                Write-Warning 'Dependency removal preparation failed or emitted a diagnostic. No request was submitted for this input; subsequent removals are stopped.'
                return
            }
            $parameters.Body = $prepared.Data[0]
            $request = Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if (-not $request.Succeeded) {
                $batchStopped = $true
                Write-Warning 'Dependency removal request failed or emitted a diagnostic. Its server-side outcome may be uncertain; subsequent removals are stopped and no request is retried.'
                return
            }
            $acknowledged = $false
            if ($request.Data.Count -eq 1) {
                $status = $request.Data[0].response.status
                $acknowledged = (($status -is [int32] -or $status -is [int64]) -and
                    (Test-ANOWB2Response -Envelopes $request.Data -AcknowledgmentOnly))
            }
            if (-not $acknowledged) {
                $batchStopped = $true
                Write-Warning 'Dependency removal did not return one explicit integral-zero acknowledgment. Its server-side outcome may be uncertain; subsequent removals are stopped and no request is retried.'
                return
            }
            if ($null -ne $ProcessingTemplateDependency.workflow -and $ProcessingTemplateDependency.workflow.id.Length -gt 0) {
                [string]$ProcessingTemplate_id = $ProcessingTemplateDependency.workflow.id
                Write-Verbose -Message "Processing Template Dependency $ProcessingTemplateDependency_id has been removed from $ProcessingTemplate_id"
            }
            else {
                Write-Verbose -Message "Processing Template Dependency $ProcessingTemplateDependency_id has been removed"
            }
        }
    }
    End {
    }
}

Function New-ANOWResourceDependencyRequest {
    [CmdletBinding()]
    param([ValidateSet('Add','Stock','Lock')][string]$Operation,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    [System.Collections.Specialized.OrderedDictionary]$metadata=[ordered]@{}
    if($Operation -ceq 'Add'){
        $set=$Options.ParameterSet
        if($set -cnotin @('ProcessingTemplate-Stock','ProcessingTemplate-Lock','ProcessingTemplateItem-Stock','ProcessingTemplateItem-Lock','Workspace-Stock','Workspace-Lock')){
            throw 'An existing Stock or Lock owner parameter set is required.'
        }
        $isWorkspace=$set.StartsWith('Workspace-',[StringComparison]::Ordinal)
        $isItem=$set.StartsWith('ProcessingTemplateItem-',[StringComparison]::Ordinal)
        $owner=if($isWorkspace){$Options.Workspace}elseif($isItem){$Options.ProcessingTemplateItem.workflow}else{$Options.ProcessingTemplate}
        $family=if($set.EndsWith('-Stock',[StringComparison]::Ordinal)){'STOCK'}else{'LOCK'}
        $resource=if($family -ceq 'STOCK'){$Options.Stock}else{$Options.Lock}
        if($null -eq $owner -or [string]::IsNullOrWhiteSpace($owner.id) -or
            $null -eq $resource -or [string]::IsNullOrWhiteSpace($resource.id) -or
            ($null -ne $resource.resourceType -and [string]$resource.resourceType -cne $family)){
            throw 'A matching typed owner and Stock or Lock resource identity are required.'
        }
        $itemName=''
        if($isItem){
            $item=$Options.ProcessingTemplateItem
            if($item.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' -or
                [string]::IsNullOrWhiteSpace($item.name)){
                throw 'A named item with a valid dependency owner is required.'
            }
            $itemName=$item.name
        }
        if($isWorkspace){
            $metadata.workspace=$owner.id
            $component='WorkspaceDependencyList'
        }else{
            $metadata.workflow=$owner.id
            $metadata.workflowItem=if($isItem){$itemName}else{$null}
            $metadata.valueOperator=$null
            $metadata.statusCodeOperator=$null
            $component='ProcessingTemplateDependencyEditForm'
        }
        $metadata.resourceType=$family
        if($family -ceq 'STOCK'){$metadata.resourcePermits=$Options.ResourcePermits}else{$metadata.lockState=$Options.LockState}
        $metadata.dependencyType='RESOURCE'
        $metadata.resource=$resource.id
        $operationType='add'
    }else{
        $target=$Options.Target
        $fresh=$Options.Fresh
        $family=$Operation.ToUpperInvariant()
        if($target -isnot [ANOWProcessingTemplateDependency] -or $fresh -isnot [ANOWProcessingTemplateDependency] -or
            $fresh.id -ine $target.id -or [string]$target.dependencyType -cne 'RESOURCE' -or
            [string]$fresh.dependencyType -cne 'RESOURCE' -or [string]$target.resourceType -cne $family -or
            [string]$fresh.resourceType -cne $family -or [string]::IsNullOrWhiteSpace($target.resource) -or
            -not [string]::Equals($fresh.resource,$target.resource,[StringComparison]::Ordinal)){
            throw 'One matching typed Stock or Lock prerequisite and compatible update binding are required.'
        }
        $hasWorkflow=$null -ne $target.workflow -and -not [string]::IsNullOrWhiteSpace($target.workflow.id)
        $hasWorkspace=$null -ne $target.workspace -and -not [string]::IsNullOrWhiteSpace($target.workspace.id)
        if($hasWorkflow -eq $hasWorkspace -or
            -not [string]::Equals([string]$fresh.workflow.id,[string]$target.workflow.id,[StringComparison]::Ordinal) -or
            -not [string]::Equals([string]$fresh.workspace.id,[string]$target.workspace.id,[StringComparison]::Ordinal) -or
            -not [string]::Equals([string]$fresh.workflowItem,[string]$target.workflowItem,[StringComparison]::Ordinal) -or
            ($target.domain -and -not [string]::Equals($fresh.domain,$target.domain,[StringComparison]::Ordinal))){
            throw 'The prerequisite owner, item or domain does not match the supplied dependency.'
        }
        if($Operation -ceq 'Stock'){
            if($null -ne $Options.ResourcePermits){$metadata.resourcePermits=$Options.ResourcePermits}
        }else{$metadata.lockState=$Options.LockState}
        $metadata.id=$target.id
        $metadata._oldValues=$fresh.CreateOldValues()
        $metadata.predecessor=$null
        $metadata.lastUpdated=$null
        $operationType='update'
        $component='ProcessingTemplateDependencyEditForm'
    }
    $metadata._operationType=$operationType
    $metadata._textMatchStyle='exact'
    $metadata._componentId=$component
    $metadata._dataSource='ProcessingTemplateDependencyDataSource'
    $metadata.isc_metaDataPrefix='_'
    $metadata.isc_dataFormat='json'
    $body=@(ConvertTo-QueryString -InputObject $metadata)
    if($body.Count -ne 1 -or $body[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($body[0])){
        throw 'One clean nonempty resource dependency form is required.'
    }
    if($Operation -ceq 'Add'){
        return [pscustomobject]@{Body=$body[0];Owner=$owner;IsWorkspace=$isWorkspace;ItemName=$itemName;Resource=$resource.id;Family=$family}
    }
    return $body[0]
}

Function ConvertFrom-ANOWResourceDependencyResponse {
    [CmdletBinding()]
    param([object[]]$Envelopes,[object]$Context)
    $ErrorActionPreference='Stop'
    $rows=@($Envelopes[0].response.data)
    if($rows.Count -ne 1 -or $null -eq $rows[0] -or
        ($rows[0] -isnot [Collections.IDictionary] -and $rows[0] -isnot [Management.Automation.PSCustomObject])){
        throw 'Exactly one raw resource dependency object is required.'
    }
    $row=$rows[0]
    $properties=[ordered]@{}
    if($row -is [Collections.IDictionary]){
        foreach($key in $row.Keys){$properties[$key]=$row[$key]}
    }else{
        foreach($member in $row.PSObject.Properties){$properties[$member.Name]=$member.Value}
    }
    foreach($name in @('id','workflow','workspace','workflowItem','resource','resourceType','dependencyType','domain')){
        if($null -ne $properties[$name] -and $properties[$name] -isnot [string]){
            throw 'Resource dependency identities must be scalar strings.'
        }
    }
    if($properties.id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z' -or
        $properties.dependencyType -cne 'RESOURCE' -or $properties.resourceType -cne $Context.Family -or
        -not [string]::Equals($properties.resource,$Context.Resource,[StringComparison]::Ordinal) -or
        -not [string]::Equals([string]$properties.workflowItem,$Context.ItemName,[StringComparison]::Ordinal) -or
        ($properties.domain -and $Context.Owner.domain -and
            -not [string]::Equals($properties.domain,$Context.Owner.domain,[StringComparison]::Ordinal))){
        throw 'The returned resource dependency identity, item or family was not verified.'
    }
    if($Context.IsWorkspace){
        if(-not [string]::Equals($properties.workspace,$Context.Owner.id,[StringComparison]::Ordinal) -or
            -not [string]::IsNullOrEmpty([string]$properties.workflow)){
            throw 'The returned workspace owner was not verified.'
        }
        $properties.workspace=$Context.Owner
    }else{
        if(-not [string]::Equals($properties.workflow,$Context.Owner.id,[StringComparison]::Ordinal) -or
            -not [string]::IsNullOrEmpty([string]$properties.workspace)){
            throw 'The returned workflow owner was not verified.'
        }
        $properties.workflow=$Context.Owner
    }
    return [ANOWProcessingTemplateDependency][pscustomobject]$properties
}

Function Add-AutomateNOWProcessingTemplateResourceDependency {
    <#
    .SYNOPSIS
    Adds a Processing Template Resource Dependency to a Processing Template, a Workspace or a Processing Template Item

    .DESCRIPTION
    Adds a Processing Template Resource Dependency to a Processing Template, a Workspace or a Processing Template Item

    Configures synchronized Stock permit allocation or Lock acquisition in the Resources tab. This command accepts a Stock or Lock object; it does not configure ordinary resource-state conditions or dynamic resource names.

    .PARAMETER ProcessingTemplate
    [ANOWProcessingTemplate] object that the resource dependency will be configured for. Use Get-AutomateNOWTaskTemplate, Get-AutomateNOWWorkflowTemplate, Get-AutomateNOWServiceManagerTemplate or Get-AutomateNOWProcessingTemplate to fetch these.

    .PARAMETER ProcessingTemplateItem
    [ANOWProcessingTemplateItem] object representing the Processing Template Item that is receiving the resource dependency. Use Read-AutomateNOWWorkflowTemplateItem or Read-AutomateNOWServiceManagerTemplateItem to fetch these.

    .PARAMETER Workspace
    [ANOWWorkspace] object representing the Workspace that is receiving the resource dependency. Use Get-AutomateNOWWorkspace to fetch these.

    .PARAMETER Stock
    [ANOWStock] object representing the Stock resource that will be added as a Processing Template Resource Dependency. Use Get-AutomateNOWStock to fetch these.

    .PARAMETER Lock
    [ANOWLock] object representing the Lock resource that will be added as a Processing Template Resource Dependency. Use Get-AutomateNOWLock to fetch these.

    .PARAMETER ResourcePermits
    [int32] indicating how many Resource Permits to allocate to the Stock. This value defaults to 1.

    .PARAMETER LockState
    [string] indicating the state of the Lock resource that will be added. Options are SHARED* or EXCLUSIVE.

    .PARAMETER Force
    Force the addition of the object without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Suppresses the returned [ANOWProcessingTemplateDependency] object. Verbose messages and warnings remain available.

    .INPUTS
    An [ANOWProcessingTemplate], [ANOWProcessingTemplateItem], or [ANOWWorkspace] object must be presented along with a Stock or Lock resource. Pipeline support is intentionally not included.

    .OUTPUTS
    One matching strict [ANOWProcessingTemplateDependency] object is returned after an explicit integral-zero acknowledgment, unless -Quiet is specified. Quiet still validates the full result. Diagnostics stop the operation without retry; a dispatched failure may have an uncertain server-side outcome.

    .EXAMPLE
    Adds a Lock named 'Lock1' in exclusive mode as Processing Template Resource Dependency to a Workspace named 'Workspace1' (one-liner)

    Add-AutomateNOWProcessingTemplateResourceDependency -Workspace (Get-AutomateNOWWorkspace -Id 'Workspace1') -Lock (Get-AutomateNOWLock -Id 'Lock1') -LockState 'EXCLUSIVE'

    .EXAMPLE
    Forcefully adds a Stock named 'Stock1' with 1 resource permit as a Processing Template Resource Dependency to a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Add-AutomateNOWProcessingTemplateResourceDependency -ProcessingTemplate (Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1') -Stock (Get-AutomateNOWStock -Id 'Stock1') -Force

    .EXAMPLE
    Adds a Stock named 'Stock1' with 1 resource permit as a Processing Template Resource Dependency to a Workflow Template Item named 'TaskTemplate1' which is part of a Workflow Template named 'WorkflowTemplate1' (one-liner)

    Add-AutomateNOWProcessingTemplateResourceDependency -ProcessingTemplateItem (Get-AutomateNOWWorkflowTemplate -Id 'WorkflowTemplate1' | Read-AutomateNOWWorkflowTemplateItem -Name 'TaskTemplate1') -Stock (Get-AutomateNOWStock -Id 'Stock1')

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Synchronized resources allocate Stock permits or acquire a Lock in SHARED or EXCLUSIVE mode. These allocations are distinct from ordinary dependency conditions that check a resource state or value, including Stock or Lock conditions. This command configures only the synchronized form.

    AutomateNOW product documentation describes Dynamic Resource dependencies whose resource names are evaluated at runtime in the Dependencies tab. Dynamic-name configuration and other dependency kinds are not implemented by this command.

    You do not need to include the -ProcessingTemplate when adding a resource dependency to a -ProcessingTemplateItem because the Processing Template object will be extracted from the Processing Template Item.

    #>
    [OutputType([ANOWProcessingTemplateDependency])]
    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplate-Stock')]
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplate-Lock')]
        [ANOWProcessingTemplate]$ProcessingTemplate,
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplateItem-Stock')]
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplateItem-Lock')]
        [ANOWProcessingTemplateItem]$ProcessingTemplateItem,
        [Parameter(Mandatory = $true, ParameterSetName = 'Workspace-Stock')]
        [Parameter(Mandatory = $true, ParameterSetName = 'Workspace-Lock')]
        [ANOWWorkspace]$Workspace,
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplate-Stock')]
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplateItem-Stock')]
        [Parameter(Mandatory = $true, ParameterSetName = 'Workspace-Stock')]
        [ANOWStock]$Stock,
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplate-Lock')]
        [Parameter(Mandatory = $true, ParameterSetName = 'ProcessingTemplateItem-Lock')]
        [Parameter(Mandatory = $true, ParameterSetName = 'Workspace-Lock')]
        [ANOWLock]$Lock,
        [Parameter(Mandatory = $false, ParameterSetName = 'ProcessingTemplate-Stock')]
        [Parameter(Mandatory = $false, ParameterSetName = 'ProcessingTemplateItem-Stock')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Workspace-Stock')]
        [int32]$resourcePermits = 1,
        [Parameter(Mandatory = $false, ParameterSetName = 'ProcessingTemplate-Lock')]
        [Parameter(Mandatory = $false, ParameterSetName = 'ProcessingTemplateItem-Lock')]
        [Parameter(Mandatory = $false, ParameterSetName = 'Workspace-Lock')]
        [ValidateSet('SHARED', 'EXCLUSIVE')]
        [string]$lockState = 'SHARED',
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )

    if(-not (Test-ANOWB3Session)){
        Write-Warning 'Resource dependency session check failed or emitted a diagnostic. No request was submitted; the operation is stopped.'
        return
    }
    $options=@{
        ParameterSet=$PSCmdlet.ParameterSetName;ProcessingTemplate=$ProcessingTemplate;ProcessingTemplateItem=$ProcessingTemplateItem
        Workspace=$Workspace;Stock=$Stock;Lock=$Lock;ResourcePermits=$ResourcePermits;LockState=$LockState
    }
    $resource=if($PSCmdlet.ParameterSetName.EndsWith('-Stock',[StringComparison]::Ordinal)){$Stock}else{$Lock}
    $target=if($PSCmdlet.ParameterSetName.StartsWith('Workspace-',[StringComparison]::Ordinal)){$Workspace.id}
        elseif($PSCmdlet.ParameterSetName.StartsWith('ProcessingTemplateItem-',[StringComparison]::Ordinal)){"$($ProcessingTemplateItem.name) within $($ProcessingTemplateItem.workflow.id)"}
        else{$ProcessingTemplate.id}
    if(($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($resource.id) to $target")) -eq $true){
        $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWResourceDependencyRequest) -OperationParameters @{Operation='Add';Options=$options}
        if(-not $prepared.Succeeded -or $prepared.Data.Count -ne 1 -or
            $prepared.Data[0].Body -isnot [string] -or [string]::IsNullOrWhiteSpace($prepared.Data[0].Body)){
            Write-Warning 'Resource dependency preparation failed or emitted a diagnostic. No request was submitted; the operation is stopped.'
            return
        }
        $parameters=@{
            Command='/processingTemplateDependency/create';Method='POST'
            ContentType='application/x-www-form-urlencoded; charset=UTF-8';Body=$prepared.Data[0].Body
        }
        if($anow_session.NotSecure -eq $true){$parameters.NotSecure=$true}
        $request=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
        if(-not $request.Succeeded){
            Write-Warning 'Resource dependency creation failed or emitted a diagnostic. Its server-side outcome may be uncertain; the operation is stopped without retry.'
            return
        }
        if(-not (Test-ANOWPreservationAcknowledgment -Envelopes $request.Data)){
            Write-Warning 'Resource dependency creation did not return one explicit integral-zero acknowledgment. Its server-side outcome may be uncertain; the operation is stopped without retry.'
            return
        }
        $converted=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWResourceDependencyResponse) -OperationParameters @{Envelopes=$request.Data;Context=$prepared.Data[0]}
        if(-not $converted.Succeeded -or $converted.Data.Count -ne 1 -or $converted.Data[0] -isnot [ANOWProcessingTemplateDependency]){
            Write-Warning 'Resource dependency creation was acknowledged, but its exact strict result could not be verified. The dependency may already have been added; the operation is stopped without retry.'
            return
        }
        Write-Verbose 'A Processing Template Resource Dependency was successfully added to its target'
        if(-not $Quiet){$converted.Data[0]}
    }
}

Function Set-AutomateNOWProcessingTemplateResourceDependency {
    <#
    .SYNOPSIS
    Changes the settings of a Processing Template Resource Dependency from an instance of AutomateNOW!

    .DESCRIPTION
    Changes the settings of a Processing Template Resource Dependency from an instance of AutomateNOW!

    .PARAMETER ProcessingTemplateResourceDependency
    Mandatory [ANOWProcessingTemplateDependency] object representing the Processing Template Resource Dependency that will be changed (a Lock or Stock). Use Read-AutomateNOWProcessingTemplateResourceDependency to fetch these.

    .PARAMETER ResourcePermits
    [int32] indicating how many Resource Permits to allocate to the Stock.

    .PARAMETER LockState
    [string] indicating the state of the Lock resource that will be added. Options are SHARED or EXCLUSIVE.

    .PARAMETER Force
    Force the update without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    You must present one or more [ANOWProcessingTemplateDependency] objects to the ProcessingTemplateResourceDependency parameter or across the pipeline

    .OUTPUTS
    None. A clean matching prerequisite and one explicit integral-zero acknowledgment are required; response data may be absent or sparse. Diagnostics stop subsequent inputs without retry. A dispatched failure may have an uncertain server-side outcome. Success is written with Write-Verbose.

    .EXAMPLE
    Sets the Resource Permits to 3 on a Stock named 'Stock1' that is assigned to a Workspace named 'Workspace1' (one-liner)

    Get-AutomateNOWWorkspace -Id 'Workspace1' | Read-AutomateNOWProcessingTemplateResourceDependency | Where-Object { $_.Name -eq 'Stock1' } | Set-AutomateNOWProcessingTemplateResourceDependency -ResourcePermits 3

    .EXAMPLE
    Forcefully sets the Lock State to Exclusive on a Lock named 'Lock1' that is assigned to a Processing Template named 'TaskTemplate1'

    Get-AutomateNOWTaskTemplate -Id 'TaskTemplate1' | Read-AutomateNOWProcessingTemplateResourceDependency | Where-Object { $_.Name -eq 'Lock1' } | Set-AutomateNOWProcessingTemplateResourceDependency -LockState 'EXCLUSIVE' -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    [Alias('Set-AutomateNOWWorkflowTemplateResourceDependency', 'Set-AutomateNOWServiceManagerTemplateResourceDependency')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWProcessingTemplateDependency]$ProcessingTemplateResourceDependency,
        [Parameter(Mandatory = $true, ParameterSetName = 'Stock')]
        [Nullable[int32]]$ResourcePermits,
        [Parameter(Mandatory = $true, ParameterSetName = 'Lock')]
        [ValidateSet('SHARED', 'EXCLUSIVE')]
        [string]$LockState,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )

    Begin {
        $batchStopped=$false
        if(-not (Test-ANOWB3Session)){
            $batchStopped=$true
            Write-Warning 'Resource dependency session check failed or emitted a diagnostic. No request was submitted; subsequent inputs are stopped.'
            return
        }
        $parameters=@{
            Command='/processingTemplateDependency/update';Method='POST'
            ContentType='application/x-www-form-urlencoded; charset=UTF-8'
        }
        if($anow_session.NotSecure -eq $true){$parameters.NotSecure=$true}
    }
    Process {
        if($batchStopped){return}
        $id=$ProcessingTemplateResourceDependency.id
        if($id -notmatch '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z'){
            $batchStopped=$true
            Write-Warning 'Resource dependency update requires a hexadecimal D-form GUID. No request was submitted; subsequent inputs are stopped.'
            return
        }
        if(($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess($id)) -eq $true){
            $checked=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Read-AutomateNOWProcessingTemplateResourceDependency) -OperationParameters @{Id=$id}
            if(-not $checked.Succeeded -or $checked.Data.Count -ne 1 -or $checked.Data[0] -isnot [ANOWProcessingTemplateDependency]){
                $batchStopped=$true
                Write-Warning 'Resource dependency prerequisite failed, emitted a diagnostic or did not return one typed dependency. No request was submitted for this input; subsequent inputs are stopped.'
                return
            }
            $options=@{Target=$ProcessingTemplateResourceDependency;Fresh=$checked.Data[0];ResourcePermits=$ResourcePermits;LockState=$LockState}
            $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWResourceDependencyRequest) -OperationParameters @{Operation=$PSCmdlet.ParameterSetName;Options=$options}
            if(-not $prepared.Succeeded -or $prepared.Data.Count -ne 1 -or
                $prepared.Data[0] -isnot [string] -or [string]::IsNullOrWhiteSpace($prepared.Data[0])){
                $batchStopped=$true
                Write-Warning 'Resource dependency prerequisite identity, family or form preparation failed or emitted a diagnostic. No request was submitted for this input; subsequent inputs are stopped.'
                return
            }
            $parameters.Body=$prepared.Data[0]
            $request=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if(-not $request.Succeeded){
                $batchStopped=$true
                Write-Warning 'Resource dependency update failed or emitted a diagnostic. Its server-side outcome may be uncertain; subsequent inputs are stopped without retry.'
                return
            }
            if(-not (Test-ANOWPreservationAcknowledgment -Envelopes $request.Data)){
                $batchStopped=$true
                Write-Warning 'Resource dependency update did not return one explicit integral-zero acknowledgment. Its server-side outcome may be uncertain; subsequent inputs are stopped without retry.'
                return
            }
            Write-Verbose "Processing Template Dependency $id has been updated"
        }
    }
    End {
    }
}

