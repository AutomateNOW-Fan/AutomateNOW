Function Copy-ANOWPreservationValue {
    param([AllowNull()][object]$Value)
    if ($null -eq $Value) { return $null }
    if ($Value -is [Collections.IDictionary] -or $Value -is [Management.Automation.PSCustomObject]) {
        $copy=[ordered]@{}
        $names=if ($Value -is [Collections.IDictionary]) { @($Value.Keys) } else { @($Value.PSObject.Properties.Name) }
        foreach ($name in $names) {
            if ($name -isnot [string]) { throw 'A definition member name must be a string.' }
            $copy[$name]=Copy-ANOWPreservationValue $Value.$name
        }
        return $copy
    }
    if ($Value -is [array]) {
        $copy=[object[]]::new($Value.Count)
        for ($index=0; $index -lt $Value.Count; $index++) { $copy[$index]=Copy-ANOWPreservationValue $Value[$index] }
        return ,$copy
    }
    if ($Value -is [string] -or $Value -is [ValueType]) { return $Value }
    throw 'The nested definition contains an unsupported value.'
}

Function Test-ANOWPreservationEdit {
    param([hashtable]$Options,[string[]]$Names)
    foreach ($name in $Names) {
        if (-not $Options.ContainsKey($name) -or $null -eq $Options[$name]) { continue }
        $value=$Options[$name]
        if ($value -is [Management.Automation.SwitchParameter]) { if ($value.IsPresent) { return $true }; continue }
        if ($value -is [string]) { if ($value.Length -gt 0) { return $true }; continue }
        if ($value -is [array]) { if ($value.Count -gt 0) { return $true }; continue }
        if ($name -ceq 'MaxLogSize' -and $value -le 0) { continue }
        if ($null -ne $value.PSObject.Properties['id'] -and ([string]$value.id).Length -eq 0) { continue }; return $true
    }
    return $false
}

Function New-ANOWRootTemplateUpdateRequest {
    [CmdletBinding()]
    param([ValidateSet('TaskTemplate','WorkflowTemplate')][string]$Kind,[object]$Target,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    $current=Get-ANOWPreservationObject -Kind $Kind -Id $Target.simpleId -Target $Target
    $family=if ($Kind -ceq 'TaskTemplate') { 'TASK' } else { 'WORKFLOW' }
    $subtype=if ($Kind -ceq 'TaskTemplate') { 'taskType' } else { 'workflowType' }
    if ([string]$Target.processingType -cne $family -or [string]$current.processingType -cne $family -or
        ($null -ne $Target.$subtype -and [string]$current.$subtype -cne [string]$Target.$subtype)) { throw 'The prerequisite processing family/subtype does not match the selected template.' }
    $metadata=[ordered]@{id=$Target.id}
    if ($Kind -ceq 'TaskTemplate' -and $null -ne $Options.ProcessingCommand -and $Options.ProcessingCommand.Keys.Count -gt 0) {
        $metadata['processingCommand']=$Options.ProcessingCommand | ConvertTo-Json -Compress -Depth 100 -ErrorAction Stop -WarningAction Stop
    }
    if (([string]$Options.Description).Length -gt 0) { $metadata['description']=$Options.Description }
    elseif ($Options.UnsetDescription -eq $true) { $metadata['description']=$null }
    if (([string]$Options.Folder).Length -gt 0) {
        $folder=Get-ANOWPreservationObject -Kind Folder -Id $Options.Folder
        $metadata['folder']=$folder.id
    } elseif ($Options.UnsetFolder -eq $true) { $metadata['folder']=$null }
    if ($null -ne $Options.Tags -and @($Options.Tags).Count -gt 0) {
        $ordinal=1
        foreach ($tag in $Options.Tags) {
            $null=Get-ANOWPreservationObject -Kind Tag -Id $tag
            $metadata['tags'+$ordinal]=$tag
            $ordinal++
        }
    } elseif ($Options.UnsetTags -eq $true) { $metadata['tags']=$null }
    if (([string]$Options.CodeRepository.id).Length -gt 0) {
        $null=Get-ANOWPreservationObject -Kind CodeRepository -Id $Options.CodeRepository.id -IdentityProperty id -Target $Options.CodeRepository
        $metadata['codeRepository']=$Options.CodeRepository.id
    } elseif ($Options.UnsetCodeRepository -eq $true) { $metadata['codeRepository']=$null }
    if (([string]$Options.Title).Length -gt 0) { $metadata['title']=$Options.Title }
    elseif ($Options.UnsetTitle -eq $true) { $metadata['title']=$null }
    if ($Kind -ceq 'TaskTemplate') {
        if (([string]$Options.ServerNode.simpleId).Length -gt 0) {
            $null=Get-ANOWPreservationObject -Kind ServerNode -Id $Options.ServerNode.simpleId -Target $Options.ServerNode
            $resolved=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Resolve-AutomateNOWTaskType2ServerNodeType) -OperationParameters @{TaskType=$Target.taskType}
            if (-not $resolved.Succeeded -or @($resolved.Data).Count -eq 0 -or $Options.ServerNode.serverNodeType -notin @($resolved.Data)) { throw 'A clean compatible Server Node type was not verified.' }
            $metadata['node']=$Options.ServerNode.id
        } elseif ($Options.UnsetServerNode -eq $true) { $metadata['node']=$null }
        if (([string]$Options.Endpoint.simpleId).Length -gt 0) {
            $null=Get-ANOWPreservationObject -Kind Endpoint -Id $Options.Endpoint.simpleId -Target $Options.Endpoint
            $metadata['endpoint']=$Options.Endpoint.id
            $metadata['endpointType']=$Options.Endpoint.endpointType
        } elseif ($Options.UnsetEndpoint -eq $true) { $metadata['endpoint']=$null;$metadata['endpointType']=$null }
    }
    foreach ($entry in @(@('ResultMapping','resultMapping'),@('Calendar','calendar'),@('Approval','approvalConfiguration'))) {
        $selected=$Options[$entry[0]]
        $selectedId=if ($entry[0] -ceq 'ResultMapping') { [string]$selected.simpleId } else { [string]$selected.id }
        if ($selectedId.Length -gt 0) {
            $null=Get-ANOWPreservationObject -Kind $entry[0] -Id $selected.simpleId -Target $selected
            $metadata[$entry[1]]=$selected.simpleId
        } elseif ($Options['Unset'+$entry[0]] -eq $true) { $metadata[$entry[1]]=$null }
    }
    if (([string]$Options.DelayedStartTime).Length -gt 0) { $metadata['delayedStartTime']=$Options.DelayedStartTime }
    elseif ($Options.UnsetDelayedStartTime -eq $true) { $metadata['delayedStartTime']=$null }
    if (([string]$Options.TimeZone.id).Length -gt 0) { $metadata['timeZone']=$Options.TimeZone.id }
    elseif ($Options.UnsetTimeZone -eq $true) { $metadata['timeZone']=$null }
    foreach ($name in @('priority','weight')) { if ($Options.ContainsKey($name) -and $Options[$name] -ge 0) { $metadata[$name]=$Options[$name] } }
    if ($null -ne $Options.MaxSimultaneousExecutions) { $metadata['maxSimultaneousExecutions']=$Options.MaxSimultaneousExecutions }
    elseif ($Options.UnsetMaxSimultaneousExecutions -eq $true) { $metadata['maxSimultaneousExecutions']=$null }
    $flags=@(@('Hold','onHold'),@('Skip','passBy'),@('IgnoreProcessingRegistry','ignoreProcessingStateRegistry'),@('VerboseMode','verboseMode'),@('AutoArchive','autoArchive'),@('KeepResources','keepResourcesOnFailure'),@('UseScripts','useScripts'),@('EagerScriptExecution','eagerScriptExecution'))
    if ($Kind -ceq 'WorkflowTemplate') { $flags+=@(@('LazyLoad','lazyLoad'),@('PassResources','passResourceDependenciesToChildren'),@('PassActions','passActionsToChildren')) }
    foreach ($entry in $flags) { if ($null -ne $Options[$entry[0]]) { $metadata[$entry[1]]=([string][bool]$Options[$entry[0]]).ToLowerInvariant() } }
    if (([string]$Options.Owner).Length -gt 0) { $metadata['owner']=$Options.Owner }
    if ($Options.ContainsKey('statisticalDuration') -and $Options.statisticalDuration -ge 1000) { $metadata['statisticalDuration']=$Options.statisticalDuration }
    $metadata['_operationType']='update';$metadata['_textMatchStyle']='exact';$metadata['_oldValues']=$Target.CreateOldValues()
    $metadata['_componentId']='ProcessingTemplateValuesManager';$metadata['_dataSource']='ProcessingTemplateDataSource'
    $metadata['isc_metaDataPrefix']='_';$metadata['isc_dataFormat']='json'
    $serialized=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$metadata}
    if (-not $serialized.Succeeded -or @($serialized.Data).Count -ne 1 -or $serialized.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($serialized.Data[0])) { throw 'The update form was not cleanly serialized.' }
    return [pscustomobject]@{Command='/processingTemplate/update';Body=$serialized.Data[0]}
}

Function Get-ANOWPreservationObject {
    [CmdletBinding()]
    param([string]$Kind,[string]$Id,[string]$IdentityProperty='simpleId',[object]$Target)
    $ErrorActionPreference='Stop'
    $type=switch ($Kind) {
        Agent { [ANOWAgent] } ServiceManagerTemplate { [ANOWServiceManagerTemplate] } RuntimeAction { [ANOWProcessingAction] }
        TaskTemplate { [ANOWTaskTemplate] } WorkflowTemplate { [ANOWWorkflowTemplate] } ServerNode { [ANOWServerNode] } Endpoint { [ANOWEndpoint] }
        Folder { [ANOWFolder] } Tag { [ANOWTag] } CodeRepository { [ANOWCodeRepository] }
        ResultMapping { [ANOWResultMapping] } Calendar { [ANOWCalendar] } Approval { [ANOWApproval] }
        default { throw 'Unsupported preservation prerequisite.' }
    }
    if ([string]::IsNullOrWhiteSpace($Id)) { throw 'An exact prerequisite identity is required.' }
    $found=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ('Get-AutomateNOW'+$Kind)) -OperationParameters @{Id=$Id}
    if (-not $found.Succeeded -or @($found.Data).Count -ne 1 -or -not $type.IsInstanceOfType($found.Data[0]) -or
        -not [string]::Equals($found.Data[0].$IdentityProperty,$Id,[StringComparison]::Ordinal)) { throw 'The clean, unique, strict prerequisite identity was not verified.' }
    $item=$found.Data[0]
    if ($null -ne $Target -and
        (-not [string]::Equals($item.id,$Target.id,[StringComparison]::Ordinal) -or
         (-not [string]::IsNullOrEmpty($Target.simpleId) -and -not [string]::Equals($item.simpleId,$Target.simpleId,[StringComparison]::Ordinal)))) { throw 'The prerequisite does not match the selected input.' }
    if ($null -ne $Target -and -not [string]::IsNullOrEmpty($Target.domain) -and
        -not [string]::Equals($item.domain,$Target.domain,[StringComparison]::Ordinal)) { throw 'The prerequisite domain does not match the selected input.' }
    return $item
}

Function Test-ANOWPreservationOptions {
    [CmdletBinding()]
    param([string]$Kind,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    $pairs=@('Description','Folder','CodeRepository')
    if ($Kind -cin @('ServiceManagerTemplate','TaskTemplate','WorkflowTemplate')) { $pairs+=@('Title','ResultMapping','Calendar','DelayedStartTime','TimeZone','Approval','ProcessingTemplate') }
    if ($Kind -ceq 'TaskTemplate') { $pairs+=@('ServerNode','Endpoint') }
    if ($Kind -ceq 'Agent') { $pairs+=@('OpenTelemetryLogCollectorEndpoint','OpenTelemetryTraceCollectorEndpoint','OpenTelemetryCollectorEndpoint') }
    if ($Kind -ceq 'RuntimeAction') { $pairs+=@('StartDate','EndDate','Calendar','ProcessingType','ProcessingTemplate','ParentProcessingTemplate','NodeType','ServerNode','TagOperator','StepConditionMode','EventCondition') }
    foreach ($name in $pairs) {
        $value=$Options[$name]
        $selected=if ($value -is [string]) { $value.Length -gt 0 } elseif ($null -eq $value) { $false } elseif ($null -ne $value.PSObject.Properties['id']) { ([string]$value.id).Length -gt 0 } else { $true }
        if ($selected -and $Options['Unset'+$name] -eq $true) { throw 'A field cannot be set and unset together.' }
    }
    if (@($Options.Tags).Count -gt 0 -and $null -ne $Options.Tags -and $Options.UnsetTags -eq $true) { throw 'Tags cannot be set and unset together.' }
    if ($Kind -cin @('ServiceManagerTemplate','TaskTemplate','WorkflowTemplate')) {
        if ($null -ne $Options.MaxSimultaneousExecutions -and $Options.UnsetMaxSimultaneousExecutions -eq $true) { throw 'The execution limit cannot be set and unset together.' }
        if ($Options.EagerScriptExecution -eq $true -and $Options.UseScripts -ne $true) { throw 'EagerScriptExecution requires UseScripts true.' }
    }
    if ($Kind -ceq 'Agent') {
        if ($Options.MaxLogSize -gt 0 -and $Options.UnsetMaxLogSize -eq $true) { throw 'MaxLogSize cannot be set and unset together.' }
        if ($Options.RemoveAllAdditionalLoggers -eq $true -and
            ((@($Options.AddAdditionalLoggers).Count -gt 0 -and $null -ne $Options.AddAdditionalLoggers) -or
             (@($Options.RemoveAdditionalLoggers).Count -gt 0 -and $null -ne $Options.RemoveAdditionalLoggers))) { throw 'RemoveAllAdditionalLoggers cannot be combined with logger additions or removals.' }
    }
    if ($Kind -ceq 'RuntimeAction') {
        if ($null -ne $Options.ActionOrder -and $Options.UnsetActionOrder -eq $true) { throw 'ActionOrder cannot be set and unset together.' }
        if (($Options.UnsetTagOperator -eq $true -and @($Options.Tags).Count -gt 0 -and $null -ne $Options.Tags) -or
            ($Options.UnsetTags -eq $true -and ([string]$Options.TagOperator).Length -gt 0)) { throw 'The selected tag and operator edits are incompatible.' }
        if ([string]$Options.StepConditionMode -ceq 'SIMPLE' -and
            (([string]$Options.StepName).Length -eq 0 -or ([string]$Options.StepOperator).Length -eq 0 -or ([string]$Options.StepReturnCode).Length -eq 0)) { throw 'SIMPLE requires StepName, StepOperator and StepReturnCode.' }
        if ([string]$Options.StepConditionMode -ceq 'ADVANCED' -and $null -eq $Options.StepCondition) { throw 'ADVANCED requires StepCondition.' }
    }
    return $true
}

Function Test-ANOWPreservationInput {
    [CmdletBinding()]
    param([string]$Kind,[object]$Target,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    if ([string]::IsNullOrWhiteSpace($Target.id) -or [string]::IsNullOrWhiteSpace($Target.simpleId)) { throw 'The selected input requires exact id and simpleId.' }
    if ($Kind -ceq 'ServiceManagerTemplate') {
        $bareSla=$Target -is [ANOWServiceManagerTemplate] -and
            [string]$Target.processingType -ceq 'SERVICE' -and
            [string]$Target.serviceType -ceq 'SERVICE_MANAGER' -and
            [string]$Target.serviceManagerType -ceq 'SLA_SERVICE_MANAGER' -and
            $null -eq $Target.processingCommand
        if ($bareSla) {
            foreach ($key in @('ProcessingTemplate','UnsetProcessingTemplate','RunMode','RunInterval','RunTimes','RunFor','RunTimeOfDay','RunTimeZone','RunOffSet')) {
                if ($Options.ContainsKey($key)) { throw 'Command or run settings require an existing supported Service Manager command.' }
            }
            return $true
        }
        $current=[string]$Target.processingCommand.serviceMode.runMode
        if ($current -notin @('ONCE','COUNTER','FOR','UNTIL')) { throw 'The current service mode was not verified.' }
        $explicit=([string]$Options.RunMode).Length -gt 0
        $mode=if ($explicit) { [string]$Options.RunMode } else { $current }
        $active=@{}
        foreach ($name in @('RunInterval','RunTimes','RunFor','RunTimeOfDay')) { $active[$name]=$Options.ContainsKey($name) -and $Options[$name] -ge 0 }
        $active.RunTimeZone=$null -ne $Options.RunTimeZone
        $active.RunOffSet=$Options.ContainsKey('RunOffSet') -and $Options.RunOffSet -gt 0
        $allowed=switch ($mode) {
            ONCE { @() } COUNTER { @('RunInterval','RunTimes') } FOR { @('RunInterval','RunFor') }
            UNTIL { @('RunInterval','RunTimeOfDay','RunTimeZone','RunOffSet') }
        }
        foreach ($name in $active.Keys) { if ($active[$name] -and $name -cnotin $allowed) { throw 'A selected run field is incompatible with this input mode.' } }
        if ($explicit) {
            $required=switch ($mode) { ONCE { @() } COUNTER { @('RunInterval','RunTimes') } FOR { @('RunInterval','RunFor') } UNTIL { @('RunInterval','RunTimeOfDay','RunTimeZone') } }
            foreach ($name in $required) { if (-not $Options.ContainsKey($name) -or $null -eq $Options[$name] -or ($name -cne 'RunTimeZone' -and $Options[$name] -eq -1)) { throw 'The explicit run mode requires its existing documented arguments.' } }
        }
        if (([string]$Options.ProcessingTemplate.id).Length -gt 0 -and [string]$Target.monitorType -cne 'PROCESSING_DEADLINE_MONITOR') { throw 'ProcessingTemplate can be assigned only to a Processing Deadline Monitor.' }
    }
    if ($Kind -ceq 'RuntimeAction' -and ([string]$Options.ProcessingType).Length -eq 0 -and
        ($Options.ContainsKey('TaskType') -or $Options.ContainsKey('WorkflowType') -or $Options.ContainsKey('ServiceType')) -and
        ([string]$Target.processingType).Length -eq 0) { throw 'A subtype edit requires an explicit or existing processingType.' }
    return $true
}

Function New-ANOWPreservedServiceCommand {
    [CmdletBinding()]
    param([ANOWServiceManagerTemplate]$Target,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    $command=Copy-ANOWPreservationValue $Target.processingCommand
    if ($command -isnot [Collections.IDictionary] -or $command.serviceMode -isnot [Collections.IDictionary]) { throw 'A complete command and serviceMode object are required.' }
    $mode=$command.serviceMode
    if (([string]$Options.RunMode).Length -gt 0) {
        if ([string]$Options.RunMode -ne [string]$mode.runMode) {
            foreach ($name in @('interval','counter','duration','timeOfDay','timeZone','dayOffset')) { $mode.Remove($name) }
        }
        $mode['runMode']=$Options.RunMode
    }
    foreach ($entry in @(@('RunInterval','interval'),@('RunTimes','counter'),@('RunFor','duration'),@('RunTimeOfDay','timeOfDay'))) {
        $applicable=switch ($entry[0]) { RunInterval { $mode.runMode -in @('COUNTER','FOR','UNTIL') } RunTimes { $mode.runMode -eq 'COUNTER' } RunFor { $mode.runMode -eq 'FOR' } RunTimeOfDay { $mode.runMode -eq 'UNTIL' } }
        if ($applicable -and $Options.ContainsKey($entry[0]) -and $Options[$entry[0]] -ne -1) { $mode[$entry[1]]=$Options[$entry[0]] }
    }
    if ($null -ne $Options.RunTimeZone) { $mode['timeZone']=$Options.RunTimeZone.id }
    if ($mode.runMode -eq 'UNTIL' -and $Options.ContainsKey('RunOffSet') -and $Options.RunOffSet -ge 0) { $mode['dayOffset']=$Options.RunOffSet }
    if (([string]$Options.ProcessingTemplate.id).Length -gt 0) { $command['processingTemplate']=$Options.ProcessingTemplate.id }
    elseif ($Options.UnsetProcessingTemplate -eq $true) {
        if (([string]$command.processingTemplate).Length -eq 0) { throw 'There is no monitored Processing Template to unset.' }
        $command.Remove('processingTemplate')
    }
    return ($command | ConvertTo-Json -Compress -Depth 100 -ErrorAction Stop -WarningAction Stop)
}

Function New-ANOWPreservedAgentConfiguration {
    [CmdletBinding()]
    param([ANOWAgent]$Target,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    $configuration=Copy-ANOWPreservationValue $Target.configuration
    if ($null -eq $configuration) { $configuration=[ordered]@{} }
    if ($configuration -isnot [Collections.IDictionary]) { throw 'The stored Agent configuration must be an object or null.' }
    foreach ($entry in @(@('LogLevel','logLevel'),@('LogMaxFiles','logMaxFiles'),@('AgentHeartbeat','AgentHeartbeat'))) {
        if ($Options.ContainsKey($entry[0])) { $configuration[$entry[1]]=$Options[$entry[0]] }
    }
    if ($null -ne $Options.DisableANOWObserve) { $configuration['disableTelemetry']=if ($Options.DisableANOWObserve) { 'true' } else { $null } }
    if ($Options.ContainsKey('OpenTelemetryExporterType')) { $configuration['openTelemetryExporterType']=[string]$Options.OpenTelemetryExporterType }
    foreach ($name in @('openTelemetryLogCollectorEndpoint','openTelemetryTraceCollectorEndpoint','openTelemetryCollectorEndpoint')) {
        if (([string]$Options[$name]).Length -gt 0) { $configuration[$name]=$Options[$name] }
        elseif ($Options['Unset'+$name] -eq $true) { $configuration[$name]=$null }
    }
    if ($Options.MaxLogSize -gt 0) { $configuration['maxLogSize']=$Options.MaxLogSize }
    elseif ($Options.UnsetMaxLogSize -eq $true) { $configuration['maxLogSize']=$null }
    if ($Options.RemoveAllAdditionalLoggers -eq $true) { $configuration.Remove('additionalLoggers') }
    elseif (($null -ne $Options.RemoveAdditionalLoggers -and @($Options.RemoveAdditionalLoggers).Count -gt 0) -or
            ($null -ne $Options.AddAdditionalLoggers -and @($Options.AddAdditionalLoggers).Count -gt 0)) {
        $loggers=@($configuration.additionalLoggers | Where-Object { $null -ne $_ })
        foreach ($name in $Options.RemoveAdditionalLoggers) {
            if ($name -notin @($loggers | ForEach-Object { $_.logger })) { throw 'The selected additional logger does not exist.' }
            $loggers=@($loggers | Where-Object { $_.logger -ne $name })
        }
        foreach ($logger in $Options.AddAdditionalLoggers) {
            if ($null -eq $logger -or $logger.Count -ne 2 -or -not $logger.ContainsKey('logger') -or -not $logger.ContainsKey('level') -or
                $logger.logger -isnot [string] -or $logger.logger.Length -eq 0 -or $logger.level -isnot [string] -or
                $logger.level -notin @('ERROR','WARN','INFO','DEBUG','TRACE')) { throw 'Additional loggers require exactly nonempty logger and supported level string fields.' }
            if ($logger.logger -in @($loggers | ForEach-Object { $_.logger })) { throw 'An additional logger name already exists; remove it explicitly before adding a replacement.' }
            $loggers+=,(Copy-ANOWPreservationValue $logger)
        }
        if ($loggers.Count -eq 0) { $configuration.Remove('additionalLoggers') }
        else { $configuration['additionalLoggers']=$loggers }
    }
    return ($configuration | ConvertTo-Json -Compress -Depth 100 -ErrorAction Stop -WarningAction Stop)
}

Function New-ANOWPreservedActionDefinition {
    [CmdletBinding()]
    param([ANOWProcessingAction]$Target,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    $definition=Copy-ANOWPreservationValue $Target.ruleDefinition
    if ($null -eq $definition) { $definition=[ordered]@{} }
    if ($definition -isnot [Collections.IDictionary]) { throw 'The stored RuntimeAction ruleDefinition must be an object or null.' }
    foreach ($entry in @(@('ProcessingType','processingType'),@('ProcessingTemplateOperator','processingTemplateOperator'),@('ParentProcessingTemplateOperator','parentTemplateOperator'),@('ServerNodeOperator','nodeOperator'),@('TagOperator','tagOperator'),@('Folder','folder'))) {
        if (([string]$Options[$entry[0]]).Length -gt 0) { $definition[$entry[1]]=$Options[$entry[0]] }
        elseif ($Options['Unset'+$entry[0]] -eq $true) { $definition[$entry[1]]=$null }
    }
    if (([string]$Options.ProcessingType).Length -eq 0 -and
        ($Options.ContainsKey('TaskType') -or $Options.ContainsKey('WorkflowType') -or $Options.ContainsKey('ServiceType'))) { $definition['processingType']=[string]$Target.processingType }
    foreach ($entry in @(@('ProcessingTemplate','processingTemplate'),@('ParentProcessingTemplate','parentTemplate'),@('ServerNode','node'))) {
        if (([string]$Options[$entry[0]].id).Length -gt 0) { $definition[$entry[1]]=$Options[$entry[0]].id }
        elseif ($Options['Unset'+$entry[0]] -eq $true) { $definition[$entry[1]]=$null }
    }
    if ($Options.ContainsKey('NodeType')) { $definition['serverNodeType']=[string]$Options.NodeType }
    elseif ($Options.UnsetNodeType -eq $true) { $definition['serverNodeType']=$null }
    if (([string]$Options.ServerNode.id).Length -gt 0 -and ([string]$definition.serverNodeType).Length -gt 0 -and
        [string]$Options.ServerNode.serverNodeType -cne [string]$definition.serverNodeType) { throw 'The Server Node does not match the selected node type.' }
    if ($null -ne $Options.Tags -and @($Options.Tags).Count -gt 0) { $definition['tags']=Copy-ANOWPreservationValue $Options.Tags }
    elseif ($Options.UnsetTags -eq $true) { $definition['tags']=$null }
    return ($definition | ConvertTo-Json -Compress -Depth 100 -ErrorAction Stop -WarningAction Stop)
}

Function New-ANOWPreservationRequest {
    [CmdletBinding()]
    param([string]$Kind,[object]$Target,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    $lookupId=if ($Kind -ceq 'RuntimeAction') { $Target.id } else { $Target.simpleId }
    $identity=if ($Kind -ceq 'RuntimeAction') { 'id' } else { 'simpleId' }
    $null=Get-ANOWPreservationObject -Kind $Kind -Id $lookupId -IdentityProperty $identity -Target $Target
    $metadata=[ordered]@{id=$Target.id}
    foreach ($name in @('description','folder')) {
        if (([string]$Options[$name]).Length -gt 0) {
            if ($name -ceq 'folder') {
                $folder=Get-ANOWPreservationObject -Kind Folder -Id $Options.Folder
                if ($Kind -ceq 'ServiceManagerTemplate') { $metadata[$name]=$folder.id } else { $metadata[$name]=$Options[$name] }
            } else { $metadata[$name]=$Options[$name] }
        } elseif ($Options['Unset'+$name] -eq $true) { $metadata[$name]=$null }
    }
    if (([string]$Options.CodeRepository.id).Length -gt 0) {
        $null=Get-ANOWPreservationObject -Kind CodeRepository -Id $Options.CodeRepository.id -IdentityProperty id -Target $Options.CodeRepository
        $metadata['codeRepository']=$Options.CodeRepository.id
    } elseif ($Options.UnsetCodeRepository -eq $true) { $metadata['codeRepository']=$null }
    if ($null -ne $Options.Tags -and @($Options.Tags).Count -gt 0) {
        $ordinal=1
        foreach ($tag in $Options.Tags) {
            $null=Get-ANOWPreservationObject -Kind Tag -Id $tag
            if ($Kind -cne 'RuntimeAction') { $metadata['tags'+$ordinal]=$tag; $ordinal++ }
        }
    } elseif ($Kind -cne 'RuntimeAction' -and $Options.UnsetTags -eq $true) { $metadata['tags']=$null }
    $advisories=@()
    switch ($Kind) {
        ServiceManagerTemplate {
            $bareSla=$Target -is [ANOWServiceManagerTemplate] -and
                [string]$Target.processingType -ceq 'SERVICE' -and
                [string]$Target.serviceType -ceq 'SERVICE_MANAGER' -and
                [string]$Target.serviceManagerType -ceq 'SLA_SERVICE_MANAGER' -and
                $null -eq $Target.processingCommand
            if ($bareSla) {
                foreach ($key in @('ProcessingTemplate','UnsetProcessingTemplate','RunMode','RunInterval','RunTimes','RunFor','RunTimeOfDay','RunTimeZone','RunOffSet')) {
                    if ($Options.ContainsKey($key)) { throw 'Command or run settings require an existing supported Service Manager command.' }
                }
            } else {
                $metadata['processingCommand']=New-ANOWPreservedServiceCommand -Target $Target -Options $Options
            }
            foreach ($entry in @(@('Title','title'),@('DelayedStartTime','delayedStartTime'),@('Owner','owner'))) {
                if (([string]$Options[$entry[0]]).Length -gt 0) { $metadata[$entry[1]]=$Options[$entry[0]] }
                elseif ($Options['Unset'+$entry[0]] -eq $true) { $metadata[$entry[1]]=$null }
            }
            foreach ($entry in @(@('ResultMapping','resultMapping'),@('Calendar','calendar'),@('Approval','approvalConfiguration'))) {
                if (($entry[0] -ceq 'ResultMapping' -and ([string]$Options[$entry[0]].simpleId).Length -gt 0) -or ($entry[0] -cne 'ResultMapping' -and ([string]$Options[$entry[0]].id).Length -gt 0)) {
                    $selected=$Options[$entry[0]]
                    $null=Get-ANOWPreservationObject -Kind $entry[0] -Id $selected.simpleId -Target $selected
                    $metadata[$entry[1]]=$selected.simpleId
                } elseif ($Options['Unset'+$entry[0]] -eq $true) { $metadata[$entry[1]]=$null }
            }
            if (([string]$Options.TimeZone.id).Length -gt 0) { $metadata['timeZone']=$Options.TimeZone.id }
            elseif ($Options.UnsetTimeZone -eq $true) { $metadata['timeZone']=$null }
            foreach ($name in @('priority','weight')) { if ($Options.ContainsKey($name) -and $Options[$name] -ge 0) { $metadata[$name]=$Options[$name] } }
            if ($null -ne $Options.MaxSimultaneousExecutions) { $metadata['maxSimultaneousExecutions']=$Options.MaxSimultaneousExecutions }
            elseif ($Options.UnsetMaxSimultaneousExecutions -eq $true) { $metadata['maxSimultaneousExecutions']=$null }
            foreach ($entry in @(@('Hold','onHold'),@('Skip','passBy'),@('IgnoreProcessingRegistry','ignoreProcessingStateRegistry'),@('VerboseMode','verboseMode'),@('AutoArchive','autoArchive'),@('KeepResources','keepResourcesOnFailure'),@('UseScripts','useScripts'),@('EagerScriptExecution','eagerScriptExecution'))) {
                if ($null -ne $Options[$entry[0]]) { $metadata[$entry[1]]=([string][bool]$Options[$entry[0]]).ToLowerInvariant() }
            }
            if ($Options.ContainsKey('statisticalDuration')) { $metadata['statisticalDuration']=$Options.statisticalDuration }
            $command='/processingTemplate/update';$component='ProcessingTemplateValuesManager';$dataSource='ProcessingTemplateDataSource'
        }
        Agent {
            if ($Options.ResetConfig -eq $true) { $metadata['configuration']=$null }
            else {
                $configEdits=@('LogLevel','LogMaxFiles','AgentHeartbeat','DisableANOWObserve','OpenTelemetryExporterType','OpenTelemetryLogCollectorEndpoint','UnsetOpenTelemetryLogCollectorEndpoint','OpenTelemetryTraceCollectorEndpoint','UnsetOpenTelemetryTraceCollectorEndpoint','OpenTelemetryCollectorEndpoint','UnsetOpenTelemetryCollectorEndpoint','MaxLogSize','UnsetMaxLogSize','AddAdditionalLoggers','RemoveAdditionalLoggers','RemoveAllAdditionalLoggers')
                if ($null -ne $Target.configuration -or (Test-ANOWPreservationEdit -Options $Options -Names $configEdits)) { $metadata['configuration']=New-ANOWPreservedAgentConfiguration -Target $Target -Options $Options }
            }
            $command='/agent/update';$component='AgentEditForm';$dataSource='AgentDataSource'
        }
        RuntimeAction {
            # Folder belongs inside the rule definition, not on the action envelope.
            $metadata.Remove('folder')
            foreach ($entry in @(@('simpleId','simpleId'),@('StartDate','ruleStartDate'),@('EndDate','ruleEndDate'),@('StepName','subTask'),@('StepOperator','subTaskOperator'),@('StepReturnCode','subTaskReturnCode'))) {
                if (([string]$Options[$entry[0]]).Length -gt 0) { $metadata[$entry[1]]=$Options[$entry[0]] }
                elseif ($Options['Unset'+$entry[0]] -eq $true) { $metadata[$entry[1]]=$null }
            }
            if (([string]$Options.Calendar.id).Length -gt 0) { $null=Get-ANOWPreservationObject -Kind Calendar -Id $Options.Calendar.simpleId -Target $Options.Calendar; $metadata['ruleCalendar']=$Options.Calendar.simpleId }
            elseif ($Options.UnsetCalendar -eq $true) { $metadata['ruleCalendar']=$null }
            if ($null -ne $Options.ActionOrder) { $metadata['processingActionOrder']=$Options.ActionOrder }
            elseif ($Options.UnsetActionOrder -eq $true) { $metadata['processingActionOrder']=$null }
            if ($null -ne $Options.Skip) { $metadata['skip']=([string][bool]$Options.Skip).ToLowerInvariant() }
            foreach ($name in @('TaskType','WorkflowType','ServiceType')) {
                if ($Options.ContainsKey($name)) { $metadata[$name]=[string]$Options[$name] }
                elseif ($Options['Unset'+$name] -eq $true) { $metadata[$name]=$null }
            }
            $ruleEdits=@('ProcessingType','UnsetProcessingType','TaskType','WorkflowType','ServiceType','ProcessingTemplateOperator','ProcessingTemplate','UnsetProcessingTemplate','ParentProcessingTemplateOperator','ParentProcessingTemplate','UnsetParentProcessingTemplate','ServerNodeOperator','NodeType','UnsetNodeType','ServerNode','UnsetServerNode','TagOperator','UnsetTagOperator','Folder','UnsetFolder','Tags','UnsetTags')
            if ($null -ne $Target.ruleDefinition -or (Test-ANOWPreservationEdit -Options $Options -Names $ruleEdits)) { $metadata['ruleDefinition']=New-ANOWPreservedActionDefinition -Target $Target -Options $Options }
            if ($Options.ContainsKey('StepConditionMode')) { $metadata['subTaskConditionMode']=[string]$Options.StepConditionMode }
            elseif ($Options.UnsetStepConditionMode -eq $true) { $metadata['subTaskConditionMode']=$null }
            foreach ($entry in @(@('EventCondition','condition'),@('StepCondition','subTaskCondition'))) {
                if ($null -ne $Options[$entry[0]]) { $metadata[$entry[1]]=$Options[$entry[0]] | ConvertTo-Json -Compress -Depth 100 -ErrorAction Stop -WarningAction Stop }
                elseif ($Options['Unset'+$entry[0]] -eq $true) { $metadata[$entry[1]]=$null }
            }
            if ($Options.UnsetTagOperator -eq $true -and @($Target.ruleDefinition.tags).Count -gt 0 -and $null -ne $Target.ruleDefinition.tags -and $Options.UnsetTags -ne $true) { $advisories+= 'The Tag Operator was cleared; existing tag selections remain stored.' }
            $command='/processingAction/update';$component='ProcessingRuleVM';$dataSource='ProcessingActionDataSource'
        }
        default { throw 'Unsupported preservation handler.' }
    }
    $metadata['_oldValues']=$Target.CreateOldValues()
    $metadata['_operationType']='update';$metadata['_textMatchStyle']='exact';$metadata['_componentId']=$component;$metadata['_dataSource']=$dataSource
    $metadata['isc_metaDataPrefix']='_';$metadata['isc_dataFormat']='json'
    $serialized=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$metadata}
    if (-not $serialized.Succeeded -or @($serialized.Data).Count -ne 1 -or $serialized.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($serialized.Data[0])) { throw 'The update form was not cleanly serialized.' }
    return [pscustomobject]@{Command=$command;Body=$serialized.Data[0];Advisories=$advisories}
}

Function Test-ANOWPreservationAcknowledgment {
    param([object[]]$Envelopes)
    if ($Envelopes.Count -ne 1 -or $null -eq $Envelopes[0] -or $null -eq $Envelopes[0].response -or
        $Envelopes[0].response -is [array]) { return $false }
    $status=$Envelopes[0].response.status
    return (($status -is [int] -or $status -is [long]) -and $status -eq 0)
}

Function ConvertFrom-ANOWPreservationResponse {
    [CmdletBinding()]
    param([string]$Kind,[object[]]$Envelopes,[object]$Target,[hashtable]$Options)
    $ErrorActionPreference='Stop'
    $rows=@($Envelopes[0].response.data)
    if ($rows.Count -ne 1 -or $null -eq $rows[0]) { throw 'Exactly one full returned object is required.' }
    $row=$rows[0]
    $type=switch ($Kind) { ServiceManagerTemplate { [ANOWServiceManagerTemplate] } TaskTemplate { [ANOWTaskTemplate] } WorkflowTemplate { [ANOWWorkflowTemplate] } default { [ANOWProcessingAction] } }
    if ($row -isnot [Collections.IDictionary] -and $row -isnot [Management.Automation.PSCustomObject] -and -not $type.IsInstanceOfType($row)) { throw 'A strict returned object is required.' }
    $expectedSimpleId=if ($Kind -ceq 'RuntimeAction' -and ([string]$Options.simpleId).Length -gt 0) { $Options.simpleId } else { $Target.simpleId }
    if (-not [string]::Equals($row.id,$Target.id,[StringComparison]::Ordinal) -or
        -not [string]::Equals($row.simpleId,$expectedSimpleId,[StringComparison]::Ordinal)) { throw 'The returned identity does not match the update.' }
    if (-not [string]::IsNullOrEmpty($Target.domain) -and -not [string]::Equals($row.domain,$Target.domain,[StringComparison]::Ordinal)) { throw 'The returned domain does not match the update.' }
    if ($Kind -ceq 'ServiceManagerTemplate' -and ([string]([ANOWProcessingTemplate_processingType]$row.processingType) -cne 'SERVICE' -or [string]([ANOWProcessingTemplate_serviceType]$row.serviceType) -cne [string]$Target.serviceType)) { throw 'The returned Service Manager type was not verified.' }
    if ($Kind -cin @('TaskTemplate','WorkflowTemplate')) {
        $family=if ($Kind -ceq 'TaskTemplate') { 'TASK' } else { 'WORKFLOW' }
        $subtype=if ($Kind -ceq 'TaskTemplate') { 'taskType' } else { 'workflowType' }
        if ($row.id -isnot [string] -or $row.simpleId -isnot [string] -or $null -eq $row.processingType -or
            [string]([ANOWProcessingTemplate_processingType]$row.processingType) -cne $family) { throw 'The returned template family/identity was not verified.' }
        if ($null -ne $Target.$subtype) {
            $subtypeType=if ($Kind -ceq 'TaskTemplate') { [ANOWProcessingTemplate_taskType] } else { [ANOWProcessingTemplate_workflowType] }
            if ($null -eq $row.$subtype -or [string]([Management.Automation.LanguagePrimitives]::ConvertTo($row.$subtype,$subtypeType)) -cne [string]$Target.$subtype) { throw 'The returned template subtype was not verified.' }
        }
    }
    $allowed=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($property in $type.GetProperties()) { $null=$allowed.Add($property.Name) }
    $names=if ($row -is [Collections.IDictionary]) { @($row.Keys) } else { @($row.PSObject.Properties.Name) }
    foreach ($name in $names) { if ($name -isnot [string] -or -not $allowed.Contains($name)) { throw 'The returned object has an unsupported member.' } }
    if ($Kind -ceq 'ServiceManagerTemplate') { return [ANOWServiceManagerTemplate]$row }
    if ($Kind -ceq 'TaskTemplate') { return [ANOWTaskTemplate]$row }
    if ($Kind -ceq 'WorkflowTemplate') { return [ANOWWorkflowTemplate]$row }
    return [ANOWProcessingAction]$row
}


Function Set-AutomateNOWAgent {
    <#
    .SYNOPSIS
    Changes the settings of an Agent on an AutomateNOW! instance

    .DESCRIPTION
    Changes stored Agent settings while preserving unselected configuration fields
    and additional loggers. Each input is independent and caller objects are unchanged.
    A clean acknowledgment and one matching strict readback are required, including
    with Quiet. Uncertain diagnostics stop later inputs without retry.

    .PARAMETER Agent
    An [ANOWAgent] object representing the Agent to be modified.

    .PARAMETER Description
    Optional string to set the description on the new Agent object.

    .PARAMETER UnsetDescription
    Optional switch that will remove the Description from the Agent object.

    .PARAMETER Tags
    Optional string array of CASE-SENSITIVE Tag Id's to set on the new Agent object.

    .PARAMETER UnsetTags
    Optional switch that will remove the Tags from the Agent object.

    .PARAMETER Folder
    Optional string to set a different folder on the Agent object.

    .PARAMETER UnsetFolder
    Optional switch that will remove the Folder assignment from the Agent object.

    .PARAMETER CodeRepository
    Optional Code Repository to place the Agent into. Use Get-AutomateNOWCodeRepository to fetch this object.

    .PARAMETER UnsetCodeRepository
    Switch parameter that will remove the Agent from its Code Repository.

    .PARAMETER logLevel
    A string representing the level of verbosity for the Agent log. Valid choices are: 'ERROR', 'WARN', 'INFO', 'DEBUG', 'TRACE'

    .PARAMETER logMaxFiles
    An int64 representing the number of days an agent log file will be kept at the operating system level. This value must be at least 1.

    .PARAMETER AgentHeartBeat
    An int64 representing the interval -> in milliseconds <- between heartbeat messages sent by the Agent to the AutomateNOW! server. This must be at least 1000.

    .PARAMETER DisableANOWObserve
    A nullable boolean that will either disable or enable the 'ANOW! Observe' feature

    .PARAMETER OpenTelemetryExporterType
    Optional open telemetry exporter type. The three options are: HTTP*, GPRC and ANOW.

    .PARAMETER OpenTelemetryLogCollectorEndpoint
    Optional string containing the open telemetry log collector endpoint

    .PARAMETER UnsetOpenTelemetryLogCollectorEndpoint
    Switch parameter that unsets (removes) the open telemetry log collector endpoint

    .PARAMETER OpenTelemetryTraceCollectorEndpoint
    Optional string containing the open telemetry trace collector endpoint

    .PARAMETER UnsetOpenTelemetryTraceCollectorEndpoint
    Switch parameter that unsets (removes) the string containing the open telemetry trace collector endpoint

    .PARAMETER OpenTelemetryCollectorEndpoint
    Optional string containing the open telemetry metric collector endpoint

    .PARAMETER UnsetOpenTelemetryCollectorEndpoint
    Switch parameter that unsets (removes) the string containing the open telemetry metric collector endpoint

    .PARAMETER MaxLogSize
    An int32 "MaxLog Size for Preview". This setting is not documented or explained anywhere.

    .PARAMETER UnsetMaxLogSize
    A switch parameter to unset the "MaxLog Size for Preview".

    .PARAMETER AddAdditionalLoggers
    Hashtables with exactly level and logger string fields to append in order.
    Existing loggers are retained. Duplicate names are case-insensitive and refused;
    explicitly remove a logger before adding a replacement of the same name.

    .PARAMETER RemoveAdditionalLoggers
    A string array containing the names of the Additional Loggers to remove.

    .PARAMETER RemoveAllAdditionalLoggers
    Removes the additionalLoggers property from the submitted configuration.
    Removing the last named logger uses the same omission shape.

    .PARAMETER ResetConfig
    Sets the Agent configuration to its default values. This parameter cannot be combined with any of the 'SetConfig' parameters.

    .PARAMETER NoWarning
    A switch parameter that suppresses the warning about pushing the Agent configuration after making a change to it.

    .PARAMETER Force
    Force the change without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter that silences the output of the updated object.

    .INPUTS
    ONLY [ANOWAgent] objects are accepted (including from the pipeline)

    .OUTPUTS
    The updated [ANOWAgent] object will be returned

    .EXAMPLE
    Unsets the description, tags and folder while also resetting the config to the default options on an Agent named 'Agent1' (one-liner)

    Get-AutomateNOWAgent -Id 'Agent1' | Set-AutomateNOWAgent -UnsetDescription -UnsetTags -UnsetFolder -ResetConfig

    .EXAMPLE
    Forcibly sets all of the available options (one-liner)

    Get-AutomateNOWAgent -Id 'Agent1' | Set-AutomateNOWAgent -Description 'Description' -Folder 'Folder1' -Tags 'Tag1', 'Tag2' -CodeRepository (Get-AutomateNOWCodeRepository -Id 'CodeRepository1') -LogLevel DEBUG -logMaxFiles 10 -AgentHeartbeat 900000 -DisableANOWObserve $false -OpenTelemetryExporterType 'HTTP' -OpenTelemetryLogCollectorEndpoint 'OpenTelemetryLogCollectorEndpoint' -OpenTelemetryTraceCollectorEndpoint 'OpenTelemetryTraceCollectorEndpoint' -OpenTelemetryCollectorEndpoint 'OpenTelemetryCollectorEndpoint' -MaxLogSize 1024 -Force

    .EXAMPLE
    Adds two additional loggers named 'Logger1' and 'Logger2' to an Agent named 'Agent1' (multi-line)

    $agent = Get-AutomateNOWAgent -Id 'Agent1'
    $agent | Set-AutomateNOWAgent -AddAdditionalLoggers @(@{ 'level' = 'WARN'; 'logger' = 'Logger1'}, @{ 'level' = 'ERROR'; 'logger' = 'Logger2'})

    .EXAMPLE
    Quietly removes two additional loggers named 'Logger1' and 'Logger2' from an Agent named 'Agent1' (multi-line)

    $agent = Get-AutomateNOWAgent -Id 'Agent1'
    $agent | Set-AutomateNOWAgent -RemoveAdditionalLoggers 'Logger1', 'Logger2' -Quiet

    .EXAMPLE
    Forcefully and quietly removes all additional loggers from an Agent named 'Agent1' (multi-line)

    $agent = Get-AutomateNOWAgent -Id 'Agent1'
    $agent | Set-AutomateNOWAgent -RemoveAllAdditionalLoggers -Quiet -Force

    .EXAMPLE
    Changes the stored log level while preserving other configuration and suppressing the push advisory (one-liner)

    Get-AutomateNOWAgent -Id 'Agent1' | Set-AutomateNOWAgent -LogLevel DEBUG -NoWarning -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The export type HTTP is shown in the UI as "HTTP/S"

    This command does not push configuration or perform an Agent action. Applying
    stored settings to an Agent is a separate explicit operation. ResetConfig sends
    a null configuration; ordinary edits preserve all unselected fields and absence.
    A failed readback after acknowledgment does not undo the write. Quiet retains
    validation. Force respects WhatIf and an explicit confirmation decision.

    #>
    [OutputType([ANOWAgent])]
    [CmdletBinding(SupportsShouldProcess, DefaultParameterSetName = 'ResetConfig', ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $True)]
        [ANOWAgent]$Agent,
        [Parameter(Mandatory = $false)]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetDescription,
        [Parameter(Mandatory = $false)]
        [string[]]$Tags,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetTags,
        [Parameter(Mandatory = $false)]
        [string]$Folder,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetFolder,
        [Parameter(Mandatory = $false)]
        [ANOWCodeRepository]$CodeRepository,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetCodeRepository,
        [ValidateSet( 'ERROR', 'WARN', 'INFO', 'DEBUG', 'TRACE', IgnoreCase = $false )]
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [string]$LogLevel,
        [ValidateScript({ $_ -ge 1 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [int64]$LogMaxFiles,
        [ValidateScript({ $_ -ge 1000 })]
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [int64]$AgentHeartbeat,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [nullable[boolean]]$DisableANOWObserve,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [ANOWAgent_openTelemetryExporterType]$OpenTelemetryExporterType,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [string]$OpenTelemetryLogCollectorEndpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [switch]$UnsetOpenTelemetryLogCollectorEndpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [string]$OpenTelemetryTraceCollectorEndpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [switch]$UnsetOpenTelemetryTraceCollectorEndpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [string]$OpenTelemetryCollectorEndpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [switch]$UnsetOpenTelemetryCollectorEndpoint,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [int32]$MaxLogSize,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [switch]$UnsetMaxLogSize,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [hashtable[]]$AddAdditionalLoggers,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [string[]]$RemoveAdditionalLoggers,
        [Parameter(Mandatory = $false, ParameterSetName = 'SetConfig')]
        [switch]$RemoveAllAdditionalLoggers,
        [Parameter(Mandatory = $false, ParameterSetName = 'ResetConfig')]
        [switch]$ResetConfig,
        [Parameter(Mandatory = $false)]
        [switch]$NoWarning,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        $preservationStopped=$false
        $options=@{}
        foreach ($key in $PSBoundParameters.Keys) { $options[$key]=$PSBoundParameters[$key] }
        if ($Force -and $PSBoundParameters.ContainsKey('Confirm') -and $PSBoundParameters['Confirm']) { $Force=$false }
        if (-not (Confirm-ANOWPreservationSession)) {
            $preservationStopped=$true
            Write-Warning -Message 'Set-AutomateNOWAgent stopped at [session]; no update was submitted.'
        } elseif (-not (Test-ANOWPreservationValidation -Kind 'Agent' -Options $options)) {
            $preservationStopped=$true
            Write-Warning -Message 'Set-AutomateNOWAgent stopped at [options]; no update was submitted.'
        }
    }
    Process {
        if (-not $preservationStopped) {
            $dispatched=$false; $acknowledged=$false; $failed=$false; $stage='input validation'
            do {
                if (-not (Test-ANOWPreservationValidation -Kind 'Agent' -Target $Agent -Options $options)) { $failed=$true; break }
                If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess($Agent.id)) -eq $true) {
                    $stage='prerequisite/preparation'
                    $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWPreservationRequest) -OperationParameters @{Kind='Agent';Target=$Agent;Options=$options}
                    if (-not $prepared.Succeeded -or @($prepared.Data).Count -ne 1) { $failed=$true; break }
                    $request=$prepared.Data[0]
                    foreach ($advisory in $request.Advisories) { Write-Warning -Message $advisory }
                    $parameters=@{Command=$request.Command;Body=$request.Body;Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8'}
                    if ($anow_session.NotSecure -eq $true) { $parameters['NotSecure']=$true }
                    $stage='API';$dispatched=$true
                    $result=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
                    if (-not $result.Succeeded) { $failed=$true; break }
                    $stage='acknowledgment'
                    if (-not (Test-ANOWPreservationAcknowledgment -Envelopes $result.Data)) { $failed=$true; break }
                    $acknowledged=$true
                    $stage='readback'
                    $readback=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-ANOWPreservationObject) -OperationParameters @{Kind='Agent';Id=$Agent.simpleId;Target=$Agent}
                    if (-not $readback.Succeeded -or @($readback.Data).Count -ne 1) { $failed=$true; break }
                    $updated=$readback.Data[0]
                    Write-Verbose -Message "Agent object [$($Agent.id)] was successfully updated"
                    if (-not $NoWarning) { Write-Warning -Message "After making a change to Agent settings, you need to push the configuration with Send-AutomateNOWAgentConfiguration" }
                    if (-not $Quiet) { $updated }
                }
            } while ($false)
            if ($failed) {
                $preservationStopped=$true
                $effect=if ($acknowledged) { 'The write was acknowledged; its result/readback was not verified.' } elseif ($dispatched) { 'The write may have occurred; its outcome was not verified.' } else { 'No update was submitted.' }
                Write-Warning -Message "Set-AutomateNOWAgent stopped at [$stage]. $effect No retry or rollback was attempted."
            }
        }
    }
}

Function Export-AutomateNOWAgent {
    <#
    .SYNOPSIS
    Exports the Agents from an instance of AutomateNOW!

    .DESCRIPTION
    Exports the Agents from an instance of AutomateNOW! to a local .csv file

    .PARAMETER Agent
    Mandatory [ANOWAgent] object (Use Get-AutomateNOWAgent to retrieve them)

    .INPUTS
    ONLY [ANOWAgent] objects from the pipeline are accepted

    .OUTPUTS
    The [ANOWAgent] objects are exported to the local disk in CSV format

    .EXAMPLE
    Get-AutomateNOWAgent | Export-AutomateNOWAgent

    .EXAMPLE
    Get-AutomateNOWAgent -Id 'Agent01' | Export-AutomateNOWAgent

    .EXAMPLE
    @( 'Agent01', 'Agent02' ) | Get-AutomateNOWAgent | Export-AutomateNOWAgent

    .EXAMPLE
    Get-AutomateNOWAgent | Where-Object { $_.simpleId -eq 'Agent01' } | Export-AutomateNOWAgent

    .NOTES
    Supply a named [ANOWAgent] object or pipe one or more objects.
    #>

    [CmdletBinding(DefaultParameterSetName = 'Pipeline')]
    Param(
        [Parameter(Mandatory = $true, ValueFromPipeline = $true, ParameterSetName = 'Pipeline')]
        [ANOWAgent]$Agent
    )
    Begin {
        [string]$current_time = Get-Date -Format 'yyyyMMddHHmmssfff'
        [string]$ExportFileName = 'Export-AutomateNOW-Agents-' + $current_time + '.csv'
        [string]$ExportFilePath = ((Get-Location | Select-Object -ExpandProperty Path) + '\' + $ExportFileName)
        [hashtable]$parameters = @{}
        $parameters.Add('Path', $ExportFilePath)
        $parameters.Add('Append', $true)
        If ($PSVersionTable.PSVersion.Major -eq 5) {
            $parameters.Add('NoTypeInformation', $true)
        }
    }
    Process {

        $Error.Clear()
        Try {
            $Agent | Export-CSV @parameters -ErrorAction Stop
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Export-CSV failed to export the [ANOWAgent] objects on the pipeline due to [$Message]"
            Break
        }
    }
    End {
        $Error.Clear()
        If ((Test-Path -Path $ExportFilePath) -eq $true) {
            [System.IO.FileInfo]$fileinfo = Get-Item -Path "$ExportFilePath"
            [int32]$filelength = $fileinfo.Length
            [string]$filelength_display = "{0:N0}" -f $filelength
            Write-Information -MessageData "Created file $ExportFileName ($filelength_display bytes)"
        }
    }
}

Function New-AutomateNOWAgent {
    <#
    .SYNOPSIS
    Creates a Agent within an AutomateNOW! instance

    .DESCRIPTION
    Creates a Agent within an AutomateNOW! instance and returns back the newly created [ANOWAgent] object

    .PARAMETER Id
    The intended name of the Agent. For example: 'Agent01'. This value may not contain the domain in brackets.

    .PARAMETER Description
    Optional description of the Agent (may not exceed 255 characters).

    .PARAMETER Tags
    Optional string array containing the CASE-SENSITIVE id's of the tags to assign to the new Agent. Do not pass [ANOWTag] objects here.

    .PARAMETER Folder
    Optional name of the folder to place the Agent into.

    .PARAMETER CodeRepository
    Optional name of the code repository to place the Agent into.

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly created object

    .INPUTS
    None. You cannot pipe objects to New-AutomateNOWAgent.

    .OUTPUTS
    An [ANOWAgent] object representing the newly created Agent

    .EXAMPLE
    Creates a new Agent named 'Agent1' with a description, two tags, a folder and a code repository.

    New-AutomateNOWAgent -Id 'Agent1' -Description 'Description1' -Tags 'Tag1', 'Tag2' -Folder 'Folder1' -CodeRepository 'CodeRepository1'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    The name (id) of the Agent must be unique (per domain). It may consist only of letters, numbers, underscore, dot or hyphen.

    #>
    [OutputType([ANOWAgent])]
    [CmdletBinding()]
    Param(
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,}$' })]
        [Parameter(Mandatory = $true)]
        [string]$Id,
        [Parameter(Mandatory = $false, HelpMessage = "Enter a descriptive string up to 255 characters (UTF8 compatible)")]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [string[]]$Tags,
        [Parameter(Mandatory = $false)]
        [string]$Folder,
        [Parameter(Mandatory = $false)]
        [ANOWCodeRepository]$CodeRepository,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
        Write-Warning -Message "There is not a valid token confirmed."
        Break
    }
    ## Begin warning ##
    ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
    $Error.Clear()
    Try {
        [boolean]$Agent_exists = ($null -ne (Get-AutomateNOWAgent -Id $Id))
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Get-AutomateNOWAgent failed to check if the Agent [$Id] already existed due to [$Message]."
        Break
    }
    If ($Agent_exists -eq $true) {
        [string]$current_domain = $anow_session.header.domain
        Write-Warning -Message "There is already an Agent named [$Id] in [$current_domain]."
        Break
    }
    ## End warning ##
    [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
    $BodyMetaData.Add('id', $Id)
    If ($Description.Length -gt 0) {
        $BodyMetaData.Add('description', $Description)
    }
    If ($Tags.Count -gt 0) {
        [int32]$current_tag = 1
        ForEach ($tag_id in $Tags) {
            $Error.Clear()
            Try {
                [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] running under New-AutomateNOWAgent due to [$Message]"
                Break
            }
            If ($tag_object.simpleId.length -eq 0) {
                Throw "New-AutomateNOWAgent has detected that the tag [$tag_id] does not appear to exist."
            }
            ElseIf (($tag_object.simpleId -eq $tag_id) -and ($tag_object.simpleId -cne $tag_id)) {
                [string]$tag_object_simpleId = $tag_object.simpleId
                Throw "Wait! Tags are case-sensitive. [$tag_object_simpleId] is not the same case as [$tag_id]. Please check more carefully..."
            }
            [string]$tag_name_sequence = ('tags' + $current_tag)
            $BodyMetaData.Add($tag_name_sequence, $tag_id)
            $current_tag++
        }
    }
    If ($Folder.Length -gt 0) {
        $Error.Clear()
        Try {
            [ANOWFolder]$folder_object = Get-AutomateNOWFolder -Id $Folder
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWFolder failed to confirm that the folder [$Folder] existed under New-AutomateNOWAgent due to [$Message]"
            Break
        }
        If ($folder_object.simpleId.Length -eq 0) {
            Throw "Get-AutomateNOWFolder failed to locate the Folder [$Folder] under New-AutomateNOWAgent."
        }
        [string]$folder_display = $folder_object | ConvertTo-JSON -Compress -Depth 100
        Write-Verbose -Message "Adding folder $folder_display to [ANOWAgent] [$Id]"
        $BodyMetaData.Add('folder', $Folder)
    }
    If ($CodeRepository.id.Length -gt 0) {
        [string]$CodeRepository_Id = $CodeRepository.id
        $Error.Clear()
        Try {
            [ANOWCodeRepository]$code_repository_object = Get-AutomateNOWCodeRepository -Id $CodeRepository_Id
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWCodeRepository failed to confirm that the code repository [$CodeRepository_Id] existed under New-AutomateNOWAgent due to [$Message]"
            Break
        }
        If ($code_repository_object.simpleId.Length -eq 0) {
            Throw "Get-AutomateNOWCodeRepository failed to locate the Code Repository [$CodeRepository_Id] under New-AutomateNOWAgent."
        }
        Write-Verbose -Message "Adding Agent [$Id] to Code Repository $CodeRepository_Id"
        $BodyMetaData.Add('codeRepository', $CodeRepository_Id)
    }
    $BodyMetaData.'_textMatchStyle' = 'exact'
    $BodyMetaData.'_operationType' = 'add'
    $BodyMetaData.'_oldValues' = '{}'
    $BodyMetaData.'_componentId' = 'AgentCreateWindow_form'
    $BodyMetaData.'_dataSource' = 'AgentDataSource'
    $BodyMetaData.'isc_metaDataPrefix' = '_'
    $BodyMetaData.'isc_dataFormat' = 'json'
    [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
    [string]$command = '/Agent/create'
    [hashtable]$parameters = @{}
    $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
    $parameters.Add('Command', $command)
    $parameters.Add('Method', 'POST')
    $parameters.Add('Body', $Body)
    If ($anow_session.NotSecure -eq $true) {
        $parameters.Add('NotSecure', $true)
    }
    [string]$parameters_display = $parameters | ConvertTo-JSON -Compress -Depth 100
    $Error.Clear()
    Try {
        [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] with parameters $parameters_display due to [$Message]."
        Break
    }
    [int32]$response_code = $results.response.status
    If ($response_code -ne 0) {
        [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
        Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
        Break
    }
    $Error.Clear()
    Try {
        [ANOWAgent]$Agent = $results.response.data | Select-Object -First 1
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "Failed to create [ANOWAgent] object due to [$Message]."
        Break
    }
    If ($Agent.id.Length -eq 0) {
        Write-Warning -Message "The newly created [ANOWAgent] Agent is empty!"
        Break
    }
    If ($Quiet -ne $true) {
        Return $Agent
    }
}

Function Remove-AutomateNOWAgent {
    <#
    .SYNOPSIS
    Removes a Agent from an AutomateNOW! instance

    .DESCRIPTION
    Removes a Agent from an AutomateNOW! instance

    .PARAMETER Agent
    An [ANOWAgent] object representing the Agent to be deleted.

    .PARAMETER Force
    Force the removal without confirmation. This is equivalent to -Confirm:$false

    .INPUTS
    ONLY [ANOWAgent] objects are accepted (including from the pipeline)

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Removes a single Agent
    Get-AutomateNOWAgent -Id 'Agent01' | Remove-AutomateNOWAgent

    .EXAMPLE
    Forcefully removes three Agents by way of the pipeline
    @( 'Agent1', 'Agent2', 'Agent3') | Get-AutomateNOWAgent | Remove-AutomateNOWAgent -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $false, ValueFromPipeline = $True)]
        [ANOWAgent]$Agent,
        [Parameter(Mandatory = $false)]
        [switch]$Force
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        [string]$command = '/agent/delete'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($_.id.Length -gt 0) {
            [ANOWAgent]$Agent = $_
        }
        [string]$Agent_id = $Agent.id
        If ($Agent_id.Length -eq 0) {
            Write-Warning -Message "An object with an empty Id was passed to this function."
            Break
        }
        If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($Agent_id)")) -eq $true) {
            [string]$old_values = $Agent.CreateOldValues()
            [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
            $BodyMetaData.'id' = $Agent.id
            $BodyMetaData.'_textMatchStyle' = 'exact'
            $BodyMetaData.'_operationType' = 'remove'
            $BodyMetaData.'_oldValues' = $old_values
            $BodyMetaData.'_componentId' = 'AgentList'
            $BodyMetaData.'_dataSource' = 'AgentDataSource'
            $BodyMetaData.'isc_metaDataPrefix' = '_'
            $BodyMetaData.'isc_dataFormat' = 'json'
            [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
            If ($null -eq $parameters["Body"]) {
                $parameters.Add('Body', $Body)
            }
            Else {
                $parameters.Body = $Body
            }
            $Error.Clear()
            Try {
                [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
            }
            Catch {
                [string]$Message = $_.Exception.Message
                Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Agent_id] due to [$Message]."
                Break
            }
            [int32]$response_code = $results.response.status
            If ($response_code -ne 0) {
                [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                Break
            }
            Write-Verbose -Message "Agent [$Agent_id] successfully removed"
        }
    }
    End {

    }
}

Function Copy-AutomateNOWAgent {
    <#
    .SYNOPSIS
    Copies an Agent from an AutomateNOW! instance

    .DESCRIPTION
    Copies an Agent from an AutomateNOW! instance.

    .PARAMETER Agent
    Mandatory [ANOWAgent] object to be copied.

    .PARAMETER NewId
    The name (Id) of the new Agent. The new Id must be unique (per domain). It may consist only of letters, numbers, underscore, dot or hyphen.

    .PARAMETER Description
    Optional description to set on the new Agent object. If you do not set this, the new Agent object will copy the Description of the source object.

    .PARAMETER UnsetDescription
    Optional switch that will ensure that the newly created Agent will not have a description set.

    .PARAMETER Tags
    Optional string array of CASE-SENSITIVE Tag Id's to set on the new Agent object. If you do not set this, the new Agent object will apply the same Tags of the source object.

    .PARAMETER UnsetTags
    Optional switch that will ensure that the newly created Agent will not have any Tags set.

    .PARAMETER Folder
    Optional description to set a different folder on the new Agent object. If you do not set this, the new Agent object will use the same Folder of the source object.

    .PARAMETER UnsetFolder
    Optional switch that will ensure that the newly created Agent will not have a Folder set.

    .PARAMETER Force
    Force the copy without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly created object.

    .INPUTS
    ONLY the [ANOWAgent] object type is accepted. Pipeline support is intentionally unavailable.

    .OUTPUTS
    None. The status will be written to the console with Write-Verbose.

    .EXAMPLE
    Creates a copy of an Agent and changes the description (multi-line format)
    $Agent01 = Get-AutomateNOWAgent -Id 'Agent_01'
    Copy-AutomateNOWAgent -Agent $Agent01 -NewId 'Agent_01_production' -Description 'Agent 01 Production'

    .EXAMPLE
    Creates a copy of an Agent that omits the description (one-liner format)
    Copy-AutomateNOWAgent -Agent (Get-AutomateNOWAgent -Id 'Agent_01') -NewId 'Agent_01_production' -UnsetDescription -Tags 'Tag1', 'Tag2'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWAgent])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWAgent]$Agent,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,1024}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [ValidateScript({ $_.Length -le 255 })]
        [string]$Description,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetDescription,
        [Parameter(Mandatory = $false)]
        [string[]]$Tags,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetTags,
        [Parameter(Mandatory = $false)]
        [string]$Folder,
        [Parameter(Mandatory = $false)]
        [switch]$UnsetFolder,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        If ($UnsetDescription -eq $true -and $Description.Length -gt 0) {
            Write-Warning -Message "You cannot set the description and unset it at the same time. Please choose one or the other."
            Break
        }
        If ($UnsetFolder -eq $true -and $Folder.Length -gt 0) {
            Write-Warning -Message "You cannot set the Folder and unset it at the same time. Please choose one or the other."
            Break
        }
        If ($UnsetTags -eq $true -and $Tags.Count -gt 0) {
            Write-Warning -Message "You cannot set the Tags and unset them at the same time. Please choose one or the other. Tags from the source object will be carried over to the new object if you do not specify any tag-related parameters."
            Break
        }
        ## Begin warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$Agent_exists = ($null -ne (Get-AutomateNOWAgent -Id $NewId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWAgent failed to check if the Agent [$NewId] already existed due to [$Message]."
            Break
        }
        If ($Agent_exists -eq $true) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is already an Agent named [$NewId] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        ## End warning ##
        [string]$command = '/agent/copy'
        [hashtable]$parameters = @{}
        $parameters.Add('Command', $command)
        $parameters.Add('Method', 'POST')
        $parameters.Add('ContentType', 'application/x-www-form-urlencoded; charset=UTF-8')
        If ($anow_session.NotSecure -eq $true) {
            $parameters.Add('NotSecure', $true)
        }
    }
    Process {
        If ($PermissionToProceed -ne $false) {
            [string]$Agent_oldId = $Agent.id
            [string]$Agent_simpleId = $Agent.simpleId
            If ($Agent_oldId -eq $NewId) {
                Write-Warning -Message "The new id cannot be the same as the old id."
                Break
            }
            If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Copy the Agent $($Agent_simpleId) to $($NewId)?")) -eq $true) {
                [System.Collections.Specialized.OrderedDictionary]$BodyMetaData = [System.Collections.Specialized.OrderedDictionary]@{}
                If ($UnsetFolder -eq $True) {
                    $BodyMetaData.'folder' = $Null
                }
                ElseIf ($Folder.Length -gt 0) {
                    $BodyMetaData.'folder' = $Folder
                }
                Else {
                    If ($Agent.folder.Length -gt 0) {
                        $BodyMetaData.'folder' = $Agent.folder
                    }
                }
                If ($Tags.Count -gt 0) {
                    ForEach ($tag_id in $Tags) {
                        $Error.Clear()
                        Try {
                            [ANOWTag]$tag_object = Get-AutomateNOWTag -Id $tag_id
                        }
                        Catch {
                            [string]$Message = $_.Exception.Message
                            Write-Warning -Message "Get-AutomateNOWTag had an error while retrieving the tag [$tag_id] running under Copy-AutomateNOWAgent due to [$Message]"
                            Break
                        }
                        If ($tag_object.simpleId.length -eq 0) {
                            Throw "Get-AutomateNOWTag failed to confirm that the tag [$tag_id] actually exists under Copy-AutomateNOWAgent."
                        }
                    }
                    [int32]$tag_count = 1
                    ForEach ($tag in $Tags) {
                        $BodyMetaData.('tags' + $tag_count ) = $tag
                        $tag_count++
                    }
                }
                ElseIf ($UnsetTags -eq $true) {
                    $BodyMetaData.'tags' = $Null
                }
                Else {
                    If ($Agent.tags.Count -gt 0) {
                        [int32]$tag_count = 1
                        ForEach ($tag in $Agent.tags) {
                            $BodyMetaData.('tags' + $tag_count ) = $tag
                            $tag_count++
                        }
                    }
                }
                $BodyMetaData.'oldId' = $Agent_oldId
                $BodyMetaData.'domain' = $Agent.domain
                $BodyMetaData.'id' = $NewId
                If ($UnsetDescription -ne $true) {
                    If ($Description.Length -gt 0) {
                        $BodyMetaData.'description' = $Description
                    }
                    Else {
                        $BodyMetaData.'description' = $Agent.description
                    }
                }
                $BodyMetaData.'_operationType' = 'add'
                $BodyMetaData.'_operationId' = 'copy'
                $BodyMetaData.'_textMatchStyle' = 'exact'
                $BodyMetaData.'_dataSource' = 'AgentDataSource'
                $BodyMetaData.'isc_metaDataPrefix' = '_'
                $BodyMetaData.'isc_dataFormat' = 'json'
                [string]$Body = ConvertTo-QueryString -InputObject $BodyMetaData
                $parameters.Body = $Body
                $Error.Clear()
                Try {
                    [PSCustomObject]$results = Invoke-AutomateNOWAPI @parameters
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Invoke-AutomateNOWAPI failed to execute [$command] on [$Agent_oldId] due to [$Message]."
                    Break
                }
                [int32]$response_code = $results.response.status
                If ($response_code -ne 0) {
                    [string]$full_response_display = $results.response | ConvertTo-Json -Compress -Depth 100
                    Write-Warning -Message "The response code was not 0 but was [$response_code]. Body: $full_response_display"
                    Break
                }
                $Error.Clear()
                Try {
                    [ANOWAgent]$NewAgent = $results.response.data | Select-Object -First 1
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Failed to create copied [ANOWAgent] object [$NewId] due to [$Message]."
                    Break
                }
                If ($NewAgent.id.Length -eq 0) {
                    Write-Warning -Message "The newly created (copied) [ANOWAgent] object [$NewId] is empty!"
                    Break
                }
                If ($Quiet -ne $true) {
                    Return $NewAgent
                }
            }
        }
    }
    End {

    }
}

Function Rename-AutomateNOWAgent {
    <#
    .SYNOPSIS
    Renames an Agent on an AutomateNOW! instance

    .DESCRIPTION
    Performs a pseudo-rename operation of an Agent from an AutomateNOW! instance by copying it first and then deleting the source. This function merely combines Copy-AutomateNOWAgent and Remove-AutomateNOWAgent therefore it is to be considered destructive.

    .PARAMETER Agent
    An [ANOWAgent] object representing the Agent to be renamed.

    .PARAMETER NewId
    Mandatory string indicating the new id or name of the Agent. The Id is the same as a primary key, it must be unique. The console will provide the old Id + '_COPY' in the UI when making a copy. The Id is limited to 1024 characters.

    .PARAMETER Force
    Force the renaming without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Optional switch to suppress the return of the newly renamed object.

    .INPUTS
    ONLY [ANOWAgent] objects are accepted. There is intentionally no support for the pipeline.

    .OUTPUTS
    The newly renamed [ANOWAgent] object will be returned.

    .EXAMPLE
    $Agent = Get-AutomateNOWAgent -Id 'Agent01'
    Rename-AutomateNOWAgent -Agent $Agent -NewId 'Agent_02'

    .EXAMPLE
    Rename-AutomateNOWAgent -Agent (Get-AutomateNOWAgent -Id 'Agent01') -NewId 'Agent_02'

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    When renaming, you may only specify a different Id (name).

    This action will be denied if any existing referrals are found on the object.
    #>
    [OutputType([ANOWAgent])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWAgent]$Agent,
        [Parameter(Mandatory = $true)]
        [ValidateScript({ $_ -match '^[0-9a-zA-Z_.-]{1,1024}$' })]
        [string]$NewId,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )
    Begin {
        If ((Confirm-AutomateNOWSession -Quiet) -ne $true) {
            Write-Warning -Message "There is not a valid token confirmed."
            Break
        }
        ## Begin standard warning ##
        ## Do not tamper with this below code which makes sure that the object exists before attempting to change it.
        $Error.Clear()
        Try {
            [boolean]$new_Agent_exists = ($null -ne (Get-AutomateNOWAgent -Id $NewId))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWAgent failed to check if the Agent [$NewId] already existed due to [$Message]."
            Break
        }
        If ($new_Agent_exists -eq $true) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is already a Agent named [$NewId] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        [string]$Agent_id = $Agent.simpleId
        $Error.Clear()
        Try {
            [boolean]$old_Agent_exists = ($null -ne (Get-AutomateNOWAgent -Id $Agent_id))
        }
        Catch {
            [string]$Message = $_.Exception.Message
            Write-Warning -Message "Get-AutomateNOWAgent failed to check if the Agent [$Agent_id] already existed due to [$Message]."
            Break
        }
        If ($old_Agent_exists -eq $false) {
            [string]$current_domain = $anow_session.header.domain
            Write-Warning -Message "There is not a Agent named [$Agent_id] in [$current_domain]. You may not proceed."
            [boolean]$PermissionToProceed = $false
        }
        ## End standard warning ##
    }
    Process {
        If ($PermissionToProceed -ne $false) {
            If (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("$($Agent_id)")) -eq $true) {
                $Error.Clear()
                Try {
                    [ANOWAgent]$new_Agent = Copy-AutomateNOWAgent -Agent $Agent -NewId $NewId -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Copy-AutomateNOWAgent failed to create a new Agent [$NewId] as Part 1 of the renaming process due to [$Message]."
                    Break
                }
                If ($new_Agent.simpleId -eq $NewId) {
                    Write-Verbose -Message "Part 1: Agent [$Agent_id] successfully copied to [$NewId]"
                }
                Else {
                    Write-Warning -Message "The first phase (Copy-AutomateNOWAgent) failed."
                    Break
                }
                $Error.Clear()
                Try {
                    Remove-AutomateNOWAgent -Agent $Agent -Force
                }
                Catch {
                    [string]$Message = $_.Exception.Message
                    Write-Warning -Message "Remove-AutomateNOWAgent failed to remove [$Agent_id] as Part 2 of the renaming process due to [$Message]."
                    Break
                }
                Write-Verbose -Message "Part 2: Agent [$Agent_id] removed"
                Write-Verbose -Message "Task [$Agent_id] successfully renamed to [$NewId]"
                If ($Quiet -ne $true) {
                    Return $new_Agent
                }
            }
        }
        Else {
            Write-Warning -Message "No action was taken because either the source object didn't exist or the new object already existed"
        }
    }
    End {
    }
}

Function Send-AutomateNOWAgentConfiguration {
