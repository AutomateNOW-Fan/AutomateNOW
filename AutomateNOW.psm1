    $arguments=@{Kind=$Kind;Options=$Options}
    if ($null -ne $Target) { $arguments['Target']=$Target }
    $checked=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command $command) -OperationParameters $arguments
    return ($checked.Succeeded -and @($checked.Data).Count -eq 1 -and $checked.Data[0] -is [bool] -and $checked.Data[0])
}

Function Confirm-ANOWPreservationSession {
    $session=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Confirm-AutomateNOWSession) -OperationParameters @{Quiet=$true}
