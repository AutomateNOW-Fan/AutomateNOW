#region - Approval Rule

Function New-AutomateNOWApprovalRule {
    <#
    .SYNOPSIS
    Creates an Approval Rule object for use with an Approval object within an AutomateNOW! instance

    .DESCRIPTION
    Creates an Approval Rule object for use with an Approval object within an AutomateNOW! instance

    .PARAMETER approvalLevel
    Mandatory string that sets the approval level. Valid choices are: LOW, MEDIUM, HIGH

    .PARAMETER approvalActionType
    Mandatory string that sets the approval level. Valid choices are: READY_TO_START, PROCESSING_RESTART, PROCESSING_FORCE_READY, PROCESSING_FORCE_COMPLETED, PROCESSING_FORCE_FAILED, PROCESSING_SKIP_ON, PROCESSING_SKIP_OFF, PROCESSING_HOLD, PROCESSING_RESUME, PROCESSING_INTERNAL_ACTION, PROCESSING_ABORT, PROCESSING_KILL, PROCESSING_ARCHIVED, PROCESSING_ARCHIVED_CLEANUP

    .PARAMETER noSelfApproval
    Optional switch that requires a different user account to approve the approval

    .PARAMETER passwordConfirmation
    Optional switch that will ask the approver for a password.

    .INPUTS
    None. You cannot pipe objects to New-AutomateNOWApprovalRule.

    .OUTPUTS
    An [ANOWApprovalRule] object representing the newly created Approval Rule

    .EXAMPLE
    New-AutomateNOWApprovalRule ?

    .NOTES

    This function does not require connectivity to the AutomateNOW! instance

    #>
    [OutputType([ANOWApprovalRule])]
    [CmdletBinding()]
    Param(
        [Parameter(Mandatory = $True)]
        [ANOWApprovalRule_approvalLevel]$approvalLevel,
        [Parameter(Mandatory = $True)]
        [ANOWApprovalRule_approvalActionType]$approvalActionType,
        [Parameter(Mandatory = $False)]
        [switch]$noSelfApproval,
        [Parameter(Mandatory = $False)]
        [switch]$passwordConfirmation
    )
    $Error.Clear()
    Try {
        [ANOWApprovalRule]$ApprovalRule = [ANOWApprovalRule]::new()
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "The [ANOWApprovalRule] failed to instantiate due to [$Message]."
        Break
    }
    $Error.Clear()
    Try {
        $ApprovalRule.approvalLevel = [string]$approvalLevel
        $ApprovalRule.approvalActionType = [string]$approvalActionType
        If ($noSelfApproval -eq $true) {
            $ApprovalRule.noSelfApproval = [boolean]$noSelfApproval
        }
        If ($passwordConfirmation -eq $true) {
            $ApprovalRule.passwordConfirmation = [boolean]$passwordConfirmation
        }
    }
    Catch {
        [string]$Message = $_.Exception.Message
        Write-Warning -Message "The [ANOWApprovalRule] object failed to populate one of the properties due to [$Message]."
        Break
    }
    Return $ApprovalRule
}

Function Get-ANOWRuleCollectionParent {
    [CmdletBinding()]
    param([ValidateSet('Approval','ResultMapping')][string]$Kind,[object]$Target)
    $ErrorActionPreference='Stop'
    $type=if ($Kind -ceq 'Approval') { [ANOWApproval] } else { [ANOWResultMapping] }
    if (-not $type.IsInstanceOfType($Target) -or [string]::IsNullOrWhiteSpace($Target.id) -or
        [string]::IsNullOrWhiteSpace($Target.simpleId)) { throw 'A typed parent with exact full and simple identifiers is required.' }
    $lookup=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ('Get-AutomateNOW'+$Kind)) -OperationParameters @{Id=$Target.simpleId}
    if (-not $lookup.Succeeded -or @($lookup.Data).Count -ne 1 -or -not $type.IsInstanceOfType($lookup.Data[0])) { throw 'One clean typed prerequisite parent is required.' }
    $parent=$lookup.Data[0]
    if (-not [string]::Equals($parent.id,$Target.id,[StringComparison]::Ordinal) -or
        -not [string]::Equals($parent.simpleId,$Target.simpleId,[StringComparison]::Ordinal) -or
        (-not [string]::IsNullOrEmpty($Target.domain) -and -not [string]::Equals($parent.domain,$Target.domain,[StringComparison]::Ordinal))) { throw 'The prerequisite parent identity does not match the caller.' }
    return $parent
}

Function New-ANOWRuleCollectionRequest {
    [CmdletBinding()]
    param([ValidateSet('Approval','ResultMapping')][string]$Kind,[object]$Target,[AllowEmptyCollection()][object[]]$Rules,[switch]$Add)
    $ErrorActionPreference='Stop'
    if ($Kind -ceq 'Approval') {
        $wire=@(foreach ($rule in $Rules) {
            [pscustomobject]@{approvalLevel=[string]$rule.approvalLevel;approvalActionType=[string]$rule.approvalActionType;noSelfApproval=$rule.noSelfApproval;passwordConfirmation=$rule.passwordConfirmation}
        })
        $collection='rules';$route='/approvalConfiguration/update';$component='ApprovalEditForm';$dataSource='ApprovalDataSource'
    } else {
        $wire=@($Rules)
        $collection='definition';$route='/resultMapping/update';$component='ResultMappingEditForm';$dataSource='ResultMappingDataSource'
    }
    $json=@(ConvertTo-Json -InputObject $wire -Compress -Depth 100 -ErrorAction Stop -WarningAction Stop)
    if ($json.Count -ne 1 -or $json[0] -isnot [string] -or [string]::IsNullOrEmpty($json[0])) { throw 'The rule collection JSON was not serialized.' }
    $metadata=[ordered]@{id=$Target.simpleId}
    if ($Kind -ceq 'Approval' -and $Add) {
        $metadata['description']=if ($Target.description.Length -gt 0) { $Target.description } else { $null }
        $metadata['codeRepository']=if ($Target.codeRepository.Length -gt 0) { $Target.codeRepository } else { $null }
    }
    $metadata[$collection]=$json[0]
    $metadata['_operationType']='update';$metadata['_textMatchStyle']='exact'
    $metadata['_oldValues']=$Target.CreateOldValues()
    $metadata['_componentId']=$component;$metadata['_dataSource']=$dataSource
    $metadata['isc_metaDataPrefix']='_';$metadata['isc_dataFormat']='json'
    $serialized=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$metadata}
    if (-not $serialized.Succeeded -or @($serialized.Data).Count -ne 1 -or $serialized.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($serialized.Data[0])) { throw 'The rule collection form was not cleanly serialized.' }
    return [pscustomobject]@{Command=$route;Body=$serialized.Data[0]}
}

Function Invoke-ANOWRuleCollectionUpdate {
    [CmdletBinding()]
    param([ValidateSet('Approval','ResultMapping')][string]$Kind,[object]$Target,[AllowEmptyCollection()][object[]]$Rules,[switch]$Add)
    $ErrorActionPreference='Stop'
    $prepared=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command New-ANOWRuleCollectionRequest) -OperationParameters @{Kind=$Kind;Target=$Target;Rules=$Rules;Add=$Add}
    if (-not $prepared.Succeeded -or @($prepared.Data).Count -ne 1) { throw 'The rule collection request was not cleanly prepared.' }
    $parameters=@{Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8';Command=$prepared.Data[0].Command;Body=$prepared.Data[0].Body}
    if ($anow_session.NotSecure -eq $true) { $parameters['NotSecure']=$true }
    $submitted=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
    if (-not $submitted.Succeeded -or -not (Test-ANOWPreservationAcknowledgment -Envelopes $submitted.Data)) { throw 'The rule collection update was not cleanly acknowledged with integral zero; its server-side outcome may be uncertain.' }
    $converted=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWRuleCollectionResponse) -OperationParameters @{Kind=$Kind;Target=$Target;Envelopes=$submitted.Data}
    $type=if ($Kind -ceq 'Approval') { [ANOWApproval] } else { [ANOWResultMapping] }
    if (-not $converted.Succeeded -or @($converted.Data).Count -ne 1 -or -not $type.IsInstanceOfType($converted.Data[0])) { throw 'One clean strict matching updated parent was not verified; the submitted outcome may be uncertain.' }
    return $converted.Data[0]
}

Function ConvertFrom-ANOWRuleCollectionResponse {
    [CmdletBinding()]
    param([ValidateSet('Approval','ResultMapping')][string]$Kind,[object]$Target,[object[]]$Envelopes)
    $ErrorActionPreference='Stop'
    $rows=@($Envelopes[0].response.data)
    if ($rows.Count -ne 1 -or $null -eq $rows[0]) { throw 'Exactly one returned parent is required.' }
    $row=$rows[0]
    $type=if ($Kind -ceq 'Approval') { [ANOWApproval] } else { [ANOWResultMapping] }
    if ($row -isnot [Collections.IDictionary] -and $row -isnot [Management.Automation.PSCustomObject] -and -not $type.IsInstanceOfType($row)) { throw 'A strict returned parent object is required.' }
    if ($row.id -isnot [string] -or $row.simpleId -isnot [string] -or
        -not [string]::Equals($row.id,$Target.id,[StringComparison]::Ordinal) -or
        -not [string]::Equals($row.simpleId,$Target.simpleId,[StringComparison]::Ordinal) -or
        (-not [string]::IsNullOrEmpty($Target.domain) -and -not [string]::Equals($row.domain,$Target.domain,[StringComparison]::Ordinal))) { throw 'The returned parent identity does not match the update.' }
    $allowed=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($property in $type.GetProperties()) { $null=$allowed.Add($property.Name) }
    $names=if ($row -is [Collections.IDictionary]) { @($row.Keys) } else { @($row.PSObject.Properties.Name) }
    foreach ($name in $names) { if ($name -isnot [string] -or -not $allowed.Contains($name)) { throw 'The returned parent has an unsupported member.' } }
    if ($Kind -ceq 'Approval') { $collection='rules';[ANOWApprovalRule[]]$rules=$row.rules }
    else { $collection='definition';[ANOWResultMappingRule[]]$rules=$row.definition }
    $converted=[pscustomobject]$row | Select-Object -Property * -ExcludeProperty $collection
    $converted | Add-Member -MemberType NoteProperty -Name $collection -Value $rules
    if ($Kind -ceq 'Approval') { return [ANOWApproval]$converted }
    return [ANOWResultMapping]$converted
}

Function Add-AutomateNOWApprovalRule {
    <#
    .SYNOPSIS
    Adds a Rule (a.k.a. "Action") to an Approval on an AutomateNOW! instance

    .DESCRIPTION
    A clean exact-ID prerequisite, integral-zero acknowledgment and one strict matching result are required, including Quiet. Collection order and caller-derived oldValues are preserved. Empty-array serialization is supported locally; backend empty-update acceptance is unqualified. A diagnostic stops this aggregate without retry; a dispatched failure may have an uncertain server-side outcome.

    Adds a Rule (a.k.a. "Action") to an Approval on an AutomateNOW! instance

    .PARAMETER Approval
    Mandatory [ANOWApproval] object (Use Get-AutomateNOWApproval).

    .PARAMETER ApprovalRule
    Mandatory [ANOWApprovalRule] object (Use New-AutomateNOWApprovalRule)

    .PARAMETER Force
    Force the addition of the object without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to silence the output from a successful update

    .INPUTS
    One [ANOWApproval] object along with one or more [ANOWApprovalRule] objects must be supplied

    .OUTPUTS
    The updated [ANOWApproval] object will be returned.

    .EXAMPLE
    Creates a rule with action type READY_TO_START, no self-approval, password confirmation and a high approval level to an Approval named 'Approval1' (multi-line format)
    $approval = Get-AutomateNOWApproval -Id 'Approval1'
    $approval_rule = New-AutomateNOWApprovalRule -approvalLevel HIGH -approvalActionType READY_TO_START -noSelfApproval -passwordConfirmation
    Add-AutomateNOWApprovalRule -Approval $approval -ApprovalRule $approval_rule

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    #>
    [OutputType([ANOWApproval])]
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWApproval]$Approval,
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [ANOWApprovalRule]$ApprovalRule,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )

    Begin {
        $stopped=$false
        $newRules=[Collections.Generic.List[ANOWApprovalRule]]::new()
        if (-not (Confirm-ANOWPreservationSession)) { $stopped=$true;Write-Warning 'There is not a clean valid token confirmed.' }
    }
    Process {
        if ($stopped) { return }
        $newRules.Add($ApprovalRule)
    }
    End {
        if ($stopped) { return }
        $Approval_id=$Approval.simpleId
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Add the Approval Rule(s) to the Approval $($Approval_id)?")) -eq $true) {
            try {
                $null=Get-ANOWRuleCollectionParent -Kind Approval -Target $Approval
                [ANOWApprovalRule[]]$rules=$newRules.ToArray()
                if ($null -ne $Approval.rules) { $rules+=$Approval.rules }
                $updated=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-ANOWRuleCollectionUpdate) -OperationParameters @{Kind='Approval';Target=$Approval;Rules=$rules;Add=$true}
                if (-not $updated.Succeeded -or @($updated.Data).Count -ne 1 -or $updated.Data[0] -isnot [ANOWApproval]) { throw 'The aggregate update failed or has an uncertain outcome.' }
                if (-not $Quiet) { return $updated.Data[0] }
            } catch { Write-Warning ("Failed to update Approval rules under Add-AutomateNOWApprovalRule due to [{0}]." -f $_.Exception.Message) }
        }
    }
}

Function Remove-AutomateNOWApprovalRule {
    <#
    .SYNOPSIS
    Removes a Rule (a.k.a. "Action") to an Approval on an AutomateNOW! instance

    .DESCRIPTION
    A clean exact-ID prerequisite, integral-zero acknowledgment and one strict matching result are required, including Quiet. Collection order and caller-derived oldValues are preserved. Empty-array serialization is supported locally; backend empty-update acceptance is unqualified. A diagnostic stops this aggregate without retry; a dispatched failure may have an uncertain server-side outcome.

    Removes a Rule (a.k.a. "Action") to an Approval on an AutomateNOW! instance

    .PARAMETER Approval
    Mandatory [ANOWApproval] object (Use Get-AutomateNOWApproval).

    .PARAMETER ApprovalRule
    Mandatory [ANOWApprovalRule] object (Use Get-AutomateNOWApprovalRule | Select-Object -ExpandProperty rules)

    .PARAMETER Force
    Force the removal of the object(s) without confirmation. This is equivalent to -Confirm:$false

    .PARAMETER Quiet
    Switch parameter to silence the output from a successful update

    .INPUTS
    One [ANOWApproval] object along with one or more [ANOWApprovalRule] objects must be supplied

    .OUTPUTS
    The updated [ANOWApproval] object will be returned.

    .EXAMPLE
    Forcibly and quietly removes first two Approval Rules of type 'PROCESSING_SKIP_OFF' from an Approval named 'Approval1' (multi-line format)

    $approval = Get-AutomateNOWApproval -Id 'Approval1'
    $approval_rules = $approval.rules
    $approval_rules_to_remove = $approval_rules | Where-Object { $_.approvalActionType -eq 'PROCESSING_SKIP_OFF' } | Select-Object -First 2
    $approval_rules_to_remove | Remove-AutomateNOWApprovalRule -Approval $approval -Quiet -Force

    .NOTES
    You must use Connect-AutomateNOW to establish the token by way of global variable.

    Approval Rules do not have an Id or even a Name, thus you need to exercise caution here and use some extra coding to ensure you do not remove more than you planned to.

    #>
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
    Param(
        [Parameter(Mandatory = $true)]
        [ANOWApproval]$Approval,
        [Parameter(Mandatory = $true, ValueFromPipeline = $true)]
        [ANOWApprovalRule]$ApprovalRule,
        [Parameter(Mandatory = $false)]
        [switch]$Force,
        [Parameter(Mandatory = $false)]
        [switch]$Quiet
    )

    Begin {
        $stopped=$false
        if (-not (Confirm-ANOWPreservationSession)) { $stopped=$true;Write-Warning 'There is not a clean valid token confirmed.';return }
        try {
            $null=Get-ANOWRuleCollectionParent -Kind Approval -Target $Approval
            if ($Approval.rules.Count -eq 0) { throw 'There are no rules inside of this Approval.' }
            [Collections.ArrayList]$rules=$Approval.rules.Clone()
        } catch { $stopped=$true;Write-Warning ("Failed to prepare Approval rules under Remove-AutomateNOWApprovalRule due to [{0}]." -f $_.Exception.Message) }
    }
    Process {
        if ($stopped) { return }
        try {
            $index=$rules.IndexOf($ApprovalRule)
            if ($index -lt 0) { throw 'The submitted rule is not a member of the caller parent collection.' }
            $rules.RemoveAt($index)
        } catch { $stopped=$true;Write-Warning ("Failed to remove an Approval rule under Remove-AutomateNOWApprovalRule due to [{0}]." -f $_.Exception.Message) }
    }
    End {
        if ($stopped) { return }
        $Approval_id=$Approval.simpleId
        if (($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Remove the Approval Rule(s) from the Approval [$($Approval_id)]?")) -eq $true) {
            try {
                $updated=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-ANOWRuleCollectionUpdate) -OperationParameters @{Kind='Approval';Target=$Approval;Rules=$rules.ToArray()}
                if (-not $updated.Succeeded -or @($updated.Data).Count -ne 1 -or $updated.Data[0] -isnot [ANOWApproval]) { throw 'The aggregate update failed or has an uncertain outcome.' }
                if (-not $Quiet) { return $updated.Data[0] }
            } catch { Write-Warning ("Failed to update Approval rules under Remove-AutomateNOWApprovalRule due to [{0}]." -f $_.Exception.Message) }
        }
    }
}

