        $parameters=@{Command='/domain/resume';Method='POST';ContentType='application/x-www-form-urlencoded; charset=UTF-8'}
        if($anow_session.NotSecure -eq $true){$parameters['NotSecure']=$true}
    }
    Process {
        if($stopped){return}
        if($null -eq $Domain -or [string]::IsNullOrWhiteSpace($Domain.id)){
            $stopped=$true;Write-Warning 'An identified Domain is required; remaining inputs were stopped.';return
        }
        $domainId=$Domain.id
        if(($Force -eq $true -and -not $WhatIfPreference) -or ($PSCmdlet.ShouldProcess("Resume the domain $($domainId)?")) -eq $true){
            $read=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Get-AutomateNOWDomain) -OperationParameters @{Id=$domainId}
            if(-not $read.Succeeded -or $read.Data.Count -ne 1 -or $read.Data[0] -isnot [ANOWDomain] -or $read.Data[0].id -cne $domainId){
                $stopped=$true;Write-Warning 'The exact Domain prerequisite was not cleanly verified; no resume request was sent and remaining inputs were stopped.';return
            }
            if($read.Data[0].globalHold -eq $false){
                $stopped=$true;Write-Warning "[$domainId] cannot be resumed because it is not currently suspended (on hold)";return
            }
            $metadata=[ordered]@{id=$domainId;_operationType='update';_operationId='resume';_textMatchStyle='exact';_dataSource='DomainDataSource';isc_metaDataPrefix='_';isc_dataFormat='json'}
            $query=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertTo-QueryString) -OperationParameters @{InputObject=$metadata}
            if(-not $query.Succeeded -or $query.Data.Count -ne 1 -or $query.Data[0] -isnot [string] -or [string]::IsNullOrEmpty($query.Data[0])){
                $stopped=$true;Write-Warning 'The Domain form was not cleanly serialized; no resume request was sent and remaining inputs were stopped.';return
            }
            $parameters['Body']=$query.Data[0]
            $request=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command Invoke-AutomateNOWAPI) -OperationParameters $parameters
            if(-not $request.Succeeded -or -not (Test-ANOWPreservationAcknowledgment $request.Data)){
                $stopped=$true;Write-Warning 'The Domain resume request was not cleanly acknowledged; the server outcome is uncertain and remaining inputs were stopped.';return
            }
            $result=Invoke-ANOWPrivateCommand -OperationCommand (Get-Command ConvertFrom-ANOWDomainTransitionResponse) -OperationParameters @{Target=$Domain;Held=$false;Envelopes=$request.Data}
            if(-not $result.Succeeded -or $result.Data.Count -ne 1 -or $result.Data[0] -isnot [ANOWDomain]){
                $stopped=$true;Write-Warning 'The returned Domain identity, hold state or strict enrichment was not verified; the server outcome is uncertain and remaining inputs were stopped.';return
            }
            Write-Verbose "Domain $domainId successfully resumed"
            if(-not $Quiet){$result.Data[0]}
        }
    }
}

